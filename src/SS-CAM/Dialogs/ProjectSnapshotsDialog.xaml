<ui:FluentWindow x:Class="SS_CAM.Dialogs.ProjectSnapshotsDialog"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  Title="Creative Version Timeline &amp; Rollback"
                  Height="620" Width="760"
                  MinHeight="480" MinWidth="600"
                  WindowStartupLocation="CenterOwner"
                  Background="{DynamicResource ApplicationPageBackgroundThemeBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Header ─────────────────────────────────────────── -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10"
                    Background="{DynamicResource FluentBrandLight}" Margin="0,0,14,0"
                    VerticalAlignment="Center">
                <ui:SymbolIcon Symbol="History24" FontSize="22"
                               Foreground="{DynamicResource FluentBrand80}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <ui:TextBlock Text="Creative Version Timeline &amp; Rollback"
                              FontSize="18" FontWeight="Bold"
                              Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                    <ui:TextBlock Text="Audit-backed revision milestones for "
                                  FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <ui:TextBlock x:Name="TxtProjectTitle" Text="[Project]"
                                  FontSize="12" FontWeight="SemiBold"
                                  Foreground="{DynamicResource FluentBrand80}"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ── Capture Snapshot Bar ────────────────────────────── -->
        <ui:Card Grid.Row="1" Padding="14,12" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="TxtSnapshotNote" Grid.Column="0"
                         FontSize="12" Padding="10,6"
                         ToolTip="Enter a descriptive note for this snapshot"/>

                <CheckBox x:Name="ChkIncludeSource" Grid.Column="1"
                          IsChecked="True" VerticalAlignment="Center"
                          Margin="12,0,12,0"
                          ToolTip="Include working design files (.afdesign, .psd, .ai) in this snapshot">
                    <ui:TextBlock Text="Include Source Binaries" FontSize="11.5" VerticalAlignment="Center"/>
                </CheckBox>

                <ui:Button Grid.Column="2" Appearance="Primary" Height="34"
                           Padding="14,0" Cursor="Hand" Click="OnCaptureSnapshotClicked"
                           ToolTip="Capture milestone snapshot">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Camera24" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <ui:TextBlock Text="Capture Snapshot" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </ui:Button>
            </Grid>
        </ui:Card>

        <!-- ── Timeline List ──────────────────────────────────── -->
        <Border Grid.Row="2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8" Padding="14">
            <Grid>
                <!-- Empty State -->
                <StackPanel x:Name="PanelEmptyState" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="Collapsed">
                    <ui:SymbolIcon Symbol="History24" FontSize="36"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <ui:TextBlock Text="No Historical Snapshots Captured Yet"
                                  FontSize="14" FontWeight="SemiBold"
                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                  HorizontalAlignment="Center"/>
                    <ui:TextBlock Text="Snapshots are created manually above or automatically prior to rollbacks."
                                  FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                  HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Snapshots ScrollViewer -->
                <ScrollViewer x:Name="ScrollerSnapshots" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
                    <ItemsControl x:Name="ListSnapshots">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ui:Card Margin="0,0,0,10" Padding="14,12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Top Row: Rev & Timestamp -->
                                        <Grid Grid.Row="0" Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Background="{DynamicResource FluentBrand80}"
                                                    CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                <ui:TextBlock Text="{Binding Revision, StringFormat='Rev {0}'}"
                                                              FontSize="10" FontWeight="Bold" Foreground="White"/>
                                            </Border>

                                            <Border Grid.Column="1" Background="{DynamicResource FluentBrandLight}"
                                                    CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                <ui:TextBlock Text="{Binding Status}" FontSize="10"
                                                              FontWeight="SemiBold" Foreground="{DynamicResource FluentBrand80}"/>
                                            </Border>

                                            <ui:TextBlock Grid.Column="2" Text="{Binding FormattedDate}"
                                                          FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                          VerticalAlignment="Center"/>

                                            <ui:TextBlock Grid.Column="3" Text="{Binding Id}"
                                                          FontSize="10" FontFamily="Consolas, Cascadia Code"
                                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                          VerticalAlignment="Center"/>
                                        </Grid>

                                        <!-- Note Row -->
                                        <ui:TextBlock Grid.Row="1" Text="{Binding Note}"
                                                      FontSize="13" FontWeight="SemiBold"
                                                      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                      TextWrapping="Wrap" Margin="0,0,0,6"/>

                                        <!-- Meta Row -->
                                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                                            <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                                    CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="Person24" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                    <ui:TextBlock Text="{Binding Actor}" FontSize="10.5" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>

                                            <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                                    CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="Flash24" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                    <ui:TextBlock Text="{Binding Trigger}" FontSize="10.5" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>

                                            <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                                    CornerRadius="4" Padding="6,2">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="Folder24" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                    <ui:TextBlock Text="{Binding SourceFilesSummary}" FontSize="10.5" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <!-- Source Files Chips (if any) -->
                                        <ItemsControl Grid.Row="3" ItemsSource="{Binding SourceFiles}" Margin="0,0,0,8">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                            BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="0,0,6,4">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Border Background="{DynamicResource FluentBrand80}" CornerRadius="2" Padding="3,1" Margin="0,0,5,0">
                                                                <ui:TextBlock Text="{Binding Extension}" FontSize="8.5" FontWeight="Bold" Foreground="White"/>
                                                            </Border>
                                                            <ui:TextBlock Text="{Binding Name}" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                            <ui:TextBlock Text="{Binding SizeFormatted, StringFormat='({0})'}" FontSize="9.5"
                                                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Rollback CTA Row -->
                                        <DockPanel Grid.Row="4" LastChildFill="False">
                                            <ui:Button DockPanel.Dock="Right" Appearance="Secondary" Height="28"
                                                       Padding="12,0" Cursor="Hand" Click="OnRollbackClicked"
                                                       Tag="{Binding Id}" ToolTip="Rollback project to this snapshot state">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="History24" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                    <ui:TextBlock Text="Rollback to this Revision" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </ui:Button>
                                        </DockPanel>
                                    </Grid>
                                </ui:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ── Footer ─────────────────────────────────────────── -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="14"
                               Foreground="{DynamicResource FluentBrand80}"
                               Margin="0,0,6,0" VerticalAlignment="Center"/>
                <ui:TextBlock Text="Pre-rollback safety backups are created automatically prior to any restoration."
                              FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                              VerticalAlignment="Center"/>
            </StackPanel>

            <ui:Button Grid.Column="1" Appearance="Subtle" Height="32" Padding="18,0"
                       Content="Close" Click="OnCloseClicked" Cursor="Hand"/>
        </Grid>
    </Grid>
</ui:FluentWindow>
