<ui:FluentWindow x:Class="SS_CAM.Dialogs.MarkdownDiffDialog"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  Title="Markdown &amp; Brief Revision Diff Inspector"
                  Height="750" Width="1100"
                  MinWidth="880" MinHeight="580"
                  WindowStartupLocation="CenterScreen"
                  Background="{DynamicResource ApplicationPageBackgroundThemeBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- 0: Header & Revision Selectors -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Diff Summary Metrics Banner -->
            <RowDefinition Height="Auto"/>
            <!-- 2: Diff Content Viewport (Unified or Side-by-Side) -->
            <RowDefinition Height="*"/>
            <!-- 3: Action Bar & Export -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 0. HEADER & SELECTORS -->
        <ui:Card Grid.Row="0" Padding="16,12" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 1: Title & Mode Toggles -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{DynamicResource FluentBrand80}" CornerRadius="6" Width="32" Height="32" Margin="0,0,10,0">
                            <ui:SymbolIcon Symbol="DocumentText24" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <ui:TextBlock x:Name="TxtDialogTitle" Text="Revision Diff Inspector" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <Border Background="{DynamicResource FluentBrandTint}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0">
                                    <ui:TextBlock x:Name="TxtDocTypeBadge" Text="COPY.MD" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource FluentBrand80}"/>
                                </Border>
                            </StackPanel>
                            <ui:TextBlock x:Name="TxtDocSubtitle" Text="Compare revisions, analyze modifications, and inspect changes line-by-line."
                                          FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,1,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- View Mode Selector -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button x:Name="BtnModeUnified" Appearance="Primary" Click="OnModeUnifiedClicked"
                                   Height="30" Padding="12,0" Cursor="Hand" ToolTip="Single unified diff flow">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="TextAlignLeft24" FontSize="13" Margin="0,0,5,0"/>
                                <ui:TextBlock Text="Unified" FontSize="11"/>
                            </StackPanel>
                        </ui:Button>
                        <ui:Button x:Name="BtnModeSideBySide" Appearance="Secondary" Click="OnModeSideBySideClicked"
                                   Height="30" Padding="12,0" Margin="6,0,0,0" Cursor="Hand" ToolTip="Side-by-side comparative split view">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="SplitVertical24" FontSize="13" Margin="0,0,5,0"/>
                                <ui:TextBlock Text="Side-by-Side" FontSize="11"/>
                            </StackPanel>
                        </ui:Button>
                    </StackPanel>
                </Grid>

                <!-- Row 2: Before & After File Selectors -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Before Revision -->
                    <StackPanel Grid.Column="0">
                        <ui:TextBlock Text="BEFORE (Original / Base)" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbBeforeRevision" Height="36" SelectionChanged="OnRevisionSelectionChanged"/>
                    </StackPanel>

                    <!-- Arrow Indicator -->
                    <ui:SymbolIcon Grid.Column="1" Symbol="ArrowRight24" FontSize="16"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10"/>

                    <!-- After Revision -->
                    <StackPanel Grid.Column="2">
                        <ui:TextBlock Text="AFTER (Revised / Current)" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbAfterRevision" Height="36" SelectionChanged="OnRevisionSelectionChanged"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </ui:Card>

        <!-- 1. METRICS BANNER -->
        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                CornerRadius="6" Padding="14,8" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Added Badge -->
                    <Border Background="{DynamicResource SystemFillColorSuccessBrush}" Opacity="0.15" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                        <ui:TextBlock x:Name="TxtMetricsAdded" Text="+0 Lines Added" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SystemFillColorSuccessBrush}"/>
                    </Border>
                    <!-- Deleted Badge -->
                    <Border Background="{DynamicResource SystemFillColorCriticalBrush}" Opacity="0.15" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                        <ui:TextBlock x:Name="TxtMetricsDeleted" Text="-0 Lines Removed" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SystemFillColorCriticalBrush}"/>
                    </Border>
                    <!-- Unchanged Count -->
                    <ui:TextBlock x:Name="TxtMetricsUnchanged" Text="0 unchanged" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Similarity Score -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:TextBlock Text="Similarity: " FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <ui:TextBlock x:Name="TxtSimilarityPercentage" Text="100%" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. DIFF VIEWPORT -->
        <ui:Card Grid.Row="2" Padding="0" Margin="0,0,0,12">
            <Grid>
                <!-- View A: Unified Flow -->
                <ScrollViewer x:Name="ScrollUnified" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="12">
                    <ItemsControl x:Name="ItemsUnifiedDiff">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="LineBorder" Padding="8,2" Margin="0,1" CornerRadius="3">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Old Line Number -->
                                        <ui:TextBlock Grid.Column="0" Text="{Binding OldLineNumber}" FontSize="11" FontFamily="Consolas, Cascadia Code" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextAlignment="Right" Margin="0,0,8,0"/>
                                        <!-- New Line Number -->
                                        <ui:TextBlock Grid.Column="1" Text="{Binding NewLineNumber}" FontSize="11" FontFamily="Consolas, Cascadia Code" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextAlignment="Right" Margin="0,0,8,0"/>
                                        <!-- Prefix (+ / -) -->
                                        <ui:TextBlock Grid.Column="2" Text="{Binding TypeSymbol}" FontSize="11" FontWeight="Bold" FontFamily="Consolas, Cascadia Code" Foreground="{Binding AccentBrush}"/>
                                        <!-- Content -->
                                        <ui:TextBlock Grid.Column="3" Text="{Binding Text}" FontSize="11.5" FontFamily="Consolas, Cascadia Code" Foreground="{Binding TextBrush}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- View B: Side-by-Side Split View -->
                <Grid x:Name="GridSideBySide" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Original -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="12">
                        <TextBox x:Name="TxtBeforeSideBySide" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                 FontFamily="Consolas, Cascadia Code" FontSize="11.5"
                                 Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap"/>
                    </ScrollViewer>

                    <!-- Separator -->
                    <Border Grid.Column="1" Background="{DynamicResource CardStrokeColorDefaultBrush}"/>

                    <!-- Right: Revised -->
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="12">
                        <TextBox x:Name="TxtAfterSideBySide" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                 FontFamily="Consolas, Cascadia Code" FontSize="11.5"
                                 Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap"/>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </ui:Card>

        <!-- 3. ACTION BAR -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Left Actions -->
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <ui:Button Appearance="Secondary" Click="OnCopyAddedLinesClicked" Height="34" Padding="14,0" Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Copy24" FontSize="14" Margin="0,0,6,0"/>
                        <ui:TextBlock Text="Copy Added Lines" FontSize="12"/>
                    </StackPanel>
                </ui:Button>
                <ui:Button Appearance="Secondary" Click="OnCopyUnifiedDiffClicked" Height="34" Padding="14,0" Margin="8,0,0,0" Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ClipboardCode24" FontSize="14" Margin="0,0,6,0"/>
                        <ui:TextBlock Text="Copy Full Diff Patch" FontSize="12"/>
                    </StackPanel>
                </ui:Button>
            </StackPanel>

            <!-- Right Actions -->
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ui:Button Appearance="Primary" Click="OnCloseClicked" Height="34" Padding="20,0" Cursor="Hand">
                    <ui:TextBlock Text="Close Inspector" FontSize="12" FontWeight="SemiBold"/>
                </ui:Button>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
