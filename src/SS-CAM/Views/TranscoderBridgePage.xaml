<!-- UTF-8 BOM required — do not remove -->
<Page x:Class="SS_CAM.Views.TranscoderBridgePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Transcoder Bridge">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Padding="24,20,24,32" PreviewMouseWheel="OnScrollViewerPreviewMouseWheel">
        <StackPanel>

            <!-- ── Page Header ───────────────────────────────────── -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <ui:SymbolIcon Symbol="ArrowSwap24" FontSize="24"
                                       Foreground="{DynamicResource FluentBrand80}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ui:TextBlock Text="Transcoder Bridge" FontSize="24" FontWeight="Bold"
                                      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                      VerticalAlignment="Center"/>
                    </StackPanel>
                    <ui:TextBlock Text="Multi-format asset conversion engine for web-optimized video and image deliverables."
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                  FontSize="13" Margin="0,4,0,0"/>
                </StackPanel>

                <ui:Button Grid.Column="1" Appearance="Secondary"
                           Click="OnRefreshEngineClicked" Height="36"
                           Padding="16,0" VerticalAlignment="Top" Cursor="Hand"
                           ToolTip="Re-probe system for FFmpeg installation">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowSync24" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <ui:TextBlock Text="Re-Check Engine" VerticalAlignment="Center"/>
                    </StackPanel>
                </ui:Button>
            </Grid>

            <!-- ── Engine Status Card ────────────────────────────── -->
            <ui:Card Padding="16,12" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="EngineStatusDot" Width="10" Height="10"
                                 Fill="{DynamicResource SystemFillColorSuccessBrush}"
                                 VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <ui:TextBlock x:Name="EngineStatusTitle" Text="FFmpeg Engine Ready"
                                              FontWeight="SemiBold" FontSize="13"
                                              Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <Border x:Name="EngineVersionBadge" Margin="8,0,0,0" Padding="6,1"
                                        CornerRadius="4" Background="{DynamicResource CardStrokeColorDefaultBrush}"
                                        VerticalAlignment="Center">
                                    <ui:TextBlock x:Name="EngineVersionText" Text="v9.0" FontSize="11"
                                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </Border>
                            </StackPanel>
                            <ui:TextBlock x:Name="EnginePathText" Text="Probing FFmpeg..."
                                          FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                          Margin="0,2,0,0" TextTrimming="CharacterEllipsis" MaxWidth="600"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Margin="0,0,20,0" HorizontalAlignment="Right">
                            <ui:TextBlock x:Name="StatQueuedCount" Text="0" FontSize="18" FontWeight="Bold"
                                          Foreground="{DynamicResource FluentBrand80}" HorizontalAlignment="Right"/>
                            <ui:TextBlock Text="In Queue" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,20,0" HorizontalAlignment="Right">
                            <ui:TextBlock x:Name="StatCompletedCount" Text="0" FontSize="18" FontWeight="Bold"
                                          Foreground="{DynamicResource SystemFillColorSuccessBrush}" HorizontalAlignment="Right"/>
                            <ui:TextBlock Text="Completed" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right">
                            <ui:TextBlock x:Name="StatFailedCount" Text="0" FontSize="18" FontWeight="Bold"
                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right"/>
                            <ui:TextBlock Text="Failed" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </ui:Card>

            <!-- ── File Ingestion Drop Zone ───────────────────────── -->
            <ui:Card Padding="20,18" Margin="0,0,0,16" AllowDrop="True"
                     Drop="OnFileDrop" DragOver="OnFileDragOver">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel HorizontalAlignment="Center" Margin="0,6,0,14">
                        <ui:SymbolIcon Symbol="CloudArrowUp24" FontSize="36"
                                       Foreground="{DynamicResource FluentBrand80}"
                                       HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <ui:TextBlock Text="Drag and drop media files or folders here"
                                      FontSize="15" FontWeight="SemiBold"
                                      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                      HorizontalAlignment="Center"/>
                        <ui:TextBlock Text="Supports MP4, MOV, AVI, WebM, PNG, JPG, JPEG, WebP, TIFF, BMP"
                                      FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                      HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
                        <ui:Button Appearance="Primary" Click="OnAddFilesClicked"
                                   Height="36" Padding="18,0" Margin="0,0,12,0" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="DocumentAdd24" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <ui:TextBlock Text="Select Files..." VerticalAlignment="Center" FontWeight="Medium"/>
                            </StackPanel>
                        </ui:Button>

                        <ui:Button Appearance="Secondary" Click="OnAddFolderClicked"
                                   Height="36" Padding="18,0" Margin="0,0,12,0" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="FolderAdd24" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <ui:TextBlock Text="Select Folder..." VerticalAlignment="Center"/>
                            </StackPanel>
                        </ui:Button>

                        <ui:Button Appearance="Secondary" Click="OnClearAllQueueClicked"
                                   Height="36" Padding="14,0" Cursor="Hand" ToolTip="Empty entire queue">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Delete24" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <ui:TextBlock Text="Clear All" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ui:Button>
                    </StackPanel>
                </Grid>
            </ui:Card>

            <!-- ── Transcode Settings Card ────────────────────────── -->
            <ui:Card Padding="18,14" Margin="0,0,0,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Preset Selection -->
                    <StackPanel Grid.Column="0">
                        <ui:TextBlock Text="Target Format Preset" FontWeight="SemiBold" FontSize="12"
                                      Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,6"/>
                        <ComboBox x:Name="PresetComboBox" Height="36" MinHeight="36"
                                  VerticalContentAlignment="Center" Padding="10,0"
                                  SelectionChanged="OnPresetSelectionChanged">
                            <ComboBoxItem Content="WebP Image (.webp) - 85% Quality Web Asset" IsSelected="True" Tag="WebP_Image"/>
                            <ComboBoxItem Content="AVIF Image (.avif) - Next-Gen High Compression" Tag="Avif_Image"/>
                            <ComboBoxItem Content="WebM Video (.webm) - VP9/Opus HTML5 Video" Tag="WebM_Video"/>
                            <ComboBoxItem Content="Social GIF (.gif) - 10s Animated Preview 480p" Tag="Social_Gif_10s"/>
                            <ComboBoxItem Content="MP4 Compress (.mp4) - Faststart H.264 Web" Tag="Mp4_Compress"/>
                        </ComboBox>
                        <ui:TextBlock x:Name="PresetDescriptionText"
                                      Text="Optimized for web pages and digital portals. Delivers ~80% size savings over raw PNG."
                                      FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                      Margin="2,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Right: Output Folder -->
                    <StackPanel Grid.Column="2">
                        <ui:TextBlock Text="Output Destination Directory" FontWeight="SemiBold" FontSize="12"
                                      Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="OutputDirTextBox" Height="36" VerticalContentAlignment="Center"
                                     Padding="10,0" ToolTip="Leave empty to output beside the source file"/>
                            <ui:Button Grid.Column="1" Appearance="Secondary" Content="Browse..."
                                       Height="36" Padding="12,0" Margin="8,0,0,0" Click="OnBrowseOutputDirClicked"/>
                            <ui:Button Grid.Column="2" Appearance="Secondary" Content="Same as Source"
                                       Height="36" Padding="12,0" Margin="6,0,0,0" Click="OnSameAsSourceClicked"
                                       ToolTip="Reset to saving transcoded files in the same folder as each source"/>
                        </Grid>
                        <ui:TextBlock x:Name="OutputDirHintText"
                                      Text="Saving alongside source file by default (e.g. image_web.webp)."
                                      FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                      Margin="2,6,0,0"/>
                    </StackPanel>
                </Grid>
            </ui:Card>

            <!-- ── Batch Control Ribbon ──────────────────────────── -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <ui:Button x:Name="StartBatchBtn" Appearance="Primary" Click="OnStartBatchClicked"
                               Height="36" Padding="20,0" Margin="0,0,10,0" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Play24" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <ui:TextBlock Text="Start Batch Conversion" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ui:Button>

                    <ui:Button x:Name="CancelBatchBtn" Appearance="Secondary" Click="OnCancelBatchClicked"
                               Height="36" Padding="16,0" Margin="0,0,10,0" IsEnabled="False" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <ui:TextBlock Text="Cancel" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ui:Button>

                    <ui:Button x:Name="ClearFinishedBtn" Appearance="Secondary" Click="OnClearFinishedClicked"
                               Height="36" Padding="14,0" Margin="0,0,10,0" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Checkmark24" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <ui:TextBlock Text="Clear Finished" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ui:Button>
                </StackPanel>

                <ui:Button Grid.Column="2" Appearance="Secondary" Click="OnOpenOutputDirClicked"
                           Height="36" Padding="16,0" Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="FolderOpen24" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <ui:TextBlock Text="Open Output Folder" VerticalAlignment="Center"/>
                    </StackPanel>
                </ui:Button>
            </Grid>

            <!-- ── Total Batch Progress Bar ──────────────────────── -->
            <ProgressBar x:Name="BatchProgressBar" Height="4" Margin="0,0,0,16"
                         Visibility="Collapsed" Minimum="0" Maximum="100" Value="0"
                         Foreground="{DynamicResource FluentBrand80}"/>

            <!-- ── Queue Table / List Card ───────────────────────── -->
            <ui:Card Padding="0" Margin="0,0,0,24">
                <Grid>
                    <!-- Empty State -->
                    <StackPanel x:Name="QueueEmptyState" HorizontalAlignment="Center" Margin="0,48"
                                Visibility="Visible">
                        <ui:SymbolIcon Symbol="ArrowSwap24" FontSize="36"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <ui:TextBlock Text="Transcode Queue is Empty" FontSize="15" FontWeight="SemiBold"
                                      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                      HorizontalAlignment="Center"/>
                        <ui:TextBlock Text="Add media files above to queue them for batch conversion."
                                      FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                      HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Items List -->
                    <ListView x:Name="QueueListView" BorderThickness="0" Background="Transparent"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              SelectionMode="Single" Visibility="Collapsed">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="0,0,0,1" Padding="16,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Status Icon -->
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                                            <Border Width="32" Height="32" CornerRadius="16"
                                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1">
                                                <ui:SymbolIcon Symbol="ArrowSwap24" FontSize="14"
                                                               Foreground="{DynamicResource FluentBrand80}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </StackPanel>

                                        <!-- File Information & Progress -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="13"
                                                              Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                <Border Margin="8,0,0,0" Padding="6,1" CornerRadius="4"
                                                        Background="{DynamicResource CardStrokeColorDefaultBrush}">
                                                    <ui:TextBlock Text="{Binding PresetName}" FontSize="10"
                                                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                </Border>
                                            </StackPanel>

                                            <!-- Subtitle: Source Path / Status -->
                                            <ui:TextBlock Text="{Binding StatusMessage}" FontSize="11"
                                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                          Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>

                                            <!-- Progress Bar (shown when processing) -->
                                            <ProgressBar Height="3" Margin="0,6,0,0" Minimum="0" Maximum="100"
                                                         Value="{Binding ProgressPercent}"
                                                         Foreground="{DynamicResource FluentBrand80}"/>
                                        </StackPanel>

                                        <!-- Size & Savings KPI -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,20,0" HorizontalAlignment="Right">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <ui:TextBlock Text="{Binding SourceSizeFormatted}" FontSize="11"
                                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                <ui:TextBlock Text=" -&gt; " FontSize="11"
                                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                <ui:TextBlock Text="{Binding OutputSizeFormatted}" FontSize="11" FontWeight="SemiBold"
                                                              Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            </StackPanel>
                                            <ui:TextBlock Text="{Binding SavingsFormatted}" FontSize="12" FontWeight="Bold"
                                                          Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                                          HorizontalAlignment="Right" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- Actions -->
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:Button Appearance="Secondary" Padding="8,4" Margin="0,0,6,0"
                                                       ToolTip="Open output directory or file"
                                                       Tag="{Binding}" Click="OnItemRevealClicked">
                                                <ui:SymbolIcon Symbol="FolderOpen24" FontSize="13"/>
                                            </ui:Button>

                                            <ui:Button Appearance="Secondary" Padding="8,4"
                                                       ToolTip="Remove from queue"
                                                       Tag="{Binding}" Click="OnItemRemoveClicked">
                                                <ui:SymbolIcon Symbol="Dismiss24" FontSize="13"/>
                                            </ui:Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </ui:Card>

        </StackPanel>
    </ScrollViewer>
</Page>
