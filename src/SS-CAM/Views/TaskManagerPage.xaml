<Page x:Class="SS_CAM.Views.TaskManagerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Task Manager">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page Header -->
        <StackPanel Grid.Row="0" Margin="24,20,24,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE9D5;" FontFamily="Segoe Fluent Icons" FontSize="22"
                           Foreground="{DynamicResource FluentBrand80}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="Task Manager" FontSize="22" FontWeight="Bold"
                           Foreground="{DynamicResource FluentBrand80}" FontFamily="{StaticResource FluentFontFamily}"/>
            </StackPanel>
            <TextBlock Text="Project status driven by YAML frontmatter in each project's README.md."
                       Foreground="{DynamicResource FluentLightTextSecondary}" FontSize="12"
                       Margin="0,3,0,0" FontFamily="{StaticResource FluentFontFamily}"/>
        </StackPanel>

        <!-- Filter / Refresh Bar -->
        <Border Grid.Row="1" Background="{DynamicResource FluentLightCardBg}"
                BorderBrush="{DynamicResource FluentLightStroke}" BorderThickness="1"
                CornerRadius="6" Padding="14,10" Margin="24,0,24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Filter:" FontFamily="{StaticResource FluentFontFamily}" FontSize="11"
                               Foreground="{DynamicResource FluentLightTextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="DesignerFilterTM" Width="140" Height="30" SelectionChanged="OnTMFilterChanged"
                              FontFamily="{StaticResource FluentFontFamily}" FontSize="11"/>
                    <TextBlock Text="Priority:" FontFamily="{StaticResource FluentFontFamily}" FontSize="11"
                               Foreground="{DynamicResource FluentLightTextSecondary}" VerticalAlignment="Center" Margin="16,0,8,0"/>
                    <ComboBox x:Name="PriorityFilter" Width="110" Height="30" SelectionChanged="OnTMFilterChanged"
                              FontFamily="{StaticResource FluentFontFamily}" FontSize="11">
                        <ComboBoxItem Content="All Priorities" IsSelected="True"/>
                        <ComboBoxItem Content="urgent"/>
                        <ComboBoxItem Content="high"/>
                        <ComboBoxItem Content="medium"/>
                        <ComboBoxItem Content="low"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock x:Name="TxtTaskCount" Text="" FontFamily="{StaticResource FluentFontFamily}"
                               FontSize="11" Foreground="{DynamicResource FluentLightTextSecondary}"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Border CornerRadius="6" Background="{DynamicResource FluentBrand80}">
                        <Button Click="OnTMRefreshClicked" Background="Transparent" Foreground="White"
                                Height="30" Padding="12,0" BorderThickness="0" Cursor="Hand"
                                FontFamily="{StaticResource FluentFontFamily}" FontSize="11" FontWeight="Bold">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons" FontSize="12"
                                           Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Kanban Columns -->
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                      Margin="24,0,24,20">
            <StackPanel Orientation="Horizontal">

                <!-- Backlog Column -->
                <Border Width="240" Background="{DynamicResource FluentLightCardBg}"
                        BorderBrush="{DynamicResource FluentLightStroke}" BorderThickness="1"
                        CornerRadius="8" Margin="0,0,12,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="#E2E8F0" CornerRadius="8,8,0,0" Padding="12,8">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="10" Height="10" CornerRadius="5" Background="#94A3B8" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Backlog" FontWeight="Bold" FontFamily="{StaticResource FluentFontFamily}"
                                           FontSize="12" Foreground="#475569"/>
                                <Border Background="#CBD5E1" CornerRadius="8" Padding="5,1" Margin="8,0,0,0">
                                    <TextBlock x:Name="CountBacklog" Text="0" FontFamily="{StaticResource FluentFontFamily}"
                                               FontSize="10" Foreground="#475569"/>
                                </Border>
                            </StackPanel>
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="ListBacklog" Margin="6">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,6" Padding="10,8" Background="White"
                                                BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Cursor="Hand"
                                                MouseLeftButtonDown="OnProjectCardClicked">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Project}" FontFamily="{StaticResource FluentFontFamily}"
                                                           FontSize="11" FontWeight="SemiBold" Foreground="#1E293B"
                                                           TextWrapping="Wrap" TextTrimming="None"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <Border Background="{Binding PriorityColor}" CornerRadius="3" Padding="4,1" Margin="0,0,6,0">
                                                        <TextBlock Text="{Binding Priority}" FontFamily="{StaticResource FluentFontFamily}"
                                                                   FontSize="9" Foreground="White"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding DeadlineDisplay}" FontFamily="{StaticResource FluentFontFamily}"
                                                               FontSize="10" Foreground="{Binding DeadlineColor}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- In Progress Column -->
                <Border Width="240" Background="{DynamicResource FluentLightCardBg}"
                        BorderBrush="{DynamicResource FluentLightStroke}" BorderThickness="1"
                        CornerRadius="8" Margin="0,0,12,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="#DBEAFE" CornerRadius="8,8,0,0" Padding="12,8">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="10" Height="10" CornerRadius="5" Background="#3B82F6" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="In Progress" FontWeight="Bold" FontFamily="{StaticResource FluentFontFamily}"
                                           FontSize="12" Foreground="#1D4ED8"/>
                                <Border Background="#BFDBFE" CornerRadius="8" Padding="5,1" Margin="8,0,0,0">
                                    <TextBlock x:Name="CountInProgress" Text="0" FontFamily="{StaticResource FluentFontFamily}"
                                               FontSize="10" Foreground="#1D4ED8"/>
                                </Border>
                            </StackPanel>
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="ListInProgress" Margin="6">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,6" Padding="10,8" Background="White"
                                                BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Cursor="Hand"
                                                MouseLeftButtonDown="OnProjectCardClicked">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Project}" FontFamily="{StaticResource FluentFontFamily}"
                                                           FontSize="11" FontWeight="SemiBold" Foreground="#1E293B"
                                                           TextWrapping="Wrap"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <Border Background="{Binding PriorityColor}" CornerRadius="3" Padding="4,1" Margin="0,0,6,0">
                                                        <TextBlock Text="{Binding Priority}" FontFamily="{StaticResource FluentFontFamily}"
                                                                   FontSize="9" Foreground="White"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding DeadlineDisplay}" FontFamily="{StaticResource FluentFontFamily}"
                                                               FontSize="10" Foreground="{Binding DeadlineColor}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Designer}" FontFamily="{StaticResource FluentFontFamily}"
                                                           FontSize="9" Foreground="#64748B" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Review Column -->
                <Border Width="240" Background="{DynamicResource FluentLightCardBg}"
                        BorderBrush="{DynamicResource FluentLightStroke}" BorderThickness="1"
                        CornerRadius="8" Margin="0,0,12,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="#FEF3C7" CornerRadius="8,8,0,0" Padding="12,8">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="10" Height="10" CornerRadius="5" Background="#F59E0B" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Review" FontWeight="Bold" FontFamily="{StaticResource FluentFontFamily}"
                                           FontSize="12" Foreground="#B45309"/>
                                <Border Background="#FDE68A" CornerRadius="8" Padding="5,1" Margin="8,0,0,0">
                                    <TextBlock x:Name="CountReview" Text="0" FontFamily="{StaticResource FluentFontFamily}"
                                               FontSize="10" Foreground="#B45309"/>
                                </Border>
                            </StackPanel>
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="ListReview" Margin="6">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,6" Padding="10,8" Background="White"
                                                BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="6" Cursor="Hand"
                                                MouseLeftButtonDown="OnProjectCardClicked">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Project}" FontFamily="{StaticResource FluentFontFamily}"
                                                           FontSize="11" FontWeight="SemiBold" Foreground="#1E293B" TextWrapping="Wrap"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <TextBlock Text="Rev " FontFamily="{StaticResource FluentFontFamily}"
                                                               FontSize="9" Foreground="#64748B"/>
                                                    <TextBlock Text="{Binding Revision}" FontFamily="{StaticResource FluentFontFamily}"
                                                               FontSize="9" Foreground="#64748B"/>
                                                    <TextBlock Text="  " />
                                                    <TextBlock Text="{Binding DeadlineDisplay}" FontFamily="{StaticResource FluentFontFamily}"
                                                               FontSize="10" Foreground="{Binding DeadlineColor}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Done Column -->
                <Border Width="240" Background="{DynamicResource FluentLightCardBg}"
                        BorderBrush="{DynamicResource FluentLightStroke}" BorderThickness="1"
                        CornerRadius="8" Margin="0,0,12,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="#D1FAE5" CornerRadius="8,8,0,0" Padding="12,8">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="10" Height="10" CornerRadius="5" Background="#10B981" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Done" FontWeight="Bold" FontFamily="{StaticResource FluentFontFamily}"
                                           FontSize="12" Foreground="#065F46"/>
                                <Border Background="#A7F3D0" CornerRadius="8" Padding="5,1" Margin="8,0,0,0">
                                    <TextBlock x:Name="CountDone" Text="0" FontFamily="{StaticResource FluentFontFamily}"
                                               FontSize="10" Foreground="#065F46"/>
                                </Border>
                            </StackPanel>
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="ListDone" Margin="6">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,6" Padding="10,8" Background="White"
                                                BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="6" Cursor="Hand"
                                                MouseLeftButtonDown="OnProjectCardClicked">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Project}" FontFamily="{StaticResource FluentFontFamily}"
                                                           FontSize="11" FontWeight="SemiBold" Foreground="#1E293B" TextWrapping="Wrap"
                                                           TextDecorations="Strikethrough" Opacity="0.7"/>
                                                <TextBlock Text="{Binding Client}" FontFamily="{StaticResource FluentFontFamily}"
                                                           FontSize="9" Foreground="#64748B" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- On Hold / Untracked Column -->
                <Border Width="240" Background="{DynamicResource FluentLightCardBg}"
                        BorderBrush="{DynamicResource FluentLightStroke}" BorderThickness="1" CornerRadius="8">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="#F1F5F9" CornerRadius="8,8,0,0" Padding="12,8">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="10" Height="10" CornerRadius="5" Background="#94A3B8" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="On Hold / Untracked" FontWeight="Bold" FontFamily="{StaticResource FluentFontFamily}"
                                           FontSize="12" Foreground="#64748B"/>
                                <Border Background="#E2E8F0" CornerRadius="8" Padding="5,1" Margin="8,0,0,0">
                                    <TextBlock x:Name="CountOther" Text="0" FontFamily="{StaticResource FluentFontFamily}"
                                               FontSize="10" Foreground="#64748B"/>
                                </Border>
                            </StackPanel>
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="ListOther" Margin="6">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,6" Padding="10,8" Background="White"
                                                BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Cursor="Hand"
                                                MouseLeftButtonDown="OnProjectCardClicked">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Project}" FontFamily="{StaticResource FluentFontFamily}"
                                                           FontSize="11" FontWeight="SemiBold" Foreground="#1E293B"
                                                           TextWrapping="Wrap" Opacity="0.7"/>
                                                <TextBlock Text="{Binding StatusDisplay}" FontFamily="{StaticResource FluentFontFamily}"
                                                           FontSize="9" Foreground="#94A3B8" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Project Detail Overlay (edit panel — shown as right-side drawer) -->
        <Border x:Name="DetailPanel" Grid.Row="0" Grid.RowSpan="3"
                Width="340" HorizontalAlignment="Right"
                Background="{DynamicResource FluentLightCardBg}"
                BorderBrush="{DynamicResource FluentLightStroke}" BorderThickness="1,0,0,0"
                Visibility="Collapsed">
            <DockPanel Margin="20">
                <!-- Close -->
                <Button DockPanel.Dock="Top" Click="OnDetailClose" HorizontalAlignment="Right"
                        Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,0,12">
                    <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="14"
                               Foreground="{DynamicResource FluentLightTextSecondary}"/>
                </Button>
                <TextBlock DockPanel.Dock="Top" x:Name="DetailProjectName"
                           FontFamily="{StaticResource FluentFontFamily}" FontSize="14" FontWeight="Bold"
                           Foreground="{DynamicResource FluentBrand80}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                <!-- Status -->
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <TextBlock Text="Status" FontFamily="{StaticResource FluentFontFamily}" FontSize="10"
                               FontWeight="Bold" Foreground="{DynamicResource FluentLightTextSecondary}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="DetailStatus" Height="32" FontFamily="{StaticResource FluentFontFamily}" FontSize="12">
                        <ComboBoxItem Content="backlog"/>
                        <ComboBoxItem Content="in-progress"/>
                        <ComboBoxItem Content="review"/>
                        <ComboBoxItem Content="done"/>
                        <ComboBoxItem Content="on-hold"/>
                    </ComboBox>
                </StackPanel>
                <!-- Priority -->
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <TextBlock Text="Priority" FontFamily="{StaticResource FluentFontFamily}" FontSize="10"
                               FontWeight="Bold" Foreground="{DynamicResource FluentLightTextSecondary}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="DetailPriority" Height="32" FontFamily="{StaticResource FluentFontFamily}" FontSize="12">
                        <ComboBoxItem Content="low"/>
                        <ComboBoxItem Content="medium"/>
                        <ComboBoxItem Content="high"/>
                        <ComboBoxItem Content="urgent"/>
                    </ComboBox>
                </StackPanel>
                <!-- Deadline -->
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <TextBlock Text="Deadline (YYYY-MM-DD)" FontFamily="{StaticResource FluentFontFamily}" FontSize="10"
                               FontWeight="Bold" Foreground="{DynamicResource FluentLightTextSecondary}" Margin="0,0,0,4"/>
                    <ui:TextBox x:Name="DetailDeadline" Height="32" FontFamily="{StaticResource FluentFontFamily}" FontSize="12"
                                PlaceholderText="e.g. 2026-09-30"/>
                </StackPanel>
                <!-- Revision -->
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <TextBlock Text="Revision Round" FontFamily="{StaticResource FluentFontFamily}" FontSize="10"
                               FontWeight="Bold" Foreground="{DynamicResource FluentLightTextSecondary}" Margin="0,0,0,4"/>
                    <ui:TextBox x:Name="DetailRevision" Height="32" FontFamily="{StaticResource FluentFontFamily}" FontSize="12"
                                PlaceholderText="0"/>
                </StackPanel>

                <!-- Save Button -->
                <Border DockPanel.Dock="Bottom" CornerRadius="6" Background="{DynamicResource FluentBrand80}" Margin="0,12,0,0">
                    <Button Click="OnDetailSave" Background="Transparent" Foreground="White"
                            Height="36" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                            FontFamily="{StaticResource FluentFontFamily}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74E;" FontFamily="Segoe Fluent Icons" FontSize="13"
                                       Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Save to README.md" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Border>
                <TextBlock x:Name="DetailSaveStatus" DockPanel.Dock="Bottom" Text=""
                           FontFamily="{StaticResource FluentFontFamily}" FontSize="11"
                           Foreground="{DynamicResource FluentBrand80}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </DockPanel>
        </Border>
    </Grid>
</Page>
