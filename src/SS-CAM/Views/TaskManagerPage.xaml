<Page x:Class="SS_CAM.Views.TaskManagerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Task Manager">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page Header -->
        <StackPanel Grid.Row="0" Margin="24,20,24,14">
            <StackPanel Orientation="Horizontal">
                <ui:TextBlock Text="&#xE9D5;" FontFamily="Segoe Fluent Icons" FontSize="22" Foreground="{DynamicResource FluentBrand80}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ui:TextBlock Text="Task Manager" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource FluentBrand80}" />
            </StackPanel>
            <ui:TextBlock Text="Project status driven by YAML frontmatter in each project's README.md." Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,3,0,0" />
        </StackPanel>

        <!-- Filter / Refresh Bar -->
        <ui:Card Grid.Row="1" Padding="14,10" Margin="24,0,24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <ui:TextBlock Text="Filter:" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="DesignerFilterTM" Width="140" Height="30" SelectionChanged="OnTMFilterChanged" FontSize="11"/>
                    <ui:TextBlock Text="Priority:" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="16,0,8,0"/>
                    <ComboBox x:Name="PriorityFilter" Width="110" Height="30" SelectionChanged="OnTMFilterChanged" FontSize="11">
                        <ComboBoxItem Content="All Priorities" IsSelected="True"/>
                        <ComboBoxItem Content="urgent"/>
                        <ComboBoxItem Content="high"/>
                        <ComboBoxItem Content="medium"/>
                        <ComboBoxItem Content="low"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:TextBlock x:Name="TxtTaskCount" Text="" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <ui:Button Appearance="Primary" Click="OnTMRefreshClicked" Height="30" Padding="12,0" Cursor="Hand" FontSize="11" FontWeight="Bold">
                        <StackPanel Orientation="Horizontal">
                            <ui:TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <ui:TextBlock Text="Scan Workspace" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ui:Button>
                </StackPanel>
            </Grid>
        </ui:Card>

        <!-- Kanban Columns -->
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                      Margin="24,0,24,20">
            <StackPanel Orientation="Horizontal">

                <!-- Backlog Column -->
                <ui:Card Width="240" Margin="0,0,12,0" Padding="0" ClipToBounds="True">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="#E2E8F0" Padding="12,8">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="10" Height="10" CornerRadius="5" Background="#94A3B8" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <ui:TextBlock Text="Backlog" FontWeight="Bold" FontSize="12" Foreground="#475569"/>
                                <Border Background="#CBD5E1" CornerRadius="8" Padding="5,1" Margin="8,0,0,0">
                                    <ui:TextBlock x:Name="CountBacklog" Text="0" FontSize="10" Foreground="#475569"/>
                                </Border>
                            </StackPanel>
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="ListBacklog" Margin="6">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ui:CardAction Margin="0,0,0,6" Padding="10,8" Cursor="Hand" Click="OnProjectCardClicked">
                                            <StackPanel>
                                                <ui:TextBlock Text="{Binding Project}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" TextTrimming="None"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <Border Background="{Binding PriorityColor}" CornerRadius="3" Padding="4,1" Margin="0,0,6,0">
                                                        <ui:TextBlock Text="{Binding Priority}" FontSize="9" Foreground="White"/>
                                                    </Border>
                                                    <ui:TextBlock Text="{Binding DeadlineDisplay}" FontSize="10" Foreground="{Binding DeadlineColor}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </ui:CardAction>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </ui:Card>

                <!-- In Progress Column -->
                <ui:Card Width="240" Margin="0,0,12,0" Padding="0" ClipToBounds="True">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="#DBEAFE" Padding="12,8">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="10" Height="10" CornerRadius="5" Background="#3B82F6" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <ui:TextBlock Text="In Progress" FontWeight="Bold" FontSize="12" Foreground="#1D4ED8"/>
                                <Border Background="#BFDBFE" CornerRadius="8" Padding="5,1" Margin="8,0,0,0">
                                    <ui:TextBlock x:Name="CountInProgress" Text="0" FontSize="10" Foreground="#1D4ED8"/>
                                </Border>
                            </StackPanel>
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="ListInProgress" Margin="6">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ui:CardAction Margin="0,0,0,6" Padding="10,8" Cursor="Hand" Click="OnProjectCardClicked">
                                            <StackPanel>
                                                <ui:TextBlock Text="{Binding Project}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <Border Background="{Binding PriorityColor}" CornerRadius="3" Padding="4,1" Margin="0,0,6,0">
                                                        <ui:TextBlock Text="{Binding Priority}" FontSize="9" Foreground="White"/>
                                                    </Border>
                                                    <ui:TextBlock Text="{Binding DeadlineDisplay}" FontSize="10" Foreground="{Binding DeadlineColor}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <ui:TextBlock Text="{Binding Designer}" FontSize="9" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </ui:CardAction>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </ui:Card>

                <!-- Review Column -->
                <ui:Card Width="240" Margin="0,0,12,0" Padding="0" ClipToBounds="True">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="#FEF3C7" Padding="12,8">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="10" Height="10" CornerRadius="5" Background="#F59E0B" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <ui:TextBlock Text="Review" FontWeight="Bold" FontSize="12" Foreground="#B45309"/>
                                <Border Background="#FDE68A" CornerRadius="8" Padding="5,1" Margin="8,0,0,0">
                                    <ui:TextBlock x:Name="CountReview" Text="0" FontSize="10" Foreground="#B45309"/>
                                </Border>
                            </StackPanel>
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="ListReview" Margin="6">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ui:CardAction Margin="0,0,0,6" Padding="10,8" Cursor="Hand" Click="OnProjectCardClicked">
                                            <StackPanel>
                                                <ui:TextBlock Text="{Binding Project}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <ui:TextBlock Text="Rev " FontSize="9" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                    <ui:TextBlock Text="{Binding Revision}" FontSize="9" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                    <ui:TextBlock Text="  " />
                                                    <ui:TextBlock Text="{Binding DeadlineDisplay}" FontSize="10" Foreground="{Binding DeadlineColor}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </ui:CardAction>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </ui:Card>

                <!-- Done Column -->
                <ui:Card Width="240" Margin="0,0,12,0" Padding="0" ClipToBounds="True">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="#D1FAE5" Padding="12,8">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="10" Height="10" CornerRadius="5" Background="#10B981" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <ui:TextBlock Text="Done" FontWeight="Bold" FontSize="12" Foreground="#065F46"/>
                                <Border Background="#A7F3D0" CornerRadius="8" Padding="5,1" Margin="8,0,0,0">
                                    <ui:TextBlock x:Name="CountDone" Text="0" FontSize="10" Foreground="#065F46"/>
                                </Border>
                            </StackPanel>
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="ListDone" Margin="6">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ui:CardAction Margin="0,0,0,6" Padding="10,8" Cursor="Hand" Click="OnProjectCardClicked">
                                            <StackPanel>
                                                <ui:TextBlock Text="{Binding Project}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" TextDecorations="Strikethrough" Opacity="0.7"/>
                                                <ui:TextBlock Text="{Binding Client}" FontSize="9" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </ui:CardAction>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </ui:Card>

                <!-- On Hold / Untracked Column -->
                <ui:Card Width="240" Padding="0" ClipToBounds="True">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="#F1F5F9" Padding="12,8">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="10" Height="10" CornerRadius="5" Background="#94A3B8" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <ui:TextBlock Text="On Hold / Untracked" FontWeight="Bold" FontSize="12" Foreground="#64748B"/>
                                <Border Background="#E2E8F0" CornerRadius="8" Padding="5,1" Margin="8,0,0,0">
                                    <ui:TextBlock x:Name="CountOther" Text="0" FontSize="10" Foreground="#64748B"/>
                                </Border>
                            </StackPanel>
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="ListOther" Margin="6">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ui:CardAction Margin="0,0,0,6" Padding="10,8" Cursor="Hand" Click="OnProjectCardClicked">
                                            <StackPanel>
                                                <ui:TextBlock Text="{Binding Project}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" Opacity="0.7"/>
                                                <ui:TextBlock Text="{Binding StatusDisplay}" FontSize="9" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </ui:CardAction>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </ui:Card>
            </StackPanel>
        </ScrollViewer>

        <!-- Project Detail Overlay (edit panel — shown as right-side drawer) -->
        <Border x:Name="DetailPanel" Grid.Row="0" Grid.RowSpan="3"
                Width="340" HorizontalAlignment="Right"
                Background="{DynamicResource FluentLightCardBg}"
                BorderBrush="{DynamicResource FluentLightStroke}" BorderThickness="1,0,0,0"
                Visibility="Collapsed">
            <DockPanel Margin="20">
                <!-- Close -->
                <ui:Button DockPanel.Dock="Top" Click="OnDetailClose" HorizontalAlignment="Right"
                        Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,0,12">
                    <ui:TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="14"
                               Foreground="{DynamicResource FluentLightTextSecondary}"/>
                </ui:Button>
                <ui:TextBlock DockPanel.Dock="Top" x:Name="DetailProjectName"
                            FontSize="14" FontWeight="Bold"
                           Foreground="{DynamicResource FluentBrand80}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                <!-- Status -->
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <ui:TextBlock Text="Status"  FontSize="10"
                               FontWeight="Bold" Foreground="{DynamicResource FluentLightTextSecondary}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="DetailStatus" Height="32"  FontSize="12">
                        <ComboBoxItem Content="backlog"/>
                        <ComboBoxItem Content="in-progress"/>
                        <ComboBoxItem Content="review"/>
                        <ComboBoxItem Content="done"/>
                        <ComboBoxItem Content="on-hold"/>
                    </ComboBox>
                </StackPanel>
                <!-- Priority -->
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <ui:TextBlock Text="Priority"  FontSize="10"
                               FontWeight="Bold" Foreground="{DynamicResource FluentLightTextSecondary}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="DetailPriority" Height="32"  FontSize="12">
                        <ComboBoxItem Content="low"/>
                        <ComboBoxItem Content="medium"/>
                        <ComboBoxItem Content="high"/>
                        <ComboBoxItem Content="urgent"/>
                    </ComboBox>
                </StackPanel>
                <!-- Deadline -->
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <ui:TextBlock Text="Deadline (YYYY-MM-DD)"  FontSize="10"
                               FontWeight="Bold" Foreground="{DynamicResource FluentLightTextSecondary}" Margin="0,0,0,4"/>
                    <ui:TextBox x:Name="DetailDeadline" Height="32"  FontSize="12"
                                PlaceholderText="e.g. 2026-09-30"/>
                </StackPanel>
                <!-- Revision -->
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <ui:TextBlock Text="Revision Round"  FontSize="10"
                               FontWeight="Bold" Foreground="{DynamicResource FluentLightTextSecondary}" Margin="0,0,0,4"/>
                    <ui:TextBox x:Name="DetailRevision" Height="32"  FontSize="12"
                                PlaceholderText="0"/>
                </StackPanel>

                <!-- Save Button -->
                <ui:Button Appearance="Primary" DockPanel.Dock="Bottom" Click="OnDetailSave" Height="36" FontWeight="Bold" Cursor="Hand" Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal">
                        <ui:TextBlock Text="&#xE74E;" FontFamily="Segoe Fluent Icons" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <ui:TextBlock Text="Save to README.md" VerticalAlignment="Center"/>
                    </StackPanel>
                </ui:Button>
                <ui:TextBlock x:Name="DetailSaveStatus" DockPanel.Dock="Bottom" Text="" FontSize="11" Foreground="{DynamicResource SystemFillColorSuccessBrush}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </DockPanel>
        </Border>
    </Grid>
</Page>

