<Page x:Class="SS_CAM.Views.WorkstationHealthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Workstation Health &amp; Software Diagnostics">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24">
        <StackPanel HorizontalAlignment="Stretch">
            <!-- Page Header -->
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="Workstation &amp; Software Health" Foreground="#043388" FontSize="24" FontWeight="Bold"/>
                <TextBlock Text="Monitor PC hardware specs, graphics acceleration capabilities, and installed design software versions." Foreground="#64748B" FontSize="13" Margin="0,4,0,0"/>
            </StackPanel>

            <Grid HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: Workstation Hardware & Diagnostic Specs -->
                <StackPanel Grid.Column="0">
                    <GroupBox Header="Workstation Hardware Specs" Margin="0,0,0,16">
                        <StackPanel Margin="12">
                            <TextBlock Text="Hardware capabilities for GPU rendering, OpenCL acceleration &amp; export troubleshooting." Foreground="#64748B" FontSize="11" Margin="0,0,0,12" TextWrapping="Wrap"/>

                            <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="OPERATING SYSTEM" Foreground="#64748B" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock x:Name="SpecOS" Text="Windows 11 (64-bit)" Foreground="#043388" FontWeight="Bold" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="PROCESSOR (CPU)" Foreground="#64748B" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock x:Name="SpecCPU" Text="AMD Ryzen / Intel Core" Foreground="#043388" FontWeight="Bold" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="SYSTEM MEMORY (RAM)" Foreground="#64748B" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock x:Name="SpecRAM" Text="16 GB RAM" Foreground="#043388" FontWeight="Bold" FontSize="12" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="GRAPHICS ADAPTER (GPU)" Foreground="#64748B" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock x:Name="SpecGPU" Text="NVIDIA / AMD Graphics" Foreground="#043388" FontWeight="Bold" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="PRIMARY DISPLAY" Foreground="#64748B" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock x:Name="SpecDisplay" Text="1920 x 1080" Foreground="#043388" FontWeight="Bold" FontSize="12" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="AVAILABLE SCRATCH STORAGE" Foreground="#64748B" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock x:Name="SpecStorage" Text="Drive C: 84.9 GB free" Foreground="#043388" FontWeight="Bold" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>

                <!-- Right Column: 11 Design Suite Software Health Checker Responsive Table -->
                <StackPanel Grid.Column="2" HorizontalAlignment="Stretch">
                    <GroupBox Header="Design Suite Software Health Checker">
                        <DockPanel Margin="12" LastChildFill="True" HorizontalAlignment="Stretch">
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                <TextBlock Text="Scanned workstation design applications &amp; download update links" Foreground="#64748B" FontSize="11" VerticalAlignment="Center"/>
                                <Button Content="🔄 Rescan Software" Click="OnRescanSoftwareClicked" Height="28" Padding="10,0" HorizontalAlignment="Right" Background="#EFF6FF" Foreground="#043388" BorderBrush="#21A1F7" BorderThickness="1" FontSize="11" FontWeight="Bold" Cursor="Hand"/>
                            </DockPanel>

                            <!-- Responsive Table Header Bar with Separated Columns -->
                            <Border DockPanel.Dock="Top" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1,1,1,0" CornerRadius="6,6,0,0" Padding="10,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="1.8*"/>
                                        <ColumnDefinition Width="1.4*"/>
                                        <ColumnDefinition Width="1.4*"/>
                                        <ColumnDefinition Width="1.6*"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="" FontSize="10" FontWeight="Bold" Foreground="#475569"/>
                                    <TextBlock Grid.Column="1" Text="SOFTWARE NAME" FontSize="10" FontWeight="Bold" Foreground="#475569"/>
                                    <TextBlock Grid.Column="2" Text="SCANNED VERSION" FontSize="10" FontWeight="Bold" Foreground="#475569"/>
                                    <TextBlock Grid.Column="3" Text="LATEST VERSION" FontSize="10" FontWeight="Bold" Foreground="#475569"/>
                                    <TextBlock Grid.Column="4" Text="HEALTH STATUS" FontSize="10" FontWeight="Bold" Foreground="#475569" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="5" Text="ACTION" FontSize="10" FontWeight="Bold" Foreground="#475569" HorizontalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Responsive Table Rows List -->
                            <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1,0,1,1" CornerRadius="0,0,6,6" HorizontalAlignment="Stretch">
                                <ItemsControl x:Name="SoftwareHealthList" HorizontalAlignment="Stretch">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="10,8">
                                                <Grid HorizontalAlignment="Stretch">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="36"/>
                                                        <ColumnDefinition Width="1.8*"/>
                                                        <ColumnDefinition Width="1.4*"/>
                                                        <ColumnDefinition Width="1.4*"/>
                                                        <ColumnDefinition Width="1.6*"/>
                                                        <ColumnDefinition Width="110"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- App Icon -->
                                                    <TextBlock Grid.Column="0" Text="{Binding Icon}" FontFamily="Segoe UI Emoji, Segoe MDL2 Assets, Arial" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                                                    <!-- Software Name -->
                                                    <TextBlock Grid.Column="1" Text="{Binding SoftwareName}" FontWeight="Bold" FontSize="12" Foreground="#043388" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,6,0"/>

                                                    <!-- Scanned Version -->
                                                    <TextBlock Grid.Column="2" Text="{Binding ScannedVersion}" Foreground="#1E293B" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,6,0"/>

                                                    <!-- Latest Version -->
                                                    <TextBlock Grid.Column="3" Text="{Binding LatestVersion}" Foreground="#64748B" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,6,0"/>

                                                    <!-- Health Status Badge -->
                                                    <Border Grid.Column="4" Background="#EFF6FF" BorderBrush="{Binding StatusColor}" BorderThickness="1" CornerRadius="4" Padding="6,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}" FontSize="10.5" FontWeight="Bold"/>
                                                    </Border>

                                                    <!-- Action Button (Shown ONLY if update available or missing) -->
                                                    <Button Grid.Column="5" Content="⬇️ Get / Update" Click="OnDownloadSoftwareClicked" Tag="{Binding DownloadUrl}" Padding="6,3" Background="#21A1F7" Foreground="White" BorderThickness="0" FontSize="10.5" FontWeight="Bold" Cursor="Hand" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding ShowActionButton, Converter={StaticResource BoolToVisConverter}}" ToolTip="Open official download / update page"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </DockPanel>
                    </GroupBox>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
