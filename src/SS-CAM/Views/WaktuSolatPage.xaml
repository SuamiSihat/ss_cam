<Page x:Class="SS_CAM.Views.WaktuSolatPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Waktu Solat"
      Background="{DynamicResource FluentLightCanvasBg}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel MaxWidth="900" HorizontalAlignment="Left">

            <!-- ── HEADER ───────────────────────────────────────────────── -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Title & dates -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <ui:TextBlock Text="&#xE897;" FontFamily="Segoe Fluent Icons" FontSize="26"
                                   Foreground="{DynamicResource FluentBrand80}"
                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <ui:TextBlock Text="Waktu Solat" FontSize="26" FontWeight="Bold"
                                   Foreground="{DynamicResource FluentLightTextPrimary}"
                                    VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <ui:TextBlock x:Name="TxtGregorianDate" Text="..."
                                   FontSize="13" Foreground="{DynamicResource FluentLightTextSecondary}"
                                   />
                        <ui:TextBlock Text="  ·  "
                                   FontSize="13" Foreground="{DynamicResource FluentLightTextSecondary}"/>
                        <ui:TextBlock x:Name="TxtHijriDate" Text="..."
                                   FontSize="13" Foreground="{DynamicResource FluentLightTextSecondary}"
                                   />
                    </StackPanel>
                </StackPanel>

                <!-- Zone selector + reminder toggle -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:TextBlock Text="Zon:" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource FluentLightTextSecondary}"
                                Margin="0,0,8,0"/>
                    <ComboBox x:Name="ZoneCombo" Width="210" Height="32"
                              FontSize="12" 
                              Background="{DynamicResource FluentLightCardBg}"
                              Foreground="{DynamicResource FluentLightTextPrimary}"
                              SelectionChanged="OnZoneChanged" Margin="0,0,10,0"/>
                    <ui:Button x:Name="BtnReminder" Click="OnReminderToggle"
                            Height="32" Padding="12,0" BorderThickness="0"
                            Appearance="Primary" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <ui:TextBlock x:Name="ReminderIcon" Text="&#xEA8F;"
                                       FontFamily="Segoe Fluent Icons" FontSize="13"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ui:TextBlock x:Name="ReminderText" Text="Peringatan: ON"
                                       FontSize="12" 
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </ui:Button>
                </StackPanel>
            </Grid>

            <!-- ── HERO CARD: NEXT PRAYER ────────────────────────────────── -->
            <Border Background="{DynamicResource FluentLightCardBg}"
                    BorderBrush="{DynamicResource FluentLightStroke}" BorderThickness="1"
                    CornerRadius="12" Padding="28,24,28,24" Margin="0,0,0,14"
                    Effect="{DynamicResource FluentDepth8}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: next prayer info + progress -->
                    <StackPanel Grid.Column="0">
                        <ui:TextBlock Text="SOLAT SETERUSNYA" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource FluentLightTextSecondary}"
                                    Margin="0,0,0,10"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <ui:TextBlock Text="&#xE8EF;" FontFamily="Segoe Fluent Icons" FontSize="28"
                                       Foreground="{DynamicResource FluentBrand80}"
                                       VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <ui:TextBlock x:Name="TxtNextPrayer" Text="..."
                                       FontSize="34" FontWeight="Bold"
                                       Foreground="{DynamicResource FluentLightTextPrimary}"
                                       />
                        </StackPanel>

                        <ui:TextBlock x:Name="TxtNextPrayerTime" Text="--:--"
                                   FontSize="14" Foreground="{DynamicResource FluentLightTextSecondary}"
                                    Margin="0,0,0,20"/>

                        <!-- Progress bar -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:TextBlock x:Name="TxtCurrentLabel"
                                       Text="Memuatkan..." FontSize="11"
                                       Foreground="{DynamicResource FluentLightTextSecondary}"
                                       />
                            <ui:TextBlock x:Name="TxtProgressPct" Grid.Column="1"
                                       Text="" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource FluentBrand80}"
                                       />
                        </Grid>
                        <Border Height="10" CornerRadius="5"
                                Background="{DynamicResource FluentLightCardSubBg}"
                                BorderBrush="{DynamicResource FluentLightStroke}" BorderThickness="1"
                                x:Name="HeroProgressContainer">
                            <Border x:Name="ProgressFill" HorizontalAlignment="Left"
                                    Width="0" Height="8" CornerRadius="4" Margin="1">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#0078D4" Offset="0"/>
                                        <GradientStop Color="#00CFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Border>
                    </StackPanel>

                    <!-- Right: live countdown + adhan badge -->
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Margin="32,0,0,0">
                        <ui:TextBlock Text="MASA BERBAKI" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource FluentLightTextSecondary}"
                                   
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,8"/>
                        <ui:TextBlock x:Name="TxtCountdown" Text="--:--:--"
                                   FontSize="44" FontWeight="Bold"
                                   Foreground="{DynamicResource FluentBrand80}"
                                   
                                   HorizontalAlignment="Center"/>
                        <!-- Adhan alert badge -->
                        <Border x:Name="AdhanBadge" CornerRadius="10" Padding="12,5"
                                Visibility="Collapsed" Margin="0,12,0,0"
                                HorizontalAlignment="Center">
                            <Border.Background>
                                <SolidColorBrush Color="#22C55E"/>
                            </Border.Background>
                            <ui:TextBlock x:Name="TxtAdhanBadge" Text="Waktu Solat!"
                                       FontSize="12" Foreground="White" FontWeight="SemiBold"
                                       />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── PRAYER SCHEDULE LIST ───────────────────────────────────── -->
            <Border Background="{DynamicResource FluentLightCardBg}"
                    BorderBrush="{DynamicResource FluentLightStroke}" BorderThickness="1"
                    CornerRadius="12" Padding="0" Margin="0,0,0,16"
                    Effect="{DynamicResource FluentDepth4}">
                <!-- Header row -->
                <StackPanel>
                    <Border Padding="24,14,24,14"
                            BorderBrush="{DynamicResource FluentLightStroke}"
                            BorderThickness="0,0,0,1">
                        <ui:TextBlock Text="JADUAL HARI INI" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource FluentLightTextSecondary}"
                                   />
                    </Border>
                    <!-- Prayer rows populated from code-behind -->
                    <StackPanel x:Name="PrayerListPanel"/>
                </StackPanel>
            </Border>

            <!-- ── FOOTER ────────────────────────────────────────────────── -->
            <ui:TextBlock Text="Waktu solat disediakan oleh JAKIM melalui api.waktusolat.app"
                       FontSize="11" HorizontalAlignment="Center"
                       Foreground="{DynamicResource FluentLightTextSecondary}"
                        Margin="0,0,0,28"/>

        </StackPanel>
    </ScrollViewer>
</Page>



