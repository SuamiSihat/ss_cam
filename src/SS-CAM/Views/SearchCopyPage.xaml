<Page x:Class="SS_CAM.Views.SearchCopyPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Search &amp; Copy">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Search bar (fixed height) -->
            <RowDefinition Height="Auto"/>
            <!-- Main content (fills remaining) -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── Page Header + Search Bar ────────────────────────────── -->
        <StackPanel Grid.Row="0" Margin="24,20,24,0">
            <StackPanel Margin="0,0,0,14">
                <TextBlock Text="Project Workspace Catalog" FontSize="24" FontWeight="Bold"
                           Foreground="{DynamicResource FluentBrand80}"
                           FontFamily="{StaticResource FluentFontFamily}"/>
                <TextBlock Text="Browse your workspace like a catalog — select a project to inspect its brief, assets, and images."
                           Foreground="{DynamicResource FluentLightTextSecondary}" FontSize="12"
                           Margin="0,3,0,0" FontFamily="{StaticResource FluentFontFamily}"/>
            </StackPanel>

            <!-- Search Controls Bar -->
            <Border Background="{DynamicResource FluentLightCardBg}" BorderBrush="{DynamicResource FluentLightStroke}"
                    BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ui:TextBox x:Name="SearchInput" Grid.Column="0" Height="36"
                                PlaceholderText="&#xE721;  Search project title, job ID..." 
                                TextChanged="OnSearchInputChanged"
                                FontFamily="{StaticResource FluentFontFamily}"/>

                    <Border Grid.Column="2" CornerRadius="6" Background="{DynamicResource FluentBrand80}">
                        <Button Click="OnSearchClicked" Background="Transparent" Foreground="White"
                                Height="36" Padding="16,0" FontWeight="Bold" BorderThickness="0"
                                Cursor="Hand" FontFamily="{StaticResource FluentFontFamily}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons" FontSize="13"
                                           Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Search" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Border>
                </Grid>
            </Border>
        </StackPanel>

        <!-- ── Catalog Body: Narrow Sidebar + Wide README Pane ──────── -->
        <Grid Grid.Row="1" Margin="24,0,24,20">
            <Grid.ColumnDefinitions>
                <!-- Fixed narrow project list sidebar -->
                <ColumnDefinition Width="270"/>
                <!-- Gutter -->
                <ColumnDefinition Width="14"/>
                <!-- README / Preview pane takes all remaining space -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── Left Sidebar: Project Cards List ─────────────────── -->
            <Border Grid.Column="0" Background="{DynamicResource FluentLightCardBg}"
                    BorderBrush="{DynamicResource FluentLightStroke}" BorderThickness="1"
                    CornerRadius="8">
                <DockPanel>
                    <!-- Sidebar Header -->
                    <Border DockPanel.Dock="Top" Background="{DynamicResource FluentLightCardSubBg}"
                            BorderBrush="{DynamicResource FluentLightStroke}" BorderThickness="0,0,0,1"
                            CornerRadius="8,8,0,0" Padding="12,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xED25;" FontFamily="Segoe Fluent Icons" FontSize="14"
                                       Foreground="{DynamicResource FluentBrand80}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <StackPanel>
                                <TextBlock Text="PROJECT FOLDERS" FontFamily="{StaticResource FluentFontFamily}"
                                           FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource FluentLightTextSecondary}"/>
                                <TextBlock x:Name="TxtProjectCount" Text="Loading..."
                                           FontFamily="{StaticResource FluentFontFamily}" FontSize="11"
                                           Foreground="{DynamicResource FluentBrand80}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Scrollable project list -->
                    <ListBox x:Name="ResultsListBox"
                             SelectionChanged="OnListSelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             BorderThickness="0"
                             Background="Transparent"
                             Padding="6,6,6,6">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,4"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="Transparent"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="CardBorder"
                                        Background="{DynamicResource FluentLightCardSubBg}"
                                        BorderBrush="{DynamicResource FluentLightStroke}"
                                        BorderThickness="1" CornerRadius="6" Padding="10,8"
                                        Cursor="Hand">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xED25;" FontFamily="Segoe Fluent Icons"
                                                   FontSize="14" Foreground="{DynamicResource FluentBrand80}"
                                                   VerticalAlignment="Top" Margin="0,2,0,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Project}"
                                                       FontFamily="{StaticResource FluentFontFamily}"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource FluentLightTextPrimary}"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <TextBlock Text="{Binding FileCount}"
                                                           FontFamily="{StaticResource FluentFontFamily}"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource FluentLightTextSecondary}"/>
                                                <TextBlock Text=" files · "
                                                           FontFamily="{StaticResource FluentFontFamily}"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource FluentLightTextSecondary}"/>
                                                <TextBlock Text="{Binding FormattedSize}"
                                                           FontFamily="{StaticResource FluentFontFamily}"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource FluentLightTextSecondary}"/>
                                                <TextBlock Text=" · "
                                                           FontFamily="{StaticResource FluentFontFamily}"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource FluentLightTextSecondary}"/>
                                                <TextBlock Text="{Binding Modified}"
                                                           FontFamily="{StaticResource FluentFontFamily}"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource FluentLightTextSecondary}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource FluentBrandLight}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource FluentBrandTint}"/>
                                                    <Setter Property="BorderThickness" Value="1.5"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- ── Right Pane: Catalog README Preview ──────────────── -->
            <Border Grid.Column="2" Background="{DynamicResource FluentLightCardBg}"
                    BorderBrush="{DynamicResource FluentLightStroke}" BorderThickness="1"
                    CornerRadius="8">
                <DockPanel>

                    <!-- Selected Project Header Badge -->
                    <Border DockPanel.Dock="Top" x:Name="SelectedHighlightBadge"
                            Background="{DynamicResource FluentBrandLight}"
                            BorderBrush="{DynamicResource FluentBrandTint}"
                            BorderThickness="0,0,0,1" CornerRadius="8,8,0,0" Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="SELECTED PROJECT" FontFamily="{StaticResource FluentFontFamily}"
                                           Foreground="{DynamicResource FluentLightTextSecondary}"
                                           FontSize="10" FontWeight="Bold"/>
                                <TextBlock x:Name="SelectedProjectTitle" Text="None selected"
                                           Foreground="{DynamicResource FluentBrand80}"
                                           FontFamily="{StaticResource FluentFontFamily}"
                                           FontSize="16" FontWeight="Bold" Margin="0,2,0,0"/>
                                <TextBlock x:Name="SelectedProjectPath"
                                           Text="Select a project from the sidebar to inspect its brief."
                                           Foreground="{DynamicResource FluentLightTextSecondary}"
                                           FontSize="11" TextTrimming="CharacterEllipsis"
                                           FontFamily="{StaticResource FluentFontFamily}"/>
                            </StackPanel>

                            <!-- Mode Toggle Tab Strip -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border CornerRadius="4" Margin="0,0,4,0" Background="{DynamicResource FluentBrand80}">
                                    <Button x:Name="BtnModeRendered" Content="PREVIEW" Click="OnModeRenderedClicked"
                                            Height="28" Padding="10,0"
                                            Background="Transparent" Foreground="White"
                                            FontSize="11" FontWeight="Bold" BorderThickness="0"
                                            Cursor="Hand" FontFamily="{StaticResource FluentFontFamily}"/>
                                </Border>
                                <Border CornerRadius="4" Margin="0,0,4,0"
                                        Background="{DynamicResource FluentLightCardSubBg}"
                                        BorderBrush="{DynamicResource FluentLightStroke}" BorderThickness="1">
                                    <Button x:Name="BtnModeRaw" Content="Raw" Click="OnModeRawClicked"
                                            Height="28" Padding="10,0"
                                            Background="Transparent" Foreground="{DynamicResource FluentLightTextPrimary}"
                                            FontSize="11" BorderThickness="0"
                                            Cursor="Hand" FontFamily="{StaticResource FluentFontFamily}"/>
                                </Border>
                                <Border CornerRadius="4"
                                        Background="{DynamicResource FluentLightCardSubBg}"
                                        BorderBrush="{DynamicResource FluentLightStroke}" BorderThickness="1">
                                    <Button x:Name="BtnModeImages" Click="OnModeImagesClicked"
                                            Height="28" Padding="10,0"
                                            Background="Transparent" Foreground="{DynamicResource FluentLightTextPrimary}"
                                            FontSize="11" BorderThickness="0"
                                            Cursor="Hand" FontFamily="{StaticResource FluentFontFamily}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xEB9F;" FontFamily="Segoe Fluent Icons" FontSize="12"
                                                       Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Gallery" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Action Footer: Copy buttons -->
                    <Border DockPanel.Dock="Bottom"
                            Background="{DynamicResource FluentLightCardSubBg}"
                            BorderBrush="{DynamicResource FluentLightStroke}"
                            BorderThickness="0,1,0,0" CornerRadius="0,0,8,8" Padding="14,10">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Border CornerRadius="6" Background="{DynamicResource FluentLightCardBg}"
                                    BorderBrush="{DynamicResource FluentLightStroke}" BorderThickness="1"
                                    Margin="0,0,8,0">
                                <Button Click="OnCopyPathClicked"
                                        Background="Transparent"
                                        Foreground="{DynamicResource FluentLightTextPrimary}"
                                        Height="34" Padding="12,0" BorderThickness="0"
                                        Cursor="Hand" FontFamily="{StaticResource FluentFontFamily}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8C8;" FontFamily="Segoe Fluent Icons"
                                                   FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Copy Path" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Border>
                            <Border CornerRadius="6" Background="{DynamicResource FluentBrand80}">
                                <Button Click="OnCopyWholeFolderClicked"
                                        Background="Transparent" Foreground="White"
                                        Height="34" Padding="14,0" FontWeight="Bold"
                                        BorderThickness="0" Cursor="Hand"
                                        FontFamily="{StaticResource FluentFontFamily}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7C5;" FontFamily="Segoe Fluent Icons"
                                                   FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Copy Whole Project Folder..." VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Rendered Markdown — primary focus, fills all remaining height -->
                    <FlowDocumentScrollViewer x:Name="RenderedMarkdownViewer"
                                             VerticalScrollBarVisibility="Auto"
                                             Background="White"
                                             BorderThickness="0"
                                             Padding="16"/>

                    <!-- Raw Text Fallback (Collapsed by default) -->
                    <TextBox x:Name="RawMarkdownBox"
                             IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Visibility="Collapsed"
                             FontFamily="Consolas" FontSize="11"
                             Background="#F8FAFC" BorderThickness="0" Padding="16"/>

                    <!-- Image Gallery Grid (Collapsed by default) -->
                    <ScrollViewer x:Name="ImageGalleryViewer"
                                  VerticalScrollBarVisibility="Auto"
                                  Background="#F8FAFC"
                                  BorderThickness="0"
                                  Padding="12"
                                  Visibility="Collapsed">
                        <ListBox x:Name="ImageGalleryList"
                                 BorderThickness="0" Background="Transparent"
                                 MouseDoubleClick="OnImageGalleryDoubleClicked">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel IsItemsHost="True"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" BorderBrush="#CBD5E1"
                                            BorderThickness="1" CornerRadius="6"
                                            Width="140" Margin="5" Padding="6" Cursor="Hand">
                                        <StackPanel>
                                            <Border Height="100" Background="#E2E8F0"
                                                    CornerRadius="4" Margin="0,0,0,6">
                                                <Image Source="{Binding ImagePath}" Stretch="Uniform"/>
                                            </Border>
                                            <TextBlock Text="{Binding FileName}"
                                                       FontSize="11" FontWeight="Bold"
                                                       Foreground="#043388"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding SubFolder}"
                                                       FontSize="9" Foreground="#64748B"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>

                </DockPanel>
            </Border>
        </Grid>

        <!-- Hidden designer filter preserved for code-behind compat -->
        <ComboBox x:Name="DesignerFilterCmb" Visibility="Collapsed" SelectionChanged="OnFilterChanged"/>

    </Grid>
</Page>
