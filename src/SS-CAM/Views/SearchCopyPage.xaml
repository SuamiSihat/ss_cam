<Page x:Class="SS_CAM.Views.SearchCopyPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Search &amp; Copy">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Search bar (fixed height) -->
            <RowDefinition Height="Auto"/>
            <!-- Main content (fills remaining) -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── Page Header + Search Bar ── -->
        <StackPanel Grid.Row="0" Margin="24,16,24,0">
            <StackPanel Margin="0,0,0,10">
                <ui:TextBlock Text="Project Workspace Catalog" FontSize="24" FontWeight="Bold"
                           Foreground="{DynamicResource FluentBrand80}"/>
                <ui:TextBlock Text="Browse your workspace like a catalog - select a project to inspect its brief, assets, and images."
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"
                           Margin="0,2,0,0" />
            </StackPanel>

            <!-- Search Controls Bar -->
            <ui:Card Padding="12,8" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ui:TextBox x:Name="SearchInput" Grid.Column="0" Height="36"
                                PlaceholderText="Search project title, Project ID..." 
                                TextChanged="OnSearchInputChanged"/>

                    <ui:Button Grid.Column="2" Appearance="Primary" Click="OnSearchClicked"
                            Height="36" Padding="16,0" FontWeight="Bold" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <ui:TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons" FontSize="13"
                                       Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <ui:TextBlock Text="Search" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ui:Button>
                </Grid>
            </ui:Card>
        </StackPanel>

        <!-- ── Catalog Body: Responsive Sidebar + GridSplitter + Wide README Pane ── -->
        <Grid Grid.Row="1" Margin="24,0,24,16">
            <Grid.ColumnDefinitions>
                <!-- Project list sidebar (Default 320px, Min 280px, Max 400px) -->
                <ColumnDefinition Width="320" MinWidth="280" MaxWidth="400"/>
                <!-- Resizable Splitter Gutter -->
                <ColumnDefinition Width="Auto"/>
                <!-- README / Preview pane takes all remaining space -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ————————————————— Left Sidebar: Project Cards List ————————————————— -->
            <ui:Card Grid.Column="0" Padding="0" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                <DockPanel>
                    <!-- Sidebar Header -->
                    <Border DockPanel.Dock="Top" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"
                            CornerRadius="8,8,0,0" Padding="12,10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <ui:TextBlock Text="&#xED25;" FontFamily="Segoe Fluent Icons" FontSize="14"
                                           Foreground="{DynamicResource FluentBrand80}"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <StackPanel>
                                    <ui:TextBlock Text="PROJECT FOLDERS" 
                                               FontSize="10" FontWeight="Bold"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <ui:TextBlock x:Name="TxtProjectCount" Text="Loading..."
                                                FontSize="11"
                                               Foreground="{DynamicResource FluentBrand80}" FontWeight="SemiBold"/>
                                </StackPanel>
                            </StackPanel>
                            <!-- Designer Filter -->
                            <ComboBox x:Name="DesignerFilterCmb" Height="34" Padding="8,4" Margin="0,4,0,0" FontSize="11.5"
                                      SelectionChanged="OnFilterChanged"/>
                        </StackPanel>
                    </Border>

                    <!-- Scrollable project list -->
                    <ListBox x:Name="ResultsListBox"
                             SelectionChanged="OnListSelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             BorderThickness="0"
                             Background="Transparent"
                             Padding="6,6,6,6">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,4"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="Transparent"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="CardBorder"
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="10,8"
                                        Cursor="Hand">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ui:TextBlock Text="&#xED25;" FontFamily="Segoe Fluent Icons"
                                                   FontSize="14" Foreground="{DynamicResource FluentBrand80}"
                                                   VerticalAlignment="Top" Margin="0,2,0,0"/>
                                        <StackPanel Grid.Column="1">
                                            <ui:TextBlock Text="{Binding Project}"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <ui:TextBlock Text="{Binding FileCount}"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                <ui:TextBlock Text=" files &#x00B7; "
                                                           FontSize="10"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                <ui:TextBlock Text="{Binding FormattedSize}"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                <ui:TextBlock Text=" &#x00B7; "
                                                           FontSize="10"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                <ui:TextBlock Text="{Binding Modified}"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource FluentBrand80}"/>
                                                    <Setter Property="BorderThickness" Value="1.5"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </ui:Card>

            <!-- ————————————————— Column Splitter ————————————————— -->
            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="Transparent" Focusable="False" Margin="2,0"/>

            <!-- ————————————————— Right Pane: Catalog README Preview ————————————————— -->
            <ui:Card Grid.Column="2" Padding="0" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                <DockPanel>

                    <!-- Selected Project Header Badge -->
                    <Border DockPanel.Dock="Top" x:Name="SelectedHighlightBadge"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1" CornerRadius="8,8,0,0" Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <ui:TextBlock Text="SELECTED PROJECT" 
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           FontSize="10" FontWeight="Bold"/>
                                <ui:TextBlock x:Name="SelectedProjectTitle" Text="None selected"
                                           Foreground="{DynamicResource FluentBrand80}"
                                           FontSize="16" FontWeight="Bold" Margin="0,2,0,0"/>
                                <ui:TextBlock x:Name="SelectedProjectPath"
                                           Text="Select a project from the sidebar to inspect its brief."
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           FontSize="11" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <!-- Mode Toggle Tab Strip - icon only -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:Button x:Name="BtnModeRendered" Appearance="Primary" Click="OnModeRenderedClicked"
                                        Height="28" Width="32" Padding="0"
                                        Cursor="Hand" ToolTip="Preview - rendered README">
                                    <ui:TextBlock Text="&#xE8A4;" FontFamily="Segoe Fluent Icons" FontSize="13"
                                                 VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </ui:Button>
                                <ui:Button x:Name="BtnModeRaw" Appearance="Secondary" Click="OnModeRawClicked"
                                        Height="28" Width="32" Padding="0" Margin="4,0,0,0"
                                        Cursor="Hand" ToolTip="Raw - plain Markdown source">
                                    <ui:TextBlock Text="&#xE943;" FontFamily="Segoe Fluent Icons" FontSize="13"
                                                 VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </ui:Button>
                                <ui:Button x:Name="BtnModeImages" Appearance="Secondary" Click="OnModeImagesClicked"
                                        Height="28" Width="32" Padding="0" Margin="4,0,0,0"
                                        Cursor="Hand" ToolTip="Gallery - project image assets">
                                    <ui:TextBlock Text="&#xEB9F;" FontFamily="Segoe Fluent Icons" FontSize="13"
                                                 VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </ui:Button>
                            </StackPanel>

                        </Grid>
                    </Border>

                    <!-- Action Footer: Copy buttons + Edit Brief -->
                    <Border DockPanel.Dock="Bottom"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0" CornerRadius="0,0,8,8" Padding="14,10">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <ui:Button Appearance="Secondary" Click="OnCopyPathClicked"
                                    Height="34" Padding="12,0" Cursor="Hand" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <ui:TextBlock Text="&#xE8C8;" FontFamily="Segoe Fluent Icons"
                                               FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <ui:TextBlock Text="Copy Path" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ui:Button>
                            <ui:Button x:Name="BtnEditBrief" Appearance="Secondary" Click="OnEditBriefClicked"
                                    Height="34" Padding="12,0" Cursor="Hand" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <ui:TextBlock Text="&#xE70F;" FontFamily="Segoe Fluent Icons"
                                               FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <ui:TextBlock Text="Edit Brief" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ui:Button>
                            <ui:Button Appearance="Primary" Click="OnCopyWholeFolderClicked"
                                    Height="34" Padding="14,0" FontWeight="Bold" Cursor="Hand">
                                <StackPanel Orientation="Horizontal">
                                    <ui:TextBlock Text="&#xE7C5;" FontFamily="Segoe Fluent Icons"
                                               FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <ui:TextBlock Text="Copy Whole Project Folder..." VerticalAlignment="Center"/>
                                </StackPanel>
                            </ui:Button>
                        </StackPanel>
                    </Border>

                    <!-- Edit Mode Panel (Collapsed by default) -->
                    <DockPanel x:Name="EditBriefPanel" Visibility="Collapsed">
                        <!-- Edit Toolbar -->
                        <Border DockPanel.Dock="Top" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="8,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <ui:Button Content="B" Click="OnEditMdBold" Height="24" Width="28" Background="Transparent"
                                            Foreground="{DynamicResource FluentBrand80}" FontWeight="Bold" FontSize="12"
                                            BorderThickness="0" Cursor="Hand" />
                                    <ui:Button Content="I" Click="OnEditMdItalic" Height="24" Width="28" Background="Transparent"
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontStyle="Italic"
                                            FontFamily="Georgia, serif" FontSize="12" BorderThickness="0" Cursor="Hand"/>
                                    <ui:Button Click="OnEditMdCode" Height="24" Width="28" Background="Transparent"
                                            BorderThickness="0" Cursor="Hand" FontFamily="Consolas">
                                        <ui:TextBlock Text="&lt;/&gt;" FontFamily="Consolas" FontSize="10"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    </ui:Button>
                                    <ui:Button Content="H2" Click="OnEditMdH2" Height="24" Width="32" Background="Transparent"
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="10"
                                            FontWeight="SemiBold"  BorderThickness="0" Cursor="Hand"/>
                                    <ui:Button Content="* List" Click="OnEditMdList" Height="24" Padding="4,0" Background="Transparent"
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="10"
                                             BorderThickness="0" Cursor="Hand"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <ui:Button Appearance="Primary" Click="OnSaveBriefClicked"
                                            Height="26" Padding="10,0" FontSize="11" FontWeight="Bold" Cursor="Hand" Margin="0,0,6,0">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:TextBlock Text="&#xE74E;" FontFamily="Segoe Fluent Icons" FontSize="12"
                                                       Margin="0,0,4,0" VerticalAlignment="Center"/>
                                            <ui:TextBlock Text="Save" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ui:Button>
                                    <ui:Button Appearance="Secondary" Click="OnCancelEditClicked"
                                            Height="26" Padding="10,0" FontSize="11" Cursor="Hand" >
                                        Cancel
                                    </ui:Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <!-- Brief Editor TextBox -->
                        <TextBox x:Name="BriefEditor"
                                 AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 FontFamily="Consolas" FontSize="12"
                                 Padding="14" BorderThickness="0" Background="{DynamicResource TextControlBackground}"/>
                    </DockPanel>

                    <!-- Rendered Markdown — primary focus, fills all remaining height -->
                    <FlowDocumentScrollViewer x:Name="RenderedMarkdownViewer"
                                             VerticalScrollBarVisibility="Auto"
                                             Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                             BorderThickness="0"
                                             Padding="16"/>

                    <!-- Raw Text Fallback (Collapsed by default) -->
                    <TextBox x:Name="RawMarkdownBox"
                             IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Visibility="Collapsed"
                             FontFamily="Consolas" FontSize="11"
                             Background="{DynamicResource TextControlBackground}" BorderThickness="0" Padding="16"/>

                    <!-- Image Gallery Grid (Collapsed by default) -->
                    <ScrollViewer x:Name="ImageGalleryViewer"
                                  VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.CanContentScroll="False"
                                  Background="{DynamicResource ApplicationPageBackgroundThemeBrush}"
                                  BorderThickness="0"
                                  Padding="12"
                                  Visibility="Collapsed">
                        <ListBox x:Name="ImageGalleryList"
                                 BorderThickness="0" Background="Transparent"
                                 MouseDoubleClick="OnImageGalleryDoubleClicked">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel IsItemsHost="True"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1" CornerRadius="8"
                                            Width="240" Margin="6" Padding="8" Cursor="Hand">
                                        <StackPanel>
                                            <Border Height="160" Background="{DynamicResource TextControlBackground}"
                                                    CornerRadius="6" Margin="0,0,0,8">
                                                <Image Source="{Binding ImagePath}" Stretch="Uniform"/>
                                            </Border>
                                            <ui:TextBlock Text="{Binding FileName}"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <ui:TextBlock Text="{Binding SubFolder}"
                                                       FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>

                </DockPanel>
            </ui:Card>
        </Grid>

    </Grid>
</Page>


