<Page x:Class="SS_CAM.Views.SearchCopyPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Search &amp; Copy">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>
            <!-- Header -->
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="Project Workspace Search &amp; Folder Copy" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource FluentBrand80}" FontFamily="{StaticResource FluentFontFamily}"/>
                <TextBlock Text="Search project directories across Synology workspace, inspect cleaned README documentation, and copy whole project folders to local destination." Foreground="{DynamicResource FluentLightTextSecondary}" FontSize="13" Margin="0,4,0,0" FontFamily="{StaticResource FluentFontFamily}"/>
            </StackPanel>

            <!-- Search Controls Bar -->
            <Border Background="{DynamicResource FluentLightCardBg}" BorderBrush="{DynamicResource FluentLightStroke}" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox x:Name="DesignerFilterCmb" Height="38" Margin="0,0,10,0" SelectionChanged="OnFilterChanged"/>

                    <ui:TextBox x:Name="SearchInput" Grid.Column="1" Height="38" PlaceholderText="Search project title, job ID, or designer name..." Margin="0,0,10,0" TextChanged="OnSearchInputChanged"/>

                    <Button Grid.Column="2" Click="OnSearchClicked" Background="{DynamicResource FluentBrand80}" Foreground="White" Height="38" Padding="16,0" FontWeight="Bold" BorderThickness="0" Cursor="Hand" FontFamily="{StaticResource FluentFontFamily}">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="Search" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Main Content: Matching Projects Table + Selected README Inspection -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Results DataGrid Table -->
                <GroupBox Header="Matching Workspace Projects" Grid.Column="0">
                    <DockPanel Margin="8" LastChildFill="True">
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                            <Button Click="OnCopyPathClicked" Background="{DynamicResource FluentLightCardSubBg}" Foreground="{DynamicResource FluentLightTextPrimary}" Height="36" Padding="12,0" Margin="0,0,8,0" BorderThickness="0" Cursor="Hand" FontFamily="{StaticResource FluentFontFamily}">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8C8;" FontFamily="Segoe Fluent Icons" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="Copy Path String" VerticalAlignment="Center"/></StackPanel>
                            </Button>
                            <Button Click="OnCopyWholeFolderClicked" Background="{DynamicResource FluentBrand80}" Foreground="White" Height="36" Padding="16,0" FontWeight="Bold" BorderThickness="0" Cursor="Hand" FontFamily="{StaticResource FluentFontFamily}">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7C5;" FontFamily="Segoe Fluent Icons" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="Copy Whole Project Folder..." VerticalAlignment="Center"/></StackPanel>
                            </Button>
                        </StackPanel>

                        <DataGrid x:Name="ResultsGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="OnGridSelectionChanged" GridLinesVisibility="Horizontal" HeadersVisibility="Column" RowBackground="White" AlternatingRowBackground="#F8FAFC" Height="360">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource FluentBrandLight}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource FluentBrand80}"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource FluentBrandTint}"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Designer" Binding="{Binding Designer}" Width="90"/>
                                <DataGridTextColumn Header="Project Folder Name" Binding="{Binding Project}" Width="*"/>
                                <DataGridTextColumn Header="File Count" Binding="{Binding FileCount}" Width="75"/>
                                <DataGridTextColumn Header="Size" Binding="{Binding FormattedSize}" Width="85"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </GroupBox>

                <!-- Selected Project README & Info Card -->
                <GroupBox x:Name="InspectionCard" Header="Selected Project Overview &amp; README" Grid.Column="2">
                    <DockPanel Margin="8" LastChildFill="True">
                        <!-- Selected Folder Highlight Badge -->
                        <Border DockPanel.Dock="Top" x:Name="SelectedHighlightBadge" Background="{DynamicResource FluentBrandLight}" BorderBrush="{DynamicResource FluentBrandTint}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="SELECTED PROJECT FOLDER" Foreground="{DynamicResource FluentLightTextSecondary}" FontSize="10" FontWeight="Bold" FontFamily="{StaticResource FluentFontFamily}"/>
                                <TextBlock x:Name="SelectedProjectTitle" Text="None selected" Foreground="{DynamicResource FluentBrand80}" FontSize="14" FontWeight="Bold" Margin="0,2,0,0" FontFamily="{StaticResource FluentFontFamily}"/>
                                <TextBlock x:Name="SelectedProjectPath" Text="Select a folder in table to inspect." Foreground="{DynamicResource FluentLightTextSecondary}" FontSize="11" TextTrimming="CharacterEllipsis" FontFamily="{StaticResource FluentFontFamily}"/>
                            </StackPanel>
                        </Border>

                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="BtnModeRendered" Content="PREVIEW" Click="OnModeRenderedClicked" Height="26" Padding="8,0" Margin="0,0,4,0" Background="{DynamicResource FluentBrand80}" Foreground="White" FontSize="11" FontWeight="Bold" BorderThickness="0" Cursor="Hand" FontFamily="{StaticResource FluentFontFamily}"/>
                                <Button x:Name="BtnModeRaw" Content="Raw Markdown" Click="OnModeRawClicked" Height="26" Padding="8,0" Margin="0,0,4,0" Background="{DynamicResource FluentLightCardSubBg}" Foreground="{DynamicResource FluentLightTextPrimary}" FontSize="11" BorderThickness="0" Cursor="Hand" FontFamily="{StaticResource FluentFontFamily}"/>
                                <Button x:Name="BtnModeImages" Click="OnModeImagesClicked" Height="26" Padding="8,0" Background="{DynamicResource FluentLightCardSubBg}" Foreground="{DynamicResource FluentLightTextPrimary}" FontSize="11" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" FontFamily="{StaticResource FluentFontFamily}">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xEB9F;" FontFamily="Segoe Fluent Icons" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/><TextBlock Text="Image Gallery" VerticalAlignment="Center"/></StackPanel>
                                </Button>
                            </StackPanel>
                        </DockPanel>

                        <!-- Rendered Markdown FlowDocument -->
                        <FlowDocumentScrollViewer x:Name="RenderedMarkdownViewer" VerticalScrollBarVisibility="Auto" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" Padding="10"/>

                        <!-- Raw Text Fallback (Collapsed by default) -->
                        <TextBox x:Name="RawMarkdownBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" FontFamily="Consolas" FontSize="11" Background="#F8FAFC" BorderBrush="#CBD5E1" Padding="10"/>

                        <!-- Image Gallery Grid (Collapsed by default) -->
                        <ScrollViewer x:Name="ImageGalleryViewer" VerticalScrollBarVisibility="Auto" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" Padding="8" Visibility="Collapsed">
                            <ListBox x:Name="ImageGalleryList" BorderThickness="0" Background="Transparent" MouseDoubleClick="OnImageGalleryDoubleClicked">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel IsItemsHost="True"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Width="130" Margin="4" Padding="6" Cursor="Hand">
                                            <StackPanel>
                                                <Border Height="90" Background="#E2E8F0" CornerRadius="4" Margin="0,0,0,6">
                                                    <Image Source="{Binding ImagePath}" Stretch="Uniform"/>
                                                </Border>
                                                <TextBlock Text="{Binding FileName}" FontSize="11" FontWeight="Bold" Foreground="#043388" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding SubFolder}" FontSize="9" Foreground="#64748B" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </ScrollViewer>
                    </DockPanel>
                </GroupBox>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
