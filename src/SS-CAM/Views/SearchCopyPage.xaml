<Page x:Class="SS_CAM.Views.SearchCopyPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Search &amp; Copy">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Search bar (fixed height) -->
            <RowDefinition Height="Auto"/>
            <!-- Main content (fills remaining) -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- â”€â”€ Page Header + Search Bar â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
        <StackPanel Grid.Row="0" Margin="24,20,24,0">
            <StackPanel Margin="0,0,0,14">
                <ui:TextBlock Text="Project Workspace Catalog" FontSize="24" FontWeight="Bold"
                           Foreground="{DynamicResource FluentBrand80}"
                           />
                <ui:TextBlock Text="Browse your workspace like a catalog — select a project to inspect its brief, assets, and images."
                           Foreground="{DynamicResource FluentLightTextSecondary}" FontSize="12"
                           Margin="0,3,0,0" />
            </StackPanel>

            <!-- Search Controls Bar -->
            <ui:Card Padding="14,10" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ui:TextBox x:Name="SearchInput" Grid.Column="0" Height="36"
                                PlaceholderText="&#xE721;  Search project title, Project ID..." 
                                TextChanged="OnSearchInputChanged"
                                />

                    <ui:Button Grid.Column="2" Appearance="Primary" Click="OnSearchClicked"
                            Height="36" Padding="16,0" FontWeight="Bold" Cursor="Hand" >
                        <StackPanel Orientation="Horizontal">
                            <ui:TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons" FontSize="13"
                                       Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <ui:TextBlock Text="Search" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ui:Button>
                </Grid>
            </ui:Card>
        </StackPanel>

        <!-- â”€â”€ Catalog Body: Narrow Sidebar + Wide README Pane â”€â”€â”€â”€â”€â”€â”€â”€ -->
        <Grid Grid.Row="1" Margin="24,0,24,20">
            <Grid.ColumnDefinitions>
                <!-- Fixed narrow project list sidebar -->
                <ColumnDefinition Width="270"/>
                <!-- Gutter -->
                <ColumnDefinition Width="14"/>
                <!-- README / Preview pane takes all remaining space -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ————————————————— Left Sidebar: Project Cards List ————————————————— -->
            <ui:Card Grid.Column="0" Padding="0" VerticalAlignment="Stretch">
                <DockPanel>
                    <!-- Sidebar Header -->
                    <Border DockPanel.Dock="Top" Background="{DynamicResource FluentLightCardSubBg}"
                            BorderBrush="{DynamicResource FluentLightStroke}" BorderThickness="0,0,0,1"
                            CornerRadius="8,8,0,0" Padding="10,8">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <ui:TextBlock Text="&#xED25;" FontFamily="Segoe Fluent Icons" FontSize="14"
                                           Foreground="{DynamicResource FluentBrand80}"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <StackPanel>
                                    <ui:TextBlock Text="PROJECT FOLDERS" 
                                               FontSize="10" FontWeight="Bold"
                                               Foreground="{DynamicResource FluentLightTextSecondary}"/>
                                    <ui:TextBlock x:Name="TxtProjectCount" Text="Loading..."
                                                FontSize="11"
                                               Foreground="{DynamicResource FluentBrand80}" FontWeight="SemiBold"/>
                                </StackPanel>
                            </StackPanel>
                            <!-- Designer Filter -->
                            <ComboBox x:Name="DesignerFilterCmb" Height="28" FontSize="11"
                                      
                                      SelectionChanged="OnFilterChanged"/>
                        </StackPanel>
                    </Border>

                    <!-- Scrollable project list -->
                    <ListBox x:Name="ResultsListBox"
                             SelectionChanged="OnListSelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             BorderThickness="0"
                             Background="Transparent"
                             Padding="6,6,6,6">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,4"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="Transparent"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="CardBorder"
                                        Background="{DynamicResource FluentLightCardSubBg}"
                                        BorderBrush="{DynamicResource FluentLightStroke}"
                                        BorderThickness="1" CornerRadius="6" Padding="10,8"
                                        Cursor="Hand">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ui:TextBlock Text="&#xED25;" FontFamily="Segoe Fluent Icons"
                                                   FontSize="14" Foreground="{DynamicResource FluentBrand80}"
                                                   VerticalAlignment="Top" Margin="0,2,0,0"/>
                                        <StackPanel Grid.Column="1">
                                            <ui:TextBlock Text="{Binding Project}"
                                                       
                                                       FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource FluentLightTextPrimary}"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <ui:TextBlock Text="{Binding FileCount}"
                                                           
                                                           FontSize="10"
                                                           Foreground="{DynamicResource FluentLightTextSecondary}"/>
                                                <ui:TextBlock Text=" files Â· "
                                                           
                                                           FontSize="10"
                                                           Foreground="{DynamicResource FluentLightTextSecondary}"/>
                                                <ui:TextBlock Text="{Binding FormattedSize}"
                                                           
                                                           FontSize="10"
                                                           Foreground="{DynamicResource FluentLightTextSecondary}"/>
                                                <ui:TextBlock Text=" Â· "
                                                           
                                                           FontSize="10"
                                                           Foreground="{DynamicResource FluentLightTextSecondary}"/>
                                                <ui:TextBlock Text="{Binding Modified}"
                                                           
                                                           FontSize="10"
                                                           Foreground="{DynamicResource FluentLightTextSecondary}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource FluentBrandLight}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource FluentBrandTint}"/>
                                                    <Setter Property="BorderThickness" Value="1.5"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </ui:Card>

            <!-- ————————————————— Right Pane: Catalog README Preview ————————————————— -->
            <ui:Card Grid.Column="2" Padding="0" VerticalAlignment="Stretch">
                <DockPanel>

                    <!-- Selected Project Header Badge -->
                    <Border DockPanel.Dock="Top" x:Name="SelectedHighlightBadge"
                            Background="{DynamicResource FluentBrandLight}"
                            BorderBrush="{DynamicResource FluentBrandTint}"
                            BorderThickness="0,0,0,1" CornerRadius="8,8,0,0" Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <ui:TextBlock Text="SELECTED PROJECT" 
                                           Foreground="{DynamicResource FluentLightTextSecondary}"
                                           FontSize="10" FontWeight="Bold"/>
                                <ui:TextBlock x:Name="SelectedProjectTitle" Text="None selected"
                                           Foreground="{DynamicResource FluentBrand80}"
                                           
                                           FontSize="16" FontWeight="Bold" Margin="0,2,0,0"/>
                                <ui:TextBlock x:Name="SelectedProjectPath"
                                           Text="Select a project from the sidebar to inspect its brief."
                                           Foreground="{DynamicResource FluentLightTextSecondary}"
                                           FontSize="11" TextTrimming="CharacterEllipsis"
                                           />
                            </StackPanel>

                            <!-- Mode Toggle Tab Strip -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:Button x:Name="BtnModeRendered" Appearance="Primary" Content="PREVIEW" Click="OnModeRenderedClicked"
                                        Height="28" Padding="10,0" Margin="0,0,4,0"
                                        FontSize="11" FontWeight="Bold" Cursor="Hand" />
                                <ui:Button x:Name="BtnModeRaw" Appearance="Secondary" Content="Raw" Click="OnModeRawClicked"
                                        Height="28" Padding="10,0" Margin="0,0,4,0"
                                        FontSize="11" Cursor="Hand" />
                                <ui:Button x:Name="BtnModeImages" Appearance="Secondary" Click="OnModeImagesClicked"
                                        Height="28" Padding="10,0"
                                        FontSize="11" Cursor="Hand" >
                                    <StackPanel Orientation="Horizontal">
                                        <ui:TextBlock Text="&#xEB9F;" FontFamily="Segoe Fluent Icons" FontSize="12"
                                                   Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <ui:TextBlock Text="Gallery" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ui:Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Action Footer: Copy buttons + Edit Brief -->
                    <Border DockPanel.Dock="Bottom"
                            Background="{DynamicResource FluentLightCardSubBg}"
                            BorderBrush="{DynamicResource FluentLightStroke}"
                            BorderThickness="0,1,0,0" CornerRadius="0,0,8,8" Padding="14,10">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <ui:Button Appearance="Secondary" Click="OnCopyPathClicked"
                                    Height="34" Padding="12,0" Cursor="Hand" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <ui:TextBlock Text="&#xE8C8;" FontFamily="Segoe Fluent Icons"
                                               FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <ui:TextBlock Text="Copy Path" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ui:Button>
                            <ui:Button x:Name="BtnEditBrief" Appearance="Secondary" Click="OnEditBriefClicked"
                                    Height="34" Padding="12,0" Cursor="Hand" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <ui:TextBlock Text="&#xE70F;" FontFamily="Segoe Fluent Icons"
                                               FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <ui:TextBlock Text="Edit Brief" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ui:Button>
                            <ui:Button Appearance="Primary" Click="OnCopyWholeFolderClicked"
                                    Height="34" Padding="14,0" FontWeight="Bold" Cursor="Hand">
                                <StackPanel Orientation="Horizontal">
                                    <ui:TextBlock Text="&#xE7C5;" FontFamily="Segoe Fluent Icons"
                                               FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <ui:TextBlock Text="Copy Whole Project Folder..." VerticalAlignment="Center"/>
                                </StackPanel>
                            </ui:Button>
                        </StackPanel>
                    </Border>

                    <!-- Edit Mode Panel (Collapsed by default) -->
                    <DockPanel x:Name="EditBriefPanel" Visibility="Collapsed">
                        <!-- Edit Toolbar -->
                        <Border DockPanel.Dock="Top" Background="{DynamicResource FluentLightCardSubBg}"
                                BorderBrush="{DynamicResource FluentLightStroke}" BorderThickness="0,0,0,1" Padding="8,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <ui:Button Content="B" Click="OnEditMdBold" Height="24" Width="28" Background="Transparent"
                                            Foreground="{DynamicResource FluentBrand80}" FontWeight="Bold" FontSize="12"
                                            BorderThickness="0" Cursor="Hand" />
                                    <ui:Button Content="I" Click="OnEditMdItalic" Height="24" Width="28" Background="Transparent"
                                            Foreground="{DynamicResource FluentLightTextPrimary}" FontStyle="Italic"
                                            FontFamily="Georgia, serif" FontSize="12" BorderThickness="0" Cursor="Hand"/>
                                    <ui:Button Click="OnEditMdCode" Height="24" Width="28" Background="Transparent"
                                            BorderThickness="0" Cursor="Hand" FontFamily="Consolas">
                                        <ui:TextBlock Text="&lt;/&gt;" FontFamily="Consolas" FontSize="10"
                                                   Foreground="{DynamicResource FluentLightTextPrimary}"/>
                                    </ui:Button>
                                    <ui:Button Content="H2" Click="OnEditMdH2" Height="24" Width="32" Background="Transparent"
                                            Foreground="{DynamicResource FluentLightTextPrimary}" FontSize="10"
                                            FontWeight="SemiBold"  BorderThickness="0" Cursor="Hand"/>
                                    <ui:Button Content="• List" Click="OnEditMdList" Height="24" Padding="4,0" Background="Transparent"
                                            Foreground="{DynamicResource FluentLightTextPrimary}" FontSize="10"
                                             BorderThickness="0" Cursor="Hand"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <ui:Button Appearance="Primary" Click="OnSaveBriefClicked"
                                            Height="26" Padding="10,0" FontSize="11" FontWeight="Bold" Cursor="Hand" Margin="0,0,6,0">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:TextBlock Text="&#xE74E;" FontFamily="Segoe Fluent Icons" FontSize="12"
                                                       Margin="0,0,4,0" VerticalAlignment="Center"/>
                                            <ui:TextBlock Text="Save" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ui:Button>
                                    <ui:Button Appearance="Secondary" Click="OnCancelEditClicked"
                                            Height="26" Padding="10,0" FontSize="11" Cursor="Hand" >
                                        Cancel
                                    </ui:Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <!-- Brief Editor TextBox -->
                        <TextBox x:Name="BriefEditor"
                                 AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 FontFamily="Consolas" FontSize="12"
                                 Padding="14" BorderThickness="0" Background="#FAFAFA"/>
                    </DockPanel>

                    <!-- Rendered Markdown — primary focus, fills all remaining height -->
                    <FlowDocumentScrollViewer x:Name="RenderedMarkdownViewer"
                                             VerticalScrollBarVisibility="Auto"
                                             Background="White"
                                             BorderThickness="0"
                                             Padding="16"/>

                    <!-- Raw Text Fallback (Collapsed by default) -->
                    <TextBox x:Name="RawMarkdownBox"
                             IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Visibility="Collapsed"
                             FontFamily="Consolas" FontSize="11"
                             Background="#F8FAFC" BorderThickness="0" Padding="16"/>

                    <!-- Image Gallery Grid (Collapsed by default) -->
                    <ScrollViewer x:Name="ImageGalleryViewer"
                                  VerticalScrollBarVisibility="Auto"
                                  Background="#F8FAFC"
                                  BorderThickness="0"
                                  Padding="12"
                                  Visibility="Collapsed">
                        <ListBox x:Name="ImageGalleryList"
                                 BorderThickness="0" Background="Transparent"
                                 MouseDoubleClick="OnImageGalleryDoubleClicked">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel IsItemsHost="True"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" BorderBrush="#CBD5E1"
                                            BorderThickness="1" CornerRadius="6"
                                            Width="140" Margin="5" Padding="6" Cursor="Hand">
                                        <StackPanel>
                                            <Border Height="100" Background="#E2E8F0"
                                                    CornerRadius="4" Margin="0,0,0,6">
                                                <Image Source="{Binding ImagePath}" Stretch="Uniform"/>
                                            </Border>
                                            <ui:TextBlock Text="{Binding FileName}"
                                                       FontSize="11" FontWeight="Bold"
                                                       Foreground="#043388"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <ui:TextBlock Text="{Binding SubFolder}"
                                                       FontSize="9" Foreground="#64748B"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>

                </DockPanel>
            </ui:Card>
        </Grid>

    </Grid>
</Page>


