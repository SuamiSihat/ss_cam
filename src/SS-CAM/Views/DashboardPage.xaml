<Page x:Class="SS_CAM.Views.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Dashboard">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>
            <!-- Fluent 2 Page Header Bar -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Designer Intelligence Dashboard" FontFamily="{StaticResource FluentFontFamily}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource FluentLightTextPrimary}"/>
                        <Border Background="{DynamicResource FluentBrand80}" CornerRadius="12" Padding="8,2" VerticalAlignment="Center" Margin="12,0,0,0" Cursor="Hand" MouseLeftButtonDown="OnVersionBadgeClicked" ToolTip="About SuamiSihat CAM">
                            <TextBlock x:Name="TxtVersionBadge" Text="v2.3.6" FontFamily="{StaticResource FluentFontFamily}" FontSize="10.5" FontWeight="Bold" Foreground="White"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Workspace Path: " FontFamily="{StaticResource FluentFontFamily}" Foreground="{DynamicResource FluentLightTextSecondary}" FontSize="12"/>
                        <TextBlock x:Name="TxtWorkspacePath" Text="D:\Testing" FontFamily="{StaticResource FluentFontFamily}" Foreground="{DynamicResource FluentBrand80}" FontWeight="SemiBold" FontSize="12"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtStatus" Text="Ready." FontFamily="{StaticResource FluentFontFamily}" Foreground="{DynamicResource FluentLightTextSecondary}" FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>

                <Border Grid.Column="1" CornerRadius="6" Background="{DynamicResource FluentLightCardSubBg}" BorderBrush="{DynamicResource FluentLightStroke}" BorderThickness="1" VerticalAlignment="Top">
                    <Button Click="OnRefreshClicked" Background="Transparent" Foreground="{DynamicResource FluentLightTextPrimary}" BorderThickness="0" Height="34" Padding="16,0" FontFamily="{StaticResource FluentFontFamily}" FontWeight="SemiBold" Cursor="Hand">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="Refresh Analytics" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                </Border>
            </Grid>

            <!-- Fluent 2 Key Metric Cards Grid (Depth 4 Elevation) -->
            <UniformGrid Columns="4" Margin="-6,0,-6,24">
                <!-- Total Projects -->
                <Border Background="{DynamicResource FluentLightCardBg}" BorderBrush="{DynamicResource FluentLightStroke}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="6" Effect="{StaticResource FluentDepth4}">
                    <StackPanel>
                        <TextBlock Text="TOTAL PROJECTS" FontFamily="{StaticResource FluentFontFamily}" Foreground="{DynamicResource FluentLightTextSecondary}" FontSize="10" FontWeight="Bold"/>
                        <TextBlock x:Name="MetricTotalProjects" Text="0" FontFamily="{StaticResource FluentFontFamily}" Foreground="{DynamicResource FluentBrand80}" FontSize="32" FontWeight="Bold" Margin="0,6,0,0"/>
                        <TextBlock Text="Workspace total" FontFamily="{StaticResource FluentFontFamily}" Foreground="{DynamicResource FluentLightTextSecondary}" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Active WIP Projects -->
                <Border Background="{DynamicResource FluentLightCardBg}" BorderBrush="{DynamicResource FluentLightStroke}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="6" Effect="{StaticResource FluentDepth4}">
                    <StackPanel>
                        <TextBlock Text="ACTIVE WIP (7 DAYS)" FontFamily="{StaticResource FluentFontFamily}" Foreground="{DynamicResource FluentLightTextSecondary}" FontSize="10" FontWeight="Bold"/>
                        <TextBlock x:Name="MetricActiveWIP" Text="0" FontFamily="{StaticResource FluentFontFamily}" Foreground="{DynamicResource FluentBrandTint}" FontSize="32" FontWeight="Bold" Margin="0,6,0,0"/>
                        <TextBlock Text="Modified recently" FontFamily="{StaticResource FluentFontFamily}" Foreground="{DynamicResource FluentLightTextSecondary}" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Latest Project -->
                <Border Background="{DynamicResource FluentLightCardBg}" BorderBrush="{DynamicResource FluentLightStroke}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="6" Effect="{StaticResource FluentDepth4}">
                    <StackPanel>
                        <TextBlock Text="LATEST CREATED" FontFamily="{StaticResource FluentFontFamily}" Foreground="{DynamicResource FluentLightTextSecondary}" FontSize="10" FontWeight="Bold"/>
                        <TextBlock x:Name="MetricLatestProject" Text="None" FontFamily="{StaticResource FluentFontFamily}" Foreground="{DynamicResource FluentLightTextPrimary}" FontSize="13" FontWeight="Bold" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="Most recent job" FontFamily="{StaticResource FluentFontFamily}" Foreground="{DynamicResource FluentLightTextSecondary}" FontSize="11" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Storage Size -->
                <Border Background="{DynamicResource FluentLightCardBg}" BorderBrush="{DynamicResource FluentLightStroke}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="6" Effect="{StaticResource FluentDepth4}">
                    <StackPanel>
                        <TextBlock Text="STORAGE SIZE" FontFamily="{StaticResource FluentFontFamily}" Foreground="{DynamicResource FluentLightTextSecondary}" FontSize="10" FontWeight="Bold"/>
                        <TextBlock x:Name="MetricFileSize" Text="0 MB" FontFamily="{StaticResource FluentFontFamily}" Foreground="{DynamicResource FluentLightTextPrimary}" FontSize="26" FontWeight="Bold" Margin="0,6,0,0"/>
                        <TextBlock Text="Total asset volume" FontFamily="{StaticResource FluentFontFamily}" Foreground="{DynamicResource FluentLightTextSecondary}" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Created This Month -->
                <Border Background="{DynamicResource FluentLightCardBg}" BorderBrush="{DynamicResource FluentLightStroke}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="6" Effect="{StaticResource FluentDepth4}">
                    <StackPanel>
                        <TextBlock Text="THIS MONTH OUTPUT" FontFamily="{StaticResource FluentFontFamily}" Foreground="{DynamicResource FluentLightTextSecondary}" FontSize="10" FontWeight="Bold"/>
                        <TextBlock x:Name="MetricThisMonth" Text="0" FontFamily="{StaticResource FluentFontFamily}" Foreground="{DynamicResource FluentSuccess}" FontSize="28" FontWeight="Bold" Margin="0,4,0,0"/>
                        <TextBlock x:Name="MetricMonthComparison" Text="▲ +0% vs last month" FontFamily="{StaticResource FluentFontFamily}" Foreground="{DynamicResource FluentSuccess}" FontSize="11" FontWeight="Bold" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Largest Project -->
                <Border Background="{DynamicResource FluentLightCardBg}" BorderBrush="{DynamicResource FluentLightStroke}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="6" Effect="{StaticResource FluentDepth4}">
                    <StackPanel>
                        <TextBlock Text="LARGEST PROJECT" FontFamily="{StaticResource FluentFontFamily}" Foreground="{DynamicResource FluentLightTextSecondary}" FontSize="10" FontWeight="Bold"/>
                        <TextBlock x:Name="MetricLargestProjectSize" Text="0 MB" FontFamily="{StaticResource FluentFontFamily}" Foreground="#D97706" FontSize="26" FontWeight="Bold" Margin="0,6,0,0"/>
                        <TextBlock x:Name="MetricLargestProjectName" Text="None" FontFamily="{StaticResource FluentFontFamily}" Foreground="{DynamicResource FluentLightTextSecondary}" FontSize="10" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <!-- Stale Projects -->
                <Border Background="{DynamicResource FluentLightCardBg}" BorderBrush="{DynamicResource FluentLightStroke}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="6" Effect="{StaticResource FluentDepth4}">
                    <StackPanel>
                        <TextBlock Text="STALE PROJECTS (>90 DAYS)" FontFamily="{StaticResource FluentFontFamily}" Foreground="{DynamicResource FluentLightTextSecondary}" FontSize="10" FontWeight="Bold"/>
                        <TextBlock x:Name="MetricStaleProjects" Text="0" FontFamily="{StaticResource FluentFontFamily}" Foreground="{DynamicResource FluentDanger}" FontSize="32" FontWeight="Bold" Margin="0,6,0,0"/>
                        <TextBlock Text="Idle folders to archive" FontFamily="{StaticResource FluentFontFamily}" Foreground="{DynamicResource FluentLightTextSecondary}" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Flow Metrics -->
                <Border Background="{DynamicResource FluentLightCardBg}" BorderBrush="{DynamicResource FluentLightStroke}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="6" Effect="{StaticResource FluentDepth4}">
                    <StackPanel>
                        <TextBlock Text="CREATIVE TEAM FLOW" FontFamily="{StaticResource FluentFontFamily}" Foreground="{DynamicResource FluentLightTextSecondary}" FontSize="10" FontWeight="Bold"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock x:Name="FlowDesignerCount" Text="0" FontFamily="{StaticResource FluentFontFamily}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource FluentBrand80}"/>
                            <TextBlock Text=" Designers · " FontFamily="{StaticResource FluentFontFamily}" FontSize="11" Foreground="{DynamicResource FluentLightTextSecondary}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="FlowProjectCount" Text="0" FontFamily="{StaticResource FluentFontFamily}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource FluentLightTextPrimary}"/>
                            <TextBlock Text=" Projects" FontFamily="{StaticResource FluentFontFamily}" FontSize="11" Foreground="{DynamicResource FluentLightTextSecondary}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="FlowFileCount" Text="0 files indexed" FontFamily="{StaticResource FluentFontFamily}" Foreground="{DynamicResource FluentLightTextSecondary}" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Inline 6 Last Created Projects List (Fluent 2 Card Container) -->
            <GroupBox Header="Recent Past Projects (Last 6 Created)" Margin="0,0,0,24">
                <ItemsControl x:Name="Recent6ProjectsControl" Margin="8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource FluentLightCardSubBg}" BorderBrush="{DynamicResource FluentLightStroke}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34" Height="34" CornerRadius="6" Background="{DynamicResource FluentBrandLight}" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xED25;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="{DynamicResource FluentBrand80}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Project}" FontFamily="{StaticResource FluentFontFamily}" FontWeight="Bold" Foreground="{DynamicResource FluentLightTextPrimary}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <Border Background="{DynamicResource FluentBrand80}" CornerRadius="4" Padding="6,1" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding Designer}" FontFamily="{StaticResource FluentFontFamily}" Foreground="White" FontSize="9.5" FontWeight="Bold"/>
                                            </Border>
                                            <TextBlock Text="{Binding Modified}" FontFamily="{StaticResource FluentFontFamily}" Foreground="{DynamicResource FluentLightTextSecondary}" FontSize="10" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </GroupBox>

            <!-- Hidden chart controls for data binding compatibility -->
            <StackPanel Visibility="Collapsed">
                <ItemsControl x:Name="TypeChartControl"/>
                <ItemsControl x:Name="BrandChartControl"/>
                <ItemsControl x:Name="StorageChartControl"/>
                <ItemsControl x:Name="ActivityChartControl"/>
            </StackPanel>

            <!-- Designer Inspiration Widget -->
            <Border Background="{DynamicResource FluentLightCardBg}" BorderBrush="{DynamicResource FluentLightStroke}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,24" Effect="{StaticResource FluentDepth4}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Tip Display -->
                    <StackPanel Grid.Column="0" Margin="0,0,24,0">
                        <!-- Card Header -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Background="{DynamicResource FluentBrandLight}" CornerRadius="6" Width="34" Height="34" Margin="0,0,10,0">
                                <TextBlock x:Name="TxtInsightIcon" Text="&#xE82F;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="{DynamicResource FluentBrand80}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="DESIGNER INSIGHT" FontFamily="{StaticResource FluentFontFamily}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource FluentLightTextSecondary}"/>
                                <TextBlock x:Name="TxtInsightMode" Text="Tip of the Day" FontFamily="{StaticResource FluentFontFamily}" FontSize="11" Foreground="{DynamicResource FluentBrand80}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Tip Content -->
                        <StackPanel x:Name="PanelTipContent">
                            <TextBlock x:Name="TxtTipTitle" Text="Loading tip..." FontFamily="{StaticResource FluentFontFamily}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource FluentLightTextPrimary}" Margin="0,0,0,6" TextWrapping="Wrap"/>
                            <TextBlock x:Name="TxtTipBody" Text="" FontFamily="{StaticResource FluentFontFamily}" FontSize="12" Foreground="{DynamicResource FluentLightTextSecondary}" TextWrapping="Wrap" LineHeight="18"/>
                        </StackPanel>

                        <!-- RSS Articles Panel (hidden by default) -->
                        <StackPanel x:Name="PanelArticles" Visibility="Collapsed" Margin="0,4,0,0">
                            <TextBlock x:Name="TxtArticlesStatus" Text="Fetching latest articles..." FontFamily="{StaticResource FluentFontFamily}" FontSize="11" Foreground="{DynamicResource FluentLightTextSecondary}" Margin="0,0,0,6"/>
                            <ItemsControl x:Name="ArticlesList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,4" Padding="8,6" Background="{DynamicResource FluentLightCardSubBg}" CornerRadius="4" BorderBrush="{DynamicResource FluentLightStroke}" BorderThickness="1" Cursor="Hand" MouseLeftButtonDown="OnArticleClicked">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontFamily="{StaticResource FluentFontFamily}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource FluentBrand80}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding PublishedDate}" FontFamily="{StaticResource FluentFontFamily}" FontSize="10" Foreground="{DynamicResource FluentLightTextSecondary}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>

                    <!-- Right: Controls -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Right" Width="130">
                        <Border CornerRadius="6" Background="{DynamicResource FluentBrand80}" Margin="0,0,0,8">
                            <Button x:Name="BtnNextTip" Click="OnNextTipClicked" Height="32" Background="Transparent" Foreground="White" BorderThickness="0" Cursor="Hand" FontFamily="{StaticResource FluentFontFamily}" FontWeight="Bold" FontSize="11">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Next Tip" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Border>
                        <Border CornerRadius="6" Background="{DynamicResource FluentLightCardSubBg}" BorderBrush="{DynamicResource FluentLightStroke}" BorderThickness="1">
                            <Button x:Name="BtnToggleArticles" Click="OnToggleArticlesClicked" Height="32" Background="Transparent" Foreground="{DynamicResource FluentLightTextPrimary}" BorderThickness="0" Cursor="Hand" FontFamily="{StaticResource FluentFontFamily}" FontSize="11">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE774;" FontFamily="Segoe Fluent Icons" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtArticlesBtn" Text="Articles" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Border>
                        <TextBlock x:Name="TxtTipCounter" Text="1 / 40" FontFamily="{StaticResource FluentFontFamily}" FontSize="10" Foreground="{DynamicResource FluentLightTextSecondary}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
