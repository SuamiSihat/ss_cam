                        </ui:Button>
                        <ui:TextBlock x:Name="TxtTipCounter" Text="1 / 40" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </ui:Card>

            <!-- - Team Board Card - -->
            <ui:Card x:Name="CardWidget_TeamBoard" Padding="20" Margin="0,16,0,0">
                <StackPanel>
                    <!-- Header -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:TextBlock Text="&#xE716;" FontFamily="Segoe Fluent Icons" FontSize="18" Foreground="{DynamicResource FluentBrand80}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ui:TextBlock Text="Team Board" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource FluentBrand80}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ui:TextBlock Grid.Column="1" x:Name="TxtTeamBoardStatus" Text="" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <StackPanel x:Name="HeaderControls_TeamBoard" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                            <ui:Button Tag="team_board" Appearance="Secondary" Height="28" Width="28" Padding="0" Margin="0,0,4,0" Click="OnPinWidgetClicked" ToolTip="Pin to Top">
                                <ui:SymbolIcon x:Name="PinIcon_TeamBoard" Symbol="Pin24" FontSize="12"/>
                            </ui:Button>
                            <ui:Button Tag="team_board" Appearance="Secondary" Height="28" Width="28" Padding="0" Margin="0,0,4,0" Click="OnMoveWidgetUpClicked" ToolTip="Move Up">
                                <ui:SymbolIcon Symbol="ChevronUp24" FontSize="12"/>
                            </ui:Button>
                            <ui:Button Tag="team_board" Appearance="Secondary" Height="28" Width="28" Padding="0" Margin="0,0,4,0" Click="OnMoveWidgetDownClicked" ToolTip="Move Down">
                                <ui:SymbolIcon Symbol="ChevronDown24" FontSize="12"/>
                            </ui:Button>
                        </StackPanel>
                    </Grid>

                    <!-- Notes Feed -->
                    <ItemsControl x:Name="TeamNoteFeed" Margin="0,0,0,12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ui:Card Margin="0,0,0,6" Padding="10,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                <ui:TextBlock Text="{Binding Author}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource FluentBrand80}" Margin="0,0,8,0"/>
                                                <ui:TextBlock Text="{Binding DisplayTimestamp}" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            </StackPanel>
                                            <ui:TextBlock Text="{Binding Content}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                            <ui:Button Tag="{Binding Id}" Appearance="Transparent" Click="OnPinNoteClicked" Cursor="Hand" Padding="4" ToolTip="{Binding PinTooltip}">
                                                <ui:TextBlock Text="{Binding PinIcon}" FontFamily="Segoe Fluent Icons" FontSize="13" Foreground="{DynamicResource FluentBrand80}"/>
                                            </ui:Button>
                                            <ui:Button Tag="{Binding Id}" Appearance="Transparent" Click="OnDeleteTeamNoteClicked" Cursor="Hand" Padding="4">
                                                <ui:TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            </ui:Button>
                                        </StackPanel>
                                    </Grid>
                                </ui:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Post Note Row -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Margin="0,0,8,0">
                            <Grid>
                                <TextBox x:Name="NewTeamNoteInput" Height="36" Padding="10,8" BorderThickness="0" Background="Transparent" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <ui:TextBlock IsHitTestVisible="False" Text="Post a note to the team..." VerticalAlignment="Center" Margin="11,0,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                    <ui:TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=NewTeamNoteInput}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:TextBlock.Style>
                                </ui:TextBlock>
                            </Grid>
                        </Border>
                        <ui:Button Grid.Column="1" Appearance="Primary" Click="OnPostTeamNoteClicked" Width="36" Height="36" Padding="0" Cursor="Hand" ToolTip="Post Team Announcement">
                            <ui:SymbolIcon Symbol="Send24" FontSize="16" VerticalAlignment="Center"/>
                        </ui:Button>
                    </Grid>
                </StackPanel>
            </ui:Card>

            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>




