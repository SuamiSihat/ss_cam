<Page x:Class="SS_CAM.Views.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Dashboard">

    <ScrollViewer x:Name="MainScrollViewer" VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="False" Padding="24" Background="Transparent" PreviewMouseWheel="OnScrollViewerPreviewMouseWheel">
        <StackPanel>
            <!-- Fluent 2 Page Header Bar -->
            <Grid Margin="0,0,0,40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <ui:TextBlock Text="Designer Intelligence Dashboard"  FontSize="24" FontWeight="Bold" Foreground="{DynamicResource FluentLightTextPrimary}"/>
                        <Border Background="{DynamicResource FluentBrand80}" CornerRadius="12" Padding="8,2" VerticalAlignment="Center" Margin="12,0,0,0" Cursor="Hand" MouseLeftButtonDown="OnVersionBadgeClicked" ToolTip="About SuamiSihat CAM">
                            <ui:TextBlock x:Name="TxtVersionBadge" Text="v3.1.2"  FontSize="10.5" FontWeight="Bold" Foreground="White"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:TextBlock Text="Workspace Path: "  Foreground="{DynamicResource FluentLightTextSecondary}" FontSize="12"/>
                        <ui:TextBlock x:Name="TxtWorkspacePath" Text="D:\Testing"  Foreground="{DynamicResource FluentBrand80}" FontWeight="SemiBold" FontSize="12"/>
                    </StackPanel>
                    <ui:TextBlock x:Name="TxtStatus" Text="Ready."  Foreground="{DynamicResource FluentLightTextSecondary}" FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>

                <ui:Button Grid.Column="1" Appearance="Secondary" Click="OnRefreshClicked" Height="34" Padding="16,0" FontWeight="SemiBold" Cursor="Hand" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal">
                        <ui:TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <ui:TextBlock Text="Refresh Analytics" VerticalAlignment="Center"/>
                    </StackPanel>
                </ui:Button>
            </Grid>

            <!-- Fluent 2 Key Metric Cards Grid (Depth 4 Elevation) - 4-up, 2 rows, exact uniform height -->
            <UniformGrid Rows="2" Columns="4" Height="224" Margin="-6,0,-6,24">
                <!-- Total Projects -->
                <ui:Card Padding="16,12" Margin="6" VerticalAlignment="Stretch" Effect="{StaticResource FluentDepth4}">
                    <StackPanel VerticalAlignment="Center">
                        <ui:TextBlock Text="TOTAL PROJECTS" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="10" FontWeight="Bold"/>
                        <ui:TextBlock x:Name="MetricTotalProjects" Text="0" Foreground="{DynamicResource FluentBrand80}" FontSize="28" FontWeight="Bold" Margin="0,2,0,0"/>
                        <ui:TextBlock Text="Workspace total" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                </ui:Card>

                <!-- Active WIP Projects -->
                <ui:Card Padding="16,12" Margin="6" VerticalAlignment="Stretch" Effect="{StaticResource FluentDepth4}">
                    <StackPanel VerticalAlignment="Center">
                        <ui:TextBlock Text="ACTIVE WIP (7 DAYS)" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="10" FontWeight="Bold"/>
                        <ui:TextBlock x:Name="MetricActiveWIP" Text="0" Foreground="{DynamicResource SystemFillColorCautionBrush}" FontSize="28" FontWeight="Bold" Margin="0,2,0,0"/>
                        <ui:TextBlock Text="Modified recently" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                </ui:Card>

                <!-- Latest Project -->
                <ui:Card Padding="16,12" Margin="6" VerticalAlignment="Stretch" Effect="{StaticResource FluentDepth4}">
                    <StackPanel VerticalAlignment="Center">
                        <ui:TextBlock Text="LATEST CREATED" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="10" FontWeight="Bold"/>
                        <ui:TextBlock x:Name="MetricLatestProject" Text="-" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="22" FontWeight="Bold" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                        <ui:TextBlock x:Name="MetricLatestProjectSubtext" Text="Most recent project" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </ui:Card>

                <!-- Storage Size -->
                <ui:Card Padding="16,12" Margin="6" VerticalAlignment="Stretch" Effect="{StaticResource FluentDepth4}">
                    <StackPanel VerticalAlignment="Center">
                        <ui:TextBlock Text="STORAGE SIZE" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="10" FontWeight="Bold"/>
                        <ui:TextBlock x:Name="MetricFileSize" Text="0 MB" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="22" FontWeight="Bold" Margin="0,2,0,0"/>
                        <ui:TextBlock Text="Total asset volume" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                </ui:Card>

                <!-- Created This Month -->
                <ui:Card Padding="16,12" Margin="6" VerticalAlignment="Stretch" Effect="{StaticResource FluentDepth4}">
                    <StackPanel VerticalAlignment="Center">
                        <ui:TextBlock Text="THIS MONTH OUTPUT" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="10" FontWeight="Bold"/>
                        <ui:TextBlock x:Name="MetricThisMonth" Text="0" Foreground="{DynamicResource SystemFillColorSuccessBrush}" FontSize="28" FontWeight="Bold" Margin="0,2,0,0"/>
                        <ui:TextBlock x:Name="MetricMonthComparison" Text="&#x25B2; +0% vs last month" Foreground="{DynamicResource SystemFillColorSuccessBrush}" FontSize="11" FontWeight="Bold" Margin="0,2,0,0"/>
                    </StackPanel>
                </ui:Card>

                <!-- Largest Project -->
                <ui:Card Padding="16,12" Margin="6" VerticalAlignment="Stretch" Effect="{StaticResource FluentDepth4}">
                    <StackPanel VerticalAlignment="Center">
                        <ui:TextBlock Text="LARGEST PROJECT" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="10" FontWeight="Bold"/>
                        <ui:TextBlock x:Name="MetricLargestProjectSize" Text="0 MB" Foreground="{DynamicResource SystemFillColorCautionBrush}" FontSize="22" FontWeight="Bold" Margin="0,2,0,0"/>
                        <ui:TextBlock x:Name="MetricLargestProjectName" Text="None" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="10" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </ui:Card>

                <!-- Stale Projects -->
                <ui:Card Padding="16,12" Margin="6" VerticalAlignment="Stretch" Effect="{StaticResource FluentDepth4}">
                    <StackPanel VerticalAlignment="Center">
                        <ui:TextBlock Text="STALE PROJECTS (&gt;90 DAYS)" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="10" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                        <ui:TextBlock x:Name="MetricStaleProjects" Text="0" Foreground="{DynamicResource SystemFillColorCriticalBrush}" FontSize="28" FontWeight="Bold" Margin="0,2,0,0"/>
                        <ui:TextBlock Text="Idle folders to archive" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                </ui:Card>

                <!-- Flow Metrics -->
                <ui:Card Padding="16,12" Margin="6" VerticalAlignment="Stretch" Effect="{StaticResource FluentDepth4}">
                    <StackPanel VerticalAlignment="Center">
                        <ui:TextBlock Text="CREATIVE TEAM FLOW" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="10" FontWeight="Bold"/>
                        <ui:TextBlock x:Name="FlowDesignerCount" Text="0 Designers, 0 Projects" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource FluentBrand80}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                        <ui:TextBlock x:Name="FlowFileCount" Text="0 files indexed" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                </ui:Card>
            </UniformGrid>

            <!-- Inline 6 Last Created Projects List (Fluent 2 Card Container) -->
            <ui:Card Margin="0,0,0,24" Padding="20" Effect="{StaticResource FluentDepth4}">
                <StackPanel>
                    <ui:TextBlock Text="Recent Past Projects (Last 6 Created)" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,16"/>
                    <ItemsControl x:Name="Recent6ProjectsControl" Margin="0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:Card Padding="12" Margin="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34" Height="34" CornerRadius="6" Background="{DynamicResource FluentBrandLight}" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <ui:TextBlock Text="&#xED25;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="{DynamicResource FluentBrand80}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <ui:TextBlock Text="{Binding Project}" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <Border Background="{DynamicResource FluentBrand80}" CornerRadius="4" Padding="6,1" Margin="0,0,6,0">
                                                <ui:TextBlock Text="{Binding Designer}" Foreground="White" FontSize="9.5" FontWeight="Bold"/>
                                            </Border>
                                            <ui:TextBlock Text="{Binding Modified}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="10" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </ui:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ui:Card>

            <!-- Hidden chart controls for data binding compatibility -->
            <StackPanel Visibility="Collapsed">
                <ItemsControl x:Name="TypeChartControl"/>
                <ItemsControl x:Name="BrandChartControl"/>
                <ItemsControl x:Name="StorageChartControl"/>
                <ItemsControl x:Name="ActivityChartControl"/>
            </StackPanel>

            <!-- Designer Inspiration Widget -->
            <ui:Card Padding="20" Margin="0,0,0,24" Effect="{StaticResource FluentDepth4}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Tip Display -->
                    <StackPanel Grid.Column="0" Margin="0,0,24,0">
                        <!-- Card Header -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Background="{DynamicResource FluentBrandLight}" CornerRadius="6" Width="34" Height="34" Margin="0,0,10,0">
                                <ui:TextBlock x:Name="TxtInsightIcon" Text="&#xE82F;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="{DynamicResource FluentBrand80}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <ui:TextBlock Text="DESIGNER INSIGHT" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <ui:TextBlock x:Name="TxtInsightMode" Text="Tip of the Day" FontSize="11" Foreground="{DynamicResource FluentBrand80}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Tip Content -->
                        <StackPanel x:Name="PanelTipContent">
                            <ui:TextBlock x:Name="TxtTipTitle" Text="Loading tip..." FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,6" TextWrapping="Wrap"/>
                            <ui:TextBlock x:Name="TxtTipBody" Text="" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" LineHeight="18"/>
                        </StackPanel>

                        <!-- RSS Articles Panel (hidden by default) -->
                        <StackPanel x:Name="PanelArticles" Visibility="Collapsed" Margin="0,4,0,0">
                            <ui:TextBlock x:Name="TxtArticlesStatus" Text="Fetching latest articles..." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6"/>
                            <ItemsControl x:Name="ArticlesList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ui:CardAction Margin="0,0,0,4" Padding="8,6" Cursor="Hand" Click="OnArticleClicked">
                                            <StackPanel>
                                                <ui:TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource FluentBrand80}" TextTrimming="CharacterEllipsis"/>
                                                <ui:TextBlock Text="{Binding PublishedDate}" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </ui:CardAction>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>

                    <!-- Right: Controls -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Right" Width="130">
                        <ui:Button x:Name="BtnNextTip" Appearance="Primary" Click="OnNextTipClicked" Height="32" Cursor="Hand" FontWeight="Bold" FontSize="11" Margin="0,0,0,8" HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal">
                                <ui:TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <ui:TextBlock Text="Next Tip" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ui:Button>
                        <ui:Button x:Name="BtnToggleArticles" Appearance="Secondary" Click="OnToggleArticlesClicked" Height="32" Cursor="Hand" FontSize="11" HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal">
                                <ui:TextBlock Text="&#xE774;" FontFamily="Segoe Fluent Icons" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <ui:TextBlock x:Name="TxtArticlesBtn" Text="Articles" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ui:Button>
                        <ui:TextBlock x:Name="TxtTipCounter" Text="1 / 40" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    </StackPanel>
                </Grid>
            </ui:Card>

            <!-- - Team Board Card - -->
            <ui:Card Padding="20" Margin="0,16,0,0">
                <StackPanel>
                    <!-- Header -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <ui:TextBlock Text="&#xE716;" FontFamily="Segoe Fluent Icons" FontSize="18" Foreground="{DynamicResource FluentBrand80}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ui:TextBlock Text="Team Board" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource FluentBrand80}"/>
                        </StackPanel>
                        <ui:TextBlock Grid.Column="1" x:Name="TxtTeamBoardStatus" Text="" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Notes Feed -->
                    <ItemsControl x:Name="TeamNoteFeed" Margin="0,0,0,12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ui:Card Margin="0,0,0,6" Padding="10,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                <ui:TextBlock Text="{Binding Author}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource FluentBrand80}" Margin="0,0,8,0"/>
                                                <ui:TextBlock Text="{Binding DisplayTimestamp}" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            </StackPanel>
                                            <ui:TextBlock Text="{Binding Content}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                            <ui:Button Tag="{Binding Id}" Appearance="Transparent" Click="OnPinNoteClicked" Cursor="Hand" Padding="4" ToolTip="{Binding PinTooltip}">
                                                <ui:TextBlock Text="{Binding PinIcon}" FontFamily="Segoe Fluent Icons" FontSize="13" Foreground="{DynamicResource FluentBrand80}"/>
                                            </ui:Button>
                                            <ui:Button Tag="{Binding Id}" Appearance="Transparent" Click="OnDeleteTeamNoteClicked" Cursor="Hand" Padding="4">
                                                <ui:TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            </ui:Button>
                                        </StackPanel>
                                    </Grid>
                                </ui:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Post Note Row -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Margin="0,0,8,0">
                            <Grid>
                                <TextBox x:Name="NewTeamNoteInput" Height="36" Padding="10,8" BorderThickness="0" Background="Transparent" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <ui:TextBlock IsHitTestVisible="False" Text="Post a note to the team..." VerticalAlignment="Center" Margin="11,0,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                    <ui:TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=NewTeamNoteInput}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:TextBlock.Style>
                                </ui:TextBlock>
                            </Grid>
                        </Border>
                        <ui:Button Grid.Column="1" Appearance="Primary" Click="OnPostTeamNoteClicked" Height="36" Padding="16,0" Cursor="Hand" FontWeight="Bold" FontSize="12">
                            <StackPanel Orientation="Horizontal">
                                <ui:TextBlock Text="&#xE724;" FontFamily="Segoe Fluent Icons" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <ui:TextBlock Text="Post" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ui:Button>
                    </Grid>
                </StackPanel>
            </ui:Card>

        </StackPanel>
    </ScrollViewer>
</Page>




