                            <ui:TextBlock Text="Right-click any asset card in Project Catalog or drag files into Transcoder Bridge to start conversions." FontSize="10.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ui:Card>

            <!-- Real-Time Live Studio Tasks (60-30-10 Fluent 2) -->
            <ui:Card x:Name="CardWidget_LiveTasks" Margin="0,0,0,24" Padding="20" Effect="{DynamicResource FluentDepth4}">
                <StackPanel>
                    <!-- Header with Real-time Pulsing Badge -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="28" Height="28" CornerRadius="6" Background="{DynamicResource FluentBrandLight}" Margin="0,0,10,0" VerticalAlignment="Center">
                                <ui:TextBlock Text="&#xE916;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="{DynamicResource FluentBrand80}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <ui:TextBlock Text="Live Studio Tasks" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                    <Border x:Name="LiveActiveBadge" Background="#E8F8F0" BorderBrush="#10B981" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="6" Height="6" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <ui:TextBlock x:Name="TxtLiveActiveCount" Text="0 Active" FontSize="10.5" FontWeight="Bold" Foreground="#10B981" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <ui:TextBlock Text="Real-time studio designer work telemetry &amp; live session durations" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Customizer controls -->
                            <StackPanel x:Name="HeaderControls_LiveTasks" Orientation="Horizontal" Margin="0,0,8,0" VerticalAlignment="Center" Visibility="Collapsed">
                                <ui:Button Tag="live_tasks" Appearance="Secondary" Height="28" Width="28" Padding="0" Margin="0,0,4,0" Click="OnPinWidgetClicked" ToolTip="Pin to Top">
                                    <ui:SymbolIcon x:Name="PinIcon_LiveTasks" Symbol="Pin24" FontSize="12"/>
                                </ui:Button>
                                <ui:Button Tag="live_tasks" Appearance="Secondary" Height="28" Width="28" Padding="0" Margin="0,0,4,0" Click="OnMoveWidgetUpClicked" ToolTip="Move Up">
                                    <ui:SymbolIcon Symbol="ChevronUp24" FontSize="12"/>
                                </ui:Button>
                                <ui:Button Tag="live_tasks" Appearance="Secondary" Height="28" Width="28" Padding="0" Margin="0,0,4,0" Click="OnMoveWidgetDownClicked" ToolTip="Move Down">
                                    <ui:SymbolIcon Symbol="ChevronDown24" FontSize="12"/>
                                </ui:Button>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,8,0" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Person24" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <ComboBox x:Name="CmbLiveDesignerFilter" SelectionChanged="OnLiveDesignerFilterChanged"
                                          Height="36" Width="140" Padding="10,0" VerticalContentAlignment="Center" FontSize="11.5"
                                          ToolTip="Filter active studio tasks by designer">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <ui:TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <ui:Button Appearance="Secondary" Click="OnRefreshLiveTasksClicked" Height="32" Padding="10,0" Cursor="Hand" ToolTip="Refresh Live Tasks">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ArrowSync24" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <ui:TextBlock Text="Sync Live Stream" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ui:Button>
                        </StackPanel>
                    </Grid>

                    <!-- Active Live Task Cards List -->
                    <ItemsControl x:Name="LiveTasksControl">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ui:Card Padding="14" Margin="4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Designer Avatar Circle -->
                                        <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource FluentBrandLight}" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <ui:TextBlock Text="{Binding Initials}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource FluentBrand80}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Project & Designer Details -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                <ui:TextBlock Text="{Binding DisplayAuthor}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,8,0" TextTrimming="CharacterEllipsis"/>
                                                <Border Background="{Binding StatusBrush}" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                                    <ui:TextBlock Text="{Binding StatusLabel}" Foreground="White" FontSize="9" FontWeight="Bold"/>
                                                </Border>
                                            </StackPanel>

                                            <!-- Project Name -->
                                            <ui:TextBlock Text="{Binding ProjectName}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource FluentBrand80}" TextTrimming="CharacterEllipsis" Margin="0,0,0,2"/>

                                            <!-- Activity Notes if any -->
                                            <ui:TextBlock Text="{Binding SessionNotes}" FontSize="10.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <!-- Right: Real-time Stopwatch & Action Button -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="6" Padding="10,4" Margin="0,0,0,6">
                                                <ui:TextBlock Text="{Binding FormattedTime}" FontFamily="Consolas, Segoe UI" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center"/>
                                            </Border>
                                            <ui:Button Appearance="Secondary" Height="28" Padding="10,0" Click="OnLiveTaskOpenProjectClicked" Tag="{Binding ProjectId}" Cursor="Hand" ToolTip="Open in Project Catalog">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="Open24" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                    <ui:TextBlock Text="View Project" FontSize="10.5" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </ui:Button>
                                        </StackPanel>
                                    </Grid>
                                </ui:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Friendly Empty State when all workstations are idle -->
                    <Border x:Name="PanelNoLiveTasks" Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="8" Padding="24,18" Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                                <ui:SymbolIcon Symbol="Timer24" FontSize="16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <ui:TextBlock Text="All Studio Workstations Idle" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <ui:TextBlock Text="Start a project work timer (Ctrl + K or header pill) to broadcast live creative focus to the studio team." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ui:Card>

            <!-- Inline 6 Last Created Projects List (Fluent 2 Card Container) -->
            <ui:Card x:Name="CardWidget_RecentProjects" Margin="0,0,0,24" Padding="20" Effect="{DynamicResource FluentDepth4}">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Text="Recent Past Projects (Last 6 Created)" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                        <StackPanel x:Name="HeaderControls_RecentProjects" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                            <ui:Button Tag="recent_projects" Appearance="Secondary" Height="28" Width="28" Padding="0" Margin="0,0,4,0" Click="OnPinWidgetClicked" ToolTip="Pin to Top">
                                <ui:SymbolIcon x:Name="PinIcon_RecentProjects" Symbol="Pin24" FontSize="12"/>
                            </ui:Button>
                            <ui:Button Tag="recent_projects" Appearance="Secondary" Height="28" Width="28" Padding="0" Margin="0,0,4,0" Click="OnMoveWidgetUpClicked" ToolTip="Move Up">
                                <ui:SymbolIcon Symbol="ChevronUp24" FontSize="12"/>
                            </ui:Button>
                            <ui:Button Tag="recent_projects" Appearance="Secondary" Height="28" Width="28" Padding="0" Margin="0,0,4,0" Click="OnMoveWidgetDownClicked" ToolTip="Move Down">
                                <ui:SymbolIcon Symbol="ChevronDown24" FontSize="12"/>
                            </ui:Button>
                        </StackPanel>
                    </Grid>
                    <ItemsControl x:Name="Recent6ProjectsControl" Margin="0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:Card Padding="12" Margin="4" Cursor="Hand" MouseLeftButtonUp="OnRecentProjectCardClicked" ToolTip="Click to open project folder in File Explorer">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34" Height="34" CornerRadius="6" Background="{DynamicResource FluentBrandLight}" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <ui:TextBlock Text="&#xED25;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="{DynamicResource FluentBrand80}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <ui:TextBlock Text="{Binding Project}" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <Border Background="{DynamicResource FluentBrand80}" CornerRadius="4" Padding="6,1" Margin="0,0,6,0">
                                                <ui:TextBlock Text="{Binding Designer}" Foreground="White" FontSize="9.5" FontWeight="Bold"/>
                                            </Border>
                                            <ui:TextBlock Text="{Binding Modified}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="10" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </ui:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ui:Card>

            <!-- Designer Workload & Capacity Section -->
            <ui:Card x:Name="CardWidget_WorkloadRadar" Margin="0,0,0,24" Padding="20" Effect="{DynamicResource FluentDepth4}">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="PeopleTeam24" FontSize="16" Foreground="{DynamicResource FluentBrand80}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <ui:TextBlock Text="Designer Workload &amp; Capacity Radar" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ui:TextBlock Grid.Column="1" Text="Max 5.0 creative units recommended" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <StackPanel x:Name="HeaderControls_WorkloadRadar" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                            <ui:Button Tag="workload_radar" Appearance="Secondary" Height="28" Width="28" Padding="0" Margin="0,0,4,0" Click="OnPinWidgetClicked" ToolTip="Pin to Top">
                                <ui:SymbolIcon x:Name="PinIcon_WorkloadRadar" Symbol="Pin24" FontSize="12"/>
                            </ui:Button>
                            <ui:Button Tag="workload_radar" Appearance="Secondary" Height="28" Width="28" Padding="0" Margin="0,0,4,0" Click="OnMoveWidgetUpClicked" ToolTip="Move Up">
                                <ui:SymbolIcon Symbol="ChevronUp24" FontSize="12"/>
                            </ui:Button>
                            <ui:Button Tag="workload_radar" Appearance="Secondary" Height="28" Width="28" Padding="0" Margin="0,0,4,0" Click="OnMoveWidgetDownClicked" ToolTip="Move Down">
                                <ui:SymbolIcon Symbol="ChevronDown24" FontSize="12"/>
                            </ui:Button>
                        </StackPanel>
                    </Grid>

                    <ItemsControl x:Name="DesignerWorkloadControl">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ui:Card Padding="14" Margin="4">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <ui:TextBlock Text="{Binding DesignerName}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:TextBlock Text="{Binding StaffId}" FontSize="10.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                    <ui:TextBlock Text=" &#x2022; " FontSize="10.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                    <ui:TextBlock Text="{Binding ActiveWeightDisplay}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource FluentBrand80}"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <Border Grid.Column="1" BorderBrush="{Binding CapacityColor}" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Top">
                                                <ui:TextBlock Text="{Binding CapacityStatus}" FontSize="10" FontWeight="Bold" Foreground="{Binding CapacityColor}"/>
                                            </Border>
                                        </Grid>

                                        <!-- Capacity Progress Bar -->
                                        <ProgressBar Value="{Binding CapacityPercent}" Maximum="100" Height="6" Margin="0,10,0,8" Foreground="{Binding CapacityColor}"/>

                                        <Grid Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <ui:TextBlock Text="In-Progress" FontSize="9.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                <ui:TextBlock Text="{Binding InProgressCount}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource FluentBrand80}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                                <ui:TextBlock Text="Review / Rev" FontSize="9.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                <ui:TextBlock Text="{Binding ReviewCount}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SystemFillColorCautionBrush}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                                <ui:TextBlock Text="Completed" FontSize="9.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                <ui:TextBlock Text="{Binding DoneCount}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SystemFillColorSuccessBrush}"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </ui:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ui:Card>

            <!-- Creative SLA & Revision Turnaround Analytics -->
            <ui:Card x:Name="CardWidget_SlaAnalytics" Margin="0,0,0,24" Padding="20" Effect="{DynamicResource FluentDepth4}">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Timer24" FontSize="16" Foreground="{DynamicResource FluentBrand80}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <ui:TextBlock Text="Operational SLA &amp; Revision Turnaround Velocity" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel x:Name="HeaderControls_SlaAnalytics" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                            <ui:Button Tag="sla_analytics" Appearance="Secondary" Height="28" Width="28" Padding="0" Margin="0,0,4,0" Click="OnPinWidgetClicked" ToolTip="Pin to Top">
                                <ui:SymbolIcon x:Name="PinIcon_SlaAnalytics" Symbol="Pin24" FontSize="12"/>
                            </ui:Button>
                            <ui:Button Tag="sla_analytics" Appearance="Secondary" Height="28" Width="28" Padding="0" Margin="0,0,4,0" Click="OnMoveWidgetUpClicked" ToolTip="Move Up">
                                <ui:SymbolIcon Symbol="ChevronUp24" FontSize="12"/>
                            </ui:Button>
                            <ui:Button Tag="sla_analytics" Appearance="Secondary" Height="28" Width="28" Padding="0" Margin="0,0,4,0" Click="OnMoveWidgetDownClicked" ToolTip="Move Down">
                                <ui:SymbolIcon Symbol="ChevronDown24" FontSize="12"/>
                            </ui:Button>
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <ui:Card Grid.Column="0" Margin="0,0,8,0" Padding="14">
                            <StackPanel>
                                <ui:TextBlock Text="FIRST-TIME RIGHT RATE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <ui:TextBlock x:Name="TxtSlaFirstTimeRight" Text="85.0%" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,4,0,2"/>
                                <ui:TextBlock Text="Projects signed off with 0 revisions" FontSize="10.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </ui:Card>

                        <ui:Card Grid.Column="1" Margin="4,0,4,0" Padding="14">
                            <StackPanel>
                                <ui:TextBlock Text="AVG TURNAROUND VELOCITY" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <ui:TextBlock x:Name="TxtSlaAvgTurnaround" Text="3.5 Days" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource FluentBrand80}" Margin="0,4,0,2"/>
                                <ui:TextBlock Text="From brief creation to deliverable sign-off" FontSize="10.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </ui:Card>

                        <ui:Card Grid.Column="2" Margin="8,0,0,0" Padding="14">
                            <StackPanel>
                                <ui:TextBlock Text="AVG REVISION ROUNDS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <ui:TextBlock x:Name="TxtSlaAvgRevs" Text="0.4 Revs" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,4,0,2"/>
                                <ui:TextBlock Text="Average iterations per deliverable" FontSize="10.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </ui:Card>
                    </Grid>
                </StackPanel>
            </ui:Card>

            <!-- Hidden chart controls for data binding compatibility -->
            <StackPanel Visibility="Collapsed">
                <ItemsControl x:Name="TypeChartControl"/>
                <ItemsControl x:Name="BrandChartControl"/>
                <ItemsControl x:Name="StorageChartControl"/>
                <ItemsControl x:Name="ActivityChartControl"/>
            </StackPanel>

            <!-- Designer Inspiration Widget -->
            <ui:Card x:Name="CardWidget_DesignerTip" Padding="20" Margin="0,0,0,24" Effect="{DynamicResource FluentDepth4}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Tip Display -->
                    <StackPanel Grid.Column="0" Margin="0,0,24,0">
                        <!-- Card Header -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="{DynamicResource FluentBrandLight}" CornerRadius="6" Width="34" Height="34" Margin="0,0,10,0">
                                    <ui:TextBlock x:Name="TxtInsightIcon" Text="&#xE82F;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="{DynamicResource FluentBrand80}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <ui:TextBlock Text="DESIGNER INSIGHT" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
