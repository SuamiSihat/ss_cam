<Page x:Class="SS_CAM.Views.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Dashboard">

    <ScrollViewer x:Name="MainScrollViewer" VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="False" Padding="24" Background="Transparent" PreviewMouseWheel="OnScrollViewerPreviewMouseWheel">
        <StackPanel>
            <!-- Fluent 2 Page Header Bar -->
            <Grid Margin="0,0,0,40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <ui:SymbolIcon Symbol="Home24" FontSize="24" Foreground="{DynamicResource FluentBrand80}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ui:TextBlock Text="Designer Intelligence Dashboard" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource FluentBrand80}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="10,0,12,0"
                                Cursor="Hand" ToolTip="Click to open About SS-CAM &amp; Release Changelog" MouseLeftButtonDown="OnVersionBadgeClicked">
                            <ui:TextBlock x:Name="TxtVersionBadge" Text="" FontSize="10.5" FontWeight="Bold" Foreground="White"/>
                        </Border>
                    </StackPanel>
                    <ui:TextBlock Text="Real-time workspace overview, creative KPI metrics, and project telemetry" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Folder24" FontSize="14" Foreground="{DynamicResource FluentBrand80}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <ui:TextBlock x:Name="TxtWorkspacePath" Text="" Foreground="{DynamicResource FluentBrand80}" FontWeight="SemiBold" FontSize="12"/>
                    </StackPanel>
                    <ui:TextBlock x:Name="TxtStatus" Text="Ready." Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <ui:Button Appearance="Primary" Click="OnQuickNewProjectClicked" Height="36" Padding="14,0" Margin="0,0,8,0" Cursor="Hand" ToolTip="Scaffold New Project">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Add24" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <ui:TextBlock Text="New Project" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ui:Button>

                    <ui:Button Appearance="Secondary" Click="OnQuickCatalogClicked" Height="36" Padding="14,0" Margin="0,0,8,0" Cursor="Hand" ToolTip="Open Project Catalog">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="FolderSearch24" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <ui:TextBlock Text="Project Catalog" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ui:Button>

                    <ui:Button x:Name="BtnCustomizeLayout" Appearance="Secondary" Click="OnCustomizeLayoutClicked" Height="36" Padding="14,0" Margin="0,0,8,0" Cursor="Hand" ToolTip="Customize, reorder, and pin dashboard widgets">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Options24" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <ui:TextBlock x:Name="TxtCustomizeLayoutLabel" Text="Customize" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ui:Button>

                    <ui:Button Appearance="Secondary" Click="OnRefreshClicked" Width="36" Height="36" Padding="0" Cursor="Hand" ToolTip="Refresh Workspace Analytics">
                        <ui:SymbolIcon Symbol="ArrowSync24" FontSize="16" VerticalAlignment="Center"/>
                    </ui:Button>
                </StackPanel>
            </Grid>

            <!-- Layout Customization Mode Banner (Visible when editing layout) -->
            <ui:Card x:Name="BannerCustomizeLayout" Margin="0,0,0,16" Padding="14,10" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource FluentBrand80}" BorderThickness="1" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Options24" FontSize="16" Foreground="{DynamicResource FluentBrand80}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center">
                            <ui:TextBlock Text="Customizing Dashboard Widgets" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <ui:TextBlock Text="Use the Pin and Move controls on each widget card to rearrange your dashboard." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button Appearance="Secondary" Height="30" Padding="10,0" Margin="0,0,6,0" Click="OnResetLayoutClicked" ToolTip="Reset all widgets to standard studio order">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowCounterclockwise24" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <ui:TextBlock Text="Reset Default" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Appearance="Primary" Height="30" Padding="14,0" Click="OnDoneCustomizingClicked" ToolTip="Save and exit customization mode">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Checkmark24" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <ui:TextBlock Text="Done" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ui:Button>
                    </StackPanel>
                </Grid>
            </ui:Card>

            <StackPanel x:Name="WidgetsContainer">

            <!-- ── WIDGET 1: KEY METRIC CARDS ── -->
            <Grid x:Name="CardWidget_Kpis" Margin="0,0,0,24">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Text="STUDIO KEY PERFORMANCE METRICS" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center"/>
                        <StackPanel x:Name="HeaderControls_Kpis" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                            <ui:Button Tag="kpis" Appearance="Secondary" Height="28" Width="28" Padding="0" Margin="0,0,4,0" Click="OnPinWidgetClicked" ToolTip="Pin to Top">
                                <ui:SymbolIcon x:Name="PinIcon_Kpis" Symbol="Pin24" FontSize="12"/>
                            </ui:Button>
                            <ui:Button Tag="kpis" Appearance="Secondary" Height="28" Width="28" Padding="0" Margin="0,0,4,0" Click="OnMoveWidgetUpClicked" ToolTip="Move Up">
                                <ui:SymbolIcon Symbol="ChevronUp24" FontSize="12"/>
                            </ui:Button>
                            <ui:Button Tag="kpis" Appearance="Secondary" Height="28" Width="28" Padding="0" Margin="0,0,4,0" Click="OnMoveWidgetDownClicked" ToolTip="Move Down">
                                <ui:SymbolIcon Symbol="ChevronDown24" FontSize="12"/>
                            </ui:Button>
                        </StackPanel>
                    </Grid>

                    <UniformGrid Rows="2" Columns="4" Height="224" Margin="-6,0,-6,0">
                <!-- Total Projects -->
                <ui:Card Padding="16,12" Margin="6" VerticalAlignment="Stretch" Effect="{DynamicResource FluentDepth4}">
                    <StackPanel VerticalAlignment="Center">
                        <ui:TextBlock Text="TOTAL PROJECTS" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="10" FontWeight="Bold"/>
                        <ui:TextBlock x:Name="MetricTotalProjects" Text="0" Foreground="{DynamicResource FluentBrand80}" FontSize="28" FontWeight="Bold" Margin="0,2,0,0"/>
                        <ui:TextBlock Text="Workspace total" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                </ui:Card>

                <!-- Active WIP Projects -->
                <ui:Card Padding="16,12" Margin="6" VerticalAlignment="Stretch" Effect="{DynamicResource FluentDepth4}">
                    <StackPanel VerticalAlignment="Center">
                        <ui:TextBlock Text="ACTIVE WIP (7 DAYS)" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="10" FontWeight="Bold"/>
                        <ui:TextBlock x:Name="MetricActiveWIP" Text="0" Foreground="{DynamicResource SystemFillColorCautionBrush}" FontSize="28" FontWeight="Bold" Margin="0,2,0,0"/>
                        <ui:TextBlock Text="Modified recently" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                </ui:Card>

                <!-- Latest Project -->
                <ui:Card Padding="16,12" Margin="6" VerticalAlignment="Stretch" Effect="{DynamicResource FluentDepth4}">
                    <StackPanel VerticalAlignment="Center">
                        <ui:TextBlock Text="LATEST CREATED" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="10" FontWeight="Bold"/>
                        <ui:TextBlock x:Name="MetricLatestProject" Text="-" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="22" FontWeight="Bold" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                        <ui:TextBlock x:Name="MetricLatestProjectSubtext" Text="Most recent project" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </ui:Card>

                <!-- Storage Size -->
                <ui:Card Padding="16,12" Margin="6" VerticalAlignment="Stretch" Effect="{DynamicResource FluentDepth4}">
                    <StackPanel VerticalAlignment="Center">
                        <ui:TextBlock Text="STORAGE SIZE" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="10" FontWeight="Bold"/>
                        <ui:TextBlock x:Name="MetricFileSize" Text="0 MB" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="22" FontWeight="Bold" Margin="0,2,0,0"/>
                        <ui:TextBlock Text="Total asset volume" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                </ui:Card>

                <!-- Created This Month -->
                <ui:Card Padding="16,12" Margin="6" VerticalAlignment="Stretch" Effect="{DynamicResource FluentDepth4}">
                    <StackPanel VerticalAlignment="Center">
                        <ui:TextBlock Text="THIS MONTH OUTPUT" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="10" FontWeight="Bold"/>
                        <ui:TextBlock x:Name="MetricThisMonth" Text="0" Foreground="{DynamicResource SystemFillColorSuccessBrush}" FontSize="28" FontWeight="Bold" Margin="0,2,0,0"/>
                        <ui:TextBlock x:Name="MetricMonthComparison" Text="&#x25B2; +0% vs last month" Foreground="{DynamicResource SystemFillColorSuccessBrush}" FontSize="11" FontWeight="Bold" Margin="0,2,0,0"/>
                    </StackPanel>
                </ui:Card>

                <!-- Largest Project -->
                <ui:Card Padding="16,12" Margin="6" VerticalAlignment="Stretch" Effect="{DynamicResource FluentDepth4}">
                    <StackPanel VerticalAlignment="Center">
                        <ui:TextBlock Text="LARGEST PROJECT" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="10" FontWeight="Bold"/>
                        <ui:TextBlock x:Name="MetricLargestProjectSize" Text="0 MB" Foreground="{DynamicResource SystemFillColorCautionBrush}" FontSize="22" FontWeight="Bold" Margin="0,2,0,0"/>
                        <ui:TextBlock x:Name="MetricLargestProjectName" Text="None" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="10" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </ui:Card>

                <!-- Stale Projects -->
                <ui:Card Padding="16,12" Margin="6" VerticalAlignment="Stretch" Effect="{DynamicResource FluentDepth4}">
                    <StackPanel VerticalAlignment="Center">
                        <ui:TextBlock Text="STALE PROJECTS (&gt;90 DAYS)" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="10" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                        <ui:TextBlock x:Name="MetricStaleProjects" Text="0" Foreground="{DynamicResource SystemFillColorCriticalBrush}" FontSize="28" FontWeight="Bold" Margin="0,2,0,0"/>
                        <ui:TextBlock Text="Idle folders to archive" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                </ui:Card>

                <!-- Flow Metrics -->
                <ui:Card Padding="16,12" Margin="6" VerticalAlignment="Stretch" Effect="{DynamicResource FluentDepth4}">
                    <StackPanel VerticalAlignment="Center">
                        <ui:TextBlock Text="CREATIVE TEAM FLOW" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="10" FontWeight="Bold"/>
                        <ui:TextBlock x:Name="FlowDesignerCount" Text="0 Designers, 0 Projects" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource FluentBrand80}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                        <ui:TextBlock x:Name="FlowFileCount" Text="0 files indexed" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                </ui:Card>
                    </UniformGrid>
                </StackPanel>
            </Grid>

            <!-- ── WIDGET 2: IN-FLIGHT PRODUCTION SPOTLIGHT ── -->
            <ui:Card x:Name="CardWidget_Spotlight" Margin="0,0,0,24" Padding="20" Effect="{DynamicResource FluentDepth4}">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="28" Height="28" CornerRadius="6" Background="{DynamicResource FluentBrandLight}" Margin="0,0,10,0" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Flash24" FontSize="14" Foreground="{DynamicResource FluentBrand80}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <ui:TextBlock Text="In-Flight Production Spotlight" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                    <Border x:Name="SpotlightActiveBadge" Background="{DynamicResource FluentBrandLight}" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <ui:TextBlock x:Name="TxtSpotlightActiveCount" Text="0 In-Flight" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource FluentBrand80}" VerticalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                                <ui:TextBlock Text="Active production deliverables and projects undergoing revisions in the creative pipeline" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="6" Padding="2" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <ui:Button x:Name="BtnSpotlightFilterAll" Appearance="Primary" Height="28" Padding="10,0" Margin="0,0,2,0" Click="OnSpotlightFilterAllClicked" Cursor="Hand">
                                        <ui:TextBlock Text="All In-Flight" FontSize="11"/>
                                    </ui:Button>
                                    <ui:Button x:Name="BtnSpotlightFilterInProd" Appearance="Secondary" Height="28" Padding="10,0" Margin="0,0,2,0" Click="OnSpotlightFilterInProdClicked" Cursor="Hand">
                                        <ui:TextBlock Text="In Production" FontSize="11"/>
                                    </ui:Button>
                                    <ui:Button x:Name="BtnSpotlightFilterReview" Appearance="Secondary" Height="28" Padding="10,0" Click="OnSpotlightFilterReviewClicked" Cursor="Hand">
                                        <ui:TextBlock Text="Needs Review" FontSize="11"/>
                                    </ui:Button>
                                </StackPanel>
                            </Border>

                            <StackPanel x:Name="HeaderControls_Spotlight" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                                <ui:Button Tag="spotlight" Appearance="Secondary" Height="28" Width="28" Padding="0" Margin="0,0,4,0" Click="OnPinWidgetClicked" ToolTip="Pin to Top">
                                    <ui:SymbolIcon x:Name="PinIcon_Spotlight" Symbol="Pin24" FontSize="12"/>
                                </ui:Button>
                                <ui:Button Tag="spotlight" Appearance="Secondary" Height="28" Width="28" Padding="0" Margin="0,0,4,0" Click="OnMoveWidgetUpClicked" ToolTip="Move Up">
                                    <ui:SymbolIcon Symbol="ChevronUp24" FontSize="12"/>
                                </ui:Button>
                                <ui:Button Tag="spotlight" Appearance="Secondary" Height="28" Width="28" Padding="0" Margin="0,0,4,0" Click="OnMoveWidgetDownClicked" ToolTip="Move Down">
                                    <ui:SymbolIcon Symbol="ChevronDown24" FontSize="12"/>
                                </ui:Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <ItemsControl x:Name="SpotlightProjectsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ui:Card Padding="12,10" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="{DynamicResource FluentBrandLight}" BorderBrush="{DynamicResource FluentBrand80}" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <ui:TextBlock Text="{Binding JobId}" FontFamily="Consolas, monospace" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource FluentBrand80}"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                <ui:TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                <Border Background="{Binding StatusBrush}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <ui:TextBlock Text="{Binding StatusLabel}" Foreground="White" FontSize="9" FontWeight="Bold"/>
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Person24" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                <ui:TextBlock Text="{Binding Designer}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,10,0"/>
                                                <ui:SymbolIcon Symbol="Clock24" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                <ui:TextBlock Text="{Binding DeadlineDisplay}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <ui:Button Grid.Column="2" Appearance="Secondary" Height="30" Padding="12,0" Click="OnSpotlightOpenProjectClicked" Tag="{Binding ProjectPath}" Cursor="Hand" ToolTip="Open project in Catalog">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="FolderSearch24" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                <ui:TextBlock Text="Open" FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </ui:Button>
                                    </Grid>
                                </ui:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border x:Name="PanelNoSpotlightProjects" Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="8" Padding="20,14" Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="16" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,0,0,4" HorizontalAlignment="Center"/>
                            <ui:TextBlock Text="All projects caught up and delivered" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center"/>
                            <ui:TextBlock Text="No active deliverables currently requiring revisions or in-flight work." FontSize="10.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ui:Card>

            <!-- ── WIDGET 3: ACTIVE TRANSCODES ── -->
            <ui:Card x:Name="CardWidget_Transcodes" Margin="0,0,0,24" Padding="20" Effect="{DynamicResource FluentDepth4}">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="28" Height="28" CornerRadius="6" Background="{DynamicResource FluentBrandLight}" Margin="0,0,10,0" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Video24" FontSize="14" Foreground="{DynamicResource FluentBrand80}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <ui:TextBlock Text="Active Transcodes &amp; Asset Conversions" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                    <Border x:Name="TranscodeActiveBadge" Background="{DynamicResource FluentBrandLight}" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <ui:TextBlock x:Name="TxtTranscodeActiveCount" Text="0 Active" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource FluentBrand80}" VerticalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                                <ui:TextBlock Text="Real-time FFmpeg asset transcoding (WebP, AVIF, WebM, MP4, GIF)" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button Appearance="Secondary" Height="30" Padding="12,0" Click="OnOpenTranscoderBridgeClicked" Cursor="Hand" ToolTip="Open full Transcoder Bridge page" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Open24" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <ui:TextBlock Text="Transcoder Bridge" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ui:Button>

                            <StackPanel x:Name="HeaderControls_Transcodes" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                                <ui:Button Tag="transcodes" Appearance="Secondary" Height="28" Width="28" Padding="0" Margin="0,0,4,0" Click="OnPinWidgetClicked" ToolTip="Pin to Top">
                                    <ui:SymbolIcon x:Name="PinIcon_Transcodes" Symbol="Pin24" FontSize="12"/>
                                </ui:Button>
                                <ui:Button Tag="transcodes" Appearance="Secondary" Height="28" Width="28" Padding="0" Margin="0,0,4,0" Click="OnMoveWidgetUpClicked" ToolTip="Move Up">
                                    <ui:SymbolIcon Symbol="ChevronUp24" FontSize="12"/>
                                </ui:Button>
                                <ui:Button Tag="transcodes" Appearance="Secondary" Height="28" Width="28" Padding="0" Margin="0,0,4,0" Click="OnMoveWidgetDownClicked" ToolTip="Move Down">
                                    <ui:SymbolIcon Symbol="ChevronDown24" FontSize="12"/>
                                </ui:Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <ItemsControl x:Name="ActiveTranscodesControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ui:Card Padding="14,10" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="32" Height="32" CornerRadius="6" Background="{DynamicResource FluentBrandLight}" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="Document24" FontSize="14" Foreground="{DynamicResource FluentBrand80}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <ui:TextBlock Text="{Binding SourceFileName}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <Border Background="{DynamicResource FluentBrand80}" CornerRadius="4" Padding="6,1" Margin="0,0,6,0">
                                                    <ui:TextBlock Text="{Binding PresetDisplay}" Foreground="White" FontSize="9" FontWeight="Bold"/>
                                                </Border>
                                                <ui:TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="10.5" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Height="6" Foreground="{DynamicResource FluentBrand80}"/>
                                            <ui:TextBlock Text="{Binding ProgressPercentDisplay}" HorizontalAlignment="Right" FontSize="9.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <ui:Button Grid.Column="3" Appearance="Secondary" Height="28" Padding="10,0" Click="OnOpenTranscodeOutputClicked" Tag="{Binding OutputFilePath}" Cursor="Hand" ToolTip="Open converted asset in Explorer">
                                            <ui:SymbolIcon Symbol="Folder24" FontSize="12" VerticalAlignment="Center"/>
                                        </ui:Button>
                                    </Grid>
                                </ui:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border x:Name="PanelNoTranscodeJobs" Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="8" Padding="20,14" Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center">
