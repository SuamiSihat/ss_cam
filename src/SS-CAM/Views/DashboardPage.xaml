                                </StackPanel>
                            </StackPanel>
                            <StackPanel x:Name="HeaderControls_DesignerTip" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                                <ui:Button Tag="designer_tip" Appearance="Secondary" Height="28" Width="28" Padding="0" Margin="0,0,4,0" Click="OnPinWidgetClicked" ToolTip="Pin to Top">
                                    <ui:SymbolIcon x:Name="PinIcon_DesignerTip" Symbol="Pin24" FontSize="12"/>
                                </ui:Button>
                                <ui:Button Tag="designer_tip" Appearance="Secondary" Height="28" Width="28" Padding="0" Margin="0,0,4,0" Click="OnMoveWidgetUpClicked" ToolTip="Move Up">
                                    <ui:SymbolIcon Symbol="ChevronUp24" FontSize="12"/>
                                </ui:Button>
                                <ui:Button Tag="designer_tip" Appearance="Secondary" Height="28" Width="28" Padding="0" Margin="0,0,4,0" Click="OnMoveWidgetDownClicked" ToolTip="Move Down">
                                    <ui:SymbolIcon Symbol="ChevronDown24" FontSize="12"/>
                                </ui:Button>
