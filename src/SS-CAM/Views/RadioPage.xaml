<Page x:Class="SS_CAM.Views.RadioPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:converters="clr-namespace:SS_CAM.Converters"
      Title="Radio Player">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
    </Page.Resources>

    <!-- Main Layout Grid (Standard Fluent 2 Page Grid Layout - Consistent with All SS-CAM Pages) -->
    <Grid Margin="24,16,24,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Row 0: Page Header Bar -->
            <RowDefinition Height="Auto"/>   <!-- Row 1: Now Playing Hero Banner -->
            <RowDefinition Height="Auto"/>   <!-- Row 2: Genre Filter Tabs -->
            <RowDefinition Height="*"/>      <!-- Row 3: Station Cover-Art Grid -->
        </Grid.RowDefinitions>

        <!-- Row 0: Page Header Bar (Zune Panoramic Typography) -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <ui:TextBlock Text="radio &amp; audio streams" FontFamily="Segoe UI Light" FontSize="38" FontWeight="Light"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,2"/>
                <ui:TextBlock Text="ambient focus music, broadcasts, and custom stream URLs for uninterrupted creative flow."
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" FontFamily="Segoe UI"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button Appearance="Secondary" Click="OnImportPlaylistClicked" Margin="0,0,8,0"
                        Padding="10,6" Cursor="Hand" ToolTip="Import .pls or .m3u" AutomationProperties.Name="Import Playlist">
                    <StackPanel Orientation="Horizontal">
                        <ui:TextBlock Text="&#xE8B5;" FontFamily="Segoe Fluent Icons" FontSize="12"
                                   Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <ui:TextBlock Text="Import" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                </ui:Button>
                <ui:Button Appearance="Secondary" Click="OnExportPlaylistClicked" Margin="0,0,8,0"
                        Padding="10,6" Cursor="Hand" ToolTip="Export playlist as .m3u" AutomationProperties.Name="Export Playlist">
                    <StackPanel Orientation="Horizontal">
                        <ui:TextBlock Text="&#xE74E;" FontFamily="Segoe Fluent Icons" FontSize="12"
                                   Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <ui:TextBlock Text="Export" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                </ui:Button>
                <ui:Button Appearance="Secondary" Click="OnResetDefaultsClicked" Margin="0,0,8,0"
                        Padding="10,6" Cursor="Hand" ToolTip="Reset to defaults" AutomationProperties.Name="Reset to Default Stations">
                    <StackPanel Orientation="Horizontal">
                        <ui:TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons" FontSize="12"
                                   Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <ui:TextBlock Text="Reset" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                </ui:Button>
                <ui:Button Appearance="Primary" Click="OnAddCustomStationClicked"
                        Padding="14,8" Cursor="Hand" ToolTip="Add a custom stream URL" AutomationProperties.Name="Add Stream">
                    <StackPanel Orientation="Horizontal">
                        <ui:TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons" FontSize="13"
                                   Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <ui:TextBlock Text="Add Stream" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </ui:Button>
            </StackPanel>
        </Grid>

        <!-- Row 1: Now Playing Hero Banner (Panoramic Zune Style - Flat Accent Block) -->
        <Border Grid.Row="1" MinHeight="144" Height="148" Margin="0,0,0,16"
                Background="#0B132B"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                ClipToBounds="True">
            <Grid x:Name="HeroMeshContainer" SizeChanged="OnHeroMeshSizeChanged" MouseMove="OnHeroMeshMouseMove" MouseLeave="OnHeroMeshMouseLeave" Background="#0B132B" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ClipToBounds="True">
                <!-- Hero Mesh Atmosphere Gradient -->
                <Rectangle x:Name="HeroMeshAtmosphere" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Rectangle.Fill>
                        <LinearGradientBrush x:Name="HeroMeshGrad" StartPoint="0,0" EndPoint="0,1">
                            <GradientStop x:Name="HeroMeshStop1" Color="#0B132B" Offset="0.0"/>
                            <GradientStop x:Name="HeroMeshStop2" Color="#102042" Offset="0.6"/>
                            <GradientStop x:Name="HeroMeshStop3" Color="#090E1A" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!-- Dynamic Pulsating Aura Glow Rings & Backdrop Animation Canvas -->
                <Canvas x:Name="HeroMeshBackdropCanvas" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsHitTestVisible="False">
                    <!-- Glowing Azure Aura Ring -->
                    <Ellipse x:Name="AuraRing1" Width="380" Height="380" Canvas.Right="-60" Canvas.Top="-120" Opacity="0.35">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#21A1F7" Offset="0.0"/>
                                <GradientStop Color="#0021A1F7" Offset="1.0"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="AuraScale1" CenterX="190" CenterY="190" ScaleX="1.0" ScaleY="1.0"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>

                    <!-- Glowing Brand Yellow Aura Ring -->
                    <Ellipse x:Name="AuraRing2" Width="320" Height="320" Canvas.Left="-60" Canvas.Bottom="-110" Opacity="0.25">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#FCE53D" Offset="0.0"/>
                                <GradientStop Color="#00FCE53D" Offset="1.0"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="AuraScale2" CenterX="160" CenterY="160" ScaleX="1.0" ScaleY="1.0"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>

                    <!-- Concentric Bass Shockwave Ripple Ring -->
                    <Ellipse x:Name="BassShockwaveRing" Width="140" Height="140" Canvas.Right="180" Canvas.Top="20" Opacity="0" IsHitTestVisible="False">
                        <Ellipse.Stroke>
                            <SolidColorBrush x:Name="ShockwaveBrush" Color="#21A1F7"/>
                        </Ellipse.Stroke>
                        <Ellipse.StrokeThickness>
                            <System:Double xmlns:System="clr-namespace:System;assembly=mscorlib">3.0</System:Double>
                        </Ellipse.StrokeThickness>
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="ShockwaveScale" CenterX="70" CenterY="70" ScaleX="1.0" ScaleY="1.0"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>

                    <!-- Floating Spark Particles Layer -->
                    <Canvas x:Name="ParticleCanvas" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsHitTestVisible="False">
                        <Ellipse x:Name="Spark1" Width="5" Height="5" Canvas.Right="140" Canvas.Top="20" Fill="#FCE53D" Opacity="0.6"/>
                        <Ellipse x:Name="Spark2" Width="4" Height="4" Canvas.Right="220" Canvas.Top="45" Fill="#21A1F7" Opacity="0.7"/>
                        <Ellipse x:Name="Spark3" Width="6" Height="6" Canvas.Right="80" Canvas.Top="60" Fill="#38BDF8" Opacity="0.5"/>
                        <Ellipse x:Name="Spark4" Width="4" Height="4" Canvas.Left="120" Canvas.Top="30" Fill="#FCE53D" Opacity="0.6"/>
                        <Ellipse x:Name="Spark5" Width="5" Height="5" Canvas.Left="260" Canvas.Top="55" Fill="#21A1F7" Opacity="0.7"/>
                        <Ellipse x:Name="Spark6" Width="3" Height="3" Canvas.Right="180" Canvas.Top="15" Fill="#FFFFFF" Opacity="0.8"/>
                    </Canvas>

                    <!-- 69 Scattered Floating Mars Symbols Canvas (Active only when FX is toggled On) -->
                    <Canvas x:Name="ScatteredSymbolsCanvas" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Opacity="0" IsHitTestVisible="False"/>

                    <!-- Floating Crest Icon Canvas (Active only when FX is toggled On) -->
                    <Canvas x:Name="SSLogoCanvas" Canvas.Right="240" Canvas.Top="25" Opacity="0" IsHitTestVisible="False">
                        <Grid Width="70" Height="70">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="MenIconScale" CenterX="35" CenterY="35" ScaleX="1.0" ScaleY="1.0"/>
                            </Grid.RenderTransform>
                            <Viewbox Width="65" Height="65" Opacity="0.25">
                                <Canvas Width="1081" Height="1080">
                                    <Path Data="M502.876,705.61c11.387,10.993 24.629,18.95 38.659,23.928c23.084,8.125 48.39,8.125 71.501,-0.03l0.027,-0.027c3.572,-1.209 7.031,-2.643 10.488,-4.301l0.03,-0.03c10.121,-4.836 19.652,-11.33 28.144,-19.54c0.505,-0.449 1.012,-0.956 1.491,-1.433c0.477,-0.48 0.982,-0.984 1.434,-1.491c8.21,-8.49 14.704,-18.024 19.539,-28.144c1.661,-3.46 3.122,-6.946 4.331,-10.516l0.028,-0.027c8.154,-23.113 8.154,-48.418 0.027,-71.501c-4.975,-14.032 -12.933,-27.275 -23.925,-38.662c-0.452,-0.504 -0.957,-1.011 -1.434,-1.488l-101.221,-101.221c-13.974,-13.974 -36.636,-13.974 -50.61,-0c-13.468,13.467 -13.945,35.032 -1.434,49.119c0.45,0.507 0.957,1.014 1.434,1.491l101.221,101.219c0.477,0.479 0.984,0.984 1.433,1.491c12.511,14.087 12.034,35.652 -1.433,49.119c-13.975,13.975 -36.636,13.975 -50.611,0l-62.559,-62.559l-50.611,50.61l62.56,62.56c0.479,0.477 0.984,0.984 1.491,1.433" Fill="#6DC6EC"/>
                                    <Path Data="M490.954,375.185c23.111,-8.155 48.418,-8.155 71.501,-0.028c14.03,4.975 27.272,12.933 38.659,23.928c0.507,0.449 1.012,0.954 1.491,1.433l38.659,38.66l50.611,-50.611l-38.659,-38.659c-0.48,-0.479 -0.984,-0.984 -1.491,-1.434c-11.387,-10.994 -24.63,-18.952 -38.662,-23.927c-23.083,-8.125 -48.387,-8.125 -71.498,0.027l-0.03,0.03c-3.57,1.209 -7.056,2.67 -10.516,4.329c-10.12,4.835 -19.651,11.331 -28.143,19.541c-0.507,0.45 -1.012,0.955 -1.491,1.434c-0.478,0.477 -0.985,0.984 -1.434,1.489c-8.21,8.492 -14.704,18.023 -19.54,28.146c3.457,-1.659 6.944,-3.122 10.516,-4.329l0.027,-0.029Z" Fill="#6DC6EC"/>
                                    <Path Data="M868.833,575.634c-0.023,0.218 -0.048,0.435 -0.071,0.653c-18.065,165.563 -158.344,294.405 -328.714,294.405c-91.316,-0 -173.954,-37.047 -233.795,-96.89l-50.679,50.679c72.847,73.012 173.527,118.246 284.62,118.246c222.041,-0 402.718,-180.675 402.718,-402.715c0,-12.271 -0.576,-24.417 -1.642,-36.398l-80.06,0l0,0.122l-155.407,-0l4.769,4.771c-0,0 29.495,27.187 46.373,67.083l111.819,0l0.069,0.044Z" Fill="#6DC6EC"/>
                                    <Path Data="M613.037,729.509c-23.114,8.155 -48.418,8.155 -71.501,0.028c-14.03,-4.976 -27.273,-12.933 -38.659,-23.926c-0.507,-0.449 -1.014,-0.956 -1.492,-1.433l-62.559,-62.56l-50.61,50.608l62.561,62.56c0.478,0.479 0.982,0.984 1.489,1.433c11.387,10.995 24.63,18.95 38.659,23.928c23.086,8.125 48.39,8.125 71.501,-0.028l0.028,-0.029c3.571,-1.209 7.058,-2.67 10.517,-4.329c10.121,-4.838 19.652,-11.33 28.144,-19.542c0.507,-0.449 1.012,-0.954 1.489,-1.433c0.479,-0.478 0.986,-0.984 1.436,-1.491c8.21,-8.49 14.704,-18.021 19.512,-28.117c-3.459,1.661 -6.916,3.095 -10.488,4.304l-0.027,0.027Z" Fill="#21A1F7"/>
                                </Canvas>
                            </Viewbox>
                        </Grid>
                    </Canvas>

                    <!-- Dual-Ribbon 3D Waveform Paths (for Waveform mode) -->
                    <Path x:Name="HeroWavePath" Stroke="#38BDF8" StrokeThickness="2.0" Opacity="0.85" Visibility="Collapsed"/>
                    <Path x:Name="HeroWavePath2" Stroke="#FCE53D" StrokeThickness="1.5" Opacity="0.75" Visibility="Collapsed"/>

                    <!-- Water Drop Line Ripple Paths (for WaterDrop mode) -->
                    <Path x:Name="HeroWaterDropPath" Stroke="#21A1F7" StrokeThickness="2.5" Opacity="0.85" Visibility="Collapsed"/>
                    <Path x:Name="HeroWaterDropPath2" Stroke="#38BDF8" StrokeThickness="1.5" Opacity="0.70" Visibility="Collapsed"/>
                </Canvas>

                <!-- Hero Content Grid -->
                <Grid Panel.ZIndex="1" Margin="14,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>   <!-- Column 0: 128x128 Large Art / Initials Tile -->
                        <ColumnDefinition Width="*"/>      <!-- Column 1: Track / Station Metadata -->
                        <ColumnDefinition Width="Auto"/>   <!-- Column 2: Transport & Preset Controls -->
                    </Grid.ColumnDefinitions>

                    <!-- Column 0: 128x128 Large Art Tile (Zune Style) -->
                    <Border Grid.Column="0" Width="128" Height="128" CornerRadius="8"
                            Background="#162032" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" Margin="0,0,18,0" ClipToBounds="True" VerticalAlignment="Center">
                        <Grid>
                            <Image x:Name="HeroCoverImage" Width="128" Height="128" Stretch="UniformToFill" Visibility="Collapsed"/>
                            <StackPanel x:Name="HeroFallbackPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Visible">
                                <ui:TextBlock x:Name="HeroIconText" Text="&#xE768;" FontFamily="Segoe Fluent Icons" FontSize="18"
                                           Foreground="{DynamicResource FluentBrand80}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                <ui:TextBlock x:Name="HeroInitialsText" Text="SS" FontFamily="Segoe UI Light" FontSize="44" FontWeight="Light"
                                           Foreground="White" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Column 1: Station Metadata + Status -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:TextBlock x:Name="HeroStationName" Text="No station selected"
                                       FontSize="30" FontFamily="Segoe UI Light" FontWeight="Light"
                                       Foreground="White" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <Border x:Name="HeroGenreBadge" Background="{DynamicResource FluentBrand80}"
                                    CornerRadius="4" Padding="8,2" Margin="14,0,0,0" VerticalAlignment="Center">
                                <ui:TextBlock x:Name="HeroGenreText" Text="Select Stream" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>

                        <ui:TextBlock x:Name="HeroStreamTitleText" Text="Click any radio tile below to tune in live..."
                                   FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>

                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <ui:TextBlock x:Name="HeroStatusDot" Text="&#xE71A;" FontFamily="Segoe Fluent Icons" FontSize="10"
                                       Foreground="{DynamicResource SystemFillColorCautionBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ui:TextBlock x:Name="HeroStatusText" Text="Ready to Play" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Column 2: Hero Transport & Visualizer Controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Play / Pause CTA -->
                        <ui:Button x:Name="HeroPlayBtn" Click="OnHeroPlayClicked" Appearance="Primary"
                                   Width="44" Height="44" CornerRadius="22" Padding="0" Margin="0,0,8,0" Cursor="Hand"
                                   ToolTip="Play / Pause" AutomationProperties.Name="Play or Pause Stream">
                            <ui:TextBlock x:Name="HeroPlayBtnText" Text="&#xE768;" FontFamily="Segoe Fluent Icons" FontSize="18"/>
                        </ui:Button>

                        <!-- Stop Button -->
                        <ui:Button x:Name="HeroStopBtn" Click="OnHeroStopClicked" Appearance="Secondary"
                                   Width="38" Height="38" Padding="0" Margin="0,0,12,0" Cursor="Hand"
                                   ToolTip="Stop Stream" AutomationProperties.Name="Stop Stream">
                            <ui:TextBlock Text="&#xE71A;" FontFamily="Segoe Fluent Icons" FontSize="14"/>
                        </ui:Button>

                        <!-- Visualizer Preset Selector -->
                        <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock Text="VISUALIZER" FontSize="9" FontWeight="Bold"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Margin="2,0,0,3"/>
                            <ComboBox x:Name="VisualizerComboBox"
                                      SelectionChanged="OnVisualizerComboSelectionChanged"
                                      MinWidth="140" MinHeight="36"
                                      VerticalContentAlignment="Center"
                                      Padding="10,0"
                                      FontSize="12" Cursor="Hand"
                                      ToolTip="Select visualizer preset"
                                      AutomationProperties.Name="Visualizer Preset">
                                <ComboBoxItem Content="Waveform" Tag="Waveform" IsSelected="True"/>
                                <ComboBoxItem Content="Spectrum Bars" Tag="SpectrumBars"/>
                                <ComboBoxItem Content="Pulse Ring" Tag="PulseRing"/>
                                <ComboBoxItem Content="Water Drop" Tag="WaterDrop"/>
                                <ComboBoxItem Content="Galaxy Drift" Tag="GalaxyDrift"/>
                                <ComboBoxItem Content="Frequency Bars" Tag="FrequencyBars"/>
                                <ComboBoxItem Content="Hero Mesh" Tag="HeroMesh"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Heavy Particles / FX Setting Toggle -->
                        <ui:Button x:Name="BtnToggleParticles" Click="OnToggleHeavyParticlesClicked" Appearance="Secondary"
                                   Padding="10,8" VerticalAlignment="Bottom" Height="36" Cursor="Hand"
                                   ToolTip="Toggle Heavy Particles &amp; Mars Symbols (CPU Saver)"
                                   AutomationProperties.Name="Toggle Heavy Visualizer Particles">
                            <StackPanel Orientation="Horizontal">
                                <ui:TextBlock x:Name="TxtParticleIcon" Text="&#xE7C5;" FontFamily="Segoe Fluent Icons" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <ui:TextBlock x:Name="TxtParticleState" Text="FX: Off" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ui:Button>
                    </StackPanel>
                </Grid>

                <!-- Bottom Edge Thin Accent Visualizer Line -->
                <Border VerticalAlignment="Bottom" Height="2" Background="{DynamicResource CardStrokeColorDefaultBrush}" HorizontalAlignment="Stretch"/>
            </Grid>
        </Border>

        <!-- Row 2: Genre Filter Tabs (Zune Pivot Style) -->
        <Border Grid.Row="2" Background="Transparent" Margin="0,0,0,12">
            <WrapPanel x:Name="FilterCategoryPanel" Orientation="Horizontal">
                <Border x:Name="TabAll" CornerRadius="4" Background="{DynamicResource FluentBrand80}" Margin="0,0,6,6" Padding="2">
                    <ui:Button Tag="ALL" Click="OnFilterClicked" Padding="12,6"
                            Background="Transparent" Foreground="White"
                            BorderThickness="0" FontFamily="Segoe UI Light" FontWeight="SemiBold" FontSize="13"
                            AutomationProperties.Name="Filter All Stations">
                        <ui:TextBlock Text="all stations" VerticalAlignment="Center"/>
                    </ui:Button>
                </Border>
                <Border x:Name="TabFav" CornerRadius="4" Background="Transparent" Margin="0,0,6,6" Padding="2">
                    <ui:Button Tag="FAV" Click="OnFilterClicked" Padding="12,6"
                            Background="Transparent" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            BorderThickness="0" FontFamily="Segoe UI Light" FontWeight="Normal" FontSize="13"
                            AutomationProperties.Name="Filter Favourite Stations">
                        <ui:TextBlock Text="favourites" VerticalAlignment="Center"/>
                    </ui:Button>
                </Border>
                <Border x:Name="TabFocus" CornerRadius="4" Background="Transparent" Margin="0,0,6,6" Padding="2">
                    <ui:Button Tag="FOCUS" Click="OnFilterClicked" Padding="12,6"
                            Background="Transparent" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            BorderThickness="0" FontFamily="Segoe UI Light" FontWeight="Normal" FontSize="13"
                            AutomationProperties.Name="Filter Focus Stations">
                        <ui:TextBlock Text="focus / lo-fi" VerticalAlignment="Center"/>
                    </ui:Button>
                </Border>
                <Border x:Name="TabPop" CornerRadius="4" Background="Transparent" Margin="0,0,6,6" Padding="2">
                    <ui:Button Tag="POP" Click="OnFilterClicked" Padding="12,6"
                            Background="Transparent" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            BorderThickness="0" FontFamily="Segoe UI Light" FontWeight="Normal" FontSize="13"
                            AutomationProperties.Name="Filter Pop Stations">
                        <ui:TextBlock Text="pop / hits" VerticalAlignment="Center"/>
                    </ui:Button>
                </Border>
                <Border x:Name="TabTalk" CornerRadius="4" Background="Transparent" Margin="0,0,6,6" Padding="2">
                    <ui:Button Tag="TALK" Click="OnFilterClicked" Padding="12,6"
                            Background="Transparent" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            BorderThickness="0" FontFamily="Segoe UI Light" FontWeight="Normal" FontSize="13"
                            AutomationProperties.Name="Filter Talk Stations">
                        <ui:TextBlock Text="talk / news" VerticalAlignment="Center"/>
                    </ui:Button>
                </Border>
                <Border x:Name="TabJazz" CornerRadius="4" Background="Transparent" Margin="0,0,6,6" Padding="2">
                    <ui:Button Tag="JAZZ" Click="OnFilterClicked" Padding="12,6"
                            Background="Transparent" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            BorderThickness="0" FontFamily="Segoe UI Light" FontWeight="Normal" FontSize="13"
                            AutomationProperties.Name="Filter Jazz Stations">
                        <ui:TextBlock Text="jazz / chill" VerticalAlignment="Center"/>
                    </ui:Button>
                </Border>
                <Border x:Name="TabCustom" CornerRadius="4" Background="Transparent" Margin="0,0,6,6" Padding="2">
                    <ui:Button Tag="CUSTOM" Click="OnFilterClicked" Padding="12,6"
                            Background="Transparent" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            BorderThickness="0" FontFamily="Segoe UI Light" FontWeight="Normal" FontSize="13"
                            AutomationProperties.Name="Filter Custom Stations">
                        <ui:TextBlock Text="custom" VerticalAlignment="Center"/>
                    </ui:Button>
                </Border>
            </WrapPanel>
        </Border>

        <!-- Row 3: Station Cover-Art Tile Grid -->
        <ScrollViewer Grid.Row="3" Margin="0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,12,16"
                      ScrollViewer.CanContentScroll="False" Background="Transparent"
                      PreviewMouseWheel="OnScrollViewerPreviewMouseWheel">
            <ItemsControl x:Name="StationItemsControl">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="200" Height="200" Margin="6" CornerRadius="8"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" ClipToBounds="True">
                            <Grid>
                                <!-- Cover Art (When local cover is cached) -->
                                <Image Source="{Binding LocalCoverPath}" Stretch="UniformToFill"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding HasLocalCover, Converter={StaticResource BoolToVisConverter}}"/>

                                <!-- Station Initials Fallback (When no cover is available) -->
                                <Grid Visibility="{Binding HasLocalCover, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                      Background="#101827">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,32">
                                        <ui:TextBlock Text="{Binding IconEmoji}" FontSize="22" HorizontalAlignment="Center" Margin="0,0,0,2" Opacity="0.8"/>
                                        <ui:TextBlock Text="{Binding Initials}" FontFamily="Segoe UI Light" FontSize="44" FontWeight="Light"
                                                   Foreground="{DynamicResource FluentBrand80}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Bottom Gradient Overlay with Metadata & Actions -->
                                <Border VerticalAlignment="Bottom" Height="82">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#00000000" Offset="0.0"/>
                                            <GradientStop Color="#88000000" Offset="0.30"/>
                                            <GradientStop Color="#EB060C16" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Grid Margin="10,0,10,8" VerticalAlignment="Bottom">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Station Name & Genre -->
                                        <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Bottom">
                                            <ui:TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="White"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                            <ui:TextBlock Text="{Binding Genre}" FontSize="11" Foreground="#94A3B8"
                                                       TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                        </StackPanel>

                                        <!-- Play Button (Round Accent) -->
                                        <ui:Button Grid.Row="0" Grid.Column="1" Click="OnStationPlayClicked" Tag="{Binding}"
                                                   Appearance="Primary" Width="32" Height="32" CornerRadius="16" Padding="0"
                                                   Cursor="Hand" ToolTip="Tune In" AutomationProperties.Name="Play Station"
                                                   VerticalAlignment="Bottom" Margin="6,0,0,0">
                                            <ui:TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </ui:Button>

                                        <!-- Action Row (Favorite, Edit, Delete) -->
                                        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,4,0,0">
                                            <ui:Button Click="OnStationFavoriteClicked" Tag="{Binding}"
                                                    Background="Transparent" BorderThickness="0"
                                                    Cursor="Hand" ToolTip="Toggle Favourite" AutomationProperties.Name="Toggle Favourite" Padding="4,2" Margin="0,0,4,0">
                                                <ui:TextBlock Text="{Binding FavIcon}" FontFamily="Segoe Fluent Icons"
                                                           FontSize="12" Foreground="{DynamicResource FluentBrand80}"/>
                                            </ui:Button>
                                            <ui:Button Click="OnStationEditClicked" Tag="{Binding}"
                                                    Background="Transparent" BorderThickness="0"
                                                    Cursor="Hand" ToolTip="Edit" AutomationProperties.Name="Edit Station" Padding="4,2" Margin="0,0,4,0">
                                                <ui:TextBlock Text="&#xE70F;" FontFamily="Segoe Fluent Icons"
                                                           FontSize="12" Foreground="#94A3B8"/>
                                            </ui:Button>
                                            <ui:Button Click="OnStationDeleteClicked" Tag="{Binding}"
                                                    Background="Transparent" BorderThickness="0"
                                                    Cursor="Hand" ToolTip="Remove" AutomationProperties.Name="Delete Station" Padding="4,2">
                                                <ui:TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons"
                                                           FontSize="12" Foreground="{DynamicResource SystemFillColorCriticalBrush}"/>
                                            </ui:Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Add / Edit Modal overlay -->
        <Grid x:Name="AddStationModal" Grid.RowSpan="4"
              Background="#99000000" Visibility="Collapsed">
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="12" Width="480" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <ui:TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons" FontSize="16"
                                       Foreground="{DynamicResource FluentBrand80}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ui:TextBlock x:Name="ModalTitleText" Text="Add Custom Radio Stream"
                                       FontSize="16" FontWeight="Bold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <ui:Button Click="OnCloseModalClicked" HorizontalAlignment="Right"
                                Background="Transparent"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                BorderThickness="0" Cursor="Hand" Padding="4"
                                AutomationProperties.Name="Close Modal">
                            <ui:TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="13"/>
                        </ui:Button>
                    </Grid>

                    <ui:TextBlock Text="Station Name" FontSize="11" FontWeight="Bold"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtStationName" Padding="8,6" Margin="0,0,0,12" FontSize="12"
                             Background="{DynamicResource TextControlBackground}"
                             Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

                    <ui:TextBlock Text="Stream URL" FontSize="11" FontWeight="Bold"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtStreamUrl" Grid.Column="0" Padding="8,6" FontSize="12" Text="https://"
                                 Background="{DynamicResource TextControlBackground}"
                                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <ui:Button Grid.Column="1" Appearance="Primary" Click="OnTestStreamClicked" Padding="12,0"
                                FontWeight="Bold" FontSize="11" Cursor="Hand" Margin="6,0,0,0"
                                AutomationProperties.Name="Test Stream URL">
                            <StackPanel Orientation="Horizontal">
                                <ui:TextBlock Text="&#xE945;" FontFamily="Segoe Fluent Icons" FontSize="11"
                                           Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <ui:TextBlock Text="Test" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ui:Button>
                    </Grid>
                    <Border x:Name="StreamTestBadge"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="4" Padding="8,4" Margin="0,0,0,12" Visibility="Collapsed">
                        <ui:TextBlock x:Name="StreamTestText" Text="Stream status" FontSize="10"
                                   FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </Border>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <ui:TextBlock Text="Genre" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CmbGenre" MinHeight="36" Padding="10,0" VerticalContentAlignment="Center" FontSize="12" IsEditable="True">
                                <ComboBoxItem Content="Focus / Lo-Fi" IsSelected="True"/>
                                <ComboBoxItem Content="Pop / Hits"/>
                                <ComboBoxItem Content="Talk / News"/>
                                <ComboBoxItem Content="Jazz / Chill"/>
                                <ComboBoxItem Content="Malay Pop"/>
                                <ComboBoxItem Content="Custom"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <ui:TextBlock Text="Emoji" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtEmoji" Text="" Padding="8,6"
                                     Width="56" TextAlignment="Center" FontSize="14"
                                     Background="{DynamicResource TextControlBackground}"
                                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        </StackPanel>
                    </Grid>

                    <ui:TextBlock Text="Description (Optional)" FontSize="11" FontWeight="Bold"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtDescription" Padding="8,6" Margin="0,0,0,20" FontSize="12"
                             Background="{DynamicResource TextControlBackground}"
                             Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:Button Appearance="Secondary" Click="OnCloseModalClicked" Content="Cancel" Padding="14,6" Margin="0,0,8,0" Cursor="Hand"
                                AutomationProperties.Name="Cancel Station Edit"/>
                        <ui:Button Appearance="Primary" Click="OnSaveCustomStationClicked" Content="Save Station" Padding="16,6"
                                FontWeight="Bold" Cursor="Hand"
                                AutomationProperties.Name="Save Custom Station"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
