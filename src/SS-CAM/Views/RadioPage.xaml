<Page x:Class="SS_CAM.Views.RadioPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:converters="clr-namespace:SS_CAM.Converters"
      Title="Radio Player">

    <Page.Resources>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
    </Page.Resources>

    <!-- Main Layout Grid -->
    <Grid Margin="24,20,24,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Row 0: Page Header -->
            <RowDefinition Height="Auto"/>   <!-- Row 1: Hero Featured Player Banner -->
            <RowDefinition Height="Auto"/>   <!-- Row 2: Genre Filter Tabs -->
            <RowDefinition Height="*"/>      <!-- Row 3: Station Cards Grid -->
        </Grid.RowDefinitions>

        <!-- Row 0: Page Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal">
                    <ui:TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons" FontSize="24"
                               Foreground="{DynamicResource FluentBrand80}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ui:TextBlock Text="Radio &amp; Focus Streams" FontSize="24" FontWeight="Bold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
                <ui:TextBlock Text="Click any station card to tune in live. Dedicated bottom player bar stays active across all pages."
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"
                           Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button Appearance="Secondary" Click="OnImportPlaylistClicked" Margin="0,0,8,0"
                        Padding="10,6" Cursor="Hand" ToolTip="Import .pls or .m3u" >
                    <StackPanel Orientation="Horizontal">
                        <ui:TextBlock Text="&#xE8B5;" FontFamily="Segoe Fluent Icons" FontSize="12"
                                   Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <ui:TextBlock Text="Import" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                </ui:Button>
                <ui:Button Appearance="Secondary" Click="OnResetDefaultsClicked" Margin="0,0,8,0"
                        Padding="10,6" Cursor="Hand" ToolTip="Reset to defaults" >
                    <StackPanel Orientation="Horizontal">
                        <ui:TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons" FontSize="12"
                                   Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <ui:TextBlock Text="Reset" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                </ui:Button>
                <ui:Button Appearance="Primary" Click="OnAddCustomStationClicked"
                        Padding="14,8" Cursor="Hand" ToolTip="Add a custom stream URL" >
                    <StackPanel Orientation="Horizontal">
                        <ui:TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons" FontSize="13"
                                   Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <ui:TextBlock Text="Add Stream" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </ui:Button>
            </StackPanel>
        </Grid>

        <!-- Row 1: ── TOP HERO FEATURED PLAYER BANNER (With SuamiSihat Hero Mesh Animation) ── -->
        <ui:Card Grid.Row="1" Padding="0" Margin="0,0,0,20"
                 Effect="{StaticResource FluentDepth4}"
                 ClipToBounds="True">
            <Border CornerRadius="12" ClipToBounds="True">
                <Grid x:Name="HeroMeshContainer">
                <!-- SuamiSihat Hero Mesh Backdrop Animation Layer (assets.suamisihat.myds.me visualizer hero) -->
                <Rectangle x:Name="HeroMeshAtmosphere">
                    <Rectangle.Fill>
                        <LinearGradientBrush x:Name="HeroMeshGrad" StartPoint="0,0" EndPoint="1,1">
                            <GradientStop x:Name="HeroMeshStop1" Color="#043388" Offset="0.0"/>
                            <GradientStop x:Name="HeroMeshStop2" Color="#1E2D5A" Offset="0.5"/>
                            <GradientStop x:Name="HeroMeshStop3" Color="#0C1535" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!-- Dynamic Pulsating Aura Glow Rings & SuamiSihat Men Icon Backdrop -->
                <Canvas IsHitTestVisible="False">
                    <!-- Glowing Azure Aura Ring -->
                    <Ellipse x:Name="AuraRing1" Width="260" Height="260" Canvas.Right="-60" Canvas.Top="-80" Opacity="0.45">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#21A1F7" Offset="0.0"/>
                                <GradientStop Color="#0021A1F7" Offset="1.0"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="AuraScale1" CenterX="130" CenterY="130" ScaleX="1.0" ScaleY="1.0"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>

                    <!-- Glowing Brand Yellow Aura Ring -->
                    <Ellipse x:Name="AuraRing2" Width="220" Height="220" Canvas.Left="-50" Canvas.Bottom="-70" Opacity="0.35">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#FCE53D" Offset="0.0"/>
                                <GradientStop Color="#00FCE53D" Offset="1.0"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="AuraScale2" CenterX="110" CenterY="110" ScaleX="1.0" ScaleY="1.0"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>

                    <!-- SuamiSihat Men Icon Backdrop Emblem (Pulsing with rhythm) -->
                    <Grid Canvas.Right="120" Canvas.Top="-15" Opacity="0.25" Width="120" Height="120">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="MenIconScale" CenterX="60" CenterY="60" ScaleX="1.0" ScaleY="1.0"/>
                        </Grid.RenderTransform>
                        <ui:TextBlock x:Name="HeroMenIcon" Text="&#xEC25;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="84" Foreground="#21A1F7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- SuamiSihat Logomark Watermark Typography -->
                    <ui:TextBlock Text="SUAMISIHAT" FontSize="32" FontWeight="Black" FontFamily="Segoe UI, Montserrat, sans-serif"
                               Foreground="#FFFFFF" Opacity="0.07" Canvas.Right="30" Canvas.Bottom="4"/>

                    <!-- Waveform Visualizer Path (for Waveform mode) -->
                    <Path x:Name="HeroWavePath" Stroke="#21A1F7" StrokeThickness="2.5" Opacity="0.8" Visibility="Collapsed"/>

                    <!-- Pulsating Energy Orb Container (for PulsatingOrb mode) -->
                    <Ellipse x:Name="HeroRhythmOrb" Width="90" Height="90" Canvas.Right="140" Canvas.Top="2" Visibility="Collapsed" Opacity="0.6">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#FCE53D" Offset="0.0"/>
                                <GradientStop Color="#21A1F7" Offset="0.6"/>
                                <GradientStop Color="#0021A1F7" Offset="1.0"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="OrbScale" CenterX="45" CenterY="45" ScaleX="1.0" ScaleY="1.0"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                </Canvas>

                <!-- Foreground Content Overlay -->
                <Grid Panel.ZIndex="1" Margin="18,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>   <!-- Cover Art / Logo -->
                        <ColumnDefinition Width="*"/>      <!-- Track / Station Metadata -->
                        <ColumnDefinition Width="Auto"/>   <!-- Hero Controls & Visualizer -->
                    </Grid.ColumnDefinitions>

                    <!-- Station Cover Art / Channel Logo -->
                    <Border Grid.Column="0" Width="56" Height="56" CornerRadius="12"
                            Background="#043388" Margin="0,0,16,0" VerticalAlignment="Center">
                        <Grid>
                            <ui:TextBlock x:Name="HeroIconText" Text="&#xE768;" FontFamily="Segoe Fluent Icons"
                                       FontSize="26" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.9"/>
                            <Image x:Name="HeroCoverImage" Stretch="UniformToFill" Visibility="Collapsed"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Grid>
                    </Border>

                    <!-- Station Metadata + Status -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <ui:TextBlock x:Name="HeroStationName" Text="No station selected"
                                       FontSize="16" FontWeight="Bold" Foreground="White"/>
                            <Border x:Name="HeroGenreBadge" Background="#21A1F7"
                                    CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <ui:TextBlock x:Name="HeroGenreText" Text="Select Stream" Foreground="White" FontSize="10" FontWeight="Bold"/>
                            </Border>
                            <!-- Visualizer Mode Badge -->
                            <Border x:Name="HeroVizBadge" Background="#00000000" BorderBrush="#21A1F7" BorderThickness="1"
                                    CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                <ui:TextBlock x:Name="HeroVizBadgeText" Text="VIZ: HERO MESH" Foreground="#21A1F7" FontSize="9" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                        
                        <ui:TextBlock x:Name="HeroStreamTitleText" Text="Click any radio card below to tune in live..."
                                   FontSize="12" Foreground="#E2E8F0"
                                   Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>

                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <ui:TextBlock x:Name="HeroStatusDot" Text="&#xE73E;" FontFamily="Segoe Fluent Icons" FontSize="10"
                                       Foreground="{DynamicResource SystemFillColorCautionBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <ui:TextBlock x:Name="HeroStatusText" Text="Ready" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Hero Transport Controls + Volume -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Equalizer bars (12 channels) -->
                        <StackPanel x:Name="VisualizerBars" Orientation="Horizontal" Margin="0,0,16,0" Height="28" VerticalAlignment="Center">
                            <Rectangle x:Name="Bar1" Width="3" Height="14" Fill="#21A1F7" Margin="1,0" VerticalAlignment="Bottom" RadiusX="1.5" RadiusY="1.5"/>
                            <Rectangle x:Name="Bar2" Width="3" Height="8"  Fill="#21A1F7" Margin="1,0" VerticalAlignment="Bottom" RadiusX="1.5" RadiusY="1.5"/>
                            <Rectangle x:Name="Bar3" Width="3" Height="22" Fill="#FCE53D" Margin="1,0" VerticalAlignment="Bottom" RadiusX="1.5" RadiusY="1.5"/>
                            <Rectangle x:Name="Bar4" Width="3" Height="12" Fill="#21A1F7" Margin="1,0" VerticalAlignment="Bottom" RadiusX="1.5" RadiusY="1.5"/>
                            <Rectangle x:Name="Bar5" Width="3" Height="18" Fill="#21A1F7" Margin="1,0" VerticalAlignment="Bottom" RadiusX="1.5" RadiusY="1.5"/>
                            <Rectangle x:Name="Bar6" Width="3" Height="10" Fill="#38BDF8" Margin="1,0" VerticalAlignment="Bottom" RadiusX="1.5" RadiusY="1.5"/>
                            <Rectangle x:Name="Bar7" Width="3" Height="24" Fill="#38BDF8" Margin="1,0" VerticalAlignment="Bottom" RadiusX="1.5" RadiusY="1.5"/>
                            <Rectangle x:Name="Bar8" Width="3" Height="16" Fill="#FCE53D" Margin="1,0" VerticalAlignment="Bottom" RadiusX="1.5" RadiusY="1.5"/>
                            <Rectangle x:Name="Bar9" Width="3" Height="20" Fill="#21A1F7" Margin="1,0" VerticalAlignment="Bottom" RadiusX="1.5" RadiusY="1.5"/>
                            <Rectangle x:Name="Bar10" Width="3" Height="14" Fill="#21A1F7" Margin="1,0" VerticalAlignment="Bottom" RadiusX="1.5" RadiusY="1.5"/>
                            <Rectangle x:Name="Bar11" Width="3" Height="8"  Fill="#38BDF8" Margin="1,0" VerticalAlignment="Bottom" RadiusX="1.5" RadiusY="1.5"/>
                            <Rectangle x:Name="Bar12" Width="3" Height="22" Fill="#FCE53D" Margin="1,0" VerticalAlignment="Bottom" RadiusX="1.5" RadiusY="1.5"/>
                        </StackPanel>

                        <!-- Play / Pause CTA -->
                        <ui:Button x:Name="HeroPlayBtn" Click="OnHeroPlayClicked" Appearance="Primary"
                                   Width="42" Height="42" CornerRadius="21" Padding="0" Margin="0,0,8,0" Cursor="Hand" ToolTip="Play / Pause">
                            <ui:TextBlock x:Name="HeroPlayBtnText" Text="&#xE768;" FontFamily="Segoe Fluent Icons" FontSize="18"/>
                        </ui:Button>

                        <!-- Stop Button -->
                        <ui:Button x:Name="HeroStopBtn" Click="OnHeroStopClicked" Appearance="Secondary"
                                   Width="36" Height="36" Padding="0" Margin="0,0,12,0" Cursor="Hand" ToolTip="Stop Stream">
                            <ui:TextBlock Text="&#xE71A;" FontFamily="Segoe Fluent Icons" FontSize="14"/>
                        </ui:Button>

                        <!-- Volume -->
                        <ui:Button x:Name="HeroMuteBtn" Click="OnHeroMuteClicked" Appearance="Secondary"
                                   Width="30" Height="30" Padding="0" Margin="0,0,6,0" Cursor="Hand" ToolTip="Mute / Unmute">
                            <ui:TextBlock x:Name="HeroMuteIcon" Text="&#xE767;" FontFamily="Segoe Fluent Icons" FontSize="13"/>
                        </ui:Button>
                        <Slider x:Name="HeroVolumeSlider" Width="90" Minimum="0" Maximum="100" Value="80"
                                ValueChanged="OnHeroVolumeChanged" VerticalAlignment="Center" ToolTip="Volume"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </ui:Card>

        <!-- Row 2: Genre Filter Tabs -->
        <ui:Card Grid.Row="2" Padding="6" Margin="0,0,0,16">
                <WrapPanel x:Name="FilterCategoryPanel">
                    <Border x:Name="TabAll" CornerRadius="6" Background="{DynamicResource FluentBrand80}" Margin="2">
                        <ui:Button Tag="ALL" Click="OnFilterClicked" Padding="12,6"
                                Background="Transparent" Foreground="White"
                                BorderThickness="0" FontWeight="Bold" FontSize="11"
                                >
                            <StackPanel Orientation="Horizontal">
                                <ui:TextBlock Text="&#xE8FD;" FontFamily="Segoe Fluent Icons" FontSize="11"
                                           Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <ui:TextBlock Text="All" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ui:Button>
                    </Border>
                    <Border x:Name="TabFav" CornerRadius="6" Background="Transparent" Margin="2">
                        <ui:Button Tag="FAV" Click="OnFilterClicked" Padding="12,6"
                                Background="Transparent" Foreground="{DynamicResource FluentLightTextSecondary}"
                                BorderThickness="0" FontWeight="SemiBold" FontSize="11"
                                >
                            <StackPanel Orientation="Horizontal">
                                <ui:TextBlock Text="&#xE734;" FontFamily="Segoe Fluent Icons" FontSize="11"
                                           Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <ui:TextBlock Text="Favourites" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ui:Button>
                    </Border>
                    <Border x:Name="TabFocus" CornerRadius="6" Background="Transparent" Margin="2">
                        <ui:Button Tag="FOCUS" Click="OnFilterClicked" Padding="12,6"
                                Background="Transparent" Foreground="{DynamicResource FluentLightTextSecondary}"
                                BorderThickness="0" FontWeight="SemiBold" FontSize="11"
                                >
                            <StackPanel Orientation="Horizontal">
                                <ui:TextBlock Text="&#xE7C3;" FontFamily="Segoe Fluent Icons" FontSize="11"
                                           Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <ui:TextBlock Text="Focus / Lo-Fi" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ui:Button>
                    </Border>
                    <Border x:Name="TabPop" CornerRadius="6" Background="Transparent" Margin="2">
                        <ui:Button Tag="POP" Click="OnFilterClicked" Padding="12,6"
                                Background="Transparent" Foreground="{DynamicResource FluentLightTextSecondary}"
                                BorderThickness="0" FontWeight="SemiBold" FontSize="11"
                                >
                            <StackPanel Orientation="Horizontal">
                                <ui:TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons" FontSize="11"
                                           Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <ui:TextBlock Text="Pop / Hits" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ui:Button>
                    </Border>
                    <Border x:Name="TabTalk" CornerRadius="6" Background="Transparent" Margin="2">
                        <ui:Button Tag="TALK" Click="OnFilterClicked" Padding="12,6"
                                Background="Transparent" Foreground="{DynamicResource FluentLightTextSecondary}"
                                BorderThickness="0" FontWeight="SemiBold" FontSize="11"
                                >
                            <StackPanel Orientation="Horizontal">
                                <ui:TextBlock Text="&#xE8D4;" FontFamily="Segoe Fluent Icons" FontSize="11"
                                           Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <ui:TextBlock Text="Talk / News" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ui:Button>
                    </Border>
                    <Border x:Name="TabJazz" CornerRadius="6" Background="Transparent" Margin="2">
                        <ui:Button Tag="JAZZ" Click="OnFilterClicked" Padding="12,6"
                                Background="Transparent" Foreground="{DynamicResource FluentLightTextSecondary}"
                                BorderThickness="0" FontWeight="SemiBold" FontSize="11"
                                >
                            <StackPanel Orientation="Horizontal">
                                <ui:TextBlock Text="&#xEC4F;" FontFamily="Segoe Fluent Icons" FontSize="11"
                                           Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <ui:TextBlock Text="Jazz / Chill" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ui:Button>
                    </Border>
                    <Border x:Name="TabCustom" CornerRadius="6" Background="Transparent" Margin="2">
                        <ui:Button Tag="CUSTOM" Click="OnFilterClicked" Padding="12,6"
                                Background="Transparent" Foreground="{DynamicResource FluentLightTextSecondary}"
                                BorderThickness="0" FontWeight="SemiBold" FontSize="11"
                                >
                            <StackPanel Orientation="Horizontal">
                                <ui:TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons" FontSize="11"
                                           Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <ui:TextBlock Text="Custom" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ui:Button>
                    </Border>
                </WrapPanel>
            </ui:Card>

            <!-- Station Cards (3-column, scrollable) -->
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="False" Background="Transparent" PreviewMouseWheel="OnScrollViewerPreviewMouseWheel">
                <ItemsControl x:Name="StationItemsControl">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3" VerticalAlignment="Top"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:Card Margin="5" Padding="0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="54"/>   <!-- Cover strip -->
                                        <RowDefinition Height="Auto"/>  <!-- Meta -->
                                        <RowDefinition Height="Auto"/>  <!-- Actions -->
                                    </Grid.RowDefinitions>

                                    <!-- Cover art strip -->
                                    <Border Grid.Row="0" CornerRadius="10,10,0,0"
                                            Background="{DynamicResource FluentLightCardSubBg}"
                                            ClipToBounds="True">
                                        <Grid>
                                            <ui:TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons"
                                                       FontSize="22" Opacity="0.25"
                                                       Foreground="{DynamicResource FluentBrand80}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Image Source="{Binding CoverImageUrl}" Stretch="UniformToFill"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Grid>
                                    </Border>

                                    <!-- Name + Genre + Description -->
                                    <StackPanel Grid.Row="1" Margin="12,8,12,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ui:TextBlock Grid.Column="0" Text="{Binding Name}"
                                                       FontWeight="Bold" FontSize="13"
                                                       Foreground="{DynamicResource FluentLightTextPrimary}"
                                                       
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"/>
                                            <Border Grid.Column="1" Background="{DynamicResource FluentBrandLight}"
                                                    CornerRadius="4" Padding="5,1" VerticalAlignment="Center" Margin="4,0,0,0">
                                                <ui:TextBlock Text="{Binding Genre}"
                                                           Foreground="{DynamicResource FluentBrand80}"
                                                           FontSize="9" FontWeight="Bold"
                                                           />
                                            </Border>
                                        </Grid>
                                        <ui:TextBlock Text="{Binding Description}"
                                                   Foreground="{DynamicResource FluentLightTextSecondary}"
                                                   FontSize="10" Margin="0,3,0,0"
                                                   TextTrimming="CharacterEllipsis"
                                                   />
                                    </StackPanel>

                                    <!-- Action row -->
                                    <Border Grid.Row="2"
                                            BorderBrush="{DynamicResource FluentLightStroke}"
                                            BorderThickness="0,1,0,0"
                                            Padding="8,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- Favourite + Edit -->
                                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                <ui:Button Click="OnStationFavoriteClicked" Tag="{Binding}"
                                                        Background="Transparent" BorderThickness="0"
                                                        Cursor="Hand" ToolTip="Toggle Favourite" Padding="4">
                                                    <ui:TextBlock Text="{Binding FavIcon}" FontFamily="Segoe Fluent Icons"
                                                               FontSize="14" Foreground="{DynamicResource FluentBrand80}"/>
                                                </ui:Button>
                                                <ui:Button Click="OnStationEditClicked" Tag="{Binding}"
                                                        Background="Transparent" BorderThickness="0"
                                                        Cursor="Hand" ToolTip="Edit" Padding="4">
                                                    <ui:TextBlock Text="&#xE70F;" FontFamily="Segoe Fluent Icons"
                                                               FontSize="13" Foreground="{DynamicResource FluentLightTextSecondary}"/>
                                                </ui:Button>
                                            </StackPanel>
                                            <!-- Play button (primary, centred) -->
                                            <Border Grid.Column="1" HorizontalAlignment="Center"
                                                    Width="32" Height="32" CornerRadius="16"
                                                    Background="{DynamicResource FluentBrand80}">
                                                <ui:Button Click="OnStationPlayClicked" Tag="{Binding}"
                                                        Background="Transparent" Foreground="White"
                                                        BorderThickness="0" Cursor="Hand" ToolTip="Tune In">
                                                    <ui:TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons"
                                                               FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </ui:Button>
                                            </Border>
                                            <!-- Delete -->
                                            <ui:Button Grid.Column="2" Click="OnStationDeleteClicked" Tag="{Binding}"
                                                    Background="Transparent" Foreground="#EF4444"
                                                    BorderThickness="0" Cursor="Hand" ToolTip="Remove" Padding="4">
                                                <ui:TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons" FontSize="13"/>
                                            </ui:Button>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </ui:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Add / Edit Modal overlay -->
            <Grid x:Name="AddStationModal" Grid.RowSpan="3"
                  Background="#80000000" Visibility="Collapsed">
                <Border Background="{DynamicResource FluentLightCardBg}"
                        CornerRadius="12" Width="480" Padding="24"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        BorderBrush="{DynamicResource FluentLightStroke}" BorderThickness="1">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal">
                                <ui:TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons" FontSize="16"
                                           Foreground="{DynamicResource FluentBrand80}"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ui:TextBlock x:Name="ModalTitleText" Text="Add Custom Radio Stream"
                                           FontSize="16" FontWeight="Bold"
                                           Foreground="{DynamicResource FluentBrand80}"
                                           VerticalAlignment="Center"
                                           />
                            </StackPanel>
                            <ui:Button Click="OnCloseModalClicked" HorizontalAlignment="Right"
                                    Background="Transparent"
                                    Foreground="{DynamicResource FluentLightTextSecondary}"
                                    BorderThickness="0" Cursor="Hand" Padding="4">
                                <ui:TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="13"/>
                            </ui:Button>
                        </Grid>

                        <ui:TextBlock Text="Station Name" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource FluentLightTextSecondary}" Margin="0,0,0,4"
                                   />
                        <TextBox x:Name="TxtStationName" Padding="8,6" Margin="0,0,0,12" FontSize="12"/>

                        <ui:TextBlock Text="Stream URL" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource FluentLightTextSecondary}" Margin="0,0,0,4"
                                   />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtStreamUrl" Grid.Column="0" Padding="8,6" FontSize="12" Text="https://"/>
                            <ui:Button Grid.Column="1" Appearance="Primary" Click="OnTestStreamClicked" Padding="10,0"
                                    FontWeight="Bold" FontSize="11" Cursor="Hand" Margin="6,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <ui:TextBlock Text="&#xE945;" FontFamily="Segoe Fluent Icons" FontSize="11"
                                               Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <ui:TextBlock Text="Test" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ui:Button>
                        </Grid>
                        <Border x:Name="StreamTestBadge"
                                Background="{DynamicResource FluentLightCardSubBg}"
                                CornerRadius="4" Padding="8,4" Margin="0,0,0,12" Visibility="Collapsed">
                            <ui:TextBlock x:Name="StreamTestText" Text="Stream status" FontSize="10"
                                       FontWeight="SemiBold" TextWrapping="Wrap"
                                       />
                        </Border>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <ui:TextBlock Text="Genre" FontSize="11" FontWeight="Bold"
                                           Foreground="{DynamicResource FluentLightTextSecondary}" Margin="0,0,0,4"
                                           />
                                <ComboBox x:Name="CmbGenre" Padding="8,6" FontSize="12" IsEditable="True">
                                    <ComboBoxItem Content="Focus / Lo-Fi" IsSelected="True"/>
                                    <ComboBoxItem Content="Pop / Hits"/>
                                    <ComboBoxItem Content="Talk / News"/>
                                    <ComboBoxItem Content="Jazz / Chill"/>
                                    <ComboBoxItem Content="Malay Pop"/>
                                    <ComboBoxItem Content="Custom"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <ui:TextBlock Text="Emoji" FontSize="11" FontWeight="Bold"
                                           Foreground="{DynamicResource FluentLightTextSecondary}" Margin="0,0,0,4"
                                           />
                                <TextBox x:Name="TxtEmoji" Text="" Padding="8,6"
                                         Width="56" TextAlignment="Center" FontSize="14"/>
                            </StackPanel>
                        </Grid>

                        <ui:TextBlock Text="Description (Optional)" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource FluentLightTextSecondary}" Margin="0,0,0,4"
                                   />
                        <TextBox x:Name="TxtDescription" Padding="8,6" Margin="0,0,0,20" FontSize="12"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <ui:Button Appearance="Secondary" Click="OnCloseModalClicked" Content="Cancel" Padding="14,6" Margin="0,0,8,0" Cursor="Hand"/>
                            <ui:Button Appearance="Primary" Click="OnSaveCustomStationClicked" Content="Save Station" Padding="16,6"
                                    FontWeight="Bold" Cursor="Hand" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
</Page>

