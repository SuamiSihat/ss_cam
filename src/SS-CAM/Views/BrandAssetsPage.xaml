<Page x:Class="SS_CAM.Views.BrandAssetsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Brand Assets">

    <Page.Resources>
        <Style x:Key="InteractiveCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#21A1F7"/>
                    <Setter Property="Background" Value="#F8FAFC"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>
            <!-- Header -->
            <StackPanel Margin="0,0,0,24">
                <TextBlock Text="SuamiSihat Official Brand System &amp; Color Palettes" FontSize="26" FontWeight="Bold" Foreground="#043388"/>
                <TextBlock Text="Official brand color codes (HEX, RGB, CMYK, Pantone), installed color swatches, Adobe/Affinity design asset libraries, and internal brand portals." Foreground="#64748B" FontSize="13" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Quick Portals & Links -->
            <GroupBox Header="Brand Portals &amp; Shortcuts" Margin="0,0,0,20">
                <UniformGrid Columns="3" Margin="8">
                    <Border Background="#EFF6FF" BorderBrush="#21A1F7" BorderThickness="1" CornerRadius="6" Padding="16" Margin="6" Cursor="Hand" MouseLeftButtonDown="OnOpenServiceDashboard">
                        <StackPanel>
                            <TextBlock Text="🌐 Service Dashboard" FontWeight="Bold" Foreground="#043388" FontSize="14"/>
                            <TextBlock Text="https://suamisihat.myds.me" Foreground="#21A1F7" FontSize="11" FontWeight="SemiBold" Margin="0,2,0,4"/>
                            <TextBlock Text="SuamiSihat internal design work orders and service portal." Foreground="#64748B" FontSize="11"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#EFF6FF" BorderBrush="#21A1F7" BorderThickness="1" CornerRadius="6" Padding="16" Margin="6" Cursor="Hand" MouseLeftButtonDown="OnOpenInternalAssets">
                        <StackPanel>
                            <TextBlock Text="📁 SS Design System" FontWeight="Bold" Foreground="#043388" FontSize="14"/>
                            <TextBlock Text="https://assets.suamisihat.myds.me/" Foreground="#21A1F7" FontSize="11" FontWeight="SemiBold" Margin="0,2,0,4"/>
                            <TextBlock Text="Internal brand guideline for the design team." Foreground="#64748B" FontSize="11"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#EFF6FF" BorderBrush="#21A1F7" BorderThickness="1" CornerRadius="6" Padding="16" Margin="6" Cursor="Hand" MouseLeftButtonDown="OnOpenPublicAssets">
                        <StackPanel>
                            <TextBlock Text="📦 Public Brand Kits" FontWeight="Bold" Foreground="#043388" FontSize="14"/>
                            <TextBlock Text="https://suamisihat.com.my/brand-assets" Foreground="#21A1F7" FontSize="11" FontWeight="SemiBold" Margin="0,2,0,4"/>
                            <TextBlock Text="External brand guidelines, press kit, and logo packages." Foreground="#64748B" FontSize="11"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </GroupBox>

            <!-- Status Banner -->
            <TextBlock x:Name="CopyStatusText" Text="Click any color swatch below to copy its HEX color code to your clipboard." Foreground="#21A1F7" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,14"/>

            <!-- Primary Colour Palette -->
            <GroupBox Header="Primary Colour Palette" Margin="0,0,0,20">
                <WrapPanel Margin="4">
                    <!-- SS Prussian Blue -->
                    <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Width="200" Padding="12" Margin="6" Cursor="Hand" MouseLeftButtonDown="OnSwatchClicked" Tag="#022057|2, 32, 87|98, 63, 0, 66|281 C|SS Prussian Blue">
                        <StackPanel>
                            <Border Height="65" Background="#022057" CornerRadius="4" Margin="0,0,0,10"/>
                            <TextBlock Text="SS Prussian Blue" FontWeight="Bold" FontSize="14" Foreground="#043388"/>
                            <TextBlock Text="HEX: #022057" FontWeight="Bold" FontSize="12" Margin="0,4,0,0"/>
                            <TextBlock Text="RGB: 2, 32, 87" Foreground="#64748B" FontSize="11"/>
                            <TextBlock Text="CMYK: 98, 63, 0, 66" Foreground="#64748B" FontSize="11"/>
                            <TextBlock Text="Pantone: 281 C" Foreground="#64748B" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <!-- SS Blue -->
                    <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Width="200" Padding="12" Margin="6" Cursor="Hand" MouseLeftButtonDown="OnSwatchClicked" Tag="#043388|4, 51, 136|97, 63, 0, 47|287 C|SS Blue">
                        <StackPanel>
                            <Border Height="65" Background="#043388" CornerRadius="4" Margin="0,0,0,10"/>
                            <TextBlock Text="SS Blue" FontWeight="Bold" FontSize="14" Foreground="#043388"/>
                            <TextBlock Text="HEX: #043388" FontWeight="Bold" FontSize="12" Margin="0,4,0,0"/>
                            <TextBlock Text="RGB: 4, 51, 136" Foreground="#64748B" FontSize="11"/>
                            <TextBlock Text="CMYK: 97, 63, 0, 47" Foreground="#64748B" FontSize="11"/>
                            <TextBlock Text="Pantone: 287 C" Foreground="#64748B" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <!-- Azure -->
                    <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Width="200" Padding="12" Margin="6" Cursor="Hand" MouseLeftButtonDown="OnSwatchClicked" Tag="#21A1F7|33, 161, 247|87, 35, 0, 3|299 C|Azure">
                        <StackPanel>
                            <Border Height="65" Background="#21A1F7" CornerRadius="4" Margin="0,0,0,10"/>
                            <TextBlock Text="Azure" FontWeight="Bold" FontSize="14" Foreground="#043388"/>
                            <TextBlock Text="HEX: #21A1F7" FontWeight="Bold" FontSize="12" Margin="0,4,0,0"/>
                            <TextBlock Text="RGB: 33, 161, 247" Foreground="#64748B" FontSize="11"/>
                            <TextBlock Text="CMYK: 87, 35, 0, 3" Foreground="#64748B" FontSize="11"/>
                            <TextBlock Text="Pantone: 299 C" Foreground="#64748B" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <!-- Malibu -->
                    <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Width="200" Padding="12" Margin="6" Cursor="Hand" MouseLeftButtonDown="OnSwatchClicked" Tag="#6DC6EC|109, 198, 236|54, 16, 0, 7|297 C|Malibu">
                        <StackPanel>
                            <Border Height="65" Background="#6DC6EC" CornerRadius="4" Margin="0,0,0,10"/>
                            <TextBlock Text="Malibu" FontWeight="Bold" FontSize="14" Foreground="#043388"/>
                            <TextBlock Text="HEX: #6DC6EC" FontWeight="Bold" FontSize="12" Margin="0,4,0,0"/>
                            <TextBlock Text="RGB: 109, 198, 236" Foreground="#64748B" FontSize="11"/>
                            <TextBlock Text="CMYK: 54, 16, 0, 7" Foreground="#64748B" FontSize="11"/>
                            <TextBlock Text="Pantone: 297 C" Foreground="#64748B" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </GroupBox>

            <!-- Secondary Colour Palette -->
            <GroupBox Header="Secondary Colour Palette" Margin="0,0,0,20">
                <WrapPanel Margin="4">
                    <!-- Lion -->
                    <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Width="200" Padding="12" Margin="6" Cursor="Hand" MouseLeftButtonDown="OnSwatchClicked" Tag="#BD9A73|189, 154, 115|0, 19, 39, 26|4655 C|Lion">
                        <StackPanel>
                            <Border Height="65" Background="#BD9A73" CornerRadius="4" Margin="0,0,0,10"/>
                            <TextBlock Text="Lion" FontWeight="Bold" FontSize="14" Foreground="#043388"/>
                            <TextBlock Text="HEX: #BD9A73" FontWeight="Bold" FontSize="12" Margin="0,4,0,0"/>
                            <TextBlock Text="RGB: 189, 154, 115" Foreground="#64748B" FontSize="11"/>
                            <TextBlock Text="CMYK: 0, 19, 39, 26" Foreground="#64748B" FontSize="11"/>
                            <TextBlock Text="Pantone: 4655 C" Foreground="#64748B" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <!-- Fawn -->
                    <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Width="200" Padding="12" Margin="6" Cursor="Hand" MouseLeftButtonDown="OnSwatchClicked" Tag="#CCAC8D|204, 172, 141|0, 16, 31, 20|4665 C|Fawn">
                        <StackPanel>
                            <Border Height="65" Background="#CCAC8D" CornerRadius="4" Margin="0,0,0,10"/>
                            <TextBlock Text="Fawn" FontWeight="Bold" FontSize="14" Foreground="#043388"/>
                            <TextBlock Text="HEX: #CCAC8D" FontWeight="Bold" FontSize="12" Margin="0,4,0,0"/>
                            <TextBlock Text="RGB: 204, 172, 141" Foreground="#64748B" FontSize="11"/>
                            <TextBlock Text="CMYK: 0, 16, 31, 20" Foreground="#64748B" FontSize="11"/>
                            <TextBlock Text="Pantone: 4665 C" Foreground="#64748B" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <!-- Arylide Yellow -->
                    <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Width="200" Padding="12" Margin="6" Cursor="Hand" MouseLeftButtonDown="OnSwatchClicked" Tag="#E5D15C|229, 209, 92|0, 9, 60, 10|108 C|Arylide Yellow">
                        <StackPanel>
                            <Border Height="65" Background="#E5D15C" CornerRadius="4" Margin="0,0,0,10"/>
                            <TextBlock Text="Arylide Yellow" FontWeight="Bold" FontSize="14" Foreground="#043388"/>
                            <TextBlock Text="HEX: #E5D15C" FontWeight="Bold" FontSize="12" Margin="0,4,0,0"/>
                            <TextBlock Text="RGB: 229, 209, 92" Foreground="#64748B" FontSize="11"/>
                            <TextBlock Text="CMYK: 0, 9, 60, 10" Foreground="#64748B" FontSize="11"/>
                            <TextBlock Text="Pantone: 108 C" Foreground="#64748B" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <!-- Banana Yellow -->
                    <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Width="200" Padding="12" Margin="6" Cursor="Hand" MouseLeftButtonDown="OnSwatchClicked" Tag="#FCE53D|252, 229, 61|0, 9, 76, 1|102 C|Banana Yellow">
                        <StackPanel>
                            <Border Height="65" Background="#FCE53D" CornerRadius="4" Margin="0,0,0,10"/>
                            <TextBlock Text="Banana Yellow" FontWeight="Bold" FontSize="14" Foreground="#043388"/>
                            <TextBlock Text="HEX: #FCE53D" FontWeight="Bold" FontSize="12" Margin="0,4,0,0"/>
                            <TextBlock Text="RGB: 252, 229, 61" Foreground="#64748B" FontSize="11"/>
                            <TextBlock Text="CMYK: 0, 9, 76, 1" Foreground="#64748B" FontSize="11"/>
                            <TextBlock Text="Pantone: 102 C" Foreground="#64748B" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </GroupBox>

            <!-- Neutrals Colour Palette -->
            <GroupBox Header="Neutrals Colour Palette" Margin="0,0,0,20">
                <WrapPanel Margin="4">
                    <!-- Black -->
                    <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Width="145" Padding="10" Margin="4" Cursor="Hand" MouseLeftButtonDown="OnSwatchClicked" Tag="#000000|0, 0, 0|0, 0, 0, 100|Black C|Black">
                        <StackPanel>
                            <Border Height="45" Background="#000000" CornerRadius="4" Margin="0,0,0,8"/>
                            <TextBlock Text="Black" FontWeight="Bold" FontSize="12" Foreground="#043388"/>
                            <TextBlock Text="#000000" FontSize="11" FontWeight="SemiBold" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Grey 20 -->
                    <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Width="145" Padding="10" Margin="4" Cursor="Hand" MouseLeftButtonDown="OnSwatchClicked" Tag="#CCCCCC|204, 204, 204|0, 0, 0, 20|Cool Gray 2 C|Grey 20">
                        <StackPanel>
                            <Border Height="45" Background="#CCCCCC" CornerRadius="4" Margin="0,0,0,8"/>
                            <TextBlock Text="Grey 20" FontWeight="Bold" FontSize="12" Foreground="#043388"/>
                            <TextBlock Text="#CCCCCC" FontSize="11" FontWeight="SemiBold" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Grey 40 -->
                    <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Width="145" Padding="10" Margin="4" Cursor="Hand" MouseLeftButtonDown="OnSwatchClicked" Tag="#999999|153, 153, 153|0, 0, 0, 40|Cool Gray 4 C|Grey 40">
                        <StackPanel>
                            <Border Height="45" Background="#999999" CornerRadius="4" Margin="0,0,0,8"/>
                            <TextBlock Text="Grey 40" FontWeight="Bold" FontSize="12" Foreground="#043388"/>
                            <TextBlock Text="#999999" FontSize="11" FontWeight="SemiBold" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Grey 60 -->
                    <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Width="145" Padding="10" Margin="4" Cursor="Hand" MouseLeftButtonDown="OnSwatchClicked" Tag="#666666|102, 102, 102|0, 0, 0, 60|430 C|Grey 60">
                        <StackPanel>
                            <Border Height="45" Background="#666666" CornerRadius="4" Margin="0,0,0,8"/>
                            <TextBlock Text="Grey 60" FontWeight="Bold" FontSize="12" Foreground="#043388"/>
                            <TextBlock Text="#666666" FontSize="11" FontWeight="SemiBold" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Grey 80 -->
                    <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Width="145" Padding="10" Margin="4" Cursor="Hand" MouseLeftButtonDown="OnSwatchClicked" Tag="#575756|87, 87, 86|0, 0, 1, 66|431 C|Grey 80">
                        <StackPanel>
                            <Border Height="45" Background="#575756" CornerRadius="4" Margin="0,0,0,8"/>
                            <TextBlock Text="Grey 80" FontWeight="Bold" FontSize="12" Foreground="#043388"/>
                            <TextBlock Text="#575756" FontSize="11" FontWeight="SemiBold" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Grey 90 -->
                    <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Width="145" Padding="10" Margin="4" Cursor="Hand" MouseLeftButtonDown="OnSwatchClicked" Tag="#333333|51, 51, 51|0, 0, 0, 80|Dark Gray|Grey 90">
                        <StackPanel>
                            <Border Height="45" Background="#333333" CornerRadius="4" Margin="0,0,0,8"/>
                            <TextBlock Text="Grey 90" FontWeight="Bold" FontSize="12" Foreground="#043388"/>
                            <TextBlock Text="#333333" FontSize="11" FontWeight="SemiBold" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- White -->
                    <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Width="145" Padding="10" Margin="4" Cursor="Hand" MouseLeftButtonDown="OnSwatchClicked" Tag="#FFFFFF|255, 255, 255|0, 0, 0, 0|White|White">
                        <StackPanel>
                            <Border Height="45" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Margin="0,0,0,8"/>
                            <TextBlock Text="White" FontWeight="Bold" FontSize="12" Foreground="#043388"/>
                            <TextBlock Text="#FFFFFF" FontSize="11" FontWeight="SemiBold" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </GroupBox>

            <!-- 3 Brand Asset Packages Cards (v1.9.10) -->
            <GroupBox Header="Official Brand Assets Packages" Margin="0,0,0,20">
                <UniformGrid Columns="3" Margin="4">
                    <!-- Card 1: Colour Palettes -->
                    <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="16" Margin="6">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Bottom" Content="🎨 Open Palettes Folder" Click="OnOpenPalettesFolder" Background="#EFF6FF" Foreground="#043388" BorderBrush="#21A1F7" BorderThickness="1" Height="36" Padding="10,0" FontWeight="Bold"/>
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="🎨 Colour Palettes" FontSize="16" FontWeight="Bold" Foreground="#043388"/>
                                <TextBlock Text="Installed .afpalette, ASE swatches, and hex guidelines for Affinity Designer &amp; Adobe CC." Foreground="#64748B" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Card 2: Logos & Vector Package -->
                    <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="16" Margin="6">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Bottom" Content="🏷️ Open Logos Package" Click="OnOpenLogosFolder" Background="#EFF6FF" Foreground="#043388" BorderBrush="#21A1F7" BorderThickness="1" Height="36" Padding="10,0" FontWeight="Bold"/>
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="🏷️ Logos &amp; Vectors" FontSize="16" FontWeight="Bold" Foreground="#043388"/>
                                <TextBlock Text="Master SuamiSihat &amp; sub-brand logos in SVG, PNG, EPS, and AI formats (Light/Dark variants)." Foreground="#64748B" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Card 3: Asset Libraries -->
                    <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="16" Margin="6">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Bottom" Content="📦 Open Libraries Folder" Click="OnOpenLibrariesFolder" Background="#EFF6FF" Foreground="#043388" BorderBrush="#21A1F7" BorderThickness="1" Height="36" Padding="10,0" FontWeight="Bold"/>
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="📦 Asset Libraries" FontSize="16" FontWeight="Bold" Foreground="#043388"/>
                                <TextBlock Text="Pre-packaged .afassets and .cclibs drag-and-drop design component libraries." Foreground="#64748B" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </UniformGrid>
            </GroupBox>

            <!-- Design Asset Libraries, Fonts & Workstation Payload Installer -->
            <GroupBox Header="Workstation Payload &amp; Brand Assets Installer" Margin="0,0,0,20">
                <StackPanel Margin="8">
                    <TextBlock Text="Install bundled brand fonts into Windows, deploy Affinity/Adobe asset libraries, or create desktop shortcuts." Foreground="#64748B" FontSize="12" Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="🔤 Install Brand Fonts" Click="OnInstallFontsClicked" Background="#043388" Foreground="White" Height="36" Padding="14,0" Margin="0,0,10,0" FontWeight="Bold"/>
                        <Button Content="📦 Deploy Asset Libraries" Click="OnDeployAssetsClicked" Background="#043388" Foreground="White" Height="36" Padding="14,0" Margin="0,0,10,0" FontWeight="Bold"/>
                        <Button Content="🌐 Create Desktop Shortcuts" Click="OnCreateShortcutsClicked" Background="#E2E8F0" Foreground="#1E293B" Height="36" Padding="14,0" Margin="0,0,10,0" FontWeight="SemiBold"/>
                        <Button Content="📁 Open Assets Folder" Click="OnOpenAssetsFolder" Background="#E2E8F0" Foreground="#1E293B" Height="36" Padding="14,0" FontWeight="SemiBold"/>
                    </StackPanel>
                    <TextBlock x:Name="PayloadStatusText" Text="" Foreground="#10B981" FontSize="12" FontWeight="Bold"/>
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</Page>
