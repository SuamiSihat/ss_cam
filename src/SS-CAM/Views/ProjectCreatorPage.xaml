<Page x:Class="SS_CAM.Views.ProjectCreatorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Project Creator">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Create New Project" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,16"/>

        <ScrollViewer Grid.Row="1">
            <StackPanel>
                <ui:CardControl Header="Project Details" Icon="{ui:SymbolIcon Edit24}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Sub-Brand" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbSubBrand" SelectedIndex="0" Margin="0,0,0,12">
                            <ComboBoxItem Content="SSH - SuamiSihat Holding" />
                            <ComboBoxItem Content="SSC - SuamiSihat Healthcare" />
                            <ComboBoxItem Content="SSW - SuamiSihat Wellness" />
                            <ComboBoxItem Content="SSE - SuamiSihat Ecom" />
                            <ComboBoxItem Content="SST - SuamiSihat Tech" />
                        </ComboBox>

                        <TextBlock Text="Project Name" Margin="0,0,0,4"/>
                        <ui:TextBox x:Name="TxtProjectName" PlaceholderText="e.g. Q3 Marketing Campaign" Margin="0,0,0,12"/>

                        <TextBlock Text="Job Number (Optional)" Margin="0,0,0,4"/>
                        <ui:TextBox x:Name="TxtJobNumber" PlaceholderText="e.g. 1024" Margin="0,0,0,12"/>
                    </StackPanel>
                </ui:CardControl>

                <ui:CardControl Header="Template Settings" Icon="{ui:SymbolIcon Folder24}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Preset Template" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbPreset" SelectedIndex="0" Margin="0,0,0,12">
                            <ComboBoxItem Content="Social Media Campaign" />
                            <ComboBoxItem Content="Video Production" />
                            <ComboBoxItem Content="Brand Identity" />
                            <ComboBoxItem Content="Standard Artwork" />
                        </ComboBox>
                    </StackPanel>
                </ui:CardControl>

                <ui:Button x:Name="BtnGenerate" Appearance="Primary" Content="Generate Project Folders" Icon="{ui:SymbolIcon Sparkle24}" HorizontalAlignment="Right" />
                <TextBlock x:Name="TxtResult" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,8,0,0" HorizontalAlignment="Right" Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
