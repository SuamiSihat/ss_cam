<Page x:Class="SS_CAM.Views.ProjectCreatorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Project Creator">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
            <StackPanel>
                <!-- Fluent 2 Header -->
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Standardized Project Creator" FontFamily="{StaticResource FluentFontFamily}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource FluentLightTextPrimary}"/>
                        <TextBlock Text="Generate structured SuamiSihat project folders, starter canvas templates, briefs, and Job IDs." FontFamily="{StaticResource FluentFontFamily}" Foreground="{DynamicResource FluentLightTextSecondary}" FontSize="13" Margin="0,4,0,0"/>
                    </StackPanel>

                    <Border Grid.Column="1" Background="{DynamicResource FluentLightCardSubBg}" BorderBrush="{DynamicResource FluentLightStroke}" BorderThickness="1" CornerRadius="6" VerticalAlignment="Center">
                        <Button Click="OnManagePresetsClicked" Background="Transparent" Foreground="{DynamicResource FluentBrand80}" Padding="14,8" BorderThickness="0" Cursor="Hand" ToolTip="Add, edit, or customize category presets &amp; folder tree structures">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙️ " FontFamily="Segoe UI Emoji" FontSize="12"/>
                                <TextBlock Text="Manage Category Presets &amp; Folders" FontFamily="{StaticResource FluentFontFamily}" FontWeight="Bold" FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </Border>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.3*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Column: Form Controls -->
                    <StackPanel Grid.Column="0">
                        <!-- Project Identity Group (Fluent 2 Card) -->
                        <GroupBox Header="01. Project Identity &amp; Job ID" Margin="0,0,0,20">
                            <StackPanel Margin="12">
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Year -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Year" FontFamily="{StaticResource FluentFontFamily}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource FluentLightTextSecondary}" Margin="0,0,0,6"/>
                                        <ComboBox x:Name="YearComboBox" Height="36" SelectionChanged="OnFormInputChanged"/>
                                    </StackPanel>
                                    <!-- Sub-brand -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Sub-Brand" FontFamily="{StaticResource FluentFontFamily}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource FluentLightTextSecondary}" Margin="0,0,0,6"/>
                                        <ComboBox x:Name="SubBrandComboBox" Height="36" SelectionChanged="OnFormInputChanged"/>
                                    </StackPanel>
                                    <!-- Job ID Suffix Code -->
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Job ID Suffix" FontFamily="{StaticResource FluentFontFamily}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource FluentLightTextSecondary}" Margin="0,0,0,6"/>
                                        <ui:TextBox x:Name="JobIdInput" Text="0001D" Height="36" TextChanged="OnFormInputChanged"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Text="Project Title / Descriptor" FontFamily="{StaticResource FluentFontFamily}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource FluentLightTextSecondary}" Margin="0,0,0,6"/>
                                    <ui:TextBox x:Name="ProjectNameInput" Text="brand campaign" Height="36" TextChanged="OnFormInputChanged"/>
                                </StackPanel>

                                <StackPanel>
                                    <TextBlock Text="Project Brief / Remarks" FontFamily="{StaticResource FluentFontFamily}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource FluentLightTextSecondary}" Margin="0,0,0,6"/>
                                    <ui:TextBox x:Name="ProjectDescriptionInput" PlaceholderText="Enter optional project scope, requirements, or client notes..." AcceptsReturn="True" Height="64"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <!-- Template & Platform Configuration -->
                        <GroupBox Header="02. Preset &amp; Starter Canvas Template" Margin="0,0,0,20">
                            <StackPanel Margin="12">
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Category Preset -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Category Preset" FontFamily="{StaticResource FluentFontFamily}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource FluentLightTextSecondary}" Margin="0,0,0,6"/>
                                        <ComboBox x:Name="PresetComboBox" Height="36" SelectionChanged="OnFormInputChanged"/>
                                    </StackPanel>

                                    <!-- Canvas Size Preset -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Target Platform" FontFamily="{StaticResource FluentFontFamily}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource FluentLightTextSecondary}" Margin="0,0,0,6"/>
                                        <ComboBox x:Name="PlatformComboBox" Height="36" SelectionChanged="OnFormInputChanged"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock x:Name="PlatformSpecsText" Text="1080 x 1080 px · 72 DPI · sRGB Color Mode" FontFamily="{StaticResource FluentFontFamily}" FontSize="11" Foreground="{DynamicResource FluentBrand80}" FontWeight="SemiBold" Margin="0,0,0,12"/>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox x:Name="InjectCanvasCheck" Content="Generate Starter Canvas File" IsChecked="True" FontFamily="{StaticResource FluentFontFamily}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource FluentLightTextPrimary}" VerticalAlignment="Center" Click="OnFormInputChanged"/>
                                    <ComboBox x:Name="TemplateExtensionComboBox" Grid.Column="2" Width="120" Height="34" SelectionChanged="OnFormInputChanged"/>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <CheckBox x:Name="IncludeRevisionsCheck" Content="Include 05_Revisions folder" IsChecked="True" FontFamily="{StaticResource FluentFontFamily}" FontSize="11" Foreground="{DynamicResource FluentLightTextSecondary}" Margin="0,0,16,0" Click="OnFormInputChanged"/>
                                    <CheckBox x:Name="IncludeRawMediaCheck" Content="Include 06_Raw_Media folder" IsChecked="True" FontFamily="{StaticResource FluentFontFamily}" FontSize="11" Foreground="{DynamicResource FluentLightTextSecondary}" Click="OnFormInputChanged"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <!-- Output Destination -->
                        <GroupBox Header="03. Output Directory" Margin="0,0,0,20">
                            <StackPanel Margin="12">
                                <TextBlock Text="Target Root Workspace Folder" FontFamily="{StaticResource FluentFontFamily}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource FluentLightTextSecondary}" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBox x:Name="TargetDirectoryInput" Text="D:\Testing" Height="36" Grid.Column="0" TextChanged="OnFormInputChanged"/>
                                    <Border Grid.Column="2" CornerRadius="6" Background="{DynamicResource FluentLightCardSubBg}" BorderBrush="{DynamicResource FluentLightStroke}" BorderThickness="1">
                                        <Button Content="Browse..." Click="OnBrowseTargetDirectory" Height="34" Width="100" Background="Transparent" Foreground="{DynamicResource FluentLightTextPrimary}" BorderThickness="0" FontFamily="{StaticResource FluentFontFamily}" FontWeight="SemiBold" Cursor="Hand"/>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <!-- Status Indicator Text -->
                        <TextBlock x:Name="CreateStatusText" Text="" FontFamily="{StaticResource FluentFontFamily}" FontSize="12" Foreground="{DynamicResource FluentSuccess}" FontWeight="Bold" Margin="0,0,0,10"/>

                        <!-- Primary Action Button -->
                        <Border CornerRadius="6" Background="{DynamicResource FluentBrand80}">
                            <Button Content="⚡ Generate Standardized Project Folder" Click="OnCreateProjectClicked" Height="44" Background="Transparent" Foreground="White" FontFamily="{StaticResource FluentFontFamily}" FontSize="14" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                        </Border>
                    </StackPanel>

                    <!-- Right Column: Live Directory Tree Preview (Fluent 2 Card) -->
                    <Border Grid.Column="2" Background="{DynamicResource FluentLightCardBg}" BorderBrush="{DynamicResource FluentLightStroke}" BorderThickness="1" CornerRadius="8" Padding="16" Effect="{StaticResource FluentDepth4}">
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="🌲 Live Directory Tree Preview" FontFamily="{StaticResource FluentFontFamily}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource FluentLightTextPrimary}"/>
                                </StackPanel>
                                <TextBlock Text="Real-time visual hierarchy of the project folder structure." FontFamily="{StaticResource FluentFontFamily}" Foreground="{DynamicResource FluentLightTextSecondary}" FontSize="11"/>
                            </StackPanel>

                            <!-- Folder Name Header Card -->
                            <Border DockPanel.Dock="Top" Background="{DynamicResource FluentLightCardSubBg}" BorderBrush="{DynamicResource FluentLightStroke}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="GENERATED TARGET FOLDER PATH:" FontFamily="{StaticResource FluentFontFamily}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource FluentLightTextSecondary}"/>
                                    <TextBlock x:Name="PreviewPathText" Text="D:\Testing\Brand\2026_SS_BRAND_0001D_brand_campaign" FontFamily="{StaticResource FluentFontFamily}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource FluentBrand80}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Tree Hierarchy View -->
                            <Border DockPanel.Dock="Top" Background="{DynamicResource FluentLightCardSubBg}" BorderBrush="{DynamicResource FluentLightStroke}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,16">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="220">
                                    <TextBlock x:Name="FolderStructureBox" Text="📁 2026_SS_BRAND_0001D_brand_campaign&#10;├── 📁 01_Product_Shots&#10;├── 📁 02_Raw_Footage&#10;└── 📁 03_Final_Exports" FontFamily="Consolas, Segoe UI Mono, monospace" FontSize="11.5" Foreground="{DynamicResource FluentLightTextPrimary}" LineHeight="20"/>
                                </ScrollViewer>
                            </Border>

                            <!-- Recent Projects List Section -->
                            <StackPanel DockPanel.Dock="Bottom">
                                <TextBlock Text="Recent Projects (Double Click to Open)" FontFamily="{StaticResource FluentFontFamily}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource FluentLightTextSecondary}" Margin="0,0,0,8"/>
                                <ListBox x:Name="RecentProjectsList" MouseDoubleClick="OnRecentProjectDoubleClicked" MaxHeight="160"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Manage Presets Modal Overlay -->
        <Grid x:Name="ManagePresetsModal" Background="#90000000" Visibility="Collapsed">
            <Border Background="{DynamicResource FluentLightCardBg}" CornerRadius="10" Padding="24" Width="680" HorizontalAlignment="Center" VerticalAlignment="Center" Effect="{StaticResource FluentDepth16}">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="⚙️ Category Presets &amp; Folder Templates" FontFamily="{StaticResource FluentFontFamily}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource FluentLightTextPrimary}"/>
                        <Button Grid.Column="1" Content="✕" Click="OnClosePresetsModalClicked" Background="Transparent" Foreground="{DynamicResource FluentLightTextSecondary}" FontSize="14" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Presets List -->
                        <DockPanel Grid.Column="0">
                            <Border DockPanel.Dock="Bottom" CornerRadius="4" Background="{DynamicResource FluentBrand80}">
                                <Button Content="➕ New Category Preset" Click="OnAddNewPresetClicked" Height="34" Background="Transparent" Foreground="White" FontFamily="{StaticResource FluentFontFamily}" FontSize="11" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                            </Border>
                            <ListBox x:Name="PresetsListBox" SelectionChanged="OnPresetSelectionChanged" DisplayMemberPath="Name" Margin="0,0,0,10"/>
                        </DockPanel>

                        <!-- Right: Edit Preset Form -->
                        <StackPanel Grid.Column="2">
                            <TextBlock x:Name="PresetFormTitle" Text="Edit Category Preset" FontFamily="{StaticResource FluentFontFamily}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource FluentLightTextPrimary}" Margin="0,0,0,12"/>
                            
                            <TextBlock Text="Category Name" FontFamily="{StaticResource FluentFontFamily}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource FluentLightTextSecondary}" Margin="0,0,0,4"/>
                            <ui:TextBox x:Name="TxtPresetName" Height="34" Margin="0,0,0,10"/>

                            <TextBlock Text="Job ID Suffix Code" FontFamily="{StaticResource FluentFontFamily}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource FluentLightTextSecondary}" Margin="0,0,0,4"/>
                            <ui:TextBox x:Name="TxtPresetSuffix" Height="34" Margin="0,0,0,10"/>

                            <TextBlock Text="Folder Tree Structure (1 subfolder per line, use '/' for nested subfolders)" FontFamily="{StaticResource FluentFontFamily}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource FluentLightTextSecondary}" Margin="0,0,0,4"/>
                            <ui:TextBox x:Name="TxtPresetFolders" AcceptsReturn="True" Height="140" Margin="0,0,0,14"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Border CornerRadius="4" Background="#DC2626" Margin="0,0,8,0">
                                    <Button x:Name="BtnDeletePreset" Content="🗑️ Delete" Click="OnDeletePresetClicked" Height="34" Padding="12,0" Background="Transparent" Foreground="White" FontFamily="{StaticResource FluentFontFamily}" FontSize="11" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                                </Border>
                                <Border CornerRadius="4" Background="{DynamicResource FluentBrand80}">
                                    <Button Content="💾 Save Preset" Click="OnSavePresetClicked" Height="34" Padding="16,0" Background="Transparent" Foreground="White" FontFamily="{StaticResource FluentFontFamily}" FontSize="11" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
