<Page x:Class="SS_CAM.Views.ProjectCreatorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Project Creator">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
            <StackPanel>
                <!-- Fluent 2 Header -->
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <ui:TextBlock Text="Standardized Project Creator"  FontSize="24" FontWeight="Bold" Foreground="{DynamicResource FluentLightTextPrimary}"/>
                        <ui:TextBlock Text="Generate structured SuamiSihat project folders, starter canvas templates, briefs, and Project IDs."  Foreground="{DynamicResource FluentLightTextSecondary}" FontSize="13" Margin="0,4,0,0"/>
                    </StackPanel>

                    <ui:Button Grid.Column="1" Appearance="Secondary" Click="OnManagePresetsClicked" Padding="14,8" Cursor="Hand" ToolTip="Add, edit, or customize category presets &amp; folder tree structures" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Settings24" FontSize="16" Margin="0,0,6,0"/>
                            <ui:TextBlock Text="Manage Category Presets &amp; Folders" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ui:Button>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.3*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Column: Form Controls -->
                    <StackPanel Grid.Column="0">
                        <!-- Project Identity Group (Fluent 2 Card) -->
                        <ui:Card Margin="0,0,0,20" Padding="16">
                            <StackPanel>
                                <ui:TextBlock Text="01. Project Identity &amp; Project ID" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,16"/>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Year -->
                                    <StackPanel Grid.Column="0">
                                        <ui:TextBlock Text="Year"  FontSize="11" FontWeight="Bold" Foreground="{DynamicResource FluentLightTextSecondary}" Margin="0,0,0,6"/>
                                        <ComboBox x:Name="YearComboBox" Height="36" SelectionChanged="OnFormInputChanged"/>
                                    </StackPanel>
                                    <!-- Sub-brand -->
                                    <StackPanel Grid.Column="2">
                                        <ui:TextBlock Text="Sub-Brand"  FontSize="11" FontWeight="Bold" Foreground="{DynamicResource FluentLightTextSecondary}" Margin="0,0,0,6"/>
                                        <ComboBox x:Name="SubBrandComboBox" Height="36" SelectionChanged="OnFormInputChanged"/>
                                    </StackPanel>
                                    <!-- Project ID Suffix Code -->
                                    <StackPanel Grid.Column="4">
                                        <ui:TextBlock Text="Project ID Suffix"  FontSize="11" FontWeight="Bold" Foreground="{DynamicResource FluentLightTextSecondary}" Margin="0,0,0,6"/>
                                        <ui:TextBox x:Name="ProjectIdInput" Text="0001D" Height="36" TextChanged="OnFormInputChanged"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Margin="0,0,0,14">
                                    <ui:TextBlock Text="Project Title / Descriptor"  FontSize="11" FontWeight="Bold" Foreground="{DynamicResource FluentLightTextSecondary}" Margin="0,0,0,6"/>
                                    <ui:TextBox x:Name="ProjectNameInput" Text="brand campaign" Height="36" TextChanged="OnFormInputChanged"/>
                                </StackPanel>

                                <StackPanel>
                                    <ui:TextBlock Text="Project Brief / Remarks"  FontSize="11" FontWeight="Bold" Foreground="{DynamicResource FluentLightTextSecondary}" Margin="0,0,0,4"/>

                                    <!-- Markdown Toolbar -->
                                    <Border Background="{DynamicResource FluentLightCardSubBg}" BorderBrush="{DynamicResource FluentLightStroke}" BorderThickness="1,1,1,0" CornerRadius="6,6,0,0" Padding="6,4">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:Button x:Name="MdBold" Content="B" Click="OnMdBold" Height="24" Width="28" Background="Transparent" Foreground="{DynamicResource FluentBrand80}"  FontWeight="Bold" FontSize="12" BorderThickness="0" Cursor="Hand" ToolTip="Bold (**text**)"/>
                                            <ui:Button x:Name="MdItalic" Content="I" Click="OnMdItalic" Height="24" Width="28" Background="Transparent" Foreground="{DynamicResource FluentLightTextPrimary}" FontFamily="Georgia, serif" FontStyle="Italic" FontSize="12" BorderThickness="0" Cursor="Hand" ToolTip="Italic (*text*)"/>
                                            <ui:Button x:Name="MdCode" Click="OnMdCode" Height="24" Width="28" Background="Transparent" Foreground="{DynamicResource FluentLightTextPrimary}" FontFamily="Consolas" FontSize="11" BorderThickness="0" Cursor="Hand" ToolTip="Inline code (`text`)">
                                                <ui:TextBlock Text="&lt;/&gt;" FontFamily="Consolas" FontSize="10"/>
                                            </ui:Button>
                                            <Border Width="1" Background="{DynamicResource FluentLightStroke}" Margin="4,3"/>
                                            <ui:Button x:Name="MdHeading" Content="H2" Click="OnMdHeading" Height="24" Width="32" Background="Transparent" Foreground="{DynamicResource FluentLightTextPrimary}"  FontWeight="SemiBold" FontSize="10" BorderThickness="0" Cursor="Hand" ToolTip="Heading 2 (## heading)"/>
                                            <ui:Button x:Name="MdList" Content="&#x2022; List" Click="OnMdList" Height="24" Padding="4,0" Background="Transparent" Foreground="{DynamicResource FluentLightTextPrimary}"  FontSize="10" BorderThickness="0" Cursor="Hand" ToolTip="List item (- item)"/>
                                            <ui:Button x:Name="MdSep" Content="&#x2500; HR" Click="OnMdSep" Height="24" Padding="4,0" Background="Transparent" Foreground="{DynamicResource FluentLightTextPrimary}"  FontSize="10" BorderThickness="0" Cursor="Hand" ToolTip="Horizontal rule (---)"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBox x:Name="ProjectDescriptionInput"
                                             AcceptsReturn="True" AcceptsTab="True"
                                             Height="200"
                                             VerticalScrollBarVisibility="Auto"
                                             TextWrapping="Wrap"
                                             
                                             FontSize="12"
                                             Padding="8"
                                             BorderBrush="{DynamicResource FluentLightStroke}"
                                             BorderThickness="1"
                                             Background="{DynamicResource TextControlBackground}"/>
                                </StackPanel>
                            </StackPanel>
                        </ui:Card>

                        <!-- Template & Platform Configuration -->
                        <ui:Card Margin="0,0,0,20" Padding="16">
                            <StackPanel>
                                <ui:TextBlock Text="02. Preset &amp; Starter Canvas Template" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,16"/>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Category Preset -->
                                    <StackPanel Grid.Column="0">
                                        <ui:TextBlock Text="Category Preset"  FontSize="11" FontWeight="Bold" Foreground="{DynamicResource FluentLightTextSecondary}" Margin="0,0,0,6"/>
                                        <ComboBox x:Name="PresetComboBox" Height="36" SelectionChanged="OnFormInputChanged"/>
                                    </StackPanel>

                                    <!-- Canvas Size Preset -->
                                    <StackPanel Grid.Column="2">
                                        <ui:TextBlock Text="Target Platform"  FontSize="11" FontWeight="Bold" Foreground="{DynamicResource FluentLightTextSecondary}" Margin="0,0,0,6"/>
                                        <ComboBox x:Name="PlatformComboBox" Height="36" SelectionChanged="OnFormInputChanged"/>
                                    </StackPanel>
                                </Grid>

                                <ui:TextBlock x:Name="PlatformSpecsText" Text="1080 x 1080 px Â· 72 DPI Â· sRGB Color Mode"  FontSize="11" Foreground="{DynamicResource FluentBrand80}" FontWeight="SemiBold" Margin="0,0,0,12"/>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox x:Name="InjectCanvasCheck" Content="Generate Starter Canvas File" IsChecked="True"  FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource FluentLightTextPrimary}" VerticalAlignment="Center" Click="OnFormInputChanged"/>
                                    <ComboBox x:Name="TemplateExtensionComboBox" Grid.Column="2" Width="140" Height="34" IsEditable="True" SelectionChanged="OnFormInputChanged"/>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <CheckBox x:Name="IncludeRevisionsCheck" Content="Include Client Revisions folder" IsChecked="True"  FontSize="11" Foreground="{DynamicResource FluentLightTextSecondary}" Margin="0,0,16,0" Click="OnFormInputChanged"/>
                                    <CheckBox x:Name="IncludeRawMediaCheck" Content="Include Raw Media folder" IsChecked="True"  FontSize="11" Foreground="{DynamicResource FluentLightTextSecondary}" Click="OnFormInputChanged"/>
                                </StackPanel>
                            </StackPanel>
                        </ui:Card>

                        <!-- Output Destination -->
                        <ui:Card Margin="0,0,0,20" Padding="16">
                            <StackPanel>
                                <ui:TextBlock Text="03. Output Directory" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,16"/>
                                <ui:TextBlock Text="Target Root Workspace Folder"  FontSize="11" FontWeight="Bold" Foreground="{DynamicResource FluentLightTextSecondary}" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBox x:Name="TargetDirectoryInput" Text="D:\Testing" Height="36" Grid.Column="0" TextChanged="OnFormInputChanged"/>
                                    <ui:Button Grid.Column="2" Appearance="Secondary" Content="Browse..." Click="OnBrowseTargetDirectory" Height="34" Width="100" FontWeight="SemiBold" Cursor="Hand"/>
                                </Grid>
                            </StackPanel>
                        </ui:Card>

                        <!-- Status Indicator Text & App Bridge -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <ui:TextBlock x:Name="CreateStatusText" Text="" FontSize="12" Foreground="{DynamicResource FluentSuccess}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <ui:Button x:Name="BtnOpenInApp" Appearance="Secondary" Visibility="Collapsed" Click="OnOpenInAppClicked" Height="28" Padding="12,0" Cursor="Hand" ToolTip="Open the generated canvas in Photoshop/Illustrator">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Open24" FontSize="14" Margin="0,0,6,0"/>
                                    <ui:TextBlock x:Name="TxtOpenInApp" Text="Open Canvas" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ui:Button>
                        </StackPanel>

                        <!-- Primary Action Button -->
                        <ui:Button Appearance="Primary" Content="&#x26A1; Generate Standardized Project Folder" Click="OnCreateProjectClicked" Height="44" FontSize="14" FontWeight="Bold" Cursor="Hand" HorizontalAlignment="Stretch"/>
                    </StackPanel>

                    <!-- Right Column: Live Directory Tree Preview (Fluent 2 Card) -->
                    <ui:Card Grid.Column="2" Padding="16" Effect="{StaticResource FluentDepth4}">
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <ui:SymbolIcon Symbol="FolderTree24" FontSize="20" Margin="0,0,8,0" Foreground="{DynamicResource FluentBrand80}"/>
                                    <ui:TextBlock Text="Live Directory Tree Preview" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <ui:TextBlock Text="Real-time visual hierarchy of the project folder structure." Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11"/>
                            </StackPanel>

                            <!-- Folder Name Header Card -->
                            <ui:Card DockPanel.Dock="Top" Padding="10" Margin="0,0,0,12">
                                <StackPanel>
                                    <ui:TextBlock Text="GENERATED TARGET FOLDER PATH:" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <ui:TextBlock x:Name="PreviewPathText" Text="D:\Testing\Brand\2026_SS_BRAND_0001D_brand_campaign" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource FluentBrand80}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </ui:Card>

                            <!-- Tree Hierarchy View -->
                            <ui:Card DockPanel.Dock="Top" Padding="12" Margin="0,0,0,16">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="220">
                                    <ui:TextBlock x:Name="FolderStructureBox" Text="[Dir] 2026_SS_BRAND_0001D_brand_campaign&#10;&#x251C;&#x2500;&#x2500; [Dir] 01_Product_Shots&#10;&#x251C;&#x2500;&#x2500; [Dir] 02_Raw_Footage&#10;&#x2514;&#x2500;&#x2500; [Dir] 03_Final_Exports" FontFamily="Consolas, Segoe UI Mono, monospace" FontSize="11.5" Foreground="{DynamicResource TextFillColorPrimaryBrush}" LineHeight="20"/>
                                </ScrollViewer>
                            </ui:Card>

                            <!-- Recent Projects List Section -->
                            <StackPanel DockPanel.Dock="Bottom">
                                <ui:TextBlock Text="Recent Projects (Double Click to Open)" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8"/>
                                <ListBox x:Name="RecentProjectsList" MouseDoubleClick="OnRecentProjectDoubleClicked" MaxHeight="160"/>
                            </StackPanel>
                        </DockPanel>
                    </ui:Card>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Manage Presets Modal Overlay -->
        <Grid x:Name="ManagePresetsModal" Background="#90000000" Visibility="Collapsed">
            <ui:Card Padding="24" Width="680" HorizontalAlignment="Center" VerticalAlignment="Center" Effect="{StaticResource FluentDepth16}">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Settings24" FontSize="20" Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <ui:TextBlock Text="Category Presets &amp; Folder Templates" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ui:Button Grid.Column="1" Appearance="Transparent" Click="OnClosePresetsModalClicked" Padding="6" Cursor="Hand">
                            <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </ui:Button>
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Presets List -->
                        <DockPanel Grid.Column="0">
                            <ui:Button DockPanel.Dock="Bottom" Appearance="Primary" Click="OnAddNewPresetClicked" Height="34" Cursor="Hand" HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Add24" FontSize="16" Margin="0,0,6,0"/>
                                    <ui:TextBlock Text="New Category Preset" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ui:Button>
                            <ListBox x:Name="PresetsListBox" SelectionChanged="OnPresetSelectionChanged" DisplayMemberPath="Name" Margin="0,0,0,10"/>
                        </DockPanel>

                        <!-- Right: Edit Preset Form -->
                        <StackPanel Grid.Column="2">
                            <ui:TextBlock x:Name="PresetFormTitle" Text="Edit Category Preset" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,12"/>
                            
                            <ui:TextBlock Text="Category Name" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                            <ui:TextBox x:Name="TxtPresetName" Height="34" Margin="0,0,0,10"/>

                            <ui:TextBlock Text="Project ID Suffix Code" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                            <ui:TextBox x:Name="TxtPresetSuffix" Height="34" Margin="0,0,0,10"/>

                            <ui:TextBlock Text="Folder Tree Structure (1 subfolder per line, use '/' for nested subfolders)" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                            <ui:TextBox x:Name="TxtPresetFolders" AcceptsReturn="True" Height="140" Margin="0,0,0,14"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <ui:Button x:Name="BtnDeletePreset" Appearance="Danger" Click="OnDeletePresetClicked" Height="34" Padding="12,0" Cursor="Hand" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Delete24" FontSize="16" Margin="0,0,6,0"/>
                                        <ui:TextBlock Text="Delete" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ui:Button>
                                <ui:Button Appearance="Primary" Click="OnSavePresetClicked" Height="34" Padding="16,0" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Save24" FontSize="16" Margin="0,0,6,0"/>
                                        <ui:TextBlock Text="Save Preset" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ui:Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ui:Card>
        </Grid>
    </Grid>
</Page>


