<Page x:Class="SS_CAM.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="User Profile &amp; Settings">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20,24,24">
        <StackPanel>
            <!-- Page Header -->
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="Settings" FontSize="26" FontWeight="Bold" Foreground="#043388"
                           FontFamily="Segoe UI Variable Display"/>
                <TextBlock Text="Manage your designer profile, workspace paths, themes, and maintenance tools."
                           Foreground="#64748B" FontSize="13" Margin="0,4,0,0" FontFamily="Segoe UI Variable Text"/>
            </StackPanel>

            <!-- 2-Column Grid -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT COLUMN -->
                <StackPanel Grid.Column="0">

                    <!-- Designer Profile Card -->
                    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Designer Profile" FontSize="14" FontWeight="Bold" Foreground="#043388"
                                       FontFamily="Segoe UI Variable Text" Margin="0,0,0,16"/>

                            <!-- Avatar + Identity Overview -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                    <Border Width="72" Height="72" CornerRadius="36" Background="#21A1F7"
                                            BorderBrush="#043388" BorderThickness="2" ClipToBounds="True"
                                            HorizontalAlignment="Center">
                                        <Grid>
                                            <TextBlock x:Name="AvatarEmojiText" Text="👤" FontSize="34"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Image x:Name="AvatarPreviewImg" Stretch="UniformToFill" Visibility="Collapsed"/>
                                        </Grid>
                                    </Border>
                                    <Button Content="Change" Click="OnChangeAvatarClicked" Height="26"
                                            Margin="0,6,0,0" Padding="8,0" FontSize="11"
                                            Background="#E2E8F0" Foreground="#1E293B" Cursor="Hand"
                                            HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="ProfileHeaderName" Text="Brand" FontSize="18"
                                               FontWeight="Bold" Foreground="#043388"
                                               FontFamily="Segoe UI Variable Text"/>
                                    <TextBlock x:Name="ProfileHeaderDept" Text="Creative &amp; Brand"
                                               Foreground="#64748B" FontSize="12"
                                               FontFamily="Segoe UI Variable Text"/>
                                    <TextBlock x:Name="ProfileHeaderStaffId" Text="Staff ID: 0001D"
                                               Foreground="#21A1F7" FontSize="11" FontWeight="SemiBold"
                                               FontFamily="Segoe UI Variable Text" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- Form fields -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Designer Name" FontSize="11" FontWeight="SemiBold"
                                               Foreground="#64748B" Margin="0,0,0,4"
                                               FontFamily="Segoe UI Variable Text"/>
                                    <ui:TextBox x:Name="DesignerNameInput" Text="Brand" Height="34"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Staff ID" FontSize="11" FontWeight="SemiBold"
                                               Foreground="#64748B" Margin="0,0,0,4"
                                               FontFamily="Segoe UI Variable Text"/>
                                    <ui:TextBox x:Name="StaffIdInput" Text="0001D" Height="34"/>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Department / Role" FontSize="11" FontWeight="SemiBold"
                                               Foreground="#64748B" Margin="0,0,0,4"
                                               FontFamily="Segoe UI Variable Text"/>
                                    <ui:TextBox x:Name="DepartmentInput" Text="Creative &amp; Brand" Height="34"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Email" FontSize="11" FontWeight="SemiBold"
                                               Foreground="#64748B" Margin="0,0,0,4"
                                               FontFamily="Segoe UI Variable Text"/>
                                    <ui:TextBox x:Name="EmailInput" Text="brand@suamisihat.com" Height="34"/>
                                </StackPanel>
                            </Grid>

                            <Button Content="Save Profile" Click="OnSaveProfileClicked"
                                    Background="#043388" Foreground="White" Height="34"
                                    Padding="18,0" FontWeight="Bold" HorizontalAlignment="Left"
                                    Cursor="Hand" FontFamily="Segoe UI Variable Text"/>
                            <TextBlock x:Name="ProfileSaveStatus" Text="" Foreground="#10B981"
                                       FontSize="12" FontWeight="Bold" Margin="0,8,0,0"
                                       FontFamily="Segoe UI Variable Text"/>
                        </StackPanel>
                    </Border>

                    <!-- Workspace Storage -->
                    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Workspace Storage" FontSize="14" FontWeight="Bold"
                                       Foreground="#043388" FontFamily="Segoe UI Variable Text" Margin="0,0,0,6"/>
                            <TextBlock Text="Root path of your Synology / local drive workspace."
                                       Foreground="#64748B" FontSize="12" Margin="0,0,0,12"
                                       FontFamily="Segoe UI Variable Text"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ui:TextBox x:Name="WorkspaceRootInput" Text="D:\Testing" Height="34"/>
                                <Button Content="Browse..." Click="OnBrowseWorkspace"
                                        Height="34" Width="90" Grid.Column="2"
                                        Background="#E2E8F0" Foreground="#1E293B" Cursor="Hand"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- App Theme -->
                    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Application Theme" FontSize="14" FontWeight="Bold"
                                       Foreground="#043388" FontFamily="Segoe UI Variable Text" Margin="0,0,0,6"/>
                            <TextBlock Text="Switch between Brand, Fluent Mica, or Cyan Glass Acrylic."
                                       Foreground="#64748B" FontSize="12" Margin="0,0,0,14"
                                       FontFamily="Segoe UI Variable Text"/>
                            <WrapPanel>
                                <Button x:Name="BtnThemeSSDefault" Content="SS Default" Click="OnSelectSSDefaultTheme"
                                        Height="34" Margin="0,0,8,8" Padding="14,0"
                                        Background="#043388" Foreground="White" FontWeight="Bold" Cursor="Hand"
                                        FontFamily="Segoe UI Variable Text"/>
                                <Button x:Name="BtnThemeWin11Fluent" Content="Win11 Fluent" Click="OnSelectWin11FluentTheme"
                                        Height="34" Margin="0,0,8,8" Padding="14,0"
                                        Background="#0078D4" Foreground="White" FontWeight="Bold" Cursor="Hand"
                                        FontFamily="Segoe UI Variable Text"/>
                                <Button x:Name="BtnThemeGlass" Content="Cyan Glass" Click="OnSelectGlassTheme"
                                        Height="34" Margin="0,0,8,8" Padding="14,0"
                                        Background="#0D4B66" Foreground="#00F2FE"
                                        BorderBrush="#00F2FE" BorderThickness="1"
                                        FontWeight="Bold" Cursor="Hand"
                                        FontFamily="Segoe UI Variable Text"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- RIGHT COLUMN -->
                <StackPanel Grid.Column="2">

                    <!-- Workstation Payload -->
                    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Workstation Payload" FontSize="14" FontWeight="Bold"
                                       Foreground="#043388" FontFamily="Segoe UI Variable Text" Margin="0,0,0,6"/>
                            <TextBlock Text="Install brand fonts, deploy asset libraries, or check for updates."
                                       Foreground="#64748B" FontSize="12" Margin="0,0,0,14"
                                       FontFamily="Segoe UI Variable Text"/>
                            <WrapPanel>
                                <Button Content="Install Brand Fonts" Click="OnRepairFonts"
                                        Height="34" Margin="0,0,8,8" Padding="14,0"
                                        Background="#043388" Foreground="White" FontWeight="Bold" Cursor="Hand"
                                        FontFamily="Segoe UI Variable Text"/>
                                <Button Content="Deploy Asset Libraries" Click="OnDeployAssets"
                                        Height="34" Margin="0,0,8,8" Padding="14,0"
                                        Background="#043388" Foreground="White" FontWeight="Bold" Cursor="Hand"
                                        FontFamily="Segoe UI Variable Text"/>
                                <Button Content="Check for Updates" Click="OnCheckUpdates"
                                        Height="34" Margin="0,0,8,8" Padding="14,0"
                                        Background="#E2E8F0" Foreground="#1E293B" Cursor="Hand"
                                        FontFamily="Segoe UI Variable Text"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Category Presets -->
                    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Category Presets &amp; Folder Structure" FontSize="14" FontWeight="Bold"
                                       Foreground="#043388" FontFamily="Segoe UI Variable Text" Margin="0,0,0,6"/>
                            <TextBlock Text="Configure project folder templates, subfolder trees, and Job ID suffix codes."
                                       Foreground="#64748B" FontSize="12" Margin="0,0,0,14"
                                       FontFamily="Segoe UI Variable Text" TextWrapping="Wrap"/>
                            <Button Content="Manage Category Presets &amp; Folder Trees"
                                    Click="OnManageCategoryPresetsClicked"
                                    Height="34" Padding="16,0"
                                    Background="#043388" Foreground="White" FontWeight="Bold"
                                    Cursor="Hand" HorizontalAlignment="Left"
                                    FontFamily="Segoe UI Variable Text"/>
                        </StackPanel>
                    </Border>

                    <!-- Reset & Maintenance -->
                    <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="8" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Reset &amp; Data Maintenance" FontSize="14" FontWeight="Bold"
                                       Foreground="#DC2626" FontFamily="Segoe UI Variable Text" Margin="0,0,0,6"/>
                            <TextBlock Text="Reset profile to defaults or clear all local session data."
                                       Foreground="#64748B" FontSize="12" Margin="0,0,0,14"
                                       FontFamily="Segoe UI Variable Text"/>
                            <WrapPanel>
                                <Button Content="Reset Profile Defaults" Click="OnResetProfileDefaults"
                                        Height="34" Margin="0,0,8,8" Padding="14,0"
                                        Background="#EFF6FF" Foreground="#043388"
                                        BorderBrush="#21A1F7" BorderThickness="1"
                                        FontWeight="Bold" Cursor="Hand"
                                        FontFamily="Segoe UI Variable Text"/>
                                <Button Content="Clear Cache &amp; Reset All" Click="OnClearAllData"
                                        Height="34" Margin="0,0,8,8" Padding="14,0"
                                        Background="#DC2626" Foreground="White"
                                        FontWeight="Bold" Cursor="Hand"
                                        FontFamily="Segoe UI Variable Text"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
