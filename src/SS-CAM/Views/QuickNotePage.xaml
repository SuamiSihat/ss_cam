<Page x:Class="SS_CAM.Views.QuickNotePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Quick Note">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page Header -->
        <StackPanel Grid.Row="0" Margin="24,20,24,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE70B;" FontFamily="Segoe Fluent Icons" FontSize="22"
                           Foreground="{DynamicResource FluentBrand80}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="Quick Notes" FontSize="22" FontWeight="Bold"
                           Foreground="{DynamicResource FluentBrand80}" FontFamily="{StaticResource FluentFontFamily}"/>
            </StackPanel>
            <TextBlock Text="Personal Markdown scratchpad. Auto-saves as you type."
                       Foreground="{DynamicResource FluentLightTextSecondary}" FontSize="12"
                       Margin="0,3,0,0" FontFamily="{StaticResource FluentFontFamily}"/>
        </StackPanel>

        <!-- Main Two-Panel Body -->
        <Grid Grid.Row="1" Margin="24,0,24,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── Left: Notes List Sidebar ────────────────────────── -->
            <Border Grid.Column="0" Background="{DynamicResource FluentLightCardBg}"
                    BorderBrush="{DynamicResource FluentLightStroke}" BorderThickness="1" CornerRadius="8">
                <DockPanel>
                    <!-- New Note Button -->
                    <Border DockPanel.Dock="Top" Background="{DynamicResource FluentBrand80}"
                            CornerRadius="8,8,0,0">
                        <Button Click="OnNewNoteClicked" Background="Transparent" Foreground="White"
                                Height="40" BorderThickness="0" Cursor="Hand"
                                FontFamily="{StaticResource FluentFontFamily}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons" FontSize="14"
                                           Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="New Note" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Border>

                    <!-- Note count label -->
                    <Border DockPanel.Dock="Top" Background="{DynamicResource FluentLightCardSubBg}"
                            BorderBrush="{DynamicResource FluentLightStroke}" BorderThickness="0,0,0,1" Padding="10,6">
                        <TextBlock x:Name="TxtNoteCount" Text="0 notes"
                                   FontFamily="{StaticResource FluentFontFamily}" FontSize="10"
                                   Foreground="{DynamicResource FluentLightTextSecondary}"/>
                    </Border>

                    <!-- Note list -->
                    <ListBox x:Name="NotesList" SelectionChanged="OnNoteSelected"
                             BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Padding="6">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,4"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,6" CornerRadius="6" Cursor="Hand"
                                        Background="{DynamicResource FluentLightCardSubBg}"
                                        BorderBrush="{DynamicResource FluentLightStroke}" BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource FluentBrandLight}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource FluentBrandTint}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}"
                                                   FontFamily="{StaticResource FluentFontFamily}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource FluentLightTextPrimary}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding ModifiedDisplay}"
                                                   FontFamily="{StaticResource FluentFontFamily}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource FluentLightTextSecondary}"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- ── Right: Editor Pane ──────────────────────────────── -->
            <Border Grid.Column="2" Background="{DynamicResource FluentLightCardBg}"
                    BorderBrush="{DynamicResource FluentLightStroke}" BorderThickness="1" CornerRadius="8">
                <DockPanel>
                    <!-- Toolbar Row -->
                    <Border DockPanel.Dock="Top" Background="{DynamicResource FluentLightCardSubBg}"
                            BorderBrush="{DynamicResource FluentLightStroke}" BorderThickness="0,0,0,1"
                            CornerRadius="8,8,0,0" Padding="10,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- Markdown Toolbar -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Button x:Name="NMdBold" Content="B" Click="OnNMdBold" Height="26" Width="28"
                                        Background="Transparent" Foreground="{DynamicResource FluentBrand80}"
                                        FontFamily="{StaticResource FluentFontFamily}" FontWeight="Bold"
                                        FontSize="12" BorderThickness="0" Cursor="Hand" ToolTip="Bold"/>
                                <Button x:Name="NMdItalic" Content="I" Click="OnNMdItalic" Height="26" Width="28"
                                        Background="Transparent" Foreground="{DynamicResource FluentLightTextPrimary}"
                                        FontFamily="Georgia, serif" FontStyle="Italic" FontSize="12"
                                        BorderThickness="0" Cursor="Hand" ToolTip="Italic"/>
                                <Button x:Name="NMdCode" Click="OnNMdCode" Height="26" Width="28"
                                        Background="Transparent" Foreground="{DynamicResource FluentLightTextPrimary}"
                                        FontFamily="Consolas" FontSize="11" BorderThickness="0" Cursor="Hand" ToolTip="Inline code">
                                    <TextBlock Text="&lt;/&gt;" FontFamily="Consolas" FontSize="10"/>
                                </Button>
                                <Border Width="1" Background="{DynamicResource FluentLightStroke}" Margin="4,3"/>
                                <Button x:Name="NMdH2" Content="H2" Click="OnNMdH2" Height="26" Width="32"
                                        Background="Transparent" Foreground="{DynamicResource FluentLightTextPrimary}"
                                        FontFamily="{StaticResource FluentFontFamily}" FontWeight="SemiBold"
                                        FontSize="10" BorderThickness="0" Cursor="Hand" ToolTip="Heading 2"/>
                                <Button x:Name="NMdList" Content="• List" Click="OnNMdList" Height="26" Padding="4,0"
                                        Background="Transparent" Foreground="{DynamicResource FluentLightTextPrimary}"
                                        FontFamily="{StaticResource FluentFontFamily}" FontSize="10"
                                        BorderThickness="0" Cursor="Hand" ToolTip="List item"/>
                                <Button x:Name="NMdHR" Content="─ HR" Click="OnNMdHR" Height="26" Padding="4,0"
                                        Background="Transparent" Foreground="{DynamicResource FluentLightTextPrimary}"
                                        FontFamily="{StaticResource FluentFontFamily}" FontSize="10"
                                        BorderThickness="0" Cursor="Hand" ToolTip="Horizontal rule"/>
                                <Button x:Name="NMdLink" Click="OnNMdLink" Height="26" Padding="4,0"
                                        Background="Transparent" Foreground="{DynamicResource FluentLightTextPrimary}"
                                        FontFamily="{StaticResource FluentFontFamily}" FontSize="10"
                                        BorderThickness="0" Cursor="Hand" ToolTip="Link [text](url)">
                                    <TextBlock Text="&#xE71B;" FontFamily="Segoe Fluent Icons" FontSize="12"/>
                                </Button>
                            </StackPanel>

                            <!-- Mode + Status -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtSavedStatus" Text=""
                                           FontFamily="{StaticResource FluentFontFamily}" FontSize="10"
                                           Foreground="{DynamicResource FluentBrand80}" VerticalAlignment="Center"
                                           Margin="0,0,12,0"/>
                                <Border CornerRadius="4" Margin="0,0,4,0" Background="{DynamicResource FluentBrand80}">
                                    <Button x:Name="BtnModeEdit" Content="Edit" Click="OnModeEdit"
                                            Height="26" Padding="8,0" Background="Transparent" Foreground="White"
                                            FontSize="10" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                                            FontFamily="{StaticResource FluentFontFamily}"/>
                                </Border>
                                <Border CornerRadius="4" Background="{DynamicResource FluentLightCardSubBg}"
                                        BorderBrush="{DynamicResource FluentLightStroke}" BorderThickness="1" Margin="0,0,8,0">
                                    <Button x:Name="BtnModePreview" Content="Preview" Click="OnModePreview"
                                            Height="26" Padding="8,0" Background="Transparent"
                                            Foreground="{DynamicResource FluentLightTextPrimary}"
                                            FontSize="10" BorderThickness="0" Cursor="Hand"
                                            FontFamily="{StaticResource FluentFontFamily}"/>
                                </Border>
                                <Border CornerRadius="4" Background="#FFEEEE" BorderBrush="#FFAAAA" BorderThickness="1">
                                    <Button x:Name="BtnDeleteNote" Click="OnDeleteNoteClicked"
                                            Height="26" Padding="8,0" Background="Transparent" Foreground="#CC0000"
                                            FontSize="10" BorderThickness="0" Cursor="Hand"
                                            FontFamily="{StaticResource FluentFontFamily}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons" FontSize="11"
                                                       Margin="0,0,4,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Delete" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Empty state (no note selected) -->
                    <StackPanel x:Name="PanelEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="&#xE70B;" FontFamily="Segoe Fluent Icons" FontSize="48"
                                   Foreground="{DynamicResource FluentLightTextSecondary}"
                                   HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <TextBlock Text="Select a note or create a new one"
                                   FontFamily="{StaticResource FluentFontFamily}" FontSize="14"
                                   Foreground="{DynamicResource FluentLightTextSecondary}" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Edit Mode TextBox -->
                    <TextBox x:Name="NoteEditor"
                             AcceptsReturn="True" AcceptsTab="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="12"
                             Padding="16" BorderThickness="0"
                             Background="White"
                             Visibility="Collapsed"
                             TextChanged="OnNoteEditorChanged"/>

                    <!-- Preview Mode -->
                    <FlowDocumentScrollViewer x:Name="NotePreviewViewer"
                                             VerticalScrollBarVisibility="Auto"
                                             Background="White" BorderThickness="0"
                                             Padding="16" Visibility="Collapsed"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
