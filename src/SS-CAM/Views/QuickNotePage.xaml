<Page x:Class="SS_CAM.Views.QuickNotePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Quick Notes &amp; Markdown Studio"
      Focusable="True" KeyDown="OnPageKeyDown">

    <Grid Background="{DynamicResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page Header -->
        <Grid Grid.Row="0" Margin="24,18,24,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                    <ui:SymbolIcon Symbol="DocumentBulletList24" FontSize="22" Foreground="{DynamicResource FluentBrand80}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ui:TextBlock Text="Quick Notes &amp; Markdown Studio" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <ui:TextBlock Text="Notion-inspired creative scratchpad, briefs, meeting decisions, and ad scripts with live Markdown preview."
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13" Margin="0,2,0,0" />
            </StackPanel>

            <!-- Header Quick Action / Telemetry -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="12" Padding="10,4" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <ui:TextBlock Text="Ctrl+N" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource FluentBrand80}"/>
                        <ui:TextBlock Text=" New Note" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="4,0,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="12" Padding="10,4">
                    <StackPanel Orientation="Horizontal">
                        <ui:TextBlock Text="Ctrl+S" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource FluentBrand80}"/>
                        <ui:TextBlock Text=" Save" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="4,0,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Main Two-Panel Body -->
        <Grid Grid.Row="1" Margin="24,0,24,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ColSidebar" Width="300" MinWidth="0" MaxWidth="420"/>
                <ColumnDefinition x:Name="ColMainSplitter" Width="14"/>
                <ColumnDefinition x:Name="ColWorkspace" Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── Left: Notes List Sidebar (Evernote / Notion style) ── -->
            <Border x:Name="SidebarContainer" Grid.Column="0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="12,12,12,8">
                        <StackPanel>
                            <!-- Full-width Primary New Note Button -->
                            <ui:Button Click="OnNewNoteClicked" Appearance="Primary" Height="34"
                                       HorizontalAlignment="Stretch" Cursor="Hand" ToolTip="Create New Note (Ctrl+N)">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Add24" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <ui:TextBlock Text="New Note" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ui:Button>

                            <!-- Instant Search Box with Clear Button -->
                            <Grid Margin="0,8,0,8">
                                <ui:TextBox x:Name="TxtSearchNotes" PlaceholderText="Search notes..."
                                            TextChanged="OnSearchNotesChanged" Height="30" FontSize="11.5"
                                            Icon="Search24" Padding="8,0,26,0"/>
                                <ui:Button x:Name="BtnClearSearch" Click="OnClearSearchClicked"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"
                                           Height="20" Width="20" Padding="0" Background="Transparent" BorderThickness="0"
                                           Cursor="Hand" ToolTip="Clear search" Visibility="Collapsed">
                                    <ui:TextBlock Text="&#x2715;" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </ui:Button>
                            </Grid>

                            <!-- Filter Chips Row -->
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal">
                                    <ui:Button x:Name="BtnFilterAll" Appearance="Secondary" Height="26" Padding="8,0" Margin="0,0,4,0"
                                               Click="OnFilterAllClicked" Cursor="Hand" ToolTip="All Notes">
                                        <ui:TextBlock x:Name="TxtFilterAll" Text="All" FontSize="11" VerticalAlignment="Center"/>
                                    </ui:Button>
                                    <ui:Button x:Name="BtnFilterPinned" Appearance="Secondary" Height="26" Padding="8,0" Margin="0,0,4,0"
                                               Click="OnFilterPinnedClicked" Cursor="Hand" ToolTip="Pinned Notes">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:TextBlock x:Name="IconFilterPinned" Text="&#xE718;" FontFamily="Segoe Fluent Icons" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                            <ui:TextBlock x:Name="TxtFilterPinned" Text="Pin" FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ui:Button>
                                    <ui:Button x:Name="BtnFilterHigh" Appearance="Secondary" Height="26" Padding="8,0" Margin="0,0,4,0"
                                               Click="OnFilterHighClicked" Cursor="Hand" ToolTip="High Priority Notes">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:TextBlock x:Name="IconFilterHigh" Text="&#xE7BA;" FontFamily="Segoe Fluent Icons" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                            <ui:TextBlock x:Name="TxtFilterHigh" Text="High" FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ui:Button>
                                    <ui:Button x:Name="BtnFilterTasks" Appearance="Secondary" Height="26" Padding="8,0" Margin="0,0,4,0"
                                               Click="OnFilterTasksClicked" Cursor="Hand" ToolTip="Notes with Tasks">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:TextBlock x:Name="IconFilterTasks" Text="&#xE73A;" FontFamily="Segoe Fluent Icons" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                            <ui:TextBlock x:Name="TxtFilterTasks" Text="Tasks" FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ui:Button>
                                    <ui:Button x:Name="BtnFilterIdeas" Appearance="Secondary" Height="26" Padding="8,0" Margin="0,0,4,0"
                                               Click="OnFilterIdeasClicked" Cursor="Hand" ToolTip="Ideas &amp; Brainstorms">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:TextBlock Text="&#x1F4A1;" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                            <ui:TextBlock x:Name="TxtFilterIdeas" Text="Ideas" FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ui:Button>
                                    <ui:Button x:Name="BtnFilterBriefs" Appearance="Secondary" Height="26" Padding="8,0"
                                               Click="OnFilterBriefsClicked" Cursor="Hand" ToolTip="Creative Briefs">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:TextBlock Text="&#x1F4CB;" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                            <ui:TextBlock x:Name="TxtFilterBriefs" Text="Briefs" FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ui:Button>
                                </StackPanel>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <!-- Subheader: Note count + Sort selector -->
                    <Border DockPanel.Dock="Top" Background="{DynamicResource SubtitleBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,1" Padding="12,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:TextBlock x:Name="TxtNoteCount" Text="0 notes"
                                        FontSize="11" FontWeight="Medium"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CmbSort" Grid.Column="1" SelectionChanged="OnSortChanged"
                                      Height="24" FontSize="10.5" Padding="6,0" VerticalContentAlignment="Center"
                                      ToolTip="Sort notes list">
                                <ComboBoxItem Content="Recently Edited" IsSelected="True"/>
                                <ComboBoxItem Content="Date Created"/>
                                <ComboBoxItem Content="Title (A-Z)"/>
                                <ComboBoxItem Content="Priority"/>
                            </ComboBox>
                        </Grid>
                    </Border>

                    <!-- Note List -->
                    <ListBox x:Name="NotesList" SelectionChanged="OnNoteSelected"
                             BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Padding="8">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,4"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="ItemBorder" Padding="10,9" CornerRadius="6" Cursor="Hand"
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Selection Indicator Bar -->
                                        <Border x:Name="SelectionPill" Grid.Column="0" Width="3" CornerRadius="1.5"
                                                Background="{DynamicResource FluentBrand80}" Margin="0,0,8,0"
                                                Visibility="Collapsed"/>

                                        <!-- Notion-style Note Icon Avatar -->
                                        <Border Grid.Column="0" Width="28" Height="28" CornerRadius="6"
                                                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                Margin="0,0,8,0" VerticalAlignment="Top" HorizontalAlignment="Center">
                                            <ui:TextBlock Text="{Binding Icon}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Center Info Column -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <ui:TextBlock Text="&#xE718;" FontFamily="Segoe Fluent Icons" FontSize="11"
                                                           Foreground="{DynamicResource FluentBrand80}"
                                                           Visibility="{Binding PinBadgeVisibility}"
                                                           Margin="0,0,4,0" VerticalAlignment="Center" ToolTip="Pinned Note"/>
                                                <ui:TextBlock Text="{Binding Title}"
                                                           FontSize="12.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Title}" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- Body snippet preview -->
                                            <ui:TextBlock Text="{Binding Snippet}"
                                                       FontSize="10.5"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,2,0,4"
                                                       Opacity="0.85"/>

                                            <!-- Meta row: Category pill + Modified date + task count -->
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- Category Badge -->
                                                <Border Visibility="{Binding CategoryBadgeVisibility}" Background="{DynamicResource FluentBrandTint}"
                                                        CornerRadius="3" Padding="4,1" Margin="0,0,6,0" VerticalAlignment="Center">
                                                    <ui:TextBlock Text="{Binding CategoryDisplay}" FontSize="9" FontWeight="SemiBold"
                                                                  Foreground="{DynamicResource FluentBrand80}"/>
                                                </Border>

                                                <ui:TextBlock Text="{Binding ModifiedDisplay}"
                                                           FontSize="9.5"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           VerticalAlignment="Center"/>

                                                <Border Visibility="{Binding TaskBadgeVisibility}" Background="{DynamicResource TextControlBackground}"
                                                        CornerRadius="3" Padding="4,0" Margin="6,0,0,0" VerticalAlignment="Center">
                                                    <ui:TextBlock Text="{Binding TaskProgressDisplay}" FontSize="9"
                                                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Priority Badge Tag -->
                                        <Border Grid.Column="2" CornerRadius="3" Padding="4,1" VerticalAlignment="Center" Margin="4,0,0,0"
                                                Visibility="{Binding PriorityBadgeVisibility}"
                                                Background="{DynamicResource SystemFillColorCautionBrush}">
                                            <ui:TextBlock Text="{Binding PriorityLabel}" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                        </Border>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                        <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource FluentBrandTint}"/>
                                        <Setter TargetName="SelectionPill" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}" Value="True">
                                        <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Splitter between Sidebar & Workspace -->
            <GridSplitter x:Name="MainPaneSplitter" Grid.Column="1" Width="6" HorizontalAlignment="Center"
                          Background="Transparent" Cursor="SizeWE"/>

            <!-- ── Right: Notion & Evernote Markdown Studio Pane ── -->
            <Border Grid.Column="2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <DockPanel>
                    <!-- Top Ribbon Accent Bar -->
                    <Border DockPanel.Dock="Top" Height="3" Background="{DynamicResource FluentBrand80}" CornerRadius="8,8,0,0"/>

                    <!-- Notion Page Header & Property Matrix (Only visible when a note is active) -->
                    <Border x:Name="PanelPageHeader" DockPanel.Dock="Top" Background="{DynamicResource SubtitleBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="16,12"
                            Visibility="Collapsed">
                        <StackPanel>
                            <!-- Row 1: Icon Avatar Button + Large Title + Action Tools -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Page Icon Picker Button -->
                                <ui:Button x:Name="BtnPageIcon" Grid.Column="0" Click="OnPageIconClicked"
                                           Height="38" Width="38" Padding="0" Cursor="Hand" Margin="0,0,10,0"
                                           Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                           BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                           ToolTip="Choose Page Icon / Emoji">
                                    <ui:TextBlock x:Name="TxtPageIcon" Text="&#x1F4DD;" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <ui:Button.ContextMenu>
                                        <ContextMenu x:Name="MenuIconPicker">
                                            <MenuItem Header="&#x1F4DD; Document / Notes" Click="OnSelectIconOption" Tag="&#x1F4DD;"/>
                                            <MenuItem Header="&#x1F4A1; Idea &amp; Concept" Click="OnSelectIconOption" Tag="&#x1F4A1;"/>
                                            <MenuItem Header="&#x1F3AF; Goals &amp; Sprint" Click="OnSelectIconOption" Tag="&#x1F3AF;"/>
                                            <MenuItem Header="&#x1F680; Project Launch" Click="OnSelectIconOption" Tag="&#x1F680;"/>
                                            <MenuItem Header="&#x1F4CB; Creative Brief" Click="OnSelectIconOption" Tag="&#x1F4CB;"/>
                                            <MenuItem Header="&#x26A1; High Priority / Script" Click="OnSelectIconOption" Tag="&#x26A1;"/>
                                            <MenuItem Header="&#x1F4AC; Meeting &amp; Discussion" Click="OnSelectIconOption" Tag="&#x1F4AC;"/>
                                            <MenuItem Header="&#x1F3A8; Design &amp; Brand" Click="OnSelectIconOption" Tag="&#x1F3A8;"/>
                                            <MenuItem Header="&#x1F4CA; Analytics &amp; Stats" Click="OnSelectIconOption" Tag="&#x1F4CA;"/>
                                            <MenuItem Header="&#x2615; Coffee / Casual" Click="OnSelectIconOption" Tag="&#x2615;"/>
                                            <MenuItem Header="&#x1F3F7;&#xFE0F; Specs &amp; Checklist" Click="OnSelectIconOption" Tag="&#x1F3F7;&#xFE0F;"/>
                                            <MenuItem Header="&#x1F4CC; Milestone Anchor" Click="OnSelectIconOption" Tag="&#x1F4CC;"/>
                                        </ContextMenu>
                                    </ui:Button.ContextMenu>
                                </ui:Button>

                                <!-- Notion-style Inline Title Box -->
                                <TextBox x:Name="TxtNoteTitle" Grid.Column="1" Text="Untitled Note"
                                         FontSize="20" FontWeight="Bold" Background="Transparent" BorderThickness="0"
                                         Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                         CaretBrush="{DynamicResource TextFillColorPrimaryBrush}"
                                         VerticalAlignment="Center" TextChanged="OnNoteTitleChanged"/>

                                <!-- Header Action Tools (Pin, Zen, Delete) -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Pin Toggle Button -->
                                    <ui:Button x:Name="BtnTogglePin" Click="OnTogglePinClicked"
                                               Height="30" Width="30" Padding="0" Cursor="Hand" Margin="0,0,6,0"
                                               ToolTip="Pin note to top">
                                        <ui:TextBlock Text="&#xE718;" FontFamily="Segoe Fluent Icons" FontSize="13"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </ui:Button>

                                    <!-- Focus / Zen Mode Toggle (Collapses Sidebar) -->
                                    <ui:Button x:Name="BtnToggleZen" Click="OnToggleZenClicked"
                                               Height="30" Width="30" Padding="0" Cursor="Hand" Margin="0,0,6,0"
                                               ToolTip="Toggle Distraction-Free Focus Mode">
                                        <ui:SymbolIcon Symbol="FullScreen24" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </ui:Button>

                                    <!-- Delete Note Button -->
                                    <ui:Button x:Name="BtnDeleteNote" Appearance="Danger" Click="OnDeleteNoteClicked"
                                               Height="30" Width="30" Padding="0" Cursor="Hand" ToolTip="Delete Note">
                                        <ui:TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons" FontSize="13"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </ui:Button>
                                </StackPanel>
                            </Grid>

                            <!-- Row 2: Notion Property Matrix Bar -->
                            <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="6" Padding="10,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Category Tag Selector -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <ui:TextBlock Text="&#x1F3F7;&#xFE0F;" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <ui:TextBlock Text="Category:" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="CmbCategory" SelectionChanged="OnCategoryChanged"
                                                  Height="26" Width="108" FontSize="11" Padding="6,0" VerticalContentAlignment="Center" ToolTip="Set note category">
                                            <ComboBoxItem Content="General"/>
                                            <ComboBoxItem Content="Brief"/>
                                            <ComboBoxItem Content="Meeting"/>
                                            <ComboBoxItem Content="Idea"/>
                                            <ComboBoxItem Content="Copywriting"/>
                                            <ComboBoxItem Content="Tasks"/>
                                            <ComboBoxItem Content="Feedback"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- Priority Selector -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <ui:TextBlock Text="&#x26A1;" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <ui:TextBlock Text="Priority:" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="CmbPriority" SelectionChanged="OnPriorityChanged"
                                                  Height="26" Width="96" FontSize="11" Padding="6,0" VerticalContentAlignment="Center" ToolTip="Set note priority">
                                            <ComboBoxItem Content="Normal"/>
                                            <ComboBoxItem Content="Medium (P1)"/>
                                            <ComboBoxItem Content="High (P2)"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- Timestamps & Reading Metrics -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:TextBlock x:Name="TxtLastEditedInfo" Text="Edited just now" FontSize="11"
                                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                        <ui:TextBlock x:Name="TxtReadingTime" Text="1 min read" FontSize="11"
                                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Templates & Export Dropdowns -->
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Templates Dropdown -->
                                        <ui:Button x:Name="BtnTemplates" Click="OnTemplatesButtonClicked" Height="26" Padding="8,0" Margin="0,0,6,0"
                                                   Cursor="Hand" ToolTip="Insert Notion Starter Template">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="DocumentSync24" FontSize="12" Margin="0,0,4,0"/>
                                                <ui:TextBlock Text="Templates &#x25BE;" FontSize="11"/>
                                            </StackPanel>
                                            <ui:Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="&#x1F4CB; Creative Brief (Notion Standard)" Click="OnTemplateBriefClicked"/>
                                                    <MenuItem Header="&#x1F4AC; Meeting Minutes &amp; Decisions" Click="OnTemplateMeetingClicked"/>
                                                    <MenuItem Header="&#x26A1; Direct-Response Ad Script &amp; 3-Hook Matrix" Click="OnTemplateTikTokClicked"/>
                                                    <MenuItem Header="&#x1F4A1; Mind Drop &amp; Concept Brainstorm" Click="OnTemplateMindDropClicked"/>
                                                    <Separator/>
                                                    <MenuItem Header="&#x1F3AF; Creative Sprint &amp; Task Backlog" Click="OnTemplateTaskSprintClicked"/>
                                                    <MenuItem Header="&#x1F4CB; Client Feedback &amp; Revision Log" Click="OnTemplateFeedbackClicked"/>
                                                </ContextMenu>
                                            </ui:Button.ContextMenu>
                                        </ui:Button>

                                        <!-- Export / Copy Dropdown -->
                                        <ui:Button x:Name="BtnExport" Click="OnExportButtonClicked" Height="26" Padding="8,0"
                                                   Cursor="Hand" ToolTip="Copy &amp; Export Options">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Share24" FontSize="12" Margin="0,0,4,0"/>
                                                <ui:TextBlock Text="Export &#x25BE;" FontSize="11"/>
                                            </StackPanel>
                                            <ui:Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="&#x1F4CB; Copy Clean Plain Text (for WhatsApp/Slack)" Click="OnCopyCleanTextClicked"/>
                                                    <MenuItem Header="&#x1F4DD; Copy Raw Markdown" Click="OnCopyMarkdownClicked"/>
                                                    <Separator/>
                                                    <MenuItem Header="&#x1F4BE; Export as .md File" Click="OnExportMdFileClicked"/>
                                                </ContextMenu>
                                            </ui:Button.ContextMenu>
                                        </ui:Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Notion Markdown & Block Formatting Toolbar -->
                    <Border x:Name="PanelMarkdownToolbar" DockPanel.Dock="Top" Background="{DynamicResource SubtitleBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="12,6"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: Markdown & Notion Block Formatter Tools -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Headings -->
                                <ui:Button x:Name="NMdH1" Content="H1" Click="OnNMdH1" Height="26" MinWidth="26" Padding="4,0"
                                           Background="Transparent" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           FontWeight="Bold" FontSize="11" BorderThickness="0" Cursor="Hand" ToolTip="Heading 1 (# text)"/>
                                <ui:Button x:Name="NMdH2" Content="H2" Click="OnNMdH2" Height="26" MinWidth="26" Padding="4,0"
                                           Background="Transparent" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           FontWeight="SemiBold" FontSize="11" BorderThickness="0" Cursor="Hand" ToolTip="Heading 2 (## text)"/>
                                <ui:Button x:Name="NMdH3" Content="H3" Click="OnNMdH3" Height="26" MinWidth="26" Padding="4,0"
                                           Background="Transparent" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           FontWeight="SemiBold" FontSize="11" BorderThickness="0" Cursor="Hand" ToolTip="Heading 3 (### text)"/>

                                <Border Width="1" Height="14" Background="{DynamicResource CardStrokeColorDefaultBrush}" Margin="4,0"/>

                                <!-- Inline Styles -->
                                <ui:Button x:Name="NMdBold" Content="B" Click="OnNMdBold" Height="26" MinWidth="26" Padding="4,0"
                                           Background="Transparent" Foreground="{DynamicResource FluentBrand80}"
                                           FontWeight="Bold" FontSize="13" BorderThickness="0" Cursor="Hand" ToolTip="Bold (**text**)"/>
                                <ui:Button x:Name="NMdItalic" Content="I" Click="OnNMdItalic" Height="26" MinWidth="26" Padding="4,0"
                                           Background="Transparent" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           FontFamily="Georgia, serif" FontStyle="Italic" FontSize="13"
                                           BorderThickness="0" Cursor="Hand" ToolTip="Italic (*text*)"/>
                                <ui:Button x:Name="NMdStrike" Click="OnNMdStrike" Height="26" MinWidth="26" Padding="4,0"
                                           Background="Transparent" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           BorderThickness="0" Cursor="Hand" ToolTip="Strikethrough (~~text~~)">
                                    <ui:TextBlock Text="S" FontSize="13" TextDecorations="Strikethrough" VerticalAlignment="Center"/>
                                </ui:Button>
                                <ui:Button x:Name="NMdCode" Click="OnNMdCode" Height="26" MinWidth="26" Padding="4,0"
                                           Background="Transparent" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           BorderThickness="0" Cursor="Hand" ToolTip="Inline code (`code`)">
                                    <ui:TextBlock Text="&lt;/&gt;" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"/>
                                </ui:Button>

                                <Border Width="1" Height="14" Background="{DynamicResource CardStrokeColorDefaultBrush}" Margin="4,0"/>

                                <!-- Notion Blocks: Callouts, Tables, Checklists -->
                                <!-- Callout Box Dropdown -->
                                <ui:Button x:Name="BtnInsertCallout" Click="OnInsertCalloutClicked" Height="26" Padding="6,0"
                                           Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Insert Notion Callout Box">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:TextBlock Text="&#x1F4A1;" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <ui:TextBlock Text="Callout &#x25BE;" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <ui:Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="&#x2139;&#xFE0F; Note Box (Blue Info)" Click="OnCalloutNoteClicked"/>
                                            <MenuItem Header="&#x1F4A1; Tip Box (Green Idea)" Click="OnCalloutTipClicked"/>
                                            <MenuItem Header="&#x26A0;&#xFE0F; Warning Box (Amber Caution)" Click="OnCalloutWarningClicked"/>
                                            <MenuItem Header="&#x1F6A8; Danger Box (Red Critical)" Click="OnCalloutDangerClicked"/>
                                        </ContextMenu>
                                    </ui:Button.ContextMenu>
                                </ui:Button>

                                <!-- Table Dropdown / Inserter -->
                                <ui:Button x:Name="BtnInsertTable" Click="OnInsertTableClicked" Height="26" Padding="6,0"
                                           Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Insert Markdown Table">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Table24" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <ui:TextBlock Text="Table" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ui:Button>

                                <!-- Task Checklist -->
                                <ui:Button x:Name="NMdCheck" Click="OnNMdCheck" Height="26" Padding="6,0"
                                           Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Insert Task Checkbox (- [ ])">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:TextBlock Text="&#xE73A;" FontFamily="Segoe Fluent Icons" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <ui:TextBlock Text="Todo" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ui:Button>

                                <!-- Lists & Blocks -->
                                <ui:Button x:Name="NMdList" Click="OnNMdList" Height="26" MinWidth="26" Padding="4,0"
                                           Background="Transparent" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           BorderThickness="0" Cursor="Hand" ToolTip="Bullet list (- text)">
                                    <ui:TextBlock Text="&#x2022;" FontSize="13" VerticalAlignment="Center"/>
                                </ui:Button>
                                <ui:Button x:Name="NMdNumList" Click="OnNMdNumList" Height="26" MinWidth="26" Padding="4,0"
                                           Background="Transparent" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           BorderThickness="0" Cursor="Hand" ToolTip="Numbered list (1. text)">
                                    <ui:TextBlock Text="1." FontSize="11" VerticalAlignment="Center"/>
                                </ui:Button>
                                <ui:Button x:Name="NMdQuote" Click="OnNMdQuote" Height="26" MinWidth="26" Padding="4,0"
                                           Background="Transparent" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           BorderThickness="0" Cursor="Hand" ToolTip="Blockquote (&gt; text)">
                                    <ui:TextBlock Text="&#x275D;" FontSize="12" VerticalAlignment="Center"/>
                                </ui:Button>
                                <ui:Button x:Name="NMdCodeBlock" Click="OnNMdCodeBlock" Height="26" MinWidth="26" Padding="4,0"
                                           Background="Transparent" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           BorderThickness="0" Cursor="Hand" ToolTip="Code block (``` block ```)">
                                    <ui:TextBlock Text="&#xE943;" FontFamily="Segoe Fluent Icons" FontSize="12" VerticalAlignment="Center"/>
                                </ui:Button>
                                <ui:Button x:Name="NMdHR" Click="OnNMdHR" Height="26" MinWidth="26" Padding="4,0"
                                           Background="Transparent" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           BorderThickness="0" Cursor="Hand" ToolTip="Horizontal rule (---)">
                                    <ui:TextBlock Text="&#x2015;" FontSize="11" VerticalAlignment="Center"/>
                                </ui:Button>
                                <ui:Button x:Name="NMdLink" Click="OnNMdLink" Height="26" MinWidth="26" Padding="4,0"
                                           Background="Transparent" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           BorderThickness="0" Cursor="Hand" ToolTip="Link [text](url)">
                                    <ui:TextBlock Text="&#xE71B;" FontFamily="Segoe Fluent Icons" FontSize="12" VerticalAlignment="Center"/>
                                </ui:Button>
                                <ui:Button x:Name="NMdImage" Click="OnNMdImage" Height="26" MinWidth="26" Padding="4,0"
                                           Background="Transparent" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           BorderThickness="0" Cursor="Hand" ToolTip="Image ![alt](url)">
                                    <ui:TextBlock Text="&#xEB9F;" FontFamily="Segoe Fluent Icons" FontSize="12" VerticalAlignment="Center"/>
                                </ui:Button>

                                <Border Width="1" Height="14" Background="{DynamicResource CardStrokeColorDefaultBrush}" Margin="4,0"/>

                                <!-- Markdown Cheatsheet Drawer Toggle -->
                                <ui:Button x:Name="BtnMarkdownHelp" Click="OnToggleMarkdownHelp" Height="26" Width="26" Padding="0"
                                           Background="Transparent" Foreground="{DynamicResource FluentBrand80}"
                                           BorderThickness="0" Cursor="Hand" ToolTip="Markdown Reference &amp; Syntax Guide">
                                    <ui:TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </ui:Button>
                            </StackPanel>

                            <!-- Right: 3-Way Mode Segmented Switcher (Split / Edit / Preview) -->
                            <Border Grid.Column="1" CornerRadius="4" Background="{DynamicResource ControlFillColorSecondaryBrush}" Padding="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <ui:Button x:Name="BtnModeSplit" Click="OnModeSplit"
                                               Height="24" Padding="8,0" Background="{DynamicResource FluentBrand80}"
                                               Foreground="White" BorderThickness="0" Cursor="Hand" ToolTip="Split View (Side-by-side Live Preview)">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="SplitVertical24" FontSize="12" Margin="0,0,4,0"/>
                                            <ui:TextBlock Text="Split" FontSize="11" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </ui:Button>
                                    <ui:Button x:Name="BtnModeEdit" Click="OnModeEdit"
                                               Height="24" Padding="8,0" Background="Transparent"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               BorderThickness="0" Cursor="Hand" ToolTip="Edit Markdown Only">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Edit24" FontSize="12" Margin="0,0,4,0"/>
                                            <ui:TextBlock Text="Edit" FontSize="11"/>
                                        </StackPanel>
                                    </ui:Button>
                                    <ui:Button x:Name="BtnModePreview" Click="OnModePreview"
                                               Height="24" Padding="8,0" Background="Transparent"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               BorderThickness="0" Cursor="Hand" ToolTip="Preview Rendered Markdown Only">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Eye24" FontSize="12" Margin="0,0,4,0"/>
                                            <ui:TextBlock Text="Preview" FontSize="11"/>
                                        </StackPanel>
                                    </ui:Button>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Bottom Telemetry & Sync Strip -->
                    <Border DockPanel.Dock="Bottom" Background="{DynamicResource SubtitleBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"
                            Padding="14,6" CornerRadius="0,0,8,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:TextBlock x:Name="TxtWordCount" Text="0 words" FontSize="11"
                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,12,0"/>
                                <ui:TextBlock x:Name="TxtCharCount" Text="0 characters" FontSize="11"
                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,12,0"/>
                                <ui:TextBlock x:Name="TxtTaskStats" Text="0 tasks" FontSize="11"
                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,12,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:TextBlock x:Name="TxtSyncStatus" Text="&#x25CF; NAS Synced" FontSize="11" FontWeight="SemiBold"
                                              Foreground="{DynamicResource SystemFillColorSuccessBrush}" VerticalAlignment="Center"
                                              Margin="0,0,10,0"/>
                                <ui:TextBlock x:Name="TxtSavedStatus" Text="" FontSize="11"
                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Main Content Grid -->
                    <Grid>
                        <!-- Notion / Evernote Inspiring Empty State (no note selected) -->
                        <Grid x:Name="PanelEmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="32">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="580">
                                <Border Width="64" Height="64" CornerRadius="32" Background="{DynamicResource FluentBrandTint}"
                                        HorizontalAlignment="Center" Margin="0,0,0,16">
                                    <ui:SymbolIcon Symbol="DocumentBulletList24" FontSize="32"
                                                   Foreground="{DynamicResource FluentBrand80}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ui:TextBlock Text="Quick Notes &amp; Creative Studio"
                                            FontSize="18" FontWeight="Bold"
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center"/>
                                <ui:TextBlock Text="Capture briefs, meeting minutes, and ad scripts with live Markdown and Notion-style callout blocks."
                                            FontSize="12.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            HorizontalAlignment="Center" Margin="0,6,0,24" TextWrapping="Wrap" TextAlignment="Center"/>

                                <!-- Quick Starter Template Cards (2x2 Grid) -->
                                <UniformGrid Columns="2" Margin="0,0,0,20">
                                    <!-- Card 1: Creative Brief -->
                                    <Border Margin="6" Padding="12" CornerRadius="6" Cursor="Hand"
                                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                            MouseLeftButtonUp="OnQuickCardBriefClicked">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <ui:TextBlock Text="&#x1F4CB;" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <ui:TextBlock Text="Creative Brief" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            </StackPanel>
                                            <ui:TextBlock Text="Objectives, audience, deliverables matrix &amp; hooks" FontSize="10.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Card 2: Meeting Minutes -->
                                    <Border Margin="6" Padding="12" CornerRadius="6" Cursor="Hand"
                                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                            MouseLeftButtonUp="OnQuickCardMeetingClicked">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <ui:TextBlock Text="&#x1F4AC;" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <ui:TextBlock Text="Meeting Sync" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            </StackPanel>
                                            <ui:TextBlock Text="Attendees, agenda, key decisions &amp; action checklist" FontSize="10.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Card 3: Ad Hook Matrix -->
                                    <Border Margin="6" Padding="12" CornerRadius="6" Cursor="Hand"
                                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                            MouseLeftButtonUp="OnQuickCardAdHookClicked">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <ui:TextBlock Text="&#x26A1;" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <ui:TextBlock Text="3-Hook Ad Matrix" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            </StackPanel>
                                            <ui:TextBlock Text="TikTok/Reels hooks, retention cues &amp; CTA scripts" FontSize="10.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Card 4: Mind Drop -->
                                    <Border Margin="6" Padding="12" CornerRadius="6" Cursor="Hand"
                                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                            MouseLeftButtonUp="OnQuickCardMindDropClicked">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <ui:TextBlock Text="&#x1F4A1;" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <ui:TextBlock Text="Mind Drop" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            </StackPanel>
                                            <ui:TextBlock Text="Raw ideas, moodboard notes &amp; concept validation" FontSize="10.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <!-- Primary Create Blank Note Button -->
                                <ui:Button Click="OnNewNoteClicked" Appearance="Primary" Height="34" Padding="16,0"
                                           HorizontalAlignment="Center" Cursor="Hand" ToolTip="Create New Blank Note (Ctrl+N)">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Add24" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <ui:TextBlock Text="Create Blank Note" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ui:Button>
                            </StackPanel>
                        </Grid>

                        <!-- Active Note Workspace (Split / Edit / Preview) -->
                        <Grid x:Name="PanelActiveWorkspace" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="ColNoteEditor" Width="*"/>
                                <ColumnDefinition x:Name="ColNoteSplitter" Width="6"/>
                                <ColumnDefinition x:Name="ColNotePreview" Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Edit Mode TextBox -->
                            <TextBox x:Name="NoteEditor" Grid.Column="0"
                                     AcceptsReturn="True" AcceptsTab="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     FontFamily="Consolas, Cascadia Mono, Segoe UI" FontSize="13"
                                     Padding="18" BorderThickness="0"
                                     Background="{DynamicResource TextControlBackground}"
                                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                     CaretBrush="{DynamicResource TextFillColorPrimaryBrush}"
                                     TextChanged="OnNoteEditorChanged"/>

                            <!-- Splitter -->
                            <GridSplitter x:Name="NoteGridSplitter" Grid.Column="1" Width="6"
                                          HorizontalAlignment="Center" Background="{DynamicResource CardStrokeColorDefaultBrush}"
                                          Cursor="SizeWE"/>

                            <!-- Live Rendered Markdown Preview -->
                            <FlowDocumentScrollViewer x:Name="NotePreviewViewer" Grid.Column="2"
                                                      FontFamily="{DynamicResource FluentFontFamily}"
                                                      VerticalScrollBarVisibility="Auto"
                                                      Background="{DynamicResource TextControlBackground}" BorderThickness="0"
                                                      Padding="22"/>
                        </Grid>

                        <!-- Markdown Guide Slide-out Drawer Panel -->
                        <Border x:Name="PanelMarkdownHelp" HorizontalAlignment="Right" Width="320"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,0,0"
                                Visibility="Collapsed">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Drawer Header -->
                                <Border Grid.Row="0" Background="{DynamicResource SubtitleBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"
                                        Padding="14,10">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons" FontSize="14"
                                                       Foreground="{DynamicResource FluentBrand80}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <ui:TextBlock Text="Markdown &amp; Notion Reference" FontWeight="Bold" FontSize="13"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <ui:Button Click="OnCloseMarkdownHelp" Height="24" Width="24" Padding="0"
                                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                                Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Close guide">
                                            <ui:TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </ui:Button>
                                    </Grid>
                                </Border>

                                <!-- Scrollable Cheatsheet Content -->
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="14">
                                    <StackPanel>
                                        <!-- Notion Callouts -->
                                        <ui:TextBlock Text="NOTION CALLOUT BLOCKS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource FluentBrand80}" Margin="0,0,0,6"/>
                                        <Border Background="{DynamicResource TextControlBackground}" CornerRadius="4" Padding="8" Margin="0,0,0,14">
                                            <StackPanel>
                                                <ui:TextBlock Text="&gt; [!NOTE] Title" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                <ui:TextBlock Text="&gt; Info note text" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,1,0,4"/>

                                                <ui:TextBlock Text="&gt; [!TIP] Pro-Tip" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                <ui:TextBlock Text="&gt; Helpful suggestion" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,1,0,4"/>

                                                <ui:TextBlock Text="&gt; [!WARNING] Caution" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                <ui:TextBlock Text="&gt; Regulatory compliance warning" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,1,0,4"/>

                                                <ui:TextBlock Text="&gt; [!DANGER] Urgent" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                <ui:TextBlock Text="&gt; Critical alert text" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,1,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Markdown Tables -->
                                        <ui:TextBlock Text="TABLES" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource FluentBrand80}" Margin="0,0,0,6"/>
                                        <Border Background="{DynamicResource TextControlBackground}" CornerRadius="4" Padding="8" Margin="0,0,0,14">
                                            <StackPanel>
                                                <ui:TextBlock Text="| Deliverable | Format | Ratio |" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                <ui:TextBlock Text="| :--- | :--- | :--- |" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                <ui:TextBlock Text="| Video Ad | MP4 | 9:16 |" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Headings -->
                                        <ui:TextBlock Text="HEADINGS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource FluentBrand80}" Margin="0,0,0,6"/>
                                        <Border Background="{DynamicResource TextControlBackground}" CornerRadius="4" Padding="8" Margin="0,0,0,14">
                                            <StackPanel>
                                                <ui:TextBlock Text="# Heading 1" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                <ui:TextBlock Text="## Heading 2" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,3,0,0"/>
                                                <ui:TextBlock Text="### Heading 3" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Lists & Tasks -->
                                        <ui:TextBlock Text="CHECKLISTS &amp; LISTS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource FluentBrand80}" Margin="0,0,0,6"/>
                                        <Border Background="{DynamicResource TextControlBackground}" CornerRadius="4" Padding="8" Margin="0,0,0,14">
                                            <StackPanel>
                                                <ui:TextBlock Text="- [ ] Todo task item" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                <ui:TextBlock Text="- [x] Completed task" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,3,0,0"/>
                                                <ui:TextBlock Text="- Bullet list item" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,3,0,0"/>
                                                <ui:TextBlock Text="1. Numbered item" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Text Formatting -->
                                        <ui:TextBlock Text="INLINE STYLES" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource FluentBrand80}" Margin="0,0,0,6">
                                        </ui:TextBlock>
                                        <Border Background="{DynamicResource TextControlBackground}" CornerRadius="4" Padding="8" Margin="0,0,0,6">
                                            <StackPanel>
                                                <ui:TextBlock Text="**Bold text**" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                <ui:TextBlock Text="*Italic text*" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,3,0,0"/>
                                                <ui:TextBlock Text="~~Strikethrough~~" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,3,0,0"/>
                                                <ui:TextBlock Text="`inline code`" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
