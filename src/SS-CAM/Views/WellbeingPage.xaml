<Page x:Class="SS_CAM.Views.WellbeingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Creative Wellbeing">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>
            <!-- Header with Casual Healthy Mind Tips -->
            <StackPanel Margin="0,0,0,20">
                <ui:TextBlock Text="Creative Wellbeing &amp; Energy Suite" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource FluentBrand80}" />
                <ui:TextBlock Text="Your personal space to stay focused, rest your eyes &amp; spine, and keep a calm, healthy mind while designing." Foreground="{DynamicResource FluentLightTextSecondary}" FontSize="13" Margin="0,4,0,0" />
            </StackPanel>

            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: Focus Timer & Breathing Animation -->
                <StackPanel Grid.Column="0">
                    <!-- Animated Focus & Breathing Timer Card -->
                    <ui:Card Padding="20" Margin="0,0,0,16">
                        <StackPanel HorizontalAlignment="Center">
                            <ui:TextBlock Text="CREATIVE TIMER &amp; BREATHING RHYTHM" Foreground="{DynamicResource FluentLightTextSecondary}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,12" />

                            <!-- Animated Pulsing Canvas Ring -->
                            <Grid Width="160" Height="160" Margin="0,0,0,14">
                                <Canvas x:Name="BreathingCanvas" Width="160" Height="160"/>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <ui:TextBlock x:Name="TxtTimerDisplay" Text="25:00" FontSize="36" FontWeight="Bold" Foreground="{DynamicResource FluentBrand80}" HorizontalAlignment="Center" />
                                    <ui:TextBlock x:Name="TxtBreathingInstruction" Text="Ready" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource FluentBrandTint}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>

                            <ui:TextBlock x:Name="TxtTimerStatus" Text="Select a mode below to begin your session." FontSize="12" Foreground="{DynamicResource FluentLightTextSecondary}" HorizontalAlignment="Center" Margin="0,0,0,14" />

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <ui:Button x:Name="BtnStartFocus" Click="BtnStartFocus_Click" Appearance="Primary" Height="38" Padding="14,0" Margin="0,0,6,0" FontWeight="Bold" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal"><ui:TextBlock Text="&#xE7C3;" FontFamily="Segoe Fluent Icons" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/><ui:TextBlock Text="Focus Mode (25m)" VerticalAlignment="Center"/></StackPanel>
                                </ui:Button>
                                <ui:Button Click="BtnBreak5_Click" Appearance="Secondary" Height="38" Padding="12,0" Margin="0,0,6,0" FontWeight="SemiBold" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal"><ui:TextBlock Text="&#xEA86;" FontFamily="Segoe Fluent Icons" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/><ui:TextBlock Text="5-Min Break" VerticalAlignment="Center"/></StackPanel>
                                </ui:Button>
                                <ui:Button Click="BtnBreathing_Click" Appearance="Secondary" Height="38" Padding="12,0" Margin="0,0,6,0" FontWeight="SemiBold" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal"><ui:TextBlock Text="&#xE9F5;" FontFamily="Segoe Fluent Icons" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/><ui:TextBlock Text="Breathing (2m)" VerticalAlignment="Center"/></StackPanel>
                                </ui:Button>
                                <ui:Button x:Name="BtnPauseFocus" Content="Pause" Click="BtnPauseFocus_Click" Appearance="Secondary" Height="38" Padding="12,0" Margin="0,0,6,0" Visibility="Collapsed" Cursor="Hand"/>
                                <ui:Button x:Name="BtnStopFocus" Content="Stop" Click="BtnStopFocus_Click" Appearance="Danger" Height="38" Padding="12,0" Visibility="Collapsed" Cursor="Hand"/>
                            </StackPanel>
                        </StackPanel>
                    </ui:Card>

                    <!-- Casual Healthy Mind Guide -->
                    <ui:Card Background="{DynamicResource FluentBrandLight}" BorderBrush="{DynamicResource FluentBrand80}" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8"><ui:TextBlock Text="&#xE82F;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="{DynamicResource FluentBrand80}" VerticalAlignment="Center" Margin="0,0,8,0"/><ui:TextBlock Text="Quick Guide to Maintaining a Healthy Mind" FontWeight="Bold" Foreground="{DynamicResource FluentBrand80}" FontSize="13"  VerticalAlignment="Center"/></StackPanel>
                            <ui:TextBlock Text="• Focus Mode (25m): 25 minutes of uninterrupted design work gets you into a flow state without mental fatigue." Foreground="{DynamicResource FluentLightTextPrimary}" FontSize="11" Margin="0,0,0,4" TextWrapping="Wrap" />
                            <ui:TextBlock Text="• 5-Min Break: Step away, stretch your shoulders, look out a window (20-20-20 rule to prevent eye strain)." Foreground="{DynamicResource FluentLightTextPrimary}" FontSize="11" Margin="0,0,0,4" TextWrapping="Wrap" />
                            <ui:TextBlock Text="• 2-Min Breathing: Follow the pulsing circle — 4s Inhale, 4s Hold, 4s Exhale to reset your nervous system." Foreground="{DynamicResource FluentLightTextPrimary}" FontSize="11" TextWrapping="Wrap" />
                        </StackPanel>
                    </ui:Card>

                    <!-- Energy Check-in -->
                    <ui:Card Padding="18">
                        <StackPanel>
                            <ui:TextBlock Text="ENERGY CHECK-IN (1 = Low Battery Â· 5 = Full Power)" Foreground="{DynamicResource FluentLightTextSecondary}" FontSize="11" FontWeight="Bold" Margin="0,0,0,12" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <ui:Button x:Name="BtnE1" Content="1" Width="40" Height="36" Margin="0,0,6,0" Click="BtnEnergy_Click" Tag="1" Appearance="Secondary" Cursor="Hand" />
                                <ui:Button x:Name="BtnE2" Content="2" Width="40" Height="36" Margin="0,0,6,0" Click="BtnEnergy_Click" Tag="2" Appearance="Secondary" Cursor="Hand" />
                                <ui:Button x:Name="BtnE3" Content="3" Width="40" Height="36" Margin="0,0,6,0" Click="BtnEnergy_Click" Tag="3" Appearance="Primary" FontWeight="Bold" Cursor="Hand" />
                                <ui:Button x:Name="BtnE4" Content="4" Width="40" Height="36" Margin="0,0,6,0" Click="BtnEnergy_Click" Tag="4" Appearance="Secondary" Cursor="Hand" />
                                <ui:Button x:Name="BtnE5" Content="5" Width="40" Height="36" Click="BtnEnergy_Click" Tag="5" Appearance="Secondary" Cursor="Hand" />
                            </StackPanel>
                            <ui:TextBlock x:Name="TxtFatigueRec" Text="" FontSize="12" Foreground="{DynamicResource FluentDanger}" Visibility="Collapsed" />
                        </StackPanel>
                    </ui:Card>
                </StackPanel>

                <!-- Right Column: Interactive Dynamic Radar / Spider Chart -->
                <ui:Card Grid.Column="2" Padding="18">
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <ui:TextBlock Text="INTERACTIVE WELLBEING RADAR" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource FluentBrand80}" />
                            <ui:TextBlock Text="Real-time multi-axis overview: Energy, Focus, Rest, Pressure, and Flow state." Foreground="{DynamicResource FluentLightTextSecondary}" FontSize="11" Margin="0,2,0,0" />
                        </StackPanel>

                        <!-- Canvas for Spider Chart -->
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas x:Name="RadarCanvas" Width="280" Height="280"/>
                        </Grid>
                    </DockPanel>
                </ui:Card>
            </Grid>

            <!-- Mind Drops Card (DPAPI Encrypted) -->
            <ui:Card Padding="18" Margin="0,0,0,20">
                <StackPanel>
                    <ui:TextBlock Text="MIND DROPS (Local Private Thought Vault)" Foreground="{DynamicResource FluentLightTextSecondary}" FontSize="11" FontWeight="Bold" Margin="0,0,0,4" />
                    <ui:TextBlock Text="Got a distracting thought or urgent reminder while designing? Drop it here privately so you can focus." Foreground="{DynamicResource FluentLightTextSecondary}" FontSize="11" Margin="0,0,0,10" />
                    <ui:TextBox x:Name="TxtMindDrop" PlaceholderText="Write down any distracting thought..." AcceptsReturn="True" MinHeight="60" Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal">
                        <ui:Button Content="Save (End-of-Day Purge)" Click="BtnSaveDrop_EndOfDay" Appearance="Primary" Height="36" Padding="14,0" Margin="0,0,8,0" FontWeight="SemiBold" Cursor="Hand" />
                        <ui:Button Content="Save (Session Only)" Click="BtnSaveDrop_Session" Appearance="Secondary" Height="36" Padding="14,0" FontWeight="SemiBold" Cursor="Hand" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <!-- Today's Session Metrics -->
            <ui:Card Padding="16">
                <UniformGrid Columns="3">
                    <StackPanel HorizontalAlignment="Center">
                        <ui:TextBlock Text="TOTAL FOCUS TIME" Foreground="{DynamicResource FluentLightTextSecondary}" FontSize="10" FontWeight="Bold" />
                        <ui:TextBlock x:Name="TxtMetricFocus" Text="0h 0m" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource FluentBrand80}" Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Center">
                        <ui:TextBlock Text="COMPLETED SESSIONS" Foreground="{DynamicResource FluentLightTextSecondary}" FontSize="10" FontWeight="Bold" />
                        <ui:TextBlock x:Name="TxtMetricSessions" Text="0 completed" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource FluentBrand80}" Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Center">
                        <ui:TextBlock Text="MIND DROPS" Foreground="{DynamicResource FluentLightTextSecondary}" FontSize="10" FontWeight="Bold" />
                        <ui:TextBlock x:Name="TxtMetricDrops" Text="0 captured" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource FluentBrand80}" Margin="0,2,0,0" />
                    </StackPanel>
                </UniformGrid>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</Page>

