<Page x:Class="SS_CAM.Views.WellbeingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Creative Wellbeing">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>
            <!-- Header with Casual Healthy Mind Tips -->
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="Creative Wellbeing &amp; Energy Suite" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource FluentBrand80}" FontFamily="{StaticResource FluentFontFamily}"/>
                <TextBlock Text="Your personal space to stay focused, rest your eyes &amp; spine, and keep a calm, healthy mind while designing." Foreground="{DynamicResource FluentLightTextSecondary}" FontSize="13" Margin="0,4,0,0" FontFamily="{StaticResource FluentFontFamily}"/>
            </StackPanel>

            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: Focus Timer & Breathing Animation -->
                <StackPanel Grid.Column="0">
                    <!-- Animated Focus & Breathing Timer Card -->
                    <Border Background="{DynamicResource FluentLightCardBg}" BorderBrush="{DynamicResource FluentLightStroke}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="CREATIVE TIMER &amp; BREATHING RHYTHM" Foreground="{DynamicResource FluentLightTextSecondary}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,12" FontFamily="{StaticResource FluentFontFamily}"/>

                            <!-- Animated Pulsing Canvas Ring -->
                            <Grid Width="160" Height="160" Margin="0,0,0,14">
                                <Canvas x:Name="BreathingCanvas" Width="160" Height="160"/>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock x:Name="TxtTimerDisplay" Text="25:00" FontSize="36" FontWeight="Bold" Foreground="{DynamicResource FluentBrand80}" HorizontalAlignment="Center" FontFamily="{StaticResource FluentFontFamily}"/>
                                    <TextBlock x:Name="TxtBreathingInstruction" Text="Ready" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource FluentBrandTint}" HorizontalAlignment="Center" Margin="0,2,0,0" FontFamily="{StaticResource FluentFontFamily}"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock x:Name="TxtTimerStatus" Text="Select a mode below to begin your session." FontSize="12" Foreground="{DynamicResource FluentLightTextSecondary}" HorizontalAlignment="Center" Margin="0,0,0,14" FontFamily="{StaticResource FluentFontFamily}"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button x:Name="BtnStartFocus" Click="BtnStartFocus_Click" Background="{DynamicResource FluentBrand80}" Foreground="White" Height="38" Padding="14,0" Margin="0,0,6,0" FontWeight="Bold" FontFamily="{StaticResource FluentFontFamily}" BorderThickness="0" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7C3;" FontFamily="Segoe Fluent Icons" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="Focus Mode (25m)" VerticalAlignment="Center"/></StackPanel>
                                </Button>
                                <Button Click="BtnBreak5_Click" Background="{DynamicResource FluentLightCardSubBg}" Foreground="{DynamicResource FluentBrand80}" BorderBrush="{DynamicResource FluentBrand80}" BorderThickness="1" Height="38" Padding="12,0" Margin="0,0,6,0" FontWeight="SemiBold" FontFamily="{StaticResource FluentFontFamily}" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xEA86;" FontFamily="Segoe Fluent Icons" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="5-Min Break" VerticalAlignment="Center"/></StackPanel>
                                </Button>
                                <Button Click="BtnBreathing_Click" Background="{DynamicResource FluentLightCardSubBg}" Foreground="{DynamicResource FluentBrand80}" BorderBrush="{DynamicResource FluentBrand80}" BorderThickness="1" Height="38" Padding="12,0" Margin="0,0,6,0" FontWeight="SemiBold" FontFamily="{StaticResource FluentFontFamily}" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9F5;" FontFamily="Segoe Fluent Icons" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="Breathing (2m)" VerticalAlignment="Center"/></StackPanel>
                                </Button>
                                <Button x:Name="BtnPauseFocus" Content="Pause" Click="BtnPauseFocus_Click" Background="{DynamicResource FluentLightCardSubBg}" Foreground="{DynamicResource FluentLightTextPrimary}" Height="38" Padding="12,0" Margin="0,0,6,0" Visibility="Collapsed" FontFamily="{StaticResource FluentFontFamily}" BorderThickness="0" Cursor="Hand"/>
                                <Button x:Name="BtnStopFocus" Content="Stop" Click="BtnStopFocus_Click" Background="{DynamicResource FluentDanger}" Foreground="White" Height="38" Padding="12,0" Visibility="Collapsed" FontFamily="{StaticResource FluentFontFamily}" BorderThickness="0" Cursor="Hand"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Casual Healthy Mind Guide -->
                    <Border Background="{DynamicResource FluentBrandLight}" BorderBrush="{DynamicResource FluentBrand80}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8"><TextBlock Text="&#xE82F;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="{DynamicResource FluentBrand80}" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock Text="Quick Guide to Maintaining a Healthy Mind" FontWeight="Bold" Foreground="{DynamicResource FluentBrand80}" FontSize="13" FontFamily="{StaticResource FluentFontFamily}" VerticalAlignment="Center"/></StackPanel>
                            <TextBlock Text="• Focus Mode (25m): 25 minutes of uninterrupted design work gets you into a flow state without mental fatigue." Foreground="{DynamicResource FluentLightTextPrimary}" FontSize="11" Margin="0,0,0,4" TextWrapping="Wrap" FontFamily="{StaticResource FluentFontFamily}"/>
                            <TextBlock Text="• 5-Min Break: Step away, stretch your shoulders, look out a window (20-20-20 rule to prevent eye strain)." Foreground="{DynamicResource FluentLightTextPrimary}" FontSize="11" Margin="0,0,0,4" TextWrapping="Wrap" FontFamily="{StaticResource FluentFontFamily}"/>
                            <TextBlock Text="• 2-Min Breathing: Follow the pulsing circle — 4s Inhale, 4s Hold, 4s Exhale to reset your nervous system." Foreground="{DynamicResource FluentLightTextPrimary}" FontSize="11" TextWrapping="Wrap" FontFamily="{StaticResource FluentFontFamily}"/>
                        </StackPanel>
                    </Border>

                    <!-- Energy Check-in -->
                    <Border Background="{DynamicResource FluentLightCardBg}" BorderBrush="{DynamicResource FluentLightStroke}" BorderThickness="1" CornerRadius="8" Padding="18">
                        <StackPanel>
                            <TextBlock Text="ENERGY CHECK-IN (1 = Low Battery · 5 = Full Power)" Foreground="{DynamicResource FluentLightTextSecondary}" FontSize="11" FontWeight="Bold" Margin="0,0,0,12" FontFamily="{StaticResource FluentFontFamily}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button x:Name="BtnE1" Content="1" Width="40" Height="36" Margin="0,0,6,0" Click="BtnEnergy_Click" Tag="1" Background="{DynamicResource FluentLightCardSubBg}" Foreground="{DynamicResource FluentLightTextPrimary}" BorderThickness="0" Cursor="Hand" FontFamily="{StaticResource FluentFontFamily}"/>
                                <Button x:Name="BtnE2" Content="2" Width="40" Height="36" Margin="0,0,6,0" Click="BtnEnergy_Click" Tag="2" Background="{DynamicResource FluentLightCardSubBg}" Foreground="{DynamicResource FluentLightTextPrimary}" BorderThickness="0" Cursor="Hand" FontFamily="{StaticResource FluentFontFamily}"/>
                                <Button x:Name="BtnE3" Content="3" Width="40" Height="36" Margin="0,0,6,0" Click="BtnEnergy_Click" Tag="3" Background="{DynamicResource FluentBrand80}" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" FontFamily="{StaticResource FluentFontFamily}"/>
                                <Button x:Name="BtnE4" Content="4" Width="40" Height="36" Margin="0,0,6,0" Click="BtnEnergy_Click" Tag="4" Background="{DynamicResource FluentLightCardSubBg}" Foreground="{DynamicResource FluentLightTextPrimary}" BorderThickness="0" Cursor="Hand" FontFamily="{StaticResource FluentFontFamily}"/>
                                <Button x:Name="BtnE5" Content="5" Width="40" Height="36" Click="BtnEnergy_Click" Tag="5" Background="{DynamicResource FluentLightCardSubBg}" Foreground="{DynamicResource FluentLightTextPrimary}" BorderThickness="0" Cursor="Hand" FontFamily="{StaticResource FluentFontFamily}"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtFatigueRec" Text="" FontSize="12" Foreground="{DynamicResource FluentDanger}" Visibility="Collapsed" FontFamily="{StaticResource FluentFontFamily}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right Column: Interactive Dynamic Radar / Spider Chart -->
                <Border Grid.Column="2" Background="{DynamicResource FluentLightCardBg}" BorderBrush="{DynamicResource FluentLightStroke}" BorderThickness="1" CornerRadius="8" Padding="18">
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <TextBlock Text="INTERACTIVE WELLBEING RADAR" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource FluentBrand80}" FontFamily="{StaticResource FluentFontFamily}"/>
                            <TextBlock Text="Real-time multi-axis overview: Energy, Focus, Rest, Pressure, and Flow state." Foreground="{DynamicResource FluentLightTextSecondary}" FontSize="11" Margin="0,2,0,0" FontFamily="{StaticResource FluentFontFamily}"/>
                        </StackPanel>

                        <!-- Canvas for Spider Chart -->
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas x:Name="RadarCanvas" Width="280" Height="280"/>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Mind Drops Card (DPAPI Encrypted) -->
            <Border Background="{DynamicResource FluentLightCardBg}" BorderBrush="{DynamicResource FluentLightStroke}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="MIND DROPS (Local Private Thought Vault)" Foreground="{DynamicResource FluentLightTextSecondary}" FontSize="11" FontWeight="Bold" Margin="0,0,0,4" FontFamily="{StaticResource FluentFontFamily}"/>
                    <TextBlock Text="Got a distracting thought or urgent reminder while designing? Drop it here privately so you can focus." Foreground="{DynamicResource FluentLightTextSecondary}" FontSize="11" Margin="0,0,0,10" FontFamily="{StaticResource FluentFontFamily}"/>
                    <ui:TextBox x:Name="TxtMindDrop" PlaceholderText="Write down any distracting thought..." AcceptsReturn="True" MinHeight="60" Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Save (End-of-Day Purge)" Click="BtnSaveDrop_EndOfDay" Background="{DynamicResource FluentBrand80}" Foreground="White" Height="36" Padding="14,0" Margin="0,0,8,0" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" FontFamily="{StaticResource FluentFontFamily}"/>
                        <Button Content="Save (Session Only)" Click="BtnSaveDrop_Session" Background="{DynamicResource FluentLightCardSubBg}" Foreground="{DynamicResource FluentLightTextPrimary}" Height="36" Padding="14,0" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" FontFamily="{StaticResource FluentFontFamily}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Today's Session Metrics -->
            <Border Background="{DynamicResource FluentLightCardSubBg}" BorderBrush="{DynamicResource FluentLightStroke}" BorderThickness="1" CornerRadius="8" Padding="16">
                <UniformGrid Columns="3">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="TOTAL FOCUS TIME" Foreground="{DynamicResource FluentLightTextSecondary}" FontSize="10" FontWeight="Bold" FontFamily="{StaticResource FluentFontFamily}"/>
                        <TextBlock x:Name="TxtMetricFocus" Text="0h 0m" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource FluentBrand80}" Margin="0,2,0,0" FontFamily="{StaticResource FluentFontFamily}"/>
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="COMPLETED SESSIONS" Foreground="{DynamicResource FluentLightTextSecondary}" FontSize="10" FontWeight="Bold" FontFamily="{StaticResource FluentFontFamily}"/>
                        <TextBlock x:Name="TxtMetricSessions" Text="0 completed" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource FluentBrand80}" Margin="0,2,0,0" FontFamily="{StaticResource FluentFontFamily}"/>
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="MIND DROPS" Foreground="{DynamicResource FluentLightTextSecondary}" FontSize="10" FontWeight="Bold" FontFamily="{StaticResource FluentFontFamily}"/>
                        <TextBlock x:Name="TxtMetricDrops" Text="0 captured" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource FluentBrand80}" Margin="0,2,0,0" FontFamily="{StaticResource FluentFontFamily}"/>
                    </StackPanel>
                </UniformGrid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
