<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================================================================= -->
    <!-- MICROSOFT FLUENT 2 DESIGN SYSTEM TOKENS (fluent2.microsoft.design) -->
    <!-- ================================================================= -->

    <!-- Brand Accent Tokens -->
    <SolidColorBrush x:Key="FluentBrand80" Color="#0078D4"/>
    <SolidColorBrush x:Key="FluentBrand70" Color="#106EBE"/>
    <SolidColorBrush x:Key="FluentBrandLight" Color="#E0F2FE"/>
    <SolidColorBrush x:Key="FluentBrandTint" Color="#2899F5"/>

    <!-- Neutral Dark Tokens -->
    <SolidColorBrush x:Key="FluentDarkCanvasBg" Color="#141414"/>
    <SolidColorBrush x:Key="FluentDarkCardBg" Color="#1F1F1F"/>
    <SolidColorBrush x:Key="FluentDarkCardSubBg" Color="#292929"/>
    <SolidColorBrush x:Key="FluentDarkStroke" Color="#2E2E2E"/>
    <SolidColorBrush x:Key="FluentDarkTextPrimary" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FluentDarkTextSecondary" Color="#ADADAD"/>

    <!-- Neutral Light Tokens -->
    <SolidColorBrush x:Key="FluentLightCanvasBg" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="FluentLightCardBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FluentLightCardSubBg" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="FluentLightStroke" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="FluentLightTextPrimary" Color="#242424"/>
    <SolidColorBrush x:Key="FluentLightTextSecondary" Color="#616161"/>

    <!-- Status Tokens -->
    <SolidColorBrush x:Key="FluentSuccess" Color="#107C41"/>
    <SolidColorBrush x:Key="FluentWarning" Color="#797700"/>
    <SolidColorBrush x:Key="FluentDanger" Color="#C50F1F"/>

    <!-- Typography Ramp -->
    <FontFamily x:Key="FluentFontFamily">Segoe UI Variable Text, Segoe UI Variable Display, Segoe UI, sans-serif</FontFamily>

    <!-- Elevation Depth Shadows -->
    <DropShadowEffect x:Key="FluentDepth4" BlurRadius="6" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.14"/>
    <DropShadowEffect x:Key="FluentDepth8" BlurRadius="12" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.20"/>
    <DropShadowEffect x:Key="FluentDepth16" BlurRadius="24" ShadowDepth="8" Direction="270" Color="#000000" Opacity="0.28"/>

</ResourceDictionary>
