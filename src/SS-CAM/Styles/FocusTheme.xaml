<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================================================================= -->
    <!--  FOCUS THEME (MINIMALIST PRODUCTIVITY & SPEED)                    -->
    <!--  Neutral slate, low-chroma, high-contrast, flat, blue-teal accent -->
    <!-- ================================================================= -->

    <!-- Brand Accent Tokens - Blue-Teal (#0EA5E9, #38BDF8, #0369A1) -->
    <SolidColorBrush x:Key="FluentBrand80"    Color="#0EA5E9"/>
    <SolidColorBrush x:Key="FluentBrand70"    Color="#38BDF8"/>
    <SolidColorBrush x:Key="FluentBrandLight" Color="#0C4A6E"/>
    <SolidColorBrush x:Key="FluentBrandTint"  Color="#0C4A6E"/>

    <!-- WPF-UI Core Base System Brush Overrides (Neutral Slate Dark) -->
    <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#0B0F19"/>
    <SolidColorBrush x:Key="WindowBackground"                     Color="#0B0F19"/>
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush"  Color="#131B2E"/>
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#1E293B"/>
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush"         Color="#243048"/>
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush"           Color="#F8FAFC"/>
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush"         Color="#94A3B8"/>
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush"          Color="#64748B"/>
    <SolidColorBrush x:Key="TextControlForeground"               Color="#F8FAFC"/>
    <SolidColorBrush x:Key="TextControlBackground"               Color="#131B2E"/>
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush"        Color="#1E293B"/>
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush"      Color="#243048"/>
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush"       Color="#334155"/>
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush"       Color="#243048"/>
    <SolidColorBrush x:Key="SystemAccentColorPrimaryBrush"       Color="#0EA5E9"/>
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush"         Color="#0EA5E9"/>
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush"       Color="#38BDF8"/>
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush"        Color="#7DD3FC"/>
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush"     Color="#0B0F19"/>
    <SolidColorBrush x:Key="SystemFillColorSuccessBrush"         Color="#10B981"/>
    <SolidColorBrush x:Key="SystemFillColorCautionBrush"         Color="#F59E0B"/>
    <SolidColorBrush x:Key="SystemFillColorCriticalBrush"        Color="#EF4444"/>

    <!-- Canvas / Page Backgrounds -->
    <SolidColorBrush x:Key="FluentLightCanvasBg"  Color="#0B0F19"/>

    <!-- Card Surfaces -->
    <SolidColorBrush x:Key="FluentLightCardBg"    Color="#131B2E"/>
    <SolidColorBrush x:Key="FluentLightCardSubBg" Color="#1E293B"/>

    <!-- Borders -->
    <SolidColorBrush x:Key="FluentLightStroke"    Color="#243048"/>

    <!-- Typography -->
    <SolidColorBrush x:Key="FluentLightTextPrimary"   Color="#F8FAFC"/>
    <SolidColorBrush x:Key="FluentLightTextSecondary" Color="#94A3B8"/>

    <!-- Sidebar Semantic Tokens -->
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="SidebarSearchBackgroundBrush" Color="#1E293B"/>
    <SolidColorBrush x:Key="SidebarTextPrimaryBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="SidebarTextSecondaryBrush" Color="#94A3B8"/>
    <SolidColorBrush x:Key="SidebarUserCardBackgroundBrush" Color="#1E293B"/>
    <SolidColorBrush x:Key="SidebarDividerBrush" Color="#1E293B"/>

    <!-- Status Tokens -->
    <SolidColorBrush x:Key="FluentSuccess" Color="#10B981"/>
    <SolidColorBrush x:Key="FluentWarning" Color="#F59E0B"/>
    <SolidColorBrush x:Key="FluentDanger"  Color="#EF4444"/>

    <!-- Typography -->
    <FontFamily x:Key="FluentFontFamily">Segoe UI Variable Text, Segoe UI Variable Display, Segoe UI, sans-serif</FontFamily>

    <!-- Elevation Shadows - Flat Minimalist -->
    <DropShadowEffect x:Key="FluentDepth4"
                      BlurRadius="4" ShadowDepth="1" Direction="270"
                      Color="#000000" Opacity="0.25"/>

    <DropShadowEffect x:Key="FluentDepth8"
                      BlurRadius="8" ShadowDepth="2" Direction="270"
                      Color="#000000" Opacity="0.35"/>

    <DropShadowEffect x:Key="FluentDepth16"
                      BlurRadius="16" ShadowDepth="4" Direction="270"
                      Color="#000000" Opacity="0.45"/>

    <!-- Global ComboBox & Input Standards (Prevents Text Clipping, Cropping & Dropdown Overlay Issues) -->
    <Style TargetType="{x:Type ComboBox}">
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="MaxDropDownHeight" Value="380"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
    </Style>

    <Style TargetType="{x:Type ComboBoxItem}">
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

</ResourceDictionary>
