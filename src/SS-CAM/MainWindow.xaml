<ui:FluentWindow x:Class="SS_CAM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:views="clr-namespace:SS_CAM.Views"
        Title="SS-CAM v2.0" Height="768" Width="1366"
        WindowState="Normal"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        WindowCornerPreference="Round">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <ui:TitleBar Grid.Row="0" Title="SuamiSihat Creative Assets Management" />
        
        <Grid Grid.Row="1">
            <ui:NavigationView x:Name="RootNavigation">
                <ui:NavigationView.MenuItems>
                    <ui:NavigationViewItem Content="Dashboard" Icon="{ui:SymbolIcon Home24}" TargetPageType="{x:Type views:DashboardPage}" />
                    <ui:NavigationViewItem Content="Project Creator" Icon="{ui:SymbolIcon Edit24}" TargetPageType="{x:Type views:ProjectCreatorPage}" />
                    <ui:NavigationViewItem Content="Creative Wellbeing" Icon="{ui:SymbolIcon Heart24}" TargetPageType="{x:Type views:WellbeingPage}" />
                </ui:NavigationView.MenuItems>
                
                <ui:NavigationView.FooterMenuItems>
                    <ui:NavigationViewItem Content="Settings" Icon="{ui:SymbolIcon Settings24}" />
                </ui:NavigationView.FooterMenuItems>
            </ui:NavigationView>
        </Grid>
    </Grid>
</ui:FluentWindow>
