<ui:FluentWindow x:Class="SS_CAM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:views="clr-namespace:SS_CAM.Views"
        Title="SuamiSihat Creative Assets Management v2.3.0" Height="820" Width="1280"
        MinHeight="660" MinWidth="980"
        WindowState="Normal"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        WindowCornerPreference="Round">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- TitleBar -->
            <RowDefinition Height="Auto"/>   <!-- Update Banner -->
            <RowDefinition Height="*"/>      <!-- Main Body -->
        </Grid.RowDefinitions>

        <!-- Fluent 2 Window TitleBar -->
        <ui:TitleBar Grid.Row="0" x:Name="AppTitleBar"
                     Title="SuamiSihat Creative Assets Management"
                     Icon="app.ico"
                     Foreground="White"
                     Background="Transparent"/>

        <!-- Update Notification Banner -->
        <Border x:Name="UpdateBanner" Grid.Row="1" Background="#FEF9C3" BorderBrush="#EAB308"
                BorderThickness="0,0,0,1" Padding="16,6" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🆕 " FontFamily="Segoe UI Emoji" FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock x:Name="UpdateBannerText" Text="A new version of SS-CAM is available!"
                               FontSize="12" FontWeight="SemiBold" Foreground="#78350F" VerticalAlignment="Center"
                               FontFamily="Segoe UI Variable Text"/>
                </StackPanel>
                <Button x:Name="UpdateDownloadBtn" Grid.Column="1" Content="Download Update"
                        Click="OnDownloadUpdateClicked" Height="26" Padding="12,0" Margin="12,0,8,0"
                        Background="#EAB308" Foreground="White" FontWeight="SemiBold" FontSize="11"
                        BorderThickness="0" Cursor="Hand" FontFamily="Segoe UI Variable Text"/>
                <Button Grid.Column="2" Content="✕" Click="OnDismissUpdateBanner" Width="26" Height="26"
                        Background="Transparent" Foreground="#92400E" BorderThickness="0" FontSize="12"
                        FontWeight="Bold" Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- Main Body: Fluent 2 Single-Column Nav + Content -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <!-- Single Fluent 2 Nav column, collapsible -->
                <ColumnDefinition x:Name="SidebarColumn" Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ═══════════════════════════════════════════════════
                 FLUENT 2 SINGLE-COLUMN NAVIGATION SIDEBAR
                 Spec: icon (20px) + label side-by-side in one row
                 Active: 3px left accent bar + colorNeutralBackground1Selected fill
                 Collapsed: icon-only (48px wide)
                 ═══════════════════════════════════════════════════ -->
            <Border Grid.Column="0" x:Name="SidebarBorder"
                    Background="#202020"
                    BorderBrush="#303030" BorderThickness="0,0,1,0">
                <Grid>
                    <!-- ── FADED ANIMATED AUDIO SPECTRUM VISUALIZER IN SIDEBAR BACKGROUND ── -->
                    <Canvas x:Name="SidebarSpectrumCanvas"
                            HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                            Height="240" Opacity="0.0" IsHitTestVisible="False"
                            ClipToBounds="True"/>

                    <DockPanel LastChildFill="True">

                        <!-- ── TOP: App Identity + Hamburger ── -->
                        <Border DockPanel.Dock="Top" Padding="12,10,12,6" Background="Transparent">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- App Logo & Title -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Hamburger toggle — always visible -->
                                    <Button x:Name="ToggleSidebarBtn" Click="OnToggleSidebarClicked"
                                            Background="Transparent" BorderThickness="0"
                                            Width="32" Height="32" Padding="0" Margin="0,0,8,0" Cursor="Hand"
                                            ToolTip="Toggle Navigation (Ctrl+B)">
                                        <TextBlock x:Name="ToggleSidebarIcon" Text="&#xE700;" FontFamily="Segoe Fluent Icons"
                                                   FontSize="16" Foreground="#FFFFFF"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button>
                                    <StackPanel x:Name="AppTitlePanel" VerticalAlignment="Center">
                                        <TextBlock x:Name="SidebarAppTitleText" Text="SuamiSihat" Foreground="#FFFFFF"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   FontFamily="Segoe UI Variable Display"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- ── BOTTOM: Status Widgets + User Profile ── -->
                        <StackPanel DockPanel.Dock="Bottom" Margin="8,8,8,12">

                            <!-- Divider -->
                            <Border x:Name="SidebarDivider1" Height="1" Background="#303030" Margin="4,0,4,8"/>

                            <!-- NAS Status row -->
                            <Border x:Name="NasPill" CornerRadius="4" Padding="8,6" Margin="0,0,0,2"
                                    Cursor="Hand" MouseLeftButtonDown="OnCheckNasStatusClicked"
                                    ToolTip="Click to re-check Synology NAS connection">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="StatusNasDot" Text="&#xE895;" FontFamily="Segoe Fluent Icons"
                                               FontSize="12" Foreground="#13A10E" VerticalAlignment="Center"
                                               Margin="0,0,10,0"/>
                                    <TextBlock x:Name="StatusNasText"
                                               Text="SSNAS Connected"
                                               Foreground="#C8C8C8" FontSize="12"
                                               FontFamily="Segoe UI Variable Text"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Focus Timer row -->
                            <Border CornerRadius="4" Padding="8,6" Margin="0,0,0,2"
                                    Cursor="Hand" MouseLeftButtonDown="OnFooterTimerClicked"
                                    ToolTip="Open Wellbeing &amp; Focus Timer">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="StatusTimerIcon" Text="&#xE916;" FontFamily="Segoe Fluent Icons"
                                               FontSize="14" Foreground="#9D9D9D" VerticalAlignment="Center"
                                               Margin="0,0,10,0"/>
                                    <TextBlock x:Name="StatusTimerText" Text="Focus: 25:00"
                                               Foreground="#C8C8C8" FontSize="12"
                                               FontFamily="Segoe UI Variable Text"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Radio Player row: hidden until radio is playing -->
                            <Border x:Name="RadioFooterRow" CornerRadius="4" Padding="8,6" Margin="0,0,0,2"
                                    Cursor="Hand" MouseLeftButtonDown="OnFooterRadioClicked"
                                    ToolTip="Open Radio Player" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="StatusRadioIcon" Text="&#xE768;" FontFamily="Segoe Fluent Icons"
                                               FontSize="14" Foreground="#9D9D9D" VerticalAlignment="Center"
                                               Margin="0,0,10,0"/>
                                    <TextBlock x:Name="StatusRadioText" Grid.Column="1"
                                               Text="Radio: BFM 89.9"
                                               Foreground="#C8C8C8" FontSize="12"
                                               FontFamily="Segoe UI Variable Text"
                                               VerticalAlignment="Center"/>
                                    <Button x:Name="StatusRadioPlayBtn" Grid.Column="2"
                                            Click="OnStatusRadioPlayToggle"
                                            Background="Transparent" BorderThickness="0"
                                            Padding="4,0" Cursor="Hand" ToolTip="Play / Pause">
                                        <TextBlock x:Name="StatusRadioPlayIcon" Text="&#xE768;"
                                                   FontFamily="Segoe Fluent Icons"
                                                   FontSize="14" Foreground="#0078D4"/>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Theme Switcher row -->
                            <Border CornerRadius="4" Padding="0,0,0,0" Margin="0,0,0,8">
                                <Button x:Name="StatusThemeBtn" Click="OnStatusThemeToggle"
                                        Background="Transparent" Foreground="#C8C8C8"
                                        BorderThickness="0" Padding="8,6" Cursor="Hand"
                                        HorizontalContentAlignment="Left" HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="StatusThemeIcon" Text="&#xE790;"
                                                   FontFamily="Segoe Fluent Icons"
                                                   FontSize="14" Foreground="#9D9D9D"
                                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock x:Name="StatusThemeText" Text="Theme: SS Default"
                                                   FontSize="12" FontFamily="Segoe UI Variable Text"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Border>

                            <!-- User Profile row (Fluent 2 Persona at bottom of nav) -->
                            <Border x:Name="SidebarUserCard" CornerRadius="6" Padding="8,8"
                                    Cursor="Hand" MouseLeftButtonDown="OnNavProfileClicked"
                                    Background="#2A2A2A"
                                    ToolTip="User Profile &amp; Settings">
                                <StackPanel Orientation="Horizontal">
                                    <!-- Avatar circle -->
                                    <Border Width="28" Height="28" CornerRadius="14"
                                            Background="#0078D4" Margin="0,0,10,0" ClipToBounds="True"
                                            VerticalAlignment="Center">
                                        <Grid x:Name="AvatarBorder">
                                            <TextBlock x:Name="AvatarEmojiText" Text="B"
                                                       Foreground="White" FontSize="13"
                                                       FontWeight="SemiBold"
                                                       FontFamily="Segoe UI Variable Text"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                            <Image x:Name="SidebarAvatarImg" Stretch="UniformToFill"
                                                   Visibility="Collapsed"/>
                                        </Grid>
                                    </Border>
                                    <StackPanel x:Name="SidebarUserText" VerticalAlignment="Center">
                                        <TextBlock x:Name="SidebarDesignerName" Text="Brand"
                                                   Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold"
                                                   FontFamily="Segoe UI Variable Text"/>
                                        <TextBlock x:Name="SidebarDepartment" Text="Creative &amp; Brand"
                                                   Foreground="#9D9D9D" FontSize="10"
                                                   FontFamily="Segoe UI Variable Text"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ── MIDDLE: Global Search ── -->
                        <Border DockPanel.Dock="Top" Padding="12,0,12,8">
                            <Border x:Name="SearchBoxBorder" Background="#2D2D2D" BorderBrush="#404040" BorderThickness="1"
                                    CornerRadius="4" Height="32">
                                <Grid Margin="8,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="SearchBoxIcon" Text="&#xE721;" FontFamily="Segoe Fluent Icons"
                                               FontSize="12" Foreground="#9D9D9D"
                                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBox x:Name="TopGlobalSearchInput" Grid.Column="1"
                                             Background="Transparent" Foreground="#FFFFFF"
                                             BorderThickness="0" FontSize="12"
                                             FontFamily="Segoe UI Variable Text"
                                             VerticalAlignment="Center"
                                             TextChanged="OnTopSearchInputChanged"/>
                                </Grid>
                            </Border>
                        </Border>

                    <!-- ── NAV ITEMS: Fluent 2 Single-Column Nav ── -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="SidebarNavPanel" Margin="8,4,8,4">

                            <!-- Section header -->
                            <TextBlock x:Name="SidebarModulesHeader"
                                       Text="MODULES"
                                       Foreground="#707070" FontSize="10" FontWeight="SemiBold"
                                       FontFamily="Segoe UI Variable Text"
                                       Margin="12,8,0,4"/>

                            <!-- Dashboard nav item -->
                            <Button x:Name="NavDashboardBtn" Click="OnNavDashboardClicked"
                                    Height="36" HorizontalContentAlignment="Left"
                                    Background="Transparent" Foreground="#FFFFFF"
                                    BorderThickness="0" Margin="0,1,0,1" Cursor="Hand"
                                    Padding="0" ToolTip="Dashboard">
                                <Grid Width="Auto" HorizontalAlignment="Stretch">
                                    <!-- Active indicator bar (3px left, colorBrandForeground1) -->
                                    <Rectangle x:Name="NavDashboardIndicator"
                                               Width="3" VerticalAlignment="Stretch"
                                               Fill="#0078D4" HorizontalAlignment="Left"
                                               RadiusX="1.5" RadiusY="1.5" Visibility="Visible"/>
                                    <StackPanel Orientation="Horizontal" Margin="12,0,8,0">
                                        <TextBlock x:Name="NavDashboardIcon" Text="&#xE8A1;"
                                                   FontFamily="Segoe Fluent Icons" FontSize="16"
                                                   Foreground="#0078D4"
                                                   Width="20" VerticalAlignment="Center"
                                                   Margin="0,0,12,0"/>
                                        <TextBlock x:Name="NavDashboardLabel"
                                                   Text="Dashboard"
                                                   Foreground="#FFFFFF" FontSize="13"
                                                   FontWeight="SemiBold"
                                                   FontFamily="Segoe UI Variable Text"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- Wellbeing nav item -->
                            <Button x:Name="NavWellbeingBtn" Click="OnNavWellbeingClicked"
                                    Height="36" HorizontalContentAlignment="Left"
                                    Background="Transparent" Foreground="#C8C8C8"
                                    BorderThickness="0" Margin="0,1,0,1" Cursor="Hand"
                                    Padding="0" ToolTip="Creative Wellbeing">
                                <Grid HorizontalAlignment="Stretch">
                                    <Rectangle x:Name="NavWellbeingIndicator"
                                               Width="3" VerticalAlignment="Stretch"
                                               Fill="#0078D4" HorizontalAlignment="Left"
                                               RadiusX="1.5" RadiusY="1.5" Visibility="Collapsed"/>
                                    <StackPanel Orientation="Horizontal" Margin="12,0,8,0">
                                        <TextBlock x:Name="NavWellbeingIcon" Text="&#xE8EF;"
                                                   FontFamily="Segoe Fluent Icons" FontSize="16"
                                                   Foreground="#9D9D9D"
                                                   Width="20" VerticalAlignment="Center"
                                                   Margin="0,0,12,0"/>
                                        <TextBlock x:Name="NavWellbeingText"
                                                   Text="Creative Wellbeing"
                                                   Foreground="#C8C8C8" FontSize="13"
                                                   FontFamily="Segoe UI Variable Text"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- Project Creator nav item -->
                            <Button x:Name="NavProjectsBtn" Click="OnNavProjectsClicked"
                                    Height="36" HorizontalContentAlignment="Left"
                                    Background="Transparent" Foreground="#C8C8C8"
                                    BorderThickness="0" Margin="0,1,0,1" Cursor="Hand"
                                    Padding="0" ToolTip="Project Creator">
                                <Grid HorizontalAlignment="Stretch">
                                    <Rectangle x:Name="NavProjectsIndicator"
                                               Width="3" VerticalAlignment="Stretch"
                                               Fill="#0078D4" HorizontalAlignment="Left"
                                               RadiusX="1.5" RadiusY="1.5" Visibility="Collapsed"/>
                                    <StackPanel Orientation="Horizontal" Margin="12,0,8,0">
                                        <TextBlock x:Name="NavProjectsIcon" Text="&#xED25;"
                                                   FontFamily="Segoe Fluent Icons" FontSize="16"
                                                   Foreground="#9D9D9D"
                                                   Width="20" VerticalAlignment="Center"
                                                   Margin="0,0,12,0"/>
                                        <TextBlock x:Name="NavProjectsText"
                                                   Text="Project Creator"
                                                   Foreground="#C8C8C8" FontSize="13"
                                                   FontFamily="Segoe UI Variable Text"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- Search & Copy nav item -->
                            <Button x:Name="NavSearchBtn" Click="OnNavSearchClicked"
                                    Height="36" HorizontalContentAlignment="Left"
                                    Background="Transparent" Foreground="#C8C8C8"
                                    BorderThickness="0" Margin="0,1,0,1" Cursor="Hand"
                                    Padding="0" ToolTip="Search &amp; Copy">
                                <Grid HorizontalAlignment="Stretch">
                                    <Rectangle x:Name="NavSearchIndicator"
                                               Width="3" VerticalAlignment="Stretch"
                                               Fill="#0078D4" HorizontalAlignment="Left"
                                               RadiusX="1.5" RadiusY="1.5" Visibility="Collapsed"/>
                                    <StackPanel Orientation="Horizontal" Margin="12,0,8,0">
                                        <TextBlock x:Name="NavSearchIcon" Text="&#xE721;"
                                                   FontFamily="Segoe Fluent Icons" FontSize="16"
                                                   Foreground="#9D9D9D"
                                                   Width="20" VerticalAlignment="Center"
                                                   Margin="0,0,12,0"/>
                                        <TextBlock x:Name="NavSearchText"
                                                   Text="Search &amp; Copy"
                                                   Foreground="#C8C8C8" FontSize="13"
                                                   FontFamily="Segoe UI Variable Text"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- Brand Assets nav item -->
                            <Button x:Name="NavBrandAssetsBtn" Click="OnNavBrandAssetsClicked"
                                    Height="36" HorizontalContentAlignment="Left"
                                    Background="Transparent" Foreground="#C8C8C8"
                                    BorderThickness="0" Margin="0,1,0,1" Cursor="Hand"
                                    Padding="0" ToolTip="Brand Assets">
                                <Grid HorizontalAlignment="Stretch">
                                    <Rectangle x:Name="NavBrandAssetsIndicator"
                                               Width="3" VerticalAlignment="Stretch"
                                               Fill="#0078D4" HorizontalAlignment="Left"
                                               RadiusX="1.5" RadiusY="1.5" Visibility="Collapsed"/>
                                    <StackPanel Orientation="Horizontal" Margin="12,0,8,0">
                                        <TextBlock x:Name="NavBrandAssetsIcon" Text="&#xEB3C;"
                                                   FontFamily="Segoe Fluent Icons" FontSize="16"
                                                   Foreground="#9D9D9D"
                                                   Width="20" VerticalAlignment="Center"
                                                   Margin="0,0,12,0"/>
                                        <TextBlock x:Name="NavBrandAssetsText"
                                                   Text="Brand Assets"
                                                   Foreground="#C8C8C8" FontSize="13"
                                                   FontFamily="Segoe UI Variable Text"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- Radio Player nav item -->
                            <Button x:Name="NavRadioBtn" Click="OnNavRadioClicked"
                                    Height="36" HorizontalContentAlignment="Left"
                                    Background="Transparent" Foreground="#C8C8C8"
                                    BorderThickness="0" Margin="0,1,0,1" Cursor="Hand"
                                    Padding="0" ToolTip="Radio Player">
                                <Grid HorizontalAlignment="Stretch">
                                    <Rectangle x:Name="NavRadioIndicator"
                                               Width="3" VerticalAlignment="Stretch"
                                               Fill="#0078D4" HorizontalAlignment="Left"
                                               RadiusX="1.5" RadiusY="1.5" Visibility="Collapsed"/>
                                    <StackPanel Orientation="Horizontal" Margin="12,0,8,0">
                                        <TextBlock x:Name="NavRadioIcon" Text="&#xE768;"
                                                   FontFamily="Segoe Fluent Icons" FontSize="16"
                                                   Foreground="#9D9D9D"
                                                   Width="20" VerticalAlignment="Center"
                                                   Margin="0,0,12,0"/>
                                        <TextBlock x:Name="NavRadioText"
                                                   Text="Radio Player"
                                                   Foreground="#C8C8C8" FontSize="13"
                                                   FontFamily="Segoe UI Variable Text"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- Workstation Health nav item -->
                            <Button x:Name="NavWorkstationHealthBtn" Click="OnNavWorkstationHealthClicked"
                                    Height="36" HorizontalContentAlignment="Left"
                                    Background="Transparent" Foreground="#C8C8C8"
                                    BorderThickness="0" Margin="0,1,0,1" Cursor="Hand"
                                    Padding="0" ToolTip="Workstation Health">
                                <Grid HorizontalAlignment="Stretch">
                                    <Rectangle x:Name="NavWorkstationHealthIndicator"
                                               Width="3" VerticalAlignment="Stretch"
                                               Fill="#0078D4" HorizontalAlignment="Left"
                                               RadiusX="1.5" RadiusY="1.5" Visibility="Collapsed"/>
                                    <StackPanel Orientation="Horizontal" Margin="12,0,8,0">
                                        <TextBlock x:Name="NavWorkstationHealthIcon" Text="&#xE7F4;"
                                                   FontFamily="Segoe Fluent Icons" FontSize="16"
                                                   Foreground="#9D9D9D"
                                                   Width="20" VerticalAlignment="Center"
                                                   Margin="0,0,12,0"/>
                                        <TextBlock x:Name="NavWorkstationHealthText"
                                                   Text="Workstation Health"
                                                   Foreground="#C8C8C8" FontSize="13"
                                                   FontFamily="Segoe UI Variable Text"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- Divider before footer items -->
                            <Border Height="1" Background="#303030" Margin="12,10,12,4"/>

                            <!-- Settings nav item -->
                            <Button Click="OnNavSettingsClicked"
                                    Height="36" HorizontalContentAlignment="Left"
                                    Background="Transparent" Foreground="#C8C8C8"
                                    BorderThickness="0" Margin="0,1,0,1" Cursor="Hand"
                                    Padding="0" ToolTip="Settings">
                                <StackPanel Orientation="Horizontal" Margin="15,0,8,0">
                                    <TextBlock Text="&#xE713;"
                                               FontFamily="Segoe Fluent Icons" FontSize="16"
                                               Foreground="#9D9D9D"
                                               Width="20" VerticalAlignment="Center"
                                               Margin="0,0,12,0"/>
                                    <TextBlock Text="Settings"
                                               Foreground="#C8C8C8" FontSize="13"
                                               FontFamily="Segoe UI Variable Text"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Grid>
        </Border>

            <!-- ═══════════════════════════════════════
                 MAIN CONTENT FRAME
                 100% vertical height, no bottom footer
                 ═══════════════════════════════════════ -->
            <Frame x:Name="MainFrame" Grid.Column="1"
                   NavigationUIVisibility="Hidden"
                   Background="#141414"/>
        </Grid>

        <!-- Visualizer / Header Canvas (hidden, kept for audio animation) -->
        <Canvas x:Name="HeaderCanvas" Grid.Row="0" IsHitTestVisible="False" Visibility="Collapsed"/>
        <TextBlock x:Name="HeaderSubtitle" Grid.Row="0" Visibility="Collapsed"/>
    </Grid>
</ui:FluentWindow>
