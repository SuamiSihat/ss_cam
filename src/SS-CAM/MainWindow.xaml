<ui:FluentWindow x:Class="SS_CAM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:views="clr-namespace:SS_CAM.Views"
        Title="SuamiSihat Creative Assets Management v2.6.0"
        Height="820" Width="1280" MinHeight="660" MinWidth="980"
        WindowState="Normal" WindowStartupLocation="CenterScreen"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        WindowCornerPreference="Round">

    <ui:FluentWindow.Resources>
        <!-- Style: Centre the WPF-UI chrome buttons (─ □ ✕) vertically -->
        <Style TargetType="{x:Type ui:TitleBarButton}"
               BasedOn="{StaticResource {x:Type ui:TitleBarButton}}">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Style: Give NavigationViewItemHeader clean Fluent 2 left margin -->
        <Style TargetType="{x:Type ui:NavigationViewItemHeader}"
               BasedOn="{StaticResource {x:Type ui:NavigationViewItemHeader}}">
            <Setter Property="Margin" Value="12,12,0,4"/>
            <Setter Property="Foreground" Value="#7FA2C7"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>   <!-- Title bar -->
            <RowDefinition Height="Auto"/> <!-- Update Banner -->
            <RowDefinition Height="*"/>    <!-- Main Body -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════════════════════════
             TITLE BAR NATIVE HEADER (Starts flush at X = 0)
             Controls are inside TitleBar.Header so click events fire reliably natively
             without triggering window maximize double-clicks.
             ══════════════════════════════════════════════════════════════════ -->
        <ui:TitleBar x:Name="AppTitleBar" Grid.Row="0"
                     Title=""
                     Background="#0078D4"
                     Foreground="White"
                     Height="44">
            <ui:TitleBar.Header>
                <Grid Height="44">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>  <!-- Col 0: Left group (Flush left at X=0) -->
                        <ColumnDefinition Width="*"/>     <!-- Col 1: Left drag area -->
                        <ColumnDefinition Width="Auto"/>  <!-- Col 2: Search box (Centred) -->
                        <ColumnDefinition Width="*"/>     <!-- Col 3: Right drag area -->
                        <ColumnDefinition Width="Auto"/>  <!-- Col 4: Right group (Timer, Avatar) -->
                        <ColumnDefinition Width="8"/>     <!-- Col 5: Spacer before buttons -->
                    </Grid.ColumnDefinitions>

            <!-- ── Col 0: Left group ─── [☰] [● NAS] [SS Design Assets Manager] ── -->
            <StackPanel Grid.Column="0" Orientation="Horizontal"
                        VerticalAlignment="Center" Margin="6,0,0,0">

                <!-- Hamburger Pane Toggle (☰) — Toggles sidebar open/closed -->
                <Button x:Name="TitleBarPaneToggle"
                        Width="38" Height="38" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="OnPaneToggleClicked"
                        ToolTip="Toggle navigation pane">
                    <TextBlock Text="&#xE700;" FontFamily="Segoe Fluent Icons"
                               Foreground="White" FontSize="15"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>

                <!-- NAS status dot (click to re-check connection) -->
                <Border x:Name="TitleBarNasClickTarget"
                        Width="22" Height="38" Background="Transparent"
                        Cursor="Hand"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        MouseLeftButtonDown="OnCheckNasStatusClicked"
                        ToolTip="SSNAS — click to check connection">
                    <Ellipse x:Name="TitleBarNasDot" Width="8" Height="8"
                             Fill="#94A3B8"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- App wordmark -->
                <TextBlock Text="SS Design Assets Manager"
                           Foreground="White" FontSize="13" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="2,0,12,0"
                           FontFamily="Segoe UI Variable Display"/>
            </StackPanel>

            <!-- ── Col 2: Search box (Centred) ─────────────────────────── -->
            <Border x:Name="TitleBarSearchBorder" Grid.Column="2"
                    Background="#26FFFFFF" CornerRadius="4"
                    BorderBrush="#40FFFFFF" BorderThickness="1"
                    Padding="8,0" Width="240" Height="28"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons"
                               Foreground="#CCFFFFFF" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="TitleBarSearchBox"
                             Background="Transparent" BorderThickness="0"
                             Foreground="White" CaretBrush="White"
                             FontSize="12" VerticalAlignment="Center"
                             MinWidth="170"
                             WindowChrome.IsHitTestVisibleInChrome="True"
                             GotFocus="OnSearchBoxGotFocus"
                             LostFocus="OnSearchBoxLostFocus"
                             TextChanged="OnSearchBoxTextChanged"/>
                </StackPanel>
            </Border>

            <!-- ── Col 4: Right group ─── [🎨 Brand Kit] [⏱ Timer] [👤 Avatar] ─────────── -->
            <StackPanel Grid.Column="4" Orientation="Horizontal"
                        VerticalAlignment="Center">

                <!-- Brand Kit Quick-Tray Badge -->
                <StackPanel x:Name="TitleBarBrandKitBtn"
                            Orientation="Horizontal" Margin="0,0,12,0"
                            Cursor="Hand"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            MouseLeftButtonDown="OnBrandKitTrayClicked"
                            ToolTip="Brand Kit Quick-Tray — click to copy brand colors">
                    <TextBlock Text="&#xE790;" FontFamily="Segoe Fluent Icons"
                               Foreground="#FFD700" FontSize="11"
                               VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="Brand Kit"
                               Foreground="#CCFFFFFF" FontSize="11" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Focus timer badge -->
                <StackPanel x:Name="TitleBarTimerBadge"
                            Orientation="Horizontal" Margin="0,0,12,0"
                            Cursor="Hand"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            MouseLeftButtonDown="OnFooterTimerClicked"
                            ToolTip="Focus timer — click to open Wellbeing page">
                    <TextBlock Text="&#xE916;" FontFamily="Segoe Fluent Icons"
                               Foreground="#CCFFFFFF" FontSize="11"
                               VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock x:Name="TitleBarTimerText" Text="Timer: Ready"
                               Foreground="#CCFFFFFF" FontSize="11"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- User avatar (circular 32 px, clipped) -->
                <Border x:Name="TitleBarAvatarBtn"
                        Width="32" Height="32" CornerRadius="50"
                        Background="#60007ACC" Cursor="Hand"
                        ClipToBounds="True"
                        VerticalAlignment="Center"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        MouseLeftButtonDown="OnProfileCardClicked"
                        ToolTip="Settings &amp; Profile">
                    <Grid>
                        <Image x:Name="TitleBarAvatarImage"
                               Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Visibility="Collapsed"/>
                        <TextBlock x:Name="TitleBarAvatarInitials" Text="H"
                                   Foreground="White" FontSize="13" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

            </StackPanel>
                </Grid>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- ══════════════════════════════════════════════════════════════════
             UPDATE NOTIFICATION BANNER  (collapsed by default)
             ══════════════════════════════════════════════════════════════════ -->
        <Border x:Name="UpdateBanner" Grid.Row="1"
                Background="#FEF9C3" BorderBrush="#EAB308" BorderThickness="0,0,0,1"
                Padding="16,6" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#x1F195; " FontFamily="Segoe UI Emoji" FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock x:Name="UpdateBannerText" Text="A new version of SS-CAM is available!"
                               FontSize="12" FontWeight="SemiBold" Foreground="#78350F"
                               VerticalAlignment="Center" FontFamily="Segoe UI Variable Text"/>
                </StackPanel>
                <Button x:Name="UpdateDownloadBtn" Grid.Column="1" Content="Download Update"
                        Click="OnDownloadUpdateClicked" Height="26" Padding="12,0" Margin="12,0,8,0"
                        Background="#EAB308" Foreground="White" FontWeight="SemiBold" FontSize="11"
                        BorderThickness="0" Cursor="Hand" FontFamily="Segoe UI Variable Text"/>
                <Button Grid.Column="2" Content="&#x2716;" Click="OnDismissUpdateBanner"
                        Width="26" Height="26" Background="Transparent" Foreground="#92400E"
                        BorderThickness="0" FontSize="12" FontWeight="Bold" Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════════════
             MAIN BODY — NavigationView
             Sidebar: SS Navy (#021B47), expandable/collapsible via ☰ toggle.
             Nav items grouped by function using NavigationViewItemHeader.
             ══════════════════════════════════════════════════════════════════ -->
        <ui:NavigationView x:Name="RootNavigation" Grid.Row="2"
                           PaneDisplayMode="Left"
                           IsPaneOpen="True"
                           IsPaneToggleVisible="False"
                           IsBackButtonVisible="Collapsed"
                           OpenPaneLength="210"
                           CompactPaneLength="50"
                           Background="Transparent"
                           Padding="4,0,0,0">

            <!-- Nav groups -->
            <ui:NavigationView.MenuItems>

                <ui:NavigationViewItemHeader Text="OVERVIEW"/>
                <ui:NavigationViewItem Content="Dashboard"
                                       Icon="{ui:SymbolIcon Home24}"
                                       TargetPageType="{x:Type views:DashboardPage}"/>

                <ui:NavigationViewItemHeader Text="WELLNESS"/>
                <ui:NavigationViewItem Content="Creative Wellbeing"
                                       Icon="{ui:SymbolIcon Heart24}"
                                       TargetPageType="{x:Type views:WellbeingPage}"/>
                <ui:NavigationViewItem Content="Waktu Solat"
                                       Icon="{ui:SymbolIcon Clock24}"
                                       TargetPageType="{x:Type views:WaktuSolatPage}"/>

                <ui:NavigationViewItemHeader Text="PROJECTS"/>
                <ui:NavigationViewItem Content="Project Creator"
                                       Icon="{ui:SymbolIcon Folder24}"
                                       TargetPageType="{x:Type views:ProjectCreatorPage}"/>
                <ui:NavigationViewItem Content="Search &amp; Copy"
                                       Icon="{ui:SymbolIcon Search24}"
                                       TargetPageType="{x:Type views:SearchCopyPage}"/>
                <ui:NavigationViewItem Content="Brand Assets"
                                       Icon="{ui:SymbolIcon Library24}"
                                       TargetPageType="{x:Type views:BrandAssetsPage}"/>

                <ui:NavigationViewItemHeader Text="TOOLS"/>
                <ui:NavigationViewItem Content="Radio Player"
                                       Icon="{ui:SymbolIcon MusicNote224}"
                                       TargetPageType="{x:Type views:RadioPage}"/>
                <ui:NavigationViewItem Content="Quick Notes"
                                       Icon="{ui:SymbolIcon Document24}"
                                       TargetPageType="{x:Type views:QuickNotePage}"/>
                <ui:NavigationViewItem Content="Task Manager"
                                       Icon="{ui:SymbolIcon Checkmark24}"
                                       TargetPageType="{x:Type views:TaskManagerPage}"/>
                <ui:NavigationViewItem Content="Workstation Health"
                                       Icon="{ui:SymbolIcon Important24}"
                                       TargetPageType="{x:Type views:WorkstationHealthPage}"/>

            </ui:NavigationView.MenuItems>

            <!-- ── Footer: Settings ──────────────────────────────────────── -->
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="Settings &amp; Profile"
                                       Icon="{ui:SymbolIcon Settings24}"
                                       TargetPageType="{x:Type views:SettingsPage}"/>
            </ui:NavigationView.FooterMenuItems>

            <!-- ── Pane Footer: theme toggle + radio row ─────────────────── -->
            <ui:NavigationView.PaneFooter>
                <StackPanel Margin="0,4,0,10">
                    <StackPanel Orientation="Horizontal" Margin="16,4" Cursor="Hand"
                                Focusable="False"
                                MouseLeftButtonDown="OnStatusThemeToggle"
                                ToolTip="Click to cycle: SS Default &#x2192; Falconia &#x2192; Metamorphosis">
                        <TextBlock Text="&#xE790;" FontFamily="Segoe Fluent Icons"
                                   Foreground="#5A7FA8" FontSize="11"
                                   VerticalAlignment="Center" Margin="0,0,7,0" Focusable="False"/>
                        <TextBlock x:Name="StatusThemeText" Text="Theme: SS Default"
                                   Foreground="#C8C8C8" FontSize="11"
                                   VerticalAlignment="Center" Focusable="False"/>
                    </StackPanel>
                    <Grid x:Name="RadioFooterRow" Visibility="Collapsed" Margin="0,2">
                        <StackPanel Orientation="Horizontal" Margin="16,0">
                            <TextBlock Text="&#xE8D6;" FontFamily="Segoe Fluent Icons"
                                       Foreground="#0078D4" FontSize="11"
                                       VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock x:Name="StatusRadioText" Text="Radio"
                                       Foreground="#C8C8C8" FontSize="11" VerticalAlignment="Center"
                                       MouseLeftButtonDown="OnFooterRadioClicked" Cursor="Hand"
                                       ToolTip="Open Radio Player"/>
                        </StackPanel>
                        <Button x:Name="StatusRadioPlayBtn" Click="OnStatusRadioPlayToggle"
                                Background="Transparent" BorderThickness="0"
                                HorizontalAlignment="Right" Margin="0,0,12,0" Cursor="Hand">
                            <TextBlock x:Name="StatusRadioPlayIcon" Text="&#xE768;"
                                       FontFamily="Segoe Fluent Icons" Foreground="#0078D4"/>
                        </Button>
                    </Grid>
                </StackPanel>
            </ui:NavigationView.PaneFooter>

        </ui:NavigationView>

        <!-- Legacy compatibility stubs (hidden) -->
        <Canvas x:Name="HeaderCanvas"      Grid.Row="0" IsHitTestVisible="False" Visibility="Collapsed"/>
        <TextBlock x:Name="HeaderSubtitle" Grid.Row="0" Visibility="Collapsed"/>
        <TextBlock x:Name="SidebarModulesLabel" Visibility="Collapsed"/>

        <!-- Brand Kit Quick-Tray Popup -->
        <Popup x:Name="BrandKitTrayPopup" StaysOpen="False" Placement="Bottom" PlacementTarget="{Binding ElementName=TitleBarBrandKitBtn}" VerticalOffset="4">
            <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="14" Width="320">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="🎨 Brand Kit Quick-Tray" Foreground="White" FontWeight="Bold" FontSize="13"/>
                        <TextBlock Text="Click to copy HEX" Foreground="#94A3B8" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Swatches grid -->
                    <UniformGrid Columns="4" Margin="0,0,0,10">
                        <Border Background="#022057" Height="36" CornerRadius="4" Margin="2" Cursor="Hand" ToolTip="SS Prussian Blue (#022057)" MouseLeftButtonDown="OnQuickSwatchClicked" Tag="#022057"/>
                        <Border Background="#043388" Height="36" CornerRadius="4" Margin="2" Cursor="Hand" ToolTip="SS Blue (#043388)" MouseLeftButtonDown="OnQuickSwatchClicked" Tag="#043388"/>
                        <Border Background="#21A1F7" Height="36" CornerRadius="4" Margin="2" Cursor="Hand" ToolTip="Azure (#21A1F7)" MouseLeftButtonDown="OnQuickSwatchClicked" Tag="#21A1F7"/>
                        <Border Background="#6DC6EC" Height="36" CornerRadius="4" Margin="2" Cursor="Hand" ToolTip="Malibu (#6DC6EC)" MouseLeftButtonDown="OnQuickSwatchClicked" Tag="#6DC6EC"/>
                        <Border Background="#BD9A73" Height="36" CornerRadius="4" Margin="2" Cursor="Hand" ToolTip="Lion (#BD9A73)" MouseLeftButtonDown="OnQuickSwatchClicked" Tag="#BD9A73"/>
                        <Border Background="#CCAC8D" Height="36" CornerRadius="4" Margin="2" Cursor="Hand" ToolTip="Fawn (#CCAC8D)" MouseLeftButtonDown="OnQuickSwatchClicked" Tag="#CCAC8D"/>
                        <Border Background="#E5D15C" Height="36" CornerRadius="4" Margin="2" Cursor="Hand" ToolTip="Arylide Yellow (#E5D15C)" MouseLeftButtonDown="OnQuickSwatchClicked" Tag="#E5D15C"/>
                        <Border Background="#FCE53D" Height="36" CornerRadius="4" Margin="2" Cursor="Hand" ToolTip="Banana Yellow (#FCE53D)" MouseLeftButtonDown="OnQuickSwatchClicked" Tag="#FCE53D"/>
                    </UniformGrid>

                    <Button Content="Open Full Brand Assets Page" Click="OnOpenFullBrandAssetsClicked" Height="28" Background="#043388" Foreground="White" FontWeight="Bold" FontSize="11" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
            </Border>
        </Popup>

    </Grid>
</ui:FluentWindow>