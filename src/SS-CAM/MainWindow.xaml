<ui:FluentWindow x:Class="SS_CAM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:views="clr-namespace:SS_CAM.Views"
        Title="SuamiSihat Creative Assets Management v3.0.1" Height="820" Width="1280"
        MinHeight="680" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">

    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <!-- TitleBar Full Blue Caption Button Theme Overrides -->
            <SolidColorBrush x:Key="TitleBarBackgroundThemeBrush" Color="#022057"/>
            <SolidColorBrush x:Key="TitleBarButtonBackground" Color="Transparent"/>
            <SolidColorBrush x:Key="TitleBarButtonForeground" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="TitleBarButtonHoverBackground" Color="#163B75"/>
            <SolidColorBrush x:Key="TitleBarButtonHoverForeground" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="TitleBarButtonPressedBackground" Color="#0D2A5C"/>
            <SolidColorBrush x:Key="TitleBarButtonPressedForeground" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="TitleBarButtonInactiveBackground" Color="Transparent"/>
            <SolidColorBrush x:Key="TitleBarButtonInactiveForeground" Color="#8AAACF"/>
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid Background="{DynamicResource ApplicationPageBackgroundThemeBrush}">
        <!-- Main Layout Rows -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- TitleBar drag region -->
            <RowDefinition Height="Auto"/>   <!-- Update Banner (hidden by default) -->
            <RowDefinition Height="*"/>      <!-- Main Body -->
            <RowDefinition Height="Auto"/>   <!-- Persistent Bottom Radio Bar -->
        </Grid.RowDefinitions>

        <!-- TITLE BAR STRIP (Extended TitleBar Header with Toggle Button, Central Search & Profile Card) -->
        <Grid x:Name="TitleBarStrip" Grid.Row="0" Height="42" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
              MouseLeftButtonDown="OnTitleBarDragWindow">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>   <!-- Navigation Toggle + App Brand -->
                <ColumnDefinition Width="*"/>      <!-- Centered Global Search Box -->
                <ColumnDefinition Width="Auto"/>   <!-- User Profile Card + TitleBar Controls -->
            </Grid.ColumnDefinitions>

            <!-- 1. Navigation Toggle + Full Logo Brand Title -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,12,0">
                <ui:Button x:Name="TitleBarNavToggleBtn" Click="OnTitleBarNavToggleClicked"
                           Appearance="Secondary" Width="30" Height="30" Padding="0" Margin="0,0,10,0"
                           Cursor="Hand" ToolTip="Toggle Navigation Sidebar">
                    <ui:TextBlock x:Name="TitleBarNavToggleIcon" Text="&#xE700;" FontFamily="Segoe Fluent Icons" FontSize="13"
                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                </ui:Button>

                <ui:TextBlock x:Name="TitleBarAppTitle" Text="SS Creative Assets Management" FontSize="13" FontWeight="Bold"
                              Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- 2. Centered Global Search Box -->
            <Grid Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="340">
                <Border x:Name="SidebarSearchBorder" Background="{DynamicResource TextControlBackground}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="8,4" Height="28">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="SidebarSearchBox" Grid.Column="1" Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource TextFillColorPrimaryBrush}" CaretBrush="{DynamicResource TextFillColorPrimaryBrush}"
                                 Text="" Tag="Search modules, projects (Ctrl+K)..."
                                 FontSize="11.5" VerticalAlignment="Center"
                                 GotFocus="OnSearchBoxGotFocus"
                                 LostFocus="OnSearchBoxLostFocus"
                                 TextChanged="OnSearchBoxTextChanged"/>
                        <Border Grid.Column="2" Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="3" Padding="4,1" VerticalAlignment="Center">
                            <ui:TextBlock Text="Ctrl+K" FontSize="8.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontWeight="SemiBold"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- 3. Profile Pill Card & Window Controls -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- User profile card (Transparent background, clean circle avatar) -->
                <Border x:Name="SidebarUserCard" Margin="0,0,6,0" CornerRadius="14" Padding="6,2"
                        Background="Transparent" Cursor="Hand"
                        MouseLeftButtonDown="OnProfileCardClicked"
                        ToolTip="Open Settings &amp; Profile">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="SidebarAvatarRing" Width="28" Height="28" CornerRadius="14"
                                Background="{DynamicResource FluentBrand80}" VerticalAlignment="Center" Margin="0,0,6,0">
                            <Grid>
                                <Image x:Name="SidebarAvatarImage" Stretch="UniformToFill"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       Visibility="Collapsed"/>
                                <ui:TextBlock x:Name="SidebarAvatarInitials" Text="H"
                                           Foreground="White" FontSize="12" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,4,0">
                            <ui:TextBlock x:Name="SidebarPersonaName" Text="Designer"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="11.5" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                            <ui:TextBlock x:Name="SidebarPersonaDept" Text="Creative" Visibility="Collapsed"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="9"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Native TitleBar for Window Minimize/Maximize/Close buttons -->
                <ui:TitleBar x:Name="AppTitleBar" Title="" MinHeight="42" Height="42" VerticalAlignment="Center"
                             Background="Transparent" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            </StackPanel>
        </Grid>

        <!-- Update Notification Banner -->
        <Border x:Name="UpdateBanner" Grid.Row="1" Background="#FEF9C3" BorderBrush="#EAB308"
                BorderThickness="0,0,0,1" Padding="16,6" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#x1F195; " FontFamily="Segoe UI Emoji" FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock x:Name="UpdateBannerText" Text="A new version of SS-CAM is available!"
                               FontSize="12" FontWeight="SemiBold" Foreground="#78350F" VerticalAlignment="Center"
                               FontFamily="Segoe UI Variable Text"/>
                </StackPanel>
                <Button x:Name="UpdateDownloadBtn" Grid.Column="1" Content="Download Update"
                        Click="OnDownloadUpdateClicked" Height="26" Padding="12,0" Margin="12,0,8,0"
                        Background="#EAB308" Foreground="White" FontWeight="SemiBold" FontSize="11"
                        BorderThickness="0" Cursor="Hand" FontFamily="Segoe UI Variable Text"/>
                <Button Grid.Column="2" Content="&#x2716;" Click="OnDismissUpdateBanner" Width="26" Height="26"
                        Background="Transparent" Foreground="#92400E" BorderThickness="0" FontSize="12"
                        FontWeight="Bold" Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- Main Body: Fluent 2 NavigationView (always expanded) -->
        <ui:NavigationView x:Name="RootNavigation" Grid.Row="2"
                           PaneDisplayMode="Left"
                           IsPaneOpen="True"
                           IsPaneToggleVisible="False"
                           IsBackButtonVisible="Collapsed"
                           HeaderVisibility="Collapsed"
                           OpenPaneLength="200"
                           PaneOpened="OnNavigationPaneOpened"
                           PaneClosed="OnNavigationPaneClosed">

            <!-- PANE HEADER: Top Padding Spacer to align top sidebar item with right-hand Page Title -->
            <ui:NavigationView.PaneHeader>
                <Grid Height="14"/>
            </ui:NavigationView.PaneHeader>

            <!-- MENU ITEMS (Grouped by Separators) -->
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="Dashboard"          Icon="{ui:SymbolIcon Home24}"        TargetPageType="{x:Type views:DashboardPage}" />

                <ui:NavigationViewItemSeparator />

                <ui:NavigationViewItem Content="Project Creator"    Icon="{ui:SymbolIcon Folder24}"      TargetPageType="{x:Type views:ProjectCreatorPage}" />
                <ui:NavigationViewItem Content="Search &amp; Copy"  Icon="{ui:SymbolIcon Search24}"      TargetPageType="{x:Type views:SearchCopyPage}" />
                <ui:NavigationViewItem Content="Brand Assets"       Icon="{ui:SymbolIcon Library24}"     TargetPageType="{x:Type views:BrandAssetsPage}" />

                <ui:NavigationViewItemSeparator />

                <ui:NavigationViewItem Content="Task Manager"       Icon="{ui:SymbolIcon Checkmark24}"   TargetPageType="{x:Type views:TaskManagerPage}" />
                <ui:NavigationViewItem Content="Quick Notes"        Icon="{ui:SymbolIcon Document24}"    TargetPageType="{x:Type views:QuickNotePage}" />

                <ui:NavigationViewItemSeparator />

                <ui:NavigationViewItem Content="Creative Wellbeing" Icon="{ui:SymbolIcon Heart24}"       TargetPageType="{x:Type views:WellbeingPage}" />
                <ui:NavigationViewItem Content="Waktu Solat"        Icon="{ui:SymbolIcon Clock24}"       TargetPageType="{x:Type views:WaktuSolatPage}" />
                <ui:NavigationViewItem Content="Radio Player"       Icon="{ui:SymbolIcon MusicNote224}"  TargetPageType="{x:Type views:RadioPage}" />

                <ui:NavigationViewItemSeparator />

                <ui:NavigationViewItem Content="Workstation Health" Icon="{ui:SymbolIcon Important24}"   TargetPageType="{x:Type views:WorkstationHealthPage}" />
                <ui:NavigationViewItemSeparator />
                <ui:NavigationViewItem Content="Settings &amp; Profile" Icon="{ui:SymbolIcon Settings24}" TargetPageType="{x:Type views:SettingsPage}" />
            </ui:NavigationView.MenuItems>

            <!-- PANE FOOTER: Status rows -->
            <ui:NavigationView.PaneFooter>
                <StackPanel Margin="0,6,0,12">
                    <Border x:Name="SidebarDivider" Height="1" Background="{DynamicResource SidebarDividerBrush}" Margin="12,0,12,6"/>
                    <!-- NAS status -->
                    <StackPanel x:Name="FooterNasPanel" Orientation="Horizontal" Margin="16,4"
                                MouseLeftButtonDown="OnCheckNasStatusClicked" Cursor="Hand"
                                ToolTip="Click to re-check Synology NAS connection">
                        <Ellipse x:Name="NasStatusDot" Width="8" Height="8" Fill="#94A3B8"
                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ui:TextBlock x:Name="StatusNasText" Text="SSNAS Offline" Foreground="{DynamicResource SidebarTextSecondaryBrush}"
                                   FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                    <!-- Focus timer -->
                    <StackPanel x:Name="FooterTimerPanel" Orientation="Horizontal" Margin="16,4"
                                MouseLeftButtonDown="OnFooterTimerClicked" Cursor="Hand"
                                ToolTip="Open Wellbeing &amp; Focus Timer">
                        <ui:TextBlock x:Name="StatusTimerIcon" Text="&#xE916;" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource SidebarTextSecondaryBrush}"
                                   FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <ui:TextBlock x:Name="StatusTimerText" Text="Focus Timer: Ready" Foreground="{DynamicResource SidebarTextSecondaryBrush}"
                                   FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                    <!-- Active theme - click to cycle -->
                    <StackPanel x:Name="FooterThemePanel" Orientation="Horizontal" Margin="16,4" Cursor="Hand"
                                Focusable="False"
                                MouseLeftButtonDown="OnStatusThemeToggle"
                                ToolTip="Click to toggle application theme">
                        <ui:TextBlock x:Name="StatusThemeIcon" Text="&#xE790;" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource SidebarTextSecondaryBrush}"
                                   FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0"
                                   Focusable="False"/>
                        <ui:TextBlock x:Name="StatusThemeText" Text="Theme: SuamiSihat Light" Foreground="{DynamicResource SidebarTextSecondaryBrush}"
                                   FontSize="11" VerticalAlignment="Center"
                                   Focusable="False"/>
                    </StackPanel>
                </StackPanel>
            </ui:NavigationView.PaneFooter>
        </ui:NavigationView>

        <!-- PERSISTENT BOTTOM RADIO PLAYER BAR (Full SuamiSihat Deep Blue + Faded Background Wave Visualizer) -->
        <Border x:Name="BottomRadioPlayerBar" Grid.Row="3"
                Background="#022057" BorderBrush="#043388"
                BorderThickness="0,1,0,0" Padding="16,10" Visibility="Collapsed">
            <Grid>
                <!-- Ambient Wavelength Audio Visualizer Background Layer -->
                <Grid x:Name="BottomRadioSpectrumPanel" Height="42" VerticalAlignment="Bottom"
                      HorizontalAlignment="Stretch" IsHitTestVisible="False" Opacity="0.35" Margin="-16,0,-16,-10">
                    <!-- Gradient Fill under wavelength -->
                    <Path x:Name="SpecWaveFillPath" Opacity="0.25">
                        <Path.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#3B82F6" Offset="0"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </LinearGradientBrush>
                        </Path.Fill>
                    </Path>

                    <!-- Glowing Wavelength Vector Line -->
                    <Path x:Name="SpecWaveLinePath" StrokeThickness="2.5">
                        <Path.Stroke>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#60A5FA" Offset="0.0"/>
                                <GradientStop Color="#38BDF8" Offset="0.3"/>
                                <GradientStop Color="#34D399" Offset="0.7"/>
                                <GradientStop Color="#818CF8" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Path.Stroke>
                    </Path>
                </Grid>

                <!-- Interactive Foreground Controls -->
                <Grid Panel.ZIndex="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>   <!-- Cover Art / Emoji badge -->
                        <ColumnDefinition Width="*"/>      <!-- Track info -->
                        <ColumnDefinition Width="Auto"/>   <!-- Controls: Play/Pause, Vol -->
                    </Grid.ColumnDefinitions>

                    <!-- Station Cover Art / Emoji Badge -->
                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8"
                            Background="#043388" Margin="0,0,12,0" VerticalAlignment="Center" ClipToBounds="True">
                        <Grid>
                            <Image x:Name="ImgBottomRadioCover" Stretch="UniformToFill" Visibility="Collapsed"/>
                            <ui:TextBlock x:Name="TxtBottomRadioEmoji" Text="&#x1F4FB;" FontSize="18"
                                          Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Station Name, Live Badge, Visualizer Badge & Now Playing Track Info -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="OnBottomRadioBarClicked">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:TextBlock x:Name="TxtBottomRadioTitle" Text="Radio Stream" FontWeight="Bold" FontSize="13"
                                           Foreground="White" VerticalAlignment="Center"/>
                            <Border Background="#10B981" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <ui:TextBlock Text="LIVE" Foreground="White" FontSize="9" FontWeight="Bold"/>
                            </Border>
                            <!-- Visualizer Mode Badge (Clickable to switch visualizer mode) -->
                            <Border x:Name="BottomVisualizerBadge" Background="#21A1F7" CornerRadius="4" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center" Cursor="Hand" ToolTip="Klik untuk tukar Visualizer Mode">
                                <ui:TextBlock x:Name="TxtBottomVisualizerBadge" Text="VIZ: HERO MESH" Foreground="White" FontSize="9" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0" VerticalAlignment="Center">
                            <ui:TextBlock x:Name="BottomRadioNowPlayingLabel" Text="NOW PLAYING:" FontSize="10" FontWeight="SemiBold"
                                           Foreground="#60A5FA" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <ui:TextBlock x:Name="TxtBottomRadioTrack" Text="Now Playing..." FontSize="11"
                                           Foreground="#93C5FD" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" MaxWidth="420"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Controls: Play/Pause, Visualizer Mode Toggle, Volume -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button x:Name="BtnBottomVisualizer" Click="OnCycleVisualizerClicked" Appearance="Secondary"
                                   Width="34" Height="34" Padding="0" Margin="0,0,8,0" Cursor="Hand" ToolTip="Visualizer Mode: Hero Mesh (Klik untuk tukar)">
                            <ui:TextBlock x:Name="TxtBottomVisualizerIcon" Text="&#xE734;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="White"/>
                        </ui:Button>

                        <ui:Button x:Name="BtnBottomRadioPlay" Click="OnStatusRadioPlayToggle" Appearance="Primary"
                                   Width="34" Height="34" Padding="0" Margin="0,0,12,0" Cursor="Hand" ToolTip="Play / Pause">
                            <ui:TextBlock x:Name="TxtBottomRadioPlayIcon" Text="&#xE768;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="White"/>
                        </ui:Button>

                        <StackPanel x:Name="BottomRadioVolumePanel" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:TextBlock Text="&#xE767;" FontFamily="Segoe Fluent Icons" FontSize="13"
                                           Foreground="#8AAACF" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Slider x:Name="BottomRadioVolumeSlider" Width="100" Minimum="0" Maximum="100" Value="80"
                                     ValueChanged="OnBottomRadioVolumeChanged" VerticalAlignment="Center" ToolTip="Volume"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Hidden elements (kept for backward compatibility) -->
        <Canvas x:Name="HeaderCanvas" Grid.Row="0" IsHitTestVisible="False" Visibility="Collapsed"/>
        <TextBlock x:Name="HeaderSubtitle" Grid.Row="0" Visibility="Collapsed"/>
    </Grid>
</ui:FluentWindow>