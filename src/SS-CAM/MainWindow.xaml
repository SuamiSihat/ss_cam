<ui:FluentWindow x:Class="SS_CAM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:views="clr-namespace:SS_CAM.Views"
        Title="SuamiSihat Creative Assets Management v2.6.0" Height="820" Width="1280"
        MinHeight="660" MinWidth="980"
        WindowState="Normal"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="None"
        WindowCornerPreference="Round">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Update Banner (hidden by default) -->
            <RowDefinition Height="*"/>      <!-- Main Body -->
        </Grid.RowDefinitions>

        <!-- Update Notification Banner -->
        <Border x:Name="UpdateBanner" Grid.Row="0" Background="#FEF9C3" BorderBrush="#EAB308"
                BorderThickness="0,0,0,1" Padding="16,6" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#x1F195; " FontFamily="Segoe UI Emoji" FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock x:Name="UpdateBannerText" Text="A new version of SS-CAM is available!"
                               FontSize="12" FontWeight="SemiBold" Foreground="#78350F" VerticalAlignment="Center"
                               FontFamily="Segoe UI Variable Text"/>
                </StackPanel>
                <Button x:Name="UpdateDownloadBtn" Grid.Column="1" Content="Download Update"
                        Click="OnDownloadUpdateClicked" Height="26" Padding="12,0" Margin="12,0,8,0"
                        Background="#EAB308" Foreground="White" FontWeight="SemiBold" FontSize="11"
                        BorderThickness="0" Cursor="Hand" FontFamily="Segoe UI Variable Text"/>
                <Button Grid.Column="2" Content="&#x2716;" Click="OnDismissUpdateBanner" Width="26" Height="26"
                        Background="Transparent" Foreground="#92400E" BorderThickness="0" FontSize="12"
                        FontWeight="Bold" Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- Main Body: Fluent 2 NavigationView (always expanded — Left pane with text labels) -->
        <ui:NavigationView x:Name="RootNavigation" Grid.Row="1"
                           PaneDisplayMode="Left"
                           IsPaneOpen="True"
                           IsBackButtonVisible="Collapsed"
                           OpenPaneLength="200">

            <!-- PANE HEADER: Search box + Modules label -->
            <ui:NavigationView.PaneHeader>
                <StackPanel Margin="12,6,12,4">
                    <!-- Search box -->
                    <Border x:Name="SidebarSearchBorder" Background="#0D2A5C" CornerRadius="6" Padding="8,6" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons" Foreground="#8AAACF"
                                       FontSize="13" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBox x:Name="SidebarSearchBox" Background="Transparent" BorderThickness="0"
                                     Foreground="#C8D8E8" CaretBrush="White"
                                     Text="" Tag="Search modules..."
                                     FontSize="12" VerticalAlignment="Center"
                                     MinWidth="130"
                                     GotFocus="OnSearchBoxGotFocus"
                                     LostFocus="OnSearchBoxLostFocus"
                                     TextChanged="OnSearchBoxTextChanged"/>
                        </StackPanel>
                    </Border>
                    <!-- MODULES section label -->
                    <TextBlock x:Name="SidebarModulesLabel" Text="MODULES" Foreground="#5A7FA8" FontSize="10" FontWeight="Bold"
                               Margin="4,0,0,4"/>
                </StackPanel>
            </ui:NavigationView.PaneHeader>

            <!-- MENU ITEMS -->
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="Dashboard"         Icon="{ui:SymbolIcon Home24}"        TargetPageType="{x:Type views:DashboardPage}" />
                <ui:NavigationViewItem Content="Creative Wellbeing" Icon="{ui:SymbolIcon Heart24}"       TargetPageType="{x:Type views:WellbeingPage}" />
                <ui:NavigationViewItem Content="Waktu Solat"       Icon="{ui:SymbolIcon Clock24}"       TargetPageType="{x:Type views:WaktuSolatPage}" />
                <ui:NavigationViewItem Content="Project Creator"   Icon="{ui:SymbolIcon Folder24}"      TargetPageType="{x:Type views:ProjectCreatorPage}" />
                <ui:NavigationViewItem Content="Search &amp; Copy" Icon="{ui:SymbolIcon Search24}"      TargetPageType="{x:Type views:SearchCopyPage}" />
                <ui:NavigationViewItem Content="Brand Assets"      Icon="{ui:SymbolIcon Library24}"     TargetPageType="{x:Type views:BrandAssetsPage}" />
                <ui:NavigationViewItem Content="Radio Player"      Icon="{ui:SymbolIcon MusicNote224}"  TargetPageType="{x:Type views:RadioPage}" />
                <ui:NavigationViewItem Content="Quick Notes"       Icon="{ui:SymbolIcon Document24}"    TargetPageType="{x:Type views:QuickNotePage}" />
                <ui:NavigationViewItem Content="Task Manager"      Icon="{ui:SymbolIcon Checkmark24}"   TargetPageType="{x:Type views:TaskManagerPage}" />
                <ui:NavigationViewItem Content="Workstation Health" Icon="{ui:SymbolIcon Important24}"  TargetPageType="{x:Type views:WorkstationHealthPage}" />
            </ui:NavigationView.MenuItems>

            <!-- FOOTER MENU ITEMS -->
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="Settings &amp; Profile" Icon="{ui:SymbolIcon Settings24}" TargetPageType="{x:Type views:SettingsPage}" />
            </ui:NavigationView.FooterMenuItems>

            <!-- PANE FOOTER: Status rows + User profile card -->
            <ui:NavigationView.PaneFooter>
                <StackPanel>
                    <!-- Status rows -->
                    <StackPanel Margin="0,6,0,4">
                        <!-- NAS status -->
                        <StackPanel Orientation="Horizontal" Margin="16,3">
                            <Ellipse x:Name="NasStatusDot" Width="8" Height="8" Fill="#94A3B8"
                                     VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock x:Name="StatusNasText" Text="SSNAS Offline" Foreground="#C8C8C8"
                                       FontSize="11" VerticalAlignment="Center"
                                       MouseLeftButtonDown="OnCheckNasStatusClicked" Cursor="Hand"
                                       ToolTip="Click to re-check Synology NAS connection"/>
                        </StackPanel>
                        <!-- Focus timer -->
                        <StackPanel Orientation="Horizontal" Margin="16,3">
                            <TextBlock Text="&#xE916;" FontFamily="Segoe Fluent Icons" Foreground="#5A7FA8"
                                       FontSize="11" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock x:Name="StatusTimerText" Text="Focus Timer: Ready" Foreground="#C8C8C8"
                                       FontSize="11" VerticalAlignment="Center"
                                       MouseLeftButtonDown="OnFooterTimerClicked" Cursor="Hand"
                                       ToolTip="Open Wellbeing &amp; Focus Timer"/>
                        </StackPanel>
                        <!-- Active theme - click to cycle themes -->
                        <StackPanel Orientation="Horizontal" Margin="16,3" Cursor="Hand"
                                    Focusable="False"
                                    MouseLeftButtonDown="OnStatusThemeToggle"
                                    ToolTip="Click to cycle: SS Default -> Falconia -> Metamorphosis">
                            <TextBlock Text="&#xE790;" FontFamily="Segoe Fluent Icons" Foreground="#5A7FA8"
                                       FontSize="11" VerticalAlignment="Center" Margin="0,0,7,0"
                                       Focusable="False"/>
                            <TextBlock x:Name="StatusThemeText" Text="Theme: SS Default" Foreground="#C8C8C8"
                                       FontSize="11" VerticalAlignment="Center"
                                       Focusable="False"/>
                        </StackPanel>
                        <!-- Radio row (shown only when playing) -->
                        <Grid Visibility="Collapsed" x:Name="RadioFooterRow" Margin="0,3">
                            <StackPanel Orientation="Horizontal" Margin="16,0">
                                <TextBlock Text="&#xE8D6;" FontFamily="Segoe Fluent Icons" Foreground="#0078D4"
                                           FontSize="11" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock x:Name="StatusRadioText" Text="Radio" Foreground="#C8C8C8"
                                           FontSize="11" VerticalAlignment="Center"
                                           MouseLeftButtonDown="OnFooterRadioClicked" Cursor="Hand"
                                           ToolTip="Open Radio Player"/>
                            </StackPanel>
                            <Button x:Name="StatusRadioPlayBtn" Click="OnStatusRadioPlayToggle"
                                    Background="Transparent" BorderThickness="0"
                                    HorizontalAlignment="Right" Margin="0,0,12,0" Cursor="Hand">
                                <TextBlock x:Name="StatusRadioPlayIcon" Text="&#xE768;"
                                           FontFamily="Segoe Fluent Icons" Foreground="#0078D4"/>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!-- Divider -->
                    <Border x:Name="SidebarDivider" Height="1" Background="#0D2A5C" Margin="12,4"/>

                    <!-- User profile card -->
                    <Border x:Name="SidebarUserCard" Margin="10,6,10,10" CornerRadius="8" Padding="10,8"
                            Background="#0D2A5C" Cursor="Hand"
                            MouseLeftButtonDown="OnProfileCardClicked"
                            ToolTip="Open Settings &amp; Profile">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Avatar circle -->
                            <Border x:Name="SidebarAvatarRing" Width="32" Height="32" CornerRadius="16"
                                    Background="#1A3D7A" VerticalAlignment="Center">
                                <Grid>
                                    <Image x:Name="SidebarAvatarImage" Stretch="UniformToFill"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           Visibility="Collapsed"/>
                                    <TextBlock x:Name="SidebarAvatarInitials" Text="H"
                                               Foreground="White" FontSize="13" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <!-- Name + department -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                <TextBlock x:Name="SidebarPersonaName" Text="Designer"
                                           Foreground="White" FontSize="12" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="SidebarPersonaDept" Text="Creative Department"
                                           Foreground="#8AAACF" FontSize="10"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ui:NavigationView.PaneFooter>
        </ui:NavigationView>

        <!-- Hidden elements for audio animation (kept for backward compatibility) -->
        <Canvas x:Name="HeaderCanvas" Grid.Row="0" IsHitTestVisible="False" Visibility="Collapsed"/>
        <TextBlock x:Name="HeaderSubtitle" Grid.Row="0" Visibility="Collapsed"/>
    </Grid>
</ui:FluentWindow>