# SS-CAM Web Portal Environment Configuration Template
# Copy this file to .env and configure strong values before starting the application.
# NEVER commit the active .env file to version control.

# Node Environment ('development' or 'production')
NODE_ENV=production

# Server Port and Host
PORT=4000
HOST=0.0.0.0

# Mandatory Production JWT Secret (must be at least 32 characters long)
# Generate a secure secret using: openssl rand -hex 32
JWT_SECRET=replace-this-with-a-random-64-character-hex-string-for-production

# JWT Access Token Lifetime (default: 12h)
JWT_EXPIRES_IN=12h

# Isolated Credential and Application Data Directory (NEVER point under WORKSPACE_ROOT)
# Stores user_passwords.json, private application state, etc.
DATA_DIR=./data

# CORS Allowed Origins (comma-separated list of browser origins permitted to connect)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4000,http://127.0.0.1:4000,https://creative.suamisihat.myds.me

# Emergency One-Time Admin Bootstrap Password
# Honored ONLY when NO admin account has a configured password in DATA_DIR/user_passwords.json.
# Once an admin password is created and hashed, this variable is strictly ignored.
ADMIN_BOOTSTRAP_PASSWORD=

# Creative Team Shared Assets Workspace Path
# In Docker: /data/Creative-Team
# On Local Windows: D:\SynologyDrive\Creative-Team or \\SSNAS\Creative-Team
WORKSPACE_ROOT=/data/Creative-Team

# Public App URL (used in email reset and notification links)
APP_URL=https://creative.suamisihat.myds.me

# SMTP Email Service Configuration
# Provider Option A - Gmail SMTP (Requires Google App Password):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_email@suamisihat.com
# SMTP_PASS=your_16_character_app_password
# SMTP_FROM="SS-CAM Creative Studio" <notifications@suamisihat.com>

# Provider Option B - Synology MailPlus Server (Local NAS):
# SMTP_HOST=192.168.50.2
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=notifications@suamisihat.com
# SMTP_PASS=your_mailplus_password
# SMTP_FROM="SS-CAM Creative Studio" <notifications@suamisihat.com>
